\viewkind4\uc1\pard\cf1\lang2057\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Praise, my soul, the King of heaven,
\par To His feet thy tribute bring;
\par Ransomed, healed, restored, forgiven,
\par Who like thee His praise should sing?
\par Praise Him ! Praise Him !
\par Praise the everlasting King.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Praise Him for His grace and favour 
\par To our fathers in distress;
\par Praise Him, still the same for ever,
\par Slow to chide and swift to bless ;
\par Praise Him ! Praise Him !
\par Glorious in His faithfulness.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Father-like He tends and spares us;
\par Well our feeble frame He knows;
\par In His hands He gently bears us,
\par Rescues us from all our foes ;
\par Praise Him ! Praise Him!
\par Widely as His mercy flows.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Angels in the height, adore Him ;
\par Ye behold Him face to face ;
\par Sun and moon, bow down before Him;
\par Dwellers all in times and space,
\par Praise Him ! Praise Him !
\par Praise with us the God of grace.   
\par                                       Amen.
\par \lang1033\f1 
\par \cf1\lang2057\ul\b\f2\fs16 
\par }

