\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. God the Father, be Thou near,
\par Save from every harm to- night;
\par Make us all Thy children dear,
\par In the darkness be our light.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. God the Saviour, be our peace,
\par Put away our sins to- night;
\par Speak the word of full release,
\par Turn our darkness into light.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Holy Spirit, deign to come,
\par Sanctify us all to- night;
\par In our hearts prepare Thy home,
\par Turn our darkness into light.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Holy Trinity, be nigh,
\par Mystery of love adored;
\par Help to live, and help to die;
\par Lighten all our darkness, Lord!
\par                                     Amen.\f1 
\par \cf1\ul\b 
\par }

