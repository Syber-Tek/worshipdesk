\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab Lord, in this t mercy's day 
\par \pard\li720 Ere it pass for aye away
\par Humbly at Thy feet we pray\tab 
\par \tab\tab\tab\tab\tab\tab\tab  
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Holy Jesus, grant us tears 
\par \pard\fi360\li360 Fill us with heart-searching fears
\par Ere that awful doom appears 
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Lord, on us Thy spirit pour,
\par \pard\fi360\li360 Kneeling lowly at Thy door, 
\par Ere it close for evermore. 
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab By Thy night of agony 
\par \pard\fi360\li360 By Thy supplicating cry
\par By Thy willing ness to die,
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab By Thy tears of bitter woe,
\par \pard\fi360\li360 For Jerusalem below,
\par Let us not Thy love forego.
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.\tab Judge and Saviour of our race,
\par \pard\fi360\li360 When we see Thee face to face ,
\par Grant us 'neath Thy wings a place.
\par \tab\tab\tab\tab Amen.
\par \pard\f1 
