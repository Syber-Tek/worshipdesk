\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab CHRIST, from whom all blessings flow,
\par \pard\li720 Perfecting the saints below,
\par Hear us, who Thy nature share,
\par Who Thy mystic body are.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Join us, in one spirit join,
\par \pard\li720 Let us still receive of Thine ;
\par Still for more on Thee we call,
\par Thou who fillest all in all.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Move, and actuate, and guide :
\par \pard\li720 Divers gifts to each divide;
\par Placed according to thy will,
\par Let us all our work fulfill ;
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Sweetly may we all agree,
\par \pard\li720 Touched with loving sympathy :
\par Kindly for each other care ;
\par Every member feel its share.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab Love, liked death, hath all destroyed,
\par \pard\li720 Rendered all distinctions void ;
\par Names, and secrets, and parties tall:
\par Thou, O Christ, art all in all.
\par \pard 
\par \f1 
\par \cf1\ul\b\f2\fs16 
\par }

