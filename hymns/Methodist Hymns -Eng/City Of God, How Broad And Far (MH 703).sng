\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab City of God, how broad and far
\par \pard\li720 Outspread thy walls sublime !
\par The true thy chartered freemen are,
\par Of every age and clime.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab One holy Church, one army strong,
\par \pard\li720 One steadfast high intent,
\par One working band, one harvest song,
\par One King Omnipotent.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab How purely hath thy speech come down
\par \pard\li720 From man's primeval youth !
\par How grandly hath thime empire grown
\par Of freedom, love, and truth !
\par \pard\li360 
\par 
\par  
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab How gleam thy watch-fires through the night
\par \pard\li720 With never-fainting ray !
\par How rise thy towers, serene and bright
\par To meet the dawning day !
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab In vain the surge's angry shock,
\par \pard\li720 In vain the drifting sands ;
\par Unharmed upon the eternal Rock
\par The eternal City stands.
\par 
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

