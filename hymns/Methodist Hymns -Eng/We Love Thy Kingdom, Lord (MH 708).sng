\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab We love Thy Kingdom, Lord,
\par \pard\li720 The house of  Thine  abode,
\par The Church our blest Redeemer saved
\par With His own precious blood.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab We love Thy Church, O God :
\par \pard\li720 Her saints before Thee stand,
\par Dear as the apple of Thine eye,
\par And graven on Thy hand.
\par \pard\fi-360\li720\tx720 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab For her our tears shall fall,
\par \pard\li720 For her our prayers ascend,
\par To her our cares and toils be given,
\par Till toils and cares shall end.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Beyond our highest joy
\par \pard\li720 We prizer her heavenly ways,
\par Her sweet communion, solemn vows,
\par Her hymns of love and praise.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab Jesus, Thou Friend divine,
\par \pard\li720 Our Saviour, and our King,
\par Thy hand from every snare and foe
\par Shall great deliverance bring.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.\tab Sure as Thy truth shall last,
\par \pard\li720 To Zion shall be given
\par The brightest glories earth can yield,
\par And brighter bliss of heaven.
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

