\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab Shepherd divine our wants relieve
\par \pard\li720 In this our evil day,
\par To all Thy tempted followers give 
\par The power to watch and pray.
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Long as our fiery trails last,
\par \pard\fi360\li360 Long as the cross we bear
\par O let our souls on Thee be cast 
\par In never- ceasing prayer!
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab The Spirit of interceding grace
\par \pard\fi360\li360 Give us in faith to claim;
\par To wrestle till we see Thy face,
\par And know Thy hidden name.
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Till Thou Thy perfect love impart ,
\par \pard\fi720 Till Thou Thyself bestow,
\par Be this the cry of every hearty:
\par I will not let Thee go
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab I will not let Thee go unless
\par \pard\li720 Thou  tell Thy name to me,
\par With all Thy great salvation bless
\par And  make me all like Thee.
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.\tab Then let me on the mountain-top
\par \pard\fi360\li360 Behold Thy open face,
\par Where faith in sight is swallowed up,
\par \pard\tab And prayer in endless praise.
\par                                                           Amen 
\par 
\par \f1 
\par \cf1\ul\b\f2\fs16 
\par }

