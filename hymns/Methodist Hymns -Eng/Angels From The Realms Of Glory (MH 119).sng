\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Angels fromthe realms of glory,
\par Wing your flight o'er all the earth;
\par Ye, who sang creation's story,
\par Now proclaim Messiah's birth;
\par Come and worship,
\par Worship Christ, the new-born King.
\par 
\par \cf1\ul\b\'b6 Verse 2
\par \cf0\ulnone\b0 2. Shepherds in the field abiding,
\par Watching o'er your flocks by night,
\par God with man is now residing,
\par Yonder shines the infant light;
\par Come and worship,
\par Worship Christ, the new-born King.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Sages, leave your contemplations;
\par Brighter visions beam afar;
\par Seek the great Desire of nations;
\par Ye have seen His natal star;
\par Come and worship,
\par Worship Christ, the new-born King.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Saints, before the altar bending,
\par Watching long with hope and fear,
\par Suddenly the Lord, descending,
\par In His temple shall appear;
\par Come and worship,
\par Worship Christ, the new-born King.
\par \f1 
\par \cf1\ul\b\fs16 
\par }

