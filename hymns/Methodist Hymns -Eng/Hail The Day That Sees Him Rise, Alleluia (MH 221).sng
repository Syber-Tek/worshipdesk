\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Hail The Day That Sees Him rise, 
\par                                               Alleluia!
\par Ravished from our wistful eyes!
\par                                              Alleluia!
\par Christ, awhile to mortals given,
\par                                              Alleluia!
\par Reascends His native heaven.
\par                                            Alleluia!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. There the pompous  triumph waits:
\par                                          Alleluia!
\par Lift your heads, eternal gates;
\par                                          Alleluia!
\par Wide unfold the radiant scene;
\par                                            Alleluia!
\par Take the King of Glory in!
\par                                     Alleluia!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Him though highest heaven receives,
\par                                               Alleluia!
\par Still He loves the earth He leaves;
\par                                               Alleluia!
\par Though returning to His throne,
\par                                               Alleluia!
\par Still He calls mankind His own.
\par                                              Alleluia!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. See! He lifts His hands above;
\par                                           Alleluia!
\par See! He shows the prints of love;
\par                                           Alleluia!
\par Hark! His gracious lips bestow
\par                                         Alleluia!
\par Blessings on His Church below.
\par                                            Alleluia!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Master, parted from our sight
\par                                             Alleluia!
\par High above yon azure height,
\par                                          Alleluia!
\par Grant our hearts may thither rise,
\par                                          Alleluia!
\par Following Thee beyond the skies.
\par                                          Alleluia!\f1 
\par \cf1\ul\b 
\par }

