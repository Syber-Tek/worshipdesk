\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Thine be the glory, risen, 
\par conquering Son,
\par Endless is the victory 
\par Thou o'er death hast won;
\par Angels in bright raiment 
\par rolled the stone away,
\par Kept the folded grave-clothes, 
\par where Thy body lay.
\par 
\par \cf1\ul\b\'b6 Chorus \cf0\ulnone\b0 
\par Thine be the glory, risen, 
\par conquering Son,
\par Endless is the victory 
\par Thou o'er death hast won.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par \pard\qj 2. Lo! Jesus meets us, 
\par risen from the tomb;
\par Lovingly He greets us, 
\par scatters fear and gloom;
\par Let the church with gladness,
\par hymns of triumph sing,
\par For her Lord now liveth,
\par death hath lost its sting.
\par 
\par \pard\cf1\ul\b\'b6 Chorus \cf0\ulnone\b0 
\par Thine be the glory, risen, 
\par conquering Son,
\par Endless is the victory 
\par \pard\qj Thou o'er death hast won.
\par 
\par \pard\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par \pard\qj 3. No more we doubt Thee,
\par glorious Prince of life;
\par Life is nought without Thee:
\par aid us in our strife;
\par Make us more than conquerors,
\par through Thy deathless love:
\par Bring us safe through Jordan 
\par to Thy home above. 
\par 
\par \pard\cf1\ul\b\'b6 Chorus \cf0\ulnone\b0 
\par Thine be the glory, risen, 
\par conquering Son,
\par Endless is the victory 
\par \pard\qj Thou o'er death hast won.\f1 
\par \pard\cf1\ul\b 
\par }

