\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Whosoever heareth! Shout,
\par shout the sound;
\par Send the blessed tidings 
\par all the world around;
\par Spread the joyful news wherever
\par man is found:
\par Whosoever will may come.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Whosoever will! Whosoever will!
\par Send the proclamation over vale
\par and hill;
\par 'Tis the loving Father calls the
\par wanderer home;
\par Whosoever will may come.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Whosoever cometh need not delay;
\par Now the door is open, enter while you may;
\par Jesus is the true and only living Way:
\par Whosoever will may come.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Whosoever will! Whosoever will!
\par Send the proclamation over vale
\par and hill;
\par 'Tis the loving Father calls the
\par wanderer home;
\par Whosoever will may come.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Whosoever will, the promise is secure;
\par Whosoever will, for ever shall endure;
\par Whosoever will, 'tis life for evermore;
\par Whosoever will may come.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Whosoever will! Whosoever will!
\par Send the proclamation over vale
\par and hill;
\par 'Tis the loving Father calls the
\par wanderer home;
\par Whosoever will may come.
\par \f1 
