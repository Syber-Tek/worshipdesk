\viewkind4\uc1\pard\fi-420\li420\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Father of heaven, whose love profound
\par A ransom for our souls hath found,
\par Before Thy throne we sinners bend;
\par To us Thy pardoning love extend.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Almighty Son, incarnate Word,
\par Our Prophet, Priest, Redeemer, Lord,
\par Before Thy throne we sinners bend;
\par To us Thy saving grace extend.
\par  
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Eternal Spirit, by whose breath
\par The soul is raised from sin and death
\par Before Thy throne we sinners bend
\par To us Thy quickening power extend.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Thrice holy: Father, Spirit, Son;
\par \pard\fi-420\li360 Mysterious Godhead, Three in One,
\par Before Thy throne we sinners bend;
\par Grace, pardon, life to us extend.
\par \tab                            Amen.
\par \pard\f1 
\par \cf1\ul\b\fs16 
\par }

