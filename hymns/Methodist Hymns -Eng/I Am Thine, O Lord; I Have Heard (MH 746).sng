\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab I AM Thine, O Lord l I have heard Thy voice,
\par \pard\li720 And it told Thy love to me ;
\par But I long to rise in the arms of faith,
\par And be closer drawn to Thee.
\par \pard\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par \b                        Draw me nearer, nearer, blessed Lord,
\par \tab            To the Cross where Thou hast died :
\par \tab            Draw me nearer, nearer, nearer,
\par \tab            Blessed Lord,
\par \tab            To Thy precious, bleeding side.
\par \b0\tab\i          \b\i0  \b0 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Consecrate me now to Thy service, Lord,
\par \pard\li720 By the power of grace divine ;
\par Let my soul look up with a steadfast hope,
\par And my will be lost in Thine.
\par \pard\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par \b                        Draw me nearer, nearer, blessed Lord,
\par \tab            To the Cross where Thou hast died :
\par \tab            Draw me nearer, nearer, nearer,
\par \tab            Blessed Lord,
\par \tab            To Thy precious, bleeding side.
\par \b0 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab O the pure delight of a single hour 
\par \pard\li720 That before Thy throne I spend,
\par When I kneel in prayer, and with Thee, my God,
\par I commune as friend with friend.
\par \pard\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par \b                        Draw me nearer, nearer, blessed Lord,
\par \tab            To the Cross where Thou hast died :
\par \tab            Draw me nearer, nearer, nearer,
\par \tab            Blessed Lord,
\par \tab            To Thy precious, bleeding side.
\par \b0 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab There are depths of love that I cannot know
\par \pard\li720 Till I cross the narrow sea ;
\par There are heights of joy that I may not reach
\par Till I rest in peace with Thee.
\par \pard\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par \b                        Draw me nearer, nearer, blessed Lord,
\par \tab            To the Cross where Thou hast died :
\par \tab            Draw me nearer, nearer, nearer,
\par \tab            Blessed Lord,
\par \tab            To Thy precious, bleeding side.
\par \b0\f1 
\par \cf1\ul\b\f2\fs16 
\par }

