\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab When the weary, seeking rest,
\par \pard\li720 To Thy goodness flee;
\par When the heavy-laden cast
\par All their load on Thee;
\par When the troubled, seeking peace,
\par On Thy name shall call
\par When the sinner, seeking life,
\par At Thy feet shall fall:
\par 
\par Hear then in love, O lord, the cry,
\par In heaven, Thy dwelling- place on high.
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab When the child  with grave fresh lip,
\par \pard\fi360\li360 Youth, or maiden fair;
\par When the aged, weak and grey,
\par Seek Thy face in prayer;
\par When the widow weeps to Thee
\par Sad, and lone, and low;
\par When the orphan brings to Thee,
\par All his orphan woe:
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab When the worldling , sick at heart, 
\par \pard\fi360\li360 Lifts his soul above;
\par When the prodigal looks back
\par To his Father's love 
\par When the proud man from his pride
\par Stoops to seek Thy face;
\par When the burdened brings his guilt 
\par To Thy throne of grace:   
\par Amen.
\par 
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

