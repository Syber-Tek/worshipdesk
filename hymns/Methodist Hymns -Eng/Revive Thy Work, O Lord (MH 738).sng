\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab REVIVE Thy work, O Lord,
\par \pard\li720 Thy mighty arm make bare ;
\par Speak with the voice that wakes the dead,
\par And make Thy people hear.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Revive Thy work, O Lord,
\par \pard\li720 Create soul-thirst for Thee ,
\par And hungering for the Bread ofLife,
\par O may our spirits be.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Revive Thy work, O Lord,
\par \pard\li720 Exalt Thy precious name ;
\par And, by the Holy Ghost, our love
\par For Thee and Thine inflame.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Revive Thy work, O Lord ;
\par \pard\li720 Give power unto Thy word ;
\par Grant that Thy blessed Gospel may
\par In living faith be heard.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab Revive Thy work, O Lord,
\par \pard\li720 And give refreshing showers ;
\par The glory shall be all Thine own,
\par The blessing, Lord, be ours
\par \pard 
\par \f1 
\par \cf1\ul\b\f2\fs16 
\par }

