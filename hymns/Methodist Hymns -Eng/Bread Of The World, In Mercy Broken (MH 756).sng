\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. BREAD of the world, in mercy broken;
\par Wine of the soul, in mercy shed;
\par By whom the words of life were spoken,
\par And in whose death our sins are dead:
\par Look on the heart by sorrow broken,
\par Look on the tears by sinners shed,
\par And be Thy feast to us the token
\par That by Thy grace our souls are fed.\f1 
\par \cf1\ul\b\fs16 
\par }

