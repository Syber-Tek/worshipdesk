\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab JESUS, we look to Thee,
\par \pard\li720 Thy promised presence claim ;
\par Thou in the midst of us shalt be,
\par Assembled in Thy name.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Thy name salvation is,
\par \pard\li720 Which here we come to prove ;
\par Thy name is life and health and peace
\par And everlasting love.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab We meet, the grace to take 
\par \pard\li720 Which Thou hast freely given ;
\par We meet on earth for Thy dear sake,
\par That we may met in heaven.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Present we know Thou art,
\par \pard\li720 But O Thyself reveal !
\par Now, Lord, let every bounding heart
\par The mighty comfort feel.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab O may Thy quickening voice 
\par \pard\li720 The death of sin remove ;
\par And bid our inmost souls rejoice 
\par In hope of perfect love !
\par Amen 
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

