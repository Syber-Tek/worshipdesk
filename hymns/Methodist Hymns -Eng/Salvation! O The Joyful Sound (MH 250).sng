\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Salvation! O the joyful sound!
\par What music to our ears!
\par A sovereign balm for every wound,
\par A cordial for our fears.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par Glory, honour, praise and power,
\par Be unto the lamb for ever!\i0 
\par \i Jesus Christ is our Redeemer
\par Hallelujah!  Praise the Lord.
\par \i0 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Salvation! O Thou bleeding Lamb,
\par To Thee the praise belongs;
\par Salvation shall inspire our hearts,
\par And dwell upon our tongues.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par Glory, honour, praise and power,
\par Be unto the lamb for ever!\i0 
\par \i Jesus Christ is our Redeemer
\par Hallelujah!  Praise the Lord.
\par \i0 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Salvation!  Let the echo fly
\par The spacious earth around;
\par While all the armies of the sky
\par Conspire to raise the sound.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par Glory, honour, praise and power,
\par Be unto the lamb for ever!\i0 
\par \i Jesus Christ is our Redeemer
\par Hallelujah!  Praise the Lord.
\par \i0\f1 
\par \cf1\ul\b\f2 
\par }

