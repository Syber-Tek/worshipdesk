\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab LORD of our life, and God of our salvation,
\par \pard\li720 Star of our night, and hope of every nation,
\par Hear and receive Thy church's supplication,
\par Lord God Almighty.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab See round Thine ark the hungry billows curling;
\par \pard\li720 See how thy foes their banners are unfurling ;
\par Lord, while their darts envenomed they are hurling,
\par Thou canst preserve us.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Lord, Thou canst help when earthly armour faileth ;
\par \pard\li720 Lor, thou canst save when deadly sin assaileth ;
\par Lord, o'er Thy rick nor death nor hell prevaileth :
\par Grant us Thy peace, Lord.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Grant us Thy help till foes are backward driven ;
\par \pard\li720 Grant them Thy truth that they may be forgiven ;
\par Grant peace on earth, and, after we have striven,
\par Peace in Thy heaven.
\par Amen .
\par 
\par \pard 
\par \f1 
\par \cf1\ul\b\f2\fs16 
\par }

