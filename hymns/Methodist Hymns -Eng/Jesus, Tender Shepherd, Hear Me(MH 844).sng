\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Jesus, tender Shepherd, hear me;
\par Bless Thy little lamb to-night;
\par Through the darkness be Thou near me;
\par Keep me safe till morning light.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. All this day Thy hand has led me,
\par And I thank Thee for Thy care;
\par Thou hast clothed me, warmed and fed me;
\par Listen to my evening prayer.
\par 
\par \cf1\ul\b\'b6 Verse 3
\par \cf0\ulnone\b0 3. Let my sins be all forgiven;
\par Bless the friends I love so well;
\par Take me, when I die, to heaven,
\par Happy there with Thee to dwell.
\par Amen.\f1 
\par \cf1\ul\b\fs16 
\par }

