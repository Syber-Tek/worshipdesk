\viewkind4\uc1\pard\li360\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab Jesus, Sun of Righteousness,
\par \pard\fi360\li360 Brightest beam of love divine,
\par With the early morning rays
\par Do Thou on our darkness shine,
\par And dispel with purest light
\par All our night.\tab 
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab As on drooping herb and flower Falls the soft refreshing dew
\par \pard\fi360\li360 Let Thy Spirit's grace and power
\par All our weary souls renew;
\par Showers of blessing over all
\par Softly fall
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Like the sun's reviving ray,
\par \pard\fi360\li360 May thy love with tender glow
\par All our coldness melt away
\par Warm and cheer us forth to go,
\par Gladly serve Thee and obey 
\par All the day.
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab O our only Hope and Guide
\par \pard\fi360\li360 Never leave us nor forsake;
\par Keep us  ever at Thy side, 
\par Till the eternal morning break,
\par Moving to Zion's Hill,
\par Homeward still
\par 
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

