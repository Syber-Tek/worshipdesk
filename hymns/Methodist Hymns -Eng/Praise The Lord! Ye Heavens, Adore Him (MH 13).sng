\viewkind4\uc1\pard\cf1\lang2057\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Praise the Lord ! ye heavens, adore Him;
\par Praise Him, angels in the height ;
\par Sun and moon, rejoice before Him;
\par Praise Him, all ye stars and light.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par Praise the Lord, for He hath spoken;
\par Worlds His mighty voice obeyed;
\par Laws, that never shall be broken,
\par For their guidance He hath made.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Praise the Lord, for He is glorious;
\par Never shall His promise fail;
\par God hath made His saints victorious;
\par Sin and death shall not prevail.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Praise the God of our salvation ;
\par Hosts on high His power proclaim;
\par Heaven and earth, and all creation,
\par Laud and magnify His name.   Amen.
\par \lang1033\f1 
\par \cf1\lang2057\ul\b\f2\fs16 
\par }

