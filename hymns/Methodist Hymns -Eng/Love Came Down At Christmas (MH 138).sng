\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Love came down at Christmas,
\par Love all lovely, Love Divine;
\par Love was born at Christmas,
\par Star and angels gave the sign.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Worship we the Godhead,
\par Love Incarnate, Love Divine;
\par Worship we our Jesus;
\par But wherewith for sacred sign
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Love shall be our token,
\par Love be yours and love be mine,
\par Love to God and all men,
\par Love for plea and gift and sign.
\par \f1 
\par \cf1\ul\b\f2 
\par }

