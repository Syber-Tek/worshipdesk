\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab BRETHREN in Christ, and well beloved,
\par \pard\li720 To Jesus and His servants dear,
\par Enter, and show yourselves approved ;
\par Enter, and find that God is here.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Welcome from earth : 1o, the right hand
\par \pard\li720 Of fellowship to you we give ;
\par With open hearts and hands we stand,
\par And you in Jesu's name receive.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Jesus, Thyself in love reveal :
\par \pard\li720 Are we not met in Thy great name ?
\par Thee in the midst we wait to feel,
\par We wait to catch the spreading flame.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Thou God that answerest by,
\par \pard\li720 The Spirit of burning now impart ;
\par And let the flames of pure desire
\par Rise from the altar of our heart.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab Truly our fellowship below
\par \pard\li720 With Thee and with the Father is :
\par In Thee eternal life we know,
\par And heaven's unutterable bliss.
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

