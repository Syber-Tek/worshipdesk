\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab FATHER of all, to Thee
\par \pard\li720 With loving hearts we pray,
\par Through Him, in mercy given,
\par The life, the truth, the way ;
\par From Heaven, Thy Throne, in mercy shed
\par Thy blessings on each bended head.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Father of all, to Thee
\par \pard\li720 Our contrite hearts we raise,
\par Unstrung by sin and pain,
\par Long voiceless in Thy praise ;
\par Breathe Thou the silent chords along
\par Until they tremble into song.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Father of all, to Thee
\par \pard\li720 We breathe unuttered fears,
\par Deep-hidden in our souls,
\par That have no voice but tears ;
\par Take Thou our hand, and through the wild
\par Lead gently on each trustful child.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Father of all, may we 
\par \pard\li720 In praise our tongues employ,
\par When gladness fills the soul
\par With deep and hallowed joy ;
\par In storm and calm give us to see
\par The path of peace which leads to Thee.
\par Amen. 
\par \pard 
\par \f1 
\par \cf1\ul\b\f2\fs16 
\par }

