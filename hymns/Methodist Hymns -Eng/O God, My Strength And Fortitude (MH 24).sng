{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset0 WL-Sims English;}{\f1\fnil\fcharset0 TwiNova2;}{\f2\froman\fprq2\fcharset0 Times New Roman;}}
