\viewkind4\uc1\pard\li360\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab Sweetly the Holy hymn
\par       Breaks on the morning air:
\par       Before the world with smoke is dim\tab\tab\tab\tab\tab\tab 
\par       We meet to offer prayer
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab While flowers are wet with dews
\par       Dews of our souls descend;
\par       Ere yet the sun the day renews,
\par       Oh Lord thy sprit send!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Upon the battle field
\par       Before the fight begins
\par       We seek O lord Thy sheltering shield
\par        To guard us from our sins 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Ere  yet our  vessel sails 
\par       Upon the stream of day,
\par \tab We plead, O  Lord,  for heavenly gales
\par \tab To speed us on our way
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab On the  lone mountain side,
\par \pard\li720 Before the morning's light,
\par The man of Sorrows wept and cried,
\par And rose refreshed  with might.
\par \pard\fi-360\li720\tx720 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.\tab O hear us, then, for we\tab\tab\tab\tab\tab\tab\tab 
\par \pard\li360     Are very weak and fail;
\par     We make the Savior's name our plea,
\par \pard           And surely must prevail.\f1 
\par \cf1\ul\b\f2\fs16 
\par }

