\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab THY kingdom come - on bended knee
\par \pard\li720 The passing ages pray ;
\par And faithful souls have yearned to see
\par On earth that kingdom's day.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab But the slow watches of the night
\par \pard\li720 Not less to God belong,
\par And for the everlasting right
\par The silent stars are strong.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab And lo, already on the hills
\par \pard\li720 The flags of dawn appear :
\par Gird up your loins, ye prophet souls,
\par Proclaim the day is near :
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab The day in whose clear-shining light
\par \pard\li720 All wrong shall stand revealed,
\par When justice shall be clothed with might,
\par And every hurt be healed :
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab When knowledge, hand in hand with peace
\par \pard\li720 Shall walk the earth abroad -
\par The day of perfect righteousness,
\par The promised day of God.
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

