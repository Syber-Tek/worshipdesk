\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab O CRIST, our God, who with Thine own hast been,
\par \pard\li720 Our spirits cleave to Thee, the Friend unseen.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Vouchsafe that all, who on Thy bounty feed
\par \pard\li720 May heed Thy love and prize Thy gifts indeed.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Make every heart that is Thy dwelling place
\par \pard\li720 A watered garden, filled with fruits of grace.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Each holy purpose help us to fulfil ;
\par \pard\li720 Increase our faith to feed upon Thee still.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab Illuminate our minds that we may see
\par \pard\li720 In all around us holy signs of Thee.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse  6\cf0\ulnone\b0 
\par 6.\tab And may such witness in our lives appear,
\par \pard\li720 That all may know Thou hast been with us here.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7.\tab So shalt Thou be for ever loving Lord,
\par \pard\li720 Our shield and our exceeding great reward.
\par 
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

