\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab HELP us to help each other, Lord,
\par \pard\li720 Each other's cross to bear,
\par Let each his friendly aid afford,
\par And feel his brother's care.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Help us to build each other up,
\par \pard\li720 Our little stock improve ;
\par Increase our faith, confirm our hope,
\par And perfect us in love.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab Up into Thee, our living Head,
\par \pard\li720 Let us in all things grow,
\par Till Thou hast made us free indeed,
\par And spotless here below.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab Then, when the mighty work is wrought,
\par \pard\li720 Receive Thy ready bride ;
\par Give us in heaven a happy lot
\par With all the sanctified.
\par Amen.
\par \pard\f1 
\par \cf1\ul\b\f2\fs16 
\par }

