\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab JESUS, with Thy Church abide ;
\par \pard\li720 Be her Saviour, Lord, and Guide,
\par While on earth her faith is tried :
\par \pard\fi-720\li1440 We beseech Thee, hear us.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Keep her life and doctrine pure ;
\par \pard\li720 Grant her patience to endure,
\par Trusting in Thy promise sure :
\par We beseech Thee, hear us.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab May her voice be ever clear,
\par \pard\li720 Warning of a judgement near,
\par Telling of a Saviour dear :
\par We beseech Thee, hear us.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab All her fettered powers release ;
\par \pard\li720 Bid all strife and envy cease ;
\par Grant the heavenly gift of peace :
\par We beseech Thee, hear us.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab May she guide the poor and blind,
\par \pard\li720 Seek the lost until she find,
\par And the broken-hearted bind :
\par We beseech Thee, hear us.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0  
\par 6.\tab May her lamp of truth be bright ;
\par \pard\li720 Bid her bear aloft its light
\par Through the realms of heathen night :
\par We beseech Thee, hear us.
\par \pard   
\par \cf1\ul\b   \'b6   Verse\cf0\ulnone\b0 
\par    7.May she holy triumph win,
\par     Overthrow the hosts of sin,
\par     Gather all the nations in:
\par     We beseech Thee, hear us.
\par     Amen.\f1 
\par \cf1\ul\b\f2\fs16 
\par }

