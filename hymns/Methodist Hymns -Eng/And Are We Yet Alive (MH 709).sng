\viewkind4\uc1\pard\fi-360\li720\tx720\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.\tab And are we yet alive,
\par \pard\li720 And see each other's face ?
\par Glory and praise to Jesus give
\par For His redeeming grace !
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.\tab Preserved by power divine
\par \pard\fi360\li360 To full salvation here,
\par \pard\li360\tab Again in Jesu's praise we join,
\par \tab And in His sight appear.
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.\tab What troubles have we seen,
\par \pard\li720 What conflicts have we passed,
\par Fightings without, and fears within,
\par Since we assembled last !
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.\tab But out of all the Lord
\par \pard\li720 Hath brought us by His love ;
\par And still He doth His help afford,
\par And hides our life above.
\par 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab Then let us make our boast
\par \pard\li720 Of His redeeming power,
\par Which saves us to the uttermost,
\par Till we can sin no more :
\par \pard 
\par \pard\fi-360\li720\tx720\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.\tab Let us take up the cross,
\par \pard\li720 Till we the crown obtain ;
\par And gladly reckon all things loss,
\par So we may Jesus gain.
\par \pard 
\par 
\par \f1 
\par \cf1\ul\b\f2\fs16 
\par }

