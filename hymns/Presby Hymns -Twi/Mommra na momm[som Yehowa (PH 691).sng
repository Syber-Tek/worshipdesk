\par 1. Mommra na momm[som Yehowa
\par mo a moy[ Onyankop]n mma;
\par mo nyinaa nni ahurusi.
\par Mommra, momm[kamfo Yehowa
\par Momfa nidi a [fata mma
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yehowa s[nea [s[.
\par Monsom Yehowa ahokekam
\par S[nea ne kronkrony[ te
\par Ne nne gyigye fa nsu ani so,
\par Otumfo Nyame nne bobom
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yehowa butuw nsu nyinaa so,
\par Yehowa nne gyigye dennen,
\par Yehowa nne no so k[se,
\par Yehowa nne no tutu nnua,
\par Yehowa tutu ky[neduru,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par mmep]w so ky[neduru no.
\par Hw[, ]ma wohuruhuru mpo,
\par wohuruw s[ anantwi mma,
\par na mmep]w ne abon nso huruw,
\par wohuruw te s[ mmoawa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yehowa nne paapae gyaframam',
\par Yehowa nne wosow sare so,
\par Yehowa wosow asase,
\par Yehowa nne ma mmoa b] hu,
\par na wuram nnua nhaban nso po
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par eyi kyer[ n'anuonyam.
\par Yehowa agua tim nsu ani;
\par Yehowa di hene daa daa.
\par Yehowa de tumi hy[ ne man,
\par Yehowa hyira ne man daa.\f1 
