\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade, wo dom ara nti, 
\par na fa me b]ne firi me. 
\par \{ka me nko a, merennya 
\par me b]ne no fafiri da. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{wom s[ wohwehw[ gyidi; 
\par \{no nso y[ w'aky[de bi; 
\par na ne titiriw ne wo dom; 
\par fafri fi w'ahum]b] mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na s[ woahy[ me b] no nti, 
\par na Yesu nso di ma me nti, 
\par minnye wo dom ho akyinnye; 
\par wutie nea meresr[. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ne saa nti mede me ho 
\par meto wo dom no nkutoo so. 
\par Wo d] no nko ne me nkwagye. 
\par Miyi w'ay[, meda w' ase.\f1 
\par \pard\lang2057\f2 
\par }

