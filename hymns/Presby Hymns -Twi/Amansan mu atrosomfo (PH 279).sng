\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Amansan mu atrosomfo
\par da so d]]so pii;
\par w]da b]nem som abosom,
\par na wontumi mfi
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w]n ak]mfo nnaadaasem mu
\par ne bonsam afrim;
\par w]te sum mu hu amane
\par w]n nna nyinaa mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na y[n Nyame hu w]n mm]b]
\par p[ s[ ogye w]n;
\par ]de n'as[m de ama y[n
\par s[ y[mfa mmr[ w]n;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ]nam n'asafo no so
\par k] so fr[ nk'r]fo, 
\par s[ wontie na wonnye 
\par ne nkwagye as[m no.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yesu Kristo ne Agyenkwa 
\par ma nnipa nyinaa, 
\par na [s[ s[ odi hene, 
\par ha ne mmaa nyinaa; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]n' ]soma kogye w]n 
\par w]n tamfo no nsam. 
\par W]n a w]p[, na wogye di, 
\par benya n'ahemman.\f1 
\par \pard\f2 
\par }

