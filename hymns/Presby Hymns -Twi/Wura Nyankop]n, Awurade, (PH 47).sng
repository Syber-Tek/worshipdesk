\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Wura Nyankop]n, Awurade, 
\par wo na y[n ani ntumi nhu wo, 
\par nanso wow] baabiara;
\par nnipa adwene nnu wo so;
\par woso k[se, na obi ns[ wo, 
\par woy[ ade nyinaa wura.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo din fata wo su, 
\par wonsakra ara da,
\par daa Nyankop]n!
\par Onipa nnim wo k[sey[;
\par nnipa nyansa ntumi nhu wo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Soro mununkum y[ w'agua, 
\par asase y[ wo nan ntiaso,
\par wo k[sey[, onipa nnim. 
\par Nea Serafim susuw no, 
\par ne y[n nnipa dwene nyinaa, 
\par w'aniwa hu ne nyinaa p[.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anadwo, adekyee.
\par sum [ne hann y[ pe
\par w] w'anim h].
\par Sum nni wo ho, wo ho hyer[n, 
\par wufura hann s[ wo ntama.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}hene ne Tumfo k[se 
\par wode tumi na [b]] w'ade,
\par nea yehu anaa yenhu.
\par Soro ne fam a wob]e no,
\par wukura mu na wohw[ so p[;
\par wudi hene w] wiase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W'atemmu y[ trenee 
\par na enam ne kwan so p[,
\par wonhw[ anim.
\par Wo ns[m te[, ne nyinaa ye;
\par y[n Nyame ye de kosi daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ayamye ne ahumm]b],
\par anuonyam [ne nokware 
\par y[ nnepa a ahy[ wo ma 
\par w'ayamye y[ k[se ampa
\par da biara da kyer[ y[n sa;
\par wo na wudi ma Adam mma.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nne[ma nkumaa no,
\par Wohw[ ne nyinaa p[,
\par Wura Nyame, wohw[ me mu 
\par wunim m'akwan;
\par ma memfa me ho memma wo.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na s[ woy[ m'Agya w]ha,
\par Na med] wo te s[ wo ba a,
\par Merenni wiase akyi.
\par S[ wopae wiase mma mu 
\par Na w'bufuw hyew mmep]w po a,
\par Dom hw[ wo mma na di ma w]n
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo ne y[n Patafo
\par Ne y[n Agyenkwa no.
\par Halleluya.
\par Ayeyi Wura, mehw[ wo 
