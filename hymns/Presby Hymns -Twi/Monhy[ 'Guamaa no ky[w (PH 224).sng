\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Monhy[ 'Guamaa no ky[w; 
\par ]s[ ahenky[w pii. 
\par Sor' ab]fo to dwom d[d[ 
\par ma no n'ahengua so
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me kra, to no dwom bi;
\par kae s[ owu maa y[n.
\par Yi n'ay[ se wo Henk[se 
\par mmeresanten nyinaa
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Monhy[ no ahenky[w; 
\par asomdwoe Wura no
\par ne tumi ma akodi
\par w] benkum ne nifa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par N'ahenni to rentwa, 
\par ne nkoa b[som no.
\par Na w]b[hyer[n w] no ho. 
\par te s[ Eden nhwiren. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Monhy[ no ahenky[w,
\par wadi damoa so, 
\par na was]re afi wu mu 
\par de agye nnipa nkwa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea wafi wum no, 
\par na y[to dwom ma no.
\par Y[nam ne wu so nya daa nkwa
\par ne nkwa amene wu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Monhy[ no ahenky[w,
\par ]y[ ]d] Hene.
\par N'apirakuru som y[n bo,
\par y[nam so hu ne d]
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yebeyi n' ay[ daa
\par s[ wawu ama y[n.
\par Y[b[kamfo ayi n' ay[
\par mmeresanten nyinaa.\f1 
