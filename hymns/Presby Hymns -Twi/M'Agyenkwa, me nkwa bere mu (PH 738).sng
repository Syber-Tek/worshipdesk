\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M'Agyenkwa, me nkwa bere mu
\par da baako atwa mu k].
\par Ma menkari me  ho menhw[
\par s[ m'akwan fata w'anim.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Da biara twa mu a,
\par [ma y[n wu da twiw b[n.
\par Adwuma a map]n nn[ yi,
\par w'asomdwoe na mede ap]n.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ampa wuhuu me nney[e pii,
\par [rens]  w'ani koraa.
\par Nneb]ne ahy[ me ma t];
\par afa m'abrab] nyinaa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nanso mafom wo kakra
\par w] me koma, m'adwene,
\par m'adwumay[ nyinaa 'ra mu,
\par kosi  s[ enni kabea.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nanso wo Domfo Nyamkop]n,
\par wo  Ba Kristo dom no nti,
\par hu me b]ney[fo mm]b].
\par Wo Ba no nti, fa ky[ me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Agya, wo nokaredi
\par ay[ hann anadwo yi.
\par Hy[ me den, na daakye bi no
\par m'ay[ s[nea wop[ no.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Tew me komam ne m'adwenem,
\par na  manaa b]ne nna bi.
\par Fa w'ayamye pa no hw[ me,
\par na w'ab]fo mm[w[n me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Dom y[n hann ne kanea,
\par na b[w[n y[n afi mu.
\par na  daakye me ne me fifo
\par wer[ anhow w] y[n haw mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Siw ab]nefo nneb]ne
\par se  w]n ksum nnwuma no kwan.
\par W]pam y[n ti so b]ne a,
\par siw w]n adwemm]ne kwan,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na [ny[ ade hunu.
\par Na s[ satan ne ne d]m 
\par hwehw[ ayi y[n hu bi a,
\par pam w]n fi wo mma ho koraa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Agya, w'ani remfi y[n so;
\par s[ owia t] po a,
\par wone Hw[fo a wonsakra.
\par Woy[ Oguanhw[fo pa,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par nea sum ne hann mu no,
\par ]da ne nguan kuw ho no.
\par \{no nti, w[n won guan kuw daa,
\par na  y[ada w] asomdwoe mu.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Na bere a [s[ du a,
\par ma  y[n ani ntetew yiye,
\par ba y[ntoto y[n akwan p[
\par w] aseda ne nyam mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na s[ owu b[to me
\par saa anadwo yi mu a,
\par mede  me ho nyinaa b[ma w'
\par ak] daakye anigye mu.\f1\fs22 
\par \pard\f2\fs24 
