\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Adekyee hann no atwam k],
\par na  owia hyer[n adum.
\par Onwin adwo, na sunsuma rek] n'anim.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n nkwa te s[  huhurow bi;
\par ne  tebea nky[ n' [yera.
\par O, Yesu, di y[n anim kan kodu fie.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma wo dom a [kanyan no
\par mma y[n koma so nk] soro.
\par Ma y[nhw[ wo tenabea soro man mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \{h] anigye, hann ne nkwa
\par rentwam da, na [so rentew.
\par \{h] ab]fopem to dwom, na wonnyae da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{h] na ahotefo w]
\par w]n ntade fitaa no pam sum.
\par \{h] na daapem hann Nyame di hene daa.\f1\fs22 
\par \pard\f2\fs24 
