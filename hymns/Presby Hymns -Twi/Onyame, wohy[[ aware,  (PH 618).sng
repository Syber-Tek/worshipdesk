\par 1. Onyame, wohy[[ aware, 
\par woy[ aware Agya; 
\par y[n Adam a odii kan no
\par asetena no anni mu,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ]hwehw[[ ne hokafo, 
\par ne honam ne ho dompe; 
\par na enti wob]] ]baa no 
\par de no k]bataa no ho.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}baa ne ]barima
\par na wob]e w'ahumm]b]m;
\par s[ w]ny[ ]honankoro,
\par w] wo d] kronkron no mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wohy[[ b] s[ wubehyira
\par nnipa a wogye wo di
\par na w]de w]n ho ma wo no.
\par Wone y[n soro Agya.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Awurade, wo b]hy[ no nti,
\par hyira nnipa baanu yi. 
\par W]n a w]hwehwe aware 
\par so nhyira w] w'anim, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na di w]n so hene, w]n fi 
\par ne w]n koma nyinaa mu; 
\par na di boa w]n daa nyinaa, 
\par ]haw ne anigye mu.\f1 
\par \pard\lang2057\f2 
