\par 1. \}man pa Yerusalem,
\par kronkronfo b[tena wo mu;
\par wobehu Awurade h]
\par de aseda ama no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yesu wu maa wiase,
\par na enti [s[ y[n s[
\par y[n nso yedi n'akyi daa
\par de kosi y[n wu da mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wiase ny[ y[n de bi
\par y[nam mu s[ ah]ho, 
\par yennim nea y[rek]; 
\par b]ne aduru y[n sum. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, y[ y[n kwan so hann 
\par ne y[n honhom aniwa; 
