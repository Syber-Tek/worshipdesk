\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu Kristo ne y[n wura 
\par ne y[n ade nyinaa 'ra, 
\par waba fam abegye y[n a 
\par y[da owu mu no nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n nti na ]dan onipa,
\par na ohuu y[n hia bi, 
\par na ]y[[ ne ho oguammaa 
\par soaa wiase b]ne.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[n nneb]ne kaw no nti na 
\par yaw k]kaa no s[ b'ribi, 
\par wayi y[n mmusu ama y[n, 
\par wagye y[n owu mu bi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ohuu fam ha yaw no nti na 
\par yenya soro anika, 
\par na ne mpatawu no nti na 
\par yebenya y[n kra nkwagye \f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

