\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu te afrum so reba,
\par mommom se: 'Hosiana, mo!' 
\par Ogyefo no de odwo nam.
\par \}nam ber[w ne ntama so
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yesu te afrum so reba, 
\par ]soro ab]fo kuw no
\par de w]n kommy[ rehw[ no s[ 
\par ]rek]hy[n amane mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yesu te af rum so reba, 
\par n'anuonyam w] ne wu mu. 
\par O, Kristo, y[n Nkonimdifo, 
\par b]ne ne wu rentumi wo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu te afrum so reba, 
\par ne ko dennen bere adu.
\par N'Agya te n'ahcngua so tw[n 
\par s[ ]de nkonimdi b[ba. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Yesu te afrum so reba, 
\par ]br[ ne ho ase k] wum; 
\par \}b[pene afa yaw mu 
\par de tumi akodi hene.\f1 
