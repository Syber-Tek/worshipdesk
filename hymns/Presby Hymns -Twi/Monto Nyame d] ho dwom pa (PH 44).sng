\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Monto Nyame d] ho dwom pa;
\par Nyame d] no rensa da.
\par Nea wanya 'hu ne d] no, 
\par nim s[ ]se dwonto pa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ Onyame bo refuw a 
\par anka ]pra y[n gu gyam;
\par na oyi ne d] adi a,
\par y[hy[ no anuonyam.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nyame d] no nam ne Ba so 
\par yi ne ho adi pefee.
\par Kristo d] no tra ohu so 
\par na yennya no ahuye,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par gye s[ ]nam ne Honhom so 
\par hy[ y[n mu nipa no den, .
\par na yegye ne d] mu ntini 
\par ma y[n gyidi ase tim.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame d] no mu tr[w s[;
\par [ka amansan po hy[m; 
\par na Onyame d] no ware;
\par [ky[ ma y[n, [rentwa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par emu d]; fi ]soro
\par sian ba y[n amanem p[[;
\par [kor]n nso s[; [de y[n 
\par fro k] Nyankop]n fie.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Saa ]d] yi tra m'adwene 
\par nanso me koma gye di.
\par Y esu d] me; satan tan me 
\par na osum me afiri.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu, .ma wo d] no nyi me,
\par ma mmnya wo ad]ye!
\par \{nde na m[to wo dwom pa, 
\par na me d] aye wo f[!\f1\fs22 
