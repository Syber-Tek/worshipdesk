\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. So memfa me nsapan yi 
\par minkohyia me Dimafo? 
\par \}som pa ne nkonimdi 
\par b[n na memfa menk] n'anim? 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par So menk] no nsapan so 
\par minkohyia me Gyefo a, 
\par meremfa ]kra baako 
\par po menk] me Gyefo anim? 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Merenhinhim wu mu mpo, 
\par m'Agyenkwa no begye me daa; 
\par nanso s[ mede nsapan 
\par hyia no a, m'ani wu pii. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par So menk] no nsapan so 
\par minkohyia me Gyefo a, 
\par meremfa ]kra baako 
\par po menk] me Gyefo anim? 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yiw, mas[e me nna nyinaa
\par w] b]ne ne anihaw mu.
\par Afei de, nea aka yi,
\par mede meky[ me Yesu daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par So menk] no nsapan so 
\par minkohyia me Gyefo a, 
\par meremfa ]kra baako 
\par po menk] me Gyefo anim? 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Kristo manfo, monkanyan
\par mo ho mm[y[ n'ap[de daa.
\par Momm] mu mm]den ara
\par ansa na owu sum aba.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par So menk] no nsapan so 
\par minkohyia me Gyefo a, 
\par meremfa ]kra baako 
\par po menk] me Gyefo anim? \f1 
\par \pard\lang2057\f2 
