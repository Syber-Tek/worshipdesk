\par 1. Y[n Wura Yesu anim, obi nni h],
\par Y[n Wura Yesu akyi, obi nni h],
\par ne din ye nwonwa s[,
\par nne tumi nso so s[.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
