\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Afe baako atwam bio,
\par afe foforo adu!
\par Me nney[e ne m'adwene
\par ne  me kasa se me d[n?
\par \{mma m'ani gye anaa?
\par Minsuro atemmuda?
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ampa mas[e nna b]nem;
\par mayi Nyame abufuw.
\par Daa ]fr[ me, na mintie,
\par nanso odi m'akyi daa.
\par Nna, asram ne mfe retwam,
\par na w]nne me b]ney[.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Midwen me b]ne ho a,
\par anka [s[ s[ mede
\par aniwa  ba n'anim h],
\par na misuro n'abufuw;
\par nanso Nyame dom k[se
\par ama me wer[ akyekye.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}ma wotwaa ne Ba no
\par twetia de kae y[n s[
\par ]y[ nn[ mma ne kanfo
\par Agyenkwa ne patafo
\par n' ]y[ Ogyefo no nti,
\par obeyi  y[n b]ne h].
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nyame b]hy[ no abam
\par w] ne Ba k[se no ho;
\par ommu mo kan nneb]ne,
\par na ]kae n'humm]b].
\par Nne[ma dedaw atwam,
\par bere  foforo adu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Nyankop]n nam Yesu so
\par de kyer[ s[ 'gye aba.
\par Sor' ahot] ne daa nkwa,
\par Yesu nky[n na yebenya.
\par W]n a wogye Yesu di,
\par enhia s[ wosuro.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Me nneb]ne ho mpata
\par ne  m'amane  awiei,
\par me trenee, m'asomdwoe de,
\par nn[ da yin e daakye ns[m,
\par me kra hann ne anigye,
\par [w] Yesu din no mu.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Yesu din nom me wer[
\par Akyekye w] wu mu mpo
\par Yesu din mu na mafa
\par satan ne n'asafo so.
\par Me kra [ne me honam
\par benya  nkwa Yesu din mu.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. N'ahenni b[k] so daa
\par w] ne din kronkron no mu.
\par W]n a w]w] din soro
\par [ne  w]n a w]w] fam
\par b[kotow saa din no bi,
\par na w]ahy[ no anu'nyam.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. Ma memfa wo din no so
\par minni  w'akyi daa nyinaa!
\par Mete ase oo, s[ miwu oo,
\par ma wo din nhyer[n me mu!
\par S[ midu wo soro a,
\par ma menkamfo wo din daa.\f1\fs22 
\par \pard\f2\fs24 
