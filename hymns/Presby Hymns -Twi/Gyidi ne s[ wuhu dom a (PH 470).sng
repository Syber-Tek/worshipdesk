\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Gyidi ne s[ wuhu dom a 
\par Nyame dom nneb]n'y[fo, 
\par bu Yesu s[ w'Agy[nkw] a 
\par owui de gyee wo nso bi.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Gyidi ne s[ wugye dom a 
\par Yesu de yii wo mmusu, 
\par n'ohwiee ne mogya nso gui 
\par de pataa wo b]ne no.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Gyidi ne s[, gye w'Agyenkwa a, 
\par Nyame de no maa wo no; 
\par gye di s[ Onyame d] wo, 
\par ne d] mene n'abufuw.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Gyidi ne s[, gye as[m a
\par Yesu aka wo no di;
\par fa wo ho to n'ayamye so,
\par na ama wo ho afi.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Gyidi n' [ma Yesu mogya 
\par hohoro wo b]ne k]; 
\par gyidi ma wunya fafiri 
\par [ne tumi foforo.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Enti gye di, na sr[ gyidi 
\par Kosi s[ wubehu s[ 
\par Nyame apopa wo b]ne, 
\par na wagye wo s[ ne ba.\f1 
\par \pard\lang2057\f2 
\par }

