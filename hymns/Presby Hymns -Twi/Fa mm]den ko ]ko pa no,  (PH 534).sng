\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Fa mm]den ko ]ko pa no, 
\par Kristo n' ]y[ w'aho]den. 
\par Hy[ wo ho so w] nkwa yi mu, 
\par na woanya nkwa ahenky[w no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. K] w'anim tee Nyame dom mu, 
\par ma w'ani so hw[ no ara.
\par Wo nkwa da w'anim s[ ]kwan, 
\par na saa ]kwan no ne Kristo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Gyae ]haw ne ]br[ ho dwen,
\par tow ne nyinaa gu Kristo so. 
\par Fa wo ho to no so ara, 
\par na woahu ne dom ne ne d]. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ne nsa pam hu ne abawpa, 
\par na ]rensakra n'as[m da. 
\par \{nde gye no di na hu s[ 
\par Yesu no ne w'ade nyinaa.\f1 
\par \pard\lang2057\f2 
