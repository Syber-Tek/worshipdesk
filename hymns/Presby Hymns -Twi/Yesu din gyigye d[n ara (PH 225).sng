\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu din gyigye d[n ara 
\par w] gyidi asom! 
\par Edwudwo ne yaw biara, 
\par n'[pam ne hu nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{sa honhom a abubu,
\par etwa koma t] yam;
\par [y[ ]kra aduan pa
\par ne kwantuni home.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M[to m'aban w] Yesu so;
\par me ky[m, hintabea,
\par m'adekorabea no nen;
\par ]dom abu no so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. M'adamfo Yesu, me Nua
\par me S]fo, me Hene; 
\par m'Awurade ne Nkwa,m'Awiei, 
\par dom begye w'ayeyi.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na me d] mu taa y[ mm[r[, 
\par meny[ hwee po mma wo; 
\par nanso mehw[ s[ wote a,
\par m[kamfo w' m'Awurade.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. M'ahomewa yi mpo b[ka 
\par wo d] yi ho as[m; 
\par na ma wo din ho dwom pa no 
\par nhy[ me den owu mu.\f1 
\par \pard\f2 
