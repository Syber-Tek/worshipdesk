\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, m'ani gye wo din ho,
\par [y[ m'asom sankub].
\par W]mma w'ayeyi no nnyigye
\par fam ha ne ]soro h]. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo bo y[ me den koraa po,
\par wone m'adem adepa;
\par dwinne y[ agode hunu,
\par na sika y[ anhwea. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo din no ase ne Agyenkwa;
\par wugye me me b]neyem'
\par ne me sodim ne m'amanem' 
\par ne ]bonsamk'rom gyam.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma wo din no ny[ me nhyira, 
\par na enyi hua me komam; 
\par ma [ny[ m'akrum aduru, 
\par na [mma me ho nsan me.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Hy[ wo din anuonyam [!
\par me ara m[hy[ no bi;
\par m'as[m a edi akyiri
\par b[y[ wo din ayeyi.\f1 
\par \pard\lang2057\f2 
\par }

