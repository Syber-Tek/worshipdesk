\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Adam asehwe no mu no, 
\par nnipa nyinaa seee koraa.
\par B]ne b]re san y[n nyinaa,
\par na y[annya yaresafo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyankop]n n' obegyee y[n 
\par fii b]ne kondua, 
\par nea ]w] no de hy[[ y[n 
\par w] Nyame abufuw mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}w] nnadaa dii Hawa so 
\par maa b]ne firi yii no.
\par \}poo n'Agya Nyame as[m 
\par maa ne mma k]] b]ne mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par B]ne de owu br[[ nnipa, 
\par na Nyame de ne Ba mae.
\par \}dann nip a soaa b]ne, 
\par na obewu gyee nnipa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[nea Adam b]ne no 
\par as[e nnipa nyinaa no, 
\par saa'ra na Yesu nkwagye no,
\par apata ama y[n nen.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[nea y[ne yen nana 
\par b[y[[ daapem wu mma no, 
\par saa ara na Nyame Ba no 
\par de y[n b[y[[ Nyame mma.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Y[da so y[ atamfo no, 
\par ]de ne Ba b[k[[ y[n.
\par As[ndua ho na owui, 
\par na was[re ama y[n.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}k]] soro w] n'Agya nky[n;
\par [h] na odi hene.
\par S[ yetumi gye di saa a, 
\par yebedu ne nky[n h] bi.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. 
\par \}y[ y[n kwan, y[n hann, y[n pon,
\par ]ye nokware ne nkwa.
\par Nyankop]n Ba ne As[m no, 
\par n'ankasa n']de no mae 
\par \cf1\ul\b\'b6 
\par \cf0\ulnone\b0 s[ ]mm[pata wiase 
\par ne Agya Nyankop]n ntam.
\par Obegye obiara a 
\par obegye no adi no.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. W]adome 'nipa, na onni 
\par Onyame nkwa ne trenee, 
\par gye s[ ne Yesu mu gyidim' 
\par na obenya trenee no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea n'ani da nnipa so 
\par b[yera akosi daa, 
\par na satan kwan so gya n'onya;
\par [h] na obehu yaw.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Nea n'ani da Nyame so 
\par w] Yesu Kristo mu no, 
\par ]no na n'ani renwu da;
\par na ogyina botan so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ohu yaw nanso ]renwu;
\par gye Nyankop]n abasam.
\par \}no b[y[ me boafo,
\par ]ne gyidifo nyinaa. 
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. O Nyame, mede me koma 
\par memna wo s[ me ky[wpa. 
\par Mma w'as[m no mmfi me nsam da, 
\par na aniwu anto me 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w] me b]ne ho afobum' ho, w] me 
\par b]ne ho f] bu mu.
\par Na nea ogye wo di no,
\par ]renhu wu ara da, 
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Me nan ase kanea no, 
\par [no ne w'as[m ma me.
\par \}kyer[ me kwan k] nkwa mu 
\par w] nkwa ne owu sum mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ hann yi rekyer[ y[n kwan 
\par aba y[n Hene nky[n a, 
\par yebenya biribiara, 
\par \pard yebenya n'ahenni no\f1\fs22 
\par \lang2057\f2\fs24 
