\par 1. Gyidi na [y[ kwankyer[fo,
\par [no n' [ma anidaso.
\par W]nam so hu nea ahintaw,
\par na [da nokw]re adi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Gyidi mu na Onyame mma nam;
\par tetefo no de tuu w]n kw]n.
\par \{kyer[[ w]n ]soro h] kw]n 
\par ma woduu w]n daakye kurom.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[nam gyidi so na yehu s[ 
\par Nyame de n'as[m b]] ade.
\par Y[nyaa treneefo te s[ Habel, 
\par Set, Hanok, Noa, Abraham, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ne treneefo pii a w]ka ho, 
\par ne Isak, Israelfo nom. 
\par \{y[ gyidi na [hy[[ w]n den, 
\par na [ma w]y[[ treneefo. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Hw[ Mose, Gideon ne Dawid, 
\par Elia ne 'diyifo a 
\par w]y[[ gyidim d]mmarima no
\par w]y[[ nnwuma ak[se pii; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w]ko dii ahene so nkonim, 
\par wobuu at[n trenee kw]n so, 
\par wonyaa Onyankop]n b]hy[ no, 
\par na wiase anni w]n so. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \{wom s[ wokum w]n mu pii de, 
\par nanso [y[ ]honam fam. 
\par \{y[ w]n gyidi na w]nam so 
\par faa yaw, ]haw ne owu mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na w]n kra ne w]n honhom no de, 
\par [k]] Nyame nky[n anigyem
\par Wohuu eyi sen fam ha ade; 
\par gyidi na [ma w]y[[ saa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Bere a w]nam gyidi mu no, 
\par na wonhuu Mesia no [. 
\par Nanso ]no na w]hw[[ no kw]n 
\par kosii s[ ne ba bere dui. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, Yesu, wo na woaba afei, 
\par wo, Nyame Ba ne nipa Ba. 
\par Y[w] anigye w] wo ba mu; 
\par y[nya wo nhyira no bebree.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ma y[n nyinaa nnya ahofadi, 
\par na y[nnya b]ne fafiri; 
\par na ma wommu y[n bem w] wo mu,
\par na woama y[anya daa nkwa no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hy[ y[n ahofadi no mu den, 
\par na y[nnya w'anim anu'nyam. 
