\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ me Gyefo ka me ho a, 
\par [nde minsuro b'ribi da, 
\par na b'ribi nso ny[ me hu. 
\par N'as[m a [y[ me de s[, 
\par ne ne honhom aw'r[kyekye 
\par n'dwudwo honam ne kra.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}w] me mu, mew] no mu, 
\par na y[n baanu rentetew mu, 
\par y[n apam b[tena h] daa. 
\par Agya Nyame nam ne Ba so 
\par de ne nhyira ab[mee me, 
\par enti merenni hia
\par \cf1 
\par \ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wiase ne n'adefunu,
\par n'anigye [ne n'ak]nn] 
\par afono me kra dodo. 
\par Agyenkwa no nky[n na menya 
\par daa nkwa [ne asomdwoe pa; 
\par oye pii sen fam nnepa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na afei a mete h] yi, 
\par Yesu te ase w] me mu; 
\par na m'ase a mete yi, 
\par mete no Yesu gyidim, 
\par na miso m'Agyenkwa no mu 
\par de kosi s[ mehu no. \f1 
\par \pard\lang2057\f2 
