\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. "W]de nneb]n' afiri"; 
\par w]n a w]n wer' ahow no 
\par awer[kyekye ni. 
\par W]nam y[n Yesu din so
\par de firi, na Onyame 
\par b]hy[ abam w] Kristo mu. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. As[m yi y[ me d[ s[. 
\par Onyankop]n d] nnipa,
\par na ]d] me bi nso;.
\par me nso manya ne dom a
\par w]de ayi me b]ne;
\par migye fafiri no midi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nea mehwehw[ tif'riw
\par ne b]ne daa fafiri,
\par n'owu renyi me hu.
\par W]n a wowu w]n b]nem,
\par na wobewu w] da mu;
\par fafiri nni h]nom bio.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nna yi mu na Onyame
\par yi ne dom no kyer[ y[n, 
\par se yemfi b]ne hawm, 
\par na y[nhwehw[ n'ahot], 
\par na y[nnye Yesu din nni, 
\par na y[mfa so nnye y[n kra nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wura, s[ mete ha yi,
\par mma w'awer[kyekye no
\par mmfi me kra mu bi da,
\par na se mek]b] mpae a,
\par dom ma wo honhom nse me
\par s[ wod] me w] Kristo mu.
\par 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.
\par S[ me wuda redu a,
\par ma minnya bot]yam pa
\par s[ woadom me dedaw.
\par B]ne fafiri, gyidi
\par ne daa nkwa anidaso
\par na mede m[k] asomdwoem.\f1 
\par \pard\lang2057\f2 
\par }

