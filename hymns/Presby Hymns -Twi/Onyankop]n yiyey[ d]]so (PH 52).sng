\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n yiyey[ d]]so, 
\par onipa ben na ]renhu?
\par So wo koma anya ap'rim n
\par na worenna no so ase?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par de, mibu ne d] s[ [so,
\par na miyi no ay[ w] ho.
\par Minim s[ ne wer[ remfi me
\par Me nso me wer[ remfi no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{hena na ]ma me me nkwa?
\par Nea onni ne ho mfaso!
\par \{hena na ]hw[ me nkwa so?
\par Nea mantie ne nne no?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hw[, wanya ne ho ase nt]e,
\par wantwe m'aso s[ [s[ me,
\par na mmom ]de me b]ne firi,
\par asana ma me koma foforo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. So meremmune d] k[se yi?
\par na merensom saa Wura no?
\par \}fr[ me daa; so merentie,
\par na meremfa ne kwan no so?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyame mm'ra w] me koma mu
\par n'as[m rehy[ mu den ma me.
\par \{ka s[: Menn] Nyame yiye,
\par [ne y]nko s[ me ho
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Onyame, w'ad]e ne wo papa
\par w] m'ani so yiye dabaa.
\par Ma wo d] no nhy[ me baninha, 
\par na me nnan wo mensom wo daa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{yaw mu, [nkyekye me wer[,
\par n'[nkyer[ me kwan nna pa mu;
\par na s[ me wuda redu nso a, 
\par fa wo d] no hyia me kwan.\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

