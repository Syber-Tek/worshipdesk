\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Sion man, mma wo wer[ nhow, 
\par w'Agyenkwa no d] no nsae [, 
\par ne wer[ nso mfi wo da.
\par S[ ]baatan gyaw ne yam ba a, 
\par Yesu de, ]nnan n'as[m da, 
\par [nky[ na wo gye aba
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]afa wo dommum na wusu, 
\par wo nkuro ay[ amanfo, 
\par w]adwiri w'as]refi, 
\par na wo nyamesom to atwa, 
\par nanso [ny[ s[ wo Nyame 
\par agyae ne man akyidi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}nokwafo no rensisi;
\par Yuda duforo befifi,
\par afef[ asow aba;
\par n'aba b[y[ aduan pa,
\par na n'abaa ay[ onwini
\par ama wiase aman.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wo dimafo ne Yehowa,
\par ]botan a [rentwiw da; 
\par n'anim y[ w'atamfo hu. 
\par S[ ]kasa a, w]b[tot] 
\par mum, na w]n ani awuwu, 
\par s[ wo Gyefo ka wo ho.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Fa w'ani to ne tumi so,
\par wob[hran ne dom no hran mu, 
\par ]b[tena wo nky[n dabaa. 
\par Na aman ne w]n ahene 
\par b[ba ab[hw[ wo hann bi,
\par ayi Nyame ay[ daa.\f1 
