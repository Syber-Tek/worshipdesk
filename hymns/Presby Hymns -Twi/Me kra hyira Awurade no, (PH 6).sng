\viewkind4\uc1\pard\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me kra hyira Awurade no,
\par s[ oyi n'ayamye kyer[, 
\par na m'ano ne koma nso 
\par da no n'ad]e no so ase,
\par ]de me mfomso firii me,
\par ]sa me nyarewa twem;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ogye me kra fi wu mu, 
\par ]twe me ba ne sr[m. 
\par ]de nnepa gu me so, 
\par ]ma me tumi y[ fofro, 
\par na mitu s[ ]k]re po, 
\par na miyi n'ay[ w] so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yehowa di asentrenee, 
\par na ]ma mm'ratofo di f];
\par oyi n'akwan kyer[ ne mma, 
\par na ]mma obi mmfa w]n so.
\par ]dom y[n hu y[n mm]b] pii, 
\par na ne bo nso mfuw y[n nt[m, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par n'ani rensa y[n daapem, 
\par ]mfa y[n nhy[ ne yam.
\par Na s[ ]soro ware
\par fi fam de rek] no ara, 
\par s[ n'ad]e so k[se ne no 
\par nnipa a wosuro no so.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ m'agya wer[ mfii me no, 
\par se nso me soro Agya no 
\par hw[ w]n a w]ye ne de bi 
\par na w]hwehw[ ne d] ne no.
\par Onim s[ yeye mm]bor];
\par na d]te ne tutuw ne y[n, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par onipa te s[ sare 
\par ne wuram nhwiren bi, 
\par se mframa b], n'[k] a, 
\par ne sibea nnim no bio:
\par onipa ba te s[ nhwiren, 
\par na n'anuoyam apo,
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yehowa na ne nko tim h]
\par w] daa nkwa ne daa ahot];
\par n'ad]e ne ne trenee no nso 
\par w] h] ma n'adeferefo.
\par ]de n'agua asi soro, 
\par na odi ne hene dabaa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ne sor' ab]fo som no 
\par som pa ne nidim daa.
\par Na me nso m[fra w]n mu, 
\par s[ n'asafo ba bi w] ha, 
\par na m[ma n'anu'nyam no so, 
\par mahyira no nne ne daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Anu'nyam nka soro Agya,
\par ]ba ne Honhom Kronkron daa.
\par Y[nam ne dom so nyin ]d]m 
\par ne ne b]hy[ nyinaa mu daa.
\par ]p[ s[ y[de y[n ho to
\par n'ahy[de ne n'ad]e so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]tew koma ne honhom 
\par a abubu mu fann;
\par enti momma yentweri 
\par y[n Nyame ]domfo yi daa, 
\par na y[n gyidi asow n'aba, 
\par na y[ato osoro nnwom.\f1 
\par \lang2057\f2 
