\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[  Awurade Yesu mma 
\par nam owu mu gyaw y[n a, 
\par y[nim s[ w]nyera. 
\par W]n Yesu na afr[ w]n, 
\par de w]n rekosie komm, 
\par na w]renyera w] ne nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]nam w]n asub] so 
\par de Yesu din afr[ w]n, 
\par ahy[ w]n agyirae. 
\par Wow] Nyame dom, 
\par na so yebu no b]ne, 
\par s[ w]afi wi yi ase nt[m?
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ obi d] wiase,
\par na Nyame dom b] no a, 
\par [nde ]yera nt[m, 
\par na owu beyi no hu. 
\par Nyame mma de, w]nte sa, 
\par efis[ wonim 
\par trenee kwan.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ y[n nna y[ tenten a, 
\par owu ne br[ haw y[n pii, 
\par na [mma y[n bo nt]. 
\par Na y[n mfe a esua no, 
\par de y[n k] ahosan mu, 
\par na owu rentumi ntwa so.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na s[ obi fi ase,
\par b] ne bra w] p[y[ mu, 
\par de gyidi nantew a,
\par obenya Yesu mpata, 
\par na wawu s[ abofra, 
\par b]ne bi ho f] nna no so.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Mmofra nketewa yi s[[ 
\par anya awo foforo, 
\par w] w]n asub] mu. 
\par Won ani da Nyame so, 
\par na w]n atamfo no 
\par b[hwehwe ase w]n anim.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Nea ]w] Yesu mu, 
\par te asase yi so de, 
\par nanso [ny[ ne fi. 
\par Nyame tumi no nkutoo
\par na ]nam so y[ n'ade, 
\par na tumi bi nni ne nko fam.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. W]n a w]n ani afi 
\par tumi de w]n abrab] 
\par ma nkumaa bi s[[ po.
\par Nanso Onyame mma de, 
\par w]w] ]dom ne nhyira, 
\par na owu ntumi nhaw w]n da.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Y[n ba, k] asomdwoe mu, 
\par wo wu yi rens[e wo kra; 
\par enti nantew yiye. 
\par K] Yesu nky[n k]da komm. 
\par K]fra ne nguan kuw no mu; 
\par [h] na wo nna rentwan da. \f1 
