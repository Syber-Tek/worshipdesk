\par 1. Hw[, Kristo akyidi nam gyidi mu;
\par [y[ ]sa a, ahopakyi w] mu.
\par \{y[ honhom p[, [ny[ honam p[,
\par efis[ honam ko tia honhom no.
\par S[ obi pa wiase ade a,
\par onya daa nkwa,
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[nam fam ha amane ne haw mu
\par ansa na yedi ]ko no mu nkonim.
\par S[ obi p[ wiase anigye
\par na odwen fam ha ade hunu ho a,
\par saa onipa no b[hwere ne kra, 
\par na wayera.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Hy[ wo ho den w] b]ne ko no mu; 
\par s[ wugyaa wo ho a, b]ne fa wo so,
\par enti fa mm]denb] ko k] w'anim
\par Hw[, wo Wura no adi nkonim 
\par na wanya ne nkonim ahenky[w no.
\par S]re na ko.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}ko no mu y[ den, [ny[ mmer[w,
\par enti fa gyidi ko na nya daa nkwa no
\par Eyi ne wo botae w] wo som mu,
\par nanso tumi no fi wo Nyame nkutoo;
\par ]no ara na ]b[hy[ wo den.
\par w] wo ko mu.\f1 
