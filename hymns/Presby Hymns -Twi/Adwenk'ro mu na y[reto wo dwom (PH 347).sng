\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Adwenk'ro mu na y[reto wo dwom. 
\par Y[as]re gyina h] ne wo di nkra
\par ansa na y[n som ak] n'awiei;
\par y[tw[n w'asomdwoes[m na y[ak]da.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n fiek] mu, ma y[n w'asomdwoe.
\par Y[de wo fii ase, de wo wie.
\par Gye y[n ne w]n a w]fr[ wo [ha\i 
\par \i0 fi fam amane ne mmusu mu daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma ahot] anadwo sum yi mu,
\par na dan y[n sum ma [ny[ y[n so hann.
\par Yi y[n fi haw ne amane nyinaam:\i 
\par \i0 wo nko na sum ne hann y[ pe w'anim. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma y[n w'asomdwoe y[n nkwa nna nyinaam. 
\par Kyekye y[n w'r[, gye y[n yen ]haw nyinaam, 
\par na s[ y[n fam ha ko yi to nya twa a, 
\par Owura, fr[ y[n k] daa asomdwoem.\f1 
\par \pard\lang2057\f2 
\par }

