\par 1. O, m'Agyenkwa Yesu Kristo, 
\par hw[ me s[ meda w'anim! 
\par Anigyina ne agyadwo 
\par na mede meba w'anim. 
\par Mehwehw[ wo, ma minhu wo, 
\par br[ w'ani ase hw[ me! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yesu, yi wo ho kyer[ me, 
\par y[ me s[ wo d] no te; 
\par wode mogya na [t]] me, 
\par de b[faa me y[[[ wo de. 
\par Mehwehw[ wo, ma minhu wo
\par ma wo dom no ny[ me f[!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. O, Agyenkwa, wo koma na
\par emu wie tew koraa;
\par me de, mehwe me komam a,
\par mihu b]ne wom ara.
\par Mehwehw[ wo, ma minhu wo,
\par na me mu atew ampa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ m'awer[howm mes]re
\par mefr[ wo a, boa me;
\par na s[ me kra hu amane 
\par na mepere a, begye me;
\par Mehwehw[ wo, ma minhu wo,
\par wo na me koma p[ wo.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wiase ha adehunu
\par ne ak]nn] ne nidi,
\par [ny[ no na me koma p[
