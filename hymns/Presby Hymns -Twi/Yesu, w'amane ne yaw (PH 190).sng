\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, ma minsusuw ho,
\par na ma minnu me ho, 
\par na many[ b]ne bio, 
\par na mamfa anhaw wo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par So me k]n b[d] b]ne 
