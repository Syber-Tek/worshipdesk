\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \{d[n na Yesu y[ maa me? 
\par Ofii soro Kanaan 
\par behuu amane na owui 
\par s[ minya Kanaan h] kwan. 
\par Ahenky[ po da h] ma y[n, 
\par ma w]n a w]te n'as[m; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par n'anu'nyam abotiri nso 
\par n']de b[ma ne nnamfo. 
\par Kanaan, hann Kanaan! 
\par Hena n' ]p[ h] kwan ak]? 
\par Kanaan y[ anigye k'row, 
\par enti mep[ h] kwan mak]. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mab] me t'rim, misim mak], 
\par na da bi madu Sion, 
\par na mafra h] ahotefom',
\par mato m'Agyenkwa dwom bi
\par Minya mifi wiase hawm'
\par na midu Sion k'rom a,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par me bo b[t] me yam k[se,
\par na yaw bi remma h] da.
\par Sion, hann Sion!
\par Hena n' ]p[ h] kw]n ak]?
\par Sion y[ anigye k'row,
\par enti mep[ h] kw]n mak].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{hena na ]p[ anya
\par ne daa nkwa w] ]soro?
\par Ma onni n'Agy[nkw] akyi,
\par ]de no bedu h]nom.'
\par \{h] na y[b[hw[ Yesu
\par s[ odi soro hene
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ohyira ne gyidifo,
\par ma w]n nkwa ne w]n home.
\par Yesu pa, Yesu!
\par Hena na ]hwehw[ Yesu?
\par Yesu y[ Agyenkwa pa,
\par enti momma y[nn] Yesu!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ ]deb]ney[fo, bi
\par P[ ne nkwagye w] h] a,
\par ]no na Yesu fr[ no s[
\par daa nkwa da h] ma no nso
\par Obiara a ogye no di 
\par n'ade ne ho ama no, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ]p[ daa ahomeka, 
\par y[n Agyenkwa de ma no. 
\par Yesu pa, Yesu! 
\par Hena na ]hwehw[ Yesu? 
\par Yesu y[ Agyenkwa pa, 
\par enti momma y[nn] Yesu!\f1 
\par \pard\lang2057\f2 
\par }

