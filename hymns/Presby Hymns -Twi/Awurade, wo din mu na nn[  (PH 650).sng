\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade, wo din mu na nn[ 
\par m[k] makodi me dwuma; 
\par nea masusuw s[ m[y[, 
\par ma [ny[ nea wopene.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma memfa anigye minni 
\par dwuma a woahy[ ama me; 
\par ma minhu wo w] m'adwumam, 
\par na wo pe ay[ me botae.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wubegyina me nifa so,
\par na woahw[ me honhom mu fee; 
\par ma wo honhom nkyer[ me kw]n, 
\par na m'adwuma as] w'ani.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma minsua wo kw]n pa no, 
\par na memfa mpaeb] ne ]w[n; 
\par ma memp[ nea nkwa wom no, 
\par na matumi mahu w'anim.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Mede me dom aky[de no 
\par b[som wo w] ahosan mu;
\par medi w'akyi w] anigyem 
\par akodu s[ medu wo nky[n.\f1 
\par \pard\lang2057\f2 
\par }

