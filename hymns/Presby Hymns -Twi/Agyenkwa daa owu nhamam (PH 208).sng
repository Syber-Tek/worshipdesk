\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Agyenkwa daa owu nhamam, 
\par owu sii y[n ananmu; 
\par wanya as]re afi dam, 
\par n']de daa nkwa abr[ y[n. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Eyi nti na y[n ani gye, 
\par na yeyi Nyankop]n ay[ 
\par to dwom se: Halleluya! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nnipa de, w]rentumi nni 
\par owu so nkonim ara; 
\par na w]n nyinaa y[ b]ne pii, 
\par na w]n trenee no asa; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par enti owu no ba y[n so, 
\par fa y[n nnommum, n' [hy[ y[n so
\par w] wiase yi mu daa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame Ba, Agyenkwa no,
\par ]ba behuu y[n mm]b]; 
\par ]de ne wu beyii mmusu, 
\par na was[e wu tumi no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{wom s[ 'wu da so w] h], 
\par na ne nwow]e nni h] bio; 
\par nti y[n ho at] y[n. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Owu ne nkwa ]ko no ne 
\par ]ko a [y[ nwonwa; 
\par nkwa no na ebedi nkonim, 
\par na amene owu no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anyames[m no se y[n s[
\par owu k'ro no as[e wupem, 
\par enti yemmu wu bio. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Y[n Gyefo a w]de no b]] 
\par af]re w] dua ho 
\par ne twam Guammaa no, ne nky[n na
\par yebenya asomdwoe pa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ne mogya sra y[n pon akyi, 
\par y[n gyidi de kyer[ owu, 
\par n']tamfo no amm[n y[n. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Na enti y[de anigye 
\par ne f[w hy[ saa fa pa yi 
\par y[n Wura no ne y[n Wia,a: 
\par [hran w] y[n komam' bi;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]de ne dom ne n'as[mpa 
\par twa y[n b]ne sum to koraa 
\par ma y[fra n'ahot]fom. 
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Yedidi, na y[te ase; 
\par wohyia y[n ne pon ho, 
\par enti yenyi mm]kaw no ngu, 
\par na amfra n'as[mpa mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Kristo ne y[n twam Guammaa no, 
\par ]no na ]maa y[n kra mee. 
\par Anuonyam nka no daa!\f1 
\par \pard\f2 
