\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. W]nam y[n asub] kronkron so
\par de y[n hy[[ Yesu Kriso wum;
\par na y[antenna fam ha amma b]ne,
\par bonsam ne wiase bio.
\par saa asub] yi ma y[y[
\par ]soro Nyame adehye.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]de asub] asie y[n
\par aka y[n Agyenkwa no ho;
\par na s[nea Agya Onyame
\par de n'anu'nyam no maa no so,
\par n']s]re fii awufom no
\par y[n nso y[anya no mu daa nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Enti na [s[ y[n nyinaa s[,
\par y[de nkwa fof'ro b] y[n bra, 
\par na y[pa y[n honam ak]nn] 
\par ne b]ney[ nyinaa koraa. 
\par \{s[ y[n s[ y[tena ase bi 
\par s[n'a y[n Wura tenaa 'se no.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ y[ne no wu saa ma b]ne,
\par na yedi n'akyi daa nyinaa a, 
\par y[nam y[n asub] so b[fra 
\par ]soro ahotefom daa, 
\par na y[anya n'anim anigye 
\par [ne daa nkwa ne ahodwo \f1 
\par \pard\lang2057\f2 
\par }

