\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O Onyankop]n, w'as[m no
\par afifi sum mu aky[.
\par W]akyer[kyer[ wo mm'ra no
\par W] w'asafo nyinaa mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Gyidi ma y[n anidaso
\par W] w'as[m no tumi mu,
\par na Kristo mpatawu no ati,
\par w'asafo beso mu daa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wiase ade funu no
\par na nnipa mma dii akyi,
\par nanso antumi annye w]n;
\par w'as[m no nko n' egye nkwa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo mm'ra a wohy[ nnipa no,
\par na [s[ s[ wodi so.
\par \{no na daa nkwa as[m w] mu,
\par na [t[w nnipa ani.
\par \cf1\expndtw-2 
\par \ul\b\'b6 Verse 3\ulnone\b0 
\par 3. \cf0\expndtw0 Wogu Kyer[w Kronkron aba,
\par n'[ma ]som foforo.
\par W]n a w]y[ atorofo
\par dan as[mpa no ani;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par enti w]dan nyaatwomfo a
\par w]de nokwasem hintaw.
\par Nnipa as[m a w]ka no,
\par ama nnipa pii as[e.
\par \cf1\expndtw-2 
\par \expndtw0\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Awurade, y[da w' ase;
\par w'abue w'as[m no so,
\par na woayi y[n anifurae 
\par Y[ahu atoro kyer[,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na yeso w'as[mpa no mu,
\par efis[ [hy[ y[n den.
\par S[ y[de y[n ho to so a,
\par yenya b]ne fafiri.
\par \cf1 
\par \ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Onyankop]n as[mpa no
\par na y[de y[ y[n gyinae,
\par na wiase ab]de bi
\par rentumi ns[e gyinae yi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n Nyankop]n ye ma y[n s[[,
\par na saa ayamye yi nti,
\par yebeyi ne din ay[ daa
\par de akosi awiei.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. O, y[n Nyame, fr[ nnipa a
\par w]da so fom kwan pa no.
\par Siw w'atamfo no nyinaa kwan,
\par na ma w'as[mpa no ntr[w.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma [ntrew nkodu mmaa nyinaa,
\par na obi ansiw no kwan,
\par w[n w'as[m no, na b] ho ban,
\par na aye mma mma dea.\f1 
\par \pard\lang2057\f2 
