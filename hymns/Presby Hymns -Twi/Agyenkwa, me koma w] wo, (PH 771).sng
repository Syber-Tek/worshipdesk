\par 1. Agyenkwa, me koma w] wo,
\par bere  a [home yi;
\par me tumi nyinaa y[ wo de,
\par ma [nnan wo de koraa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me Yesu, fa me nn[ ara,
\par fa  me koma y[ wo de;
\par y[ me wo nokware somfo,
\par na fa wo d] hy[ me mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Soma me k] nea wop[,
\par nanso dom kyer[ me kwan;
\par ma wo dom no nka me ho daa,
\par na  meny[ setie p[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma minni nea wop[ so,
\par minni p[ foforo bi;
\par miwu o, mete ase o,
\par wo de ara na mey[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Mey[ wo de daa, Awurade,
\par yi  me fa ma wo som no;
\par wo nky[n ara na ma mentena,
