\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Gyidi bewie nkonimdi,
\par ne nnyinaso ne Nyame;
\par enti nea gyidi y[ no,
\par ahoni rentumi ny[
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ obi w] gyidi pa a,
\par otumi ade nyinaa.
\par Ohu asase so nnepa
\par s[ ahuhude bi kwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Bere a Yesu nnya mmae no,
\par na obi nnim ne nnwuma.
\par Gyidi na tetefo no nyae,
\par na w]de hw[[ ne ba kw]n
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Gyidi nti na tetefo no 
\par tumi y[[ anwonwade. 
\par W]nam gyidi so n' ehui s[ 
\par Ogyefo no aba fam. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nyame tumi mu na y[ko, 
\par y[n botae y[ nkonimdi. 
\par \{y[ y[n gyidi dennen s[ 
\par Y[b[pam satan koraa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n agyanom nam Kristo so 
\par nyaa gyidi koduu wu mu, 
\par na y[n nso de saa gyidi no 
\par b[foro ak]  soro.\f1 
\par \pard\lang2057\f2 
