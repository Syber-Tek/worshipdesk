\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Meyi w' ay[ daa nyinaa,
\par wo m' Agy[nkwa Nyame Ba;
\par efis[ wode w'ad]e
\par agye me afi owu mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me mfomso nyinaa, wode firii me,
\par m' Awurade, meyi w' ay[;
\par efis[ wode w'ad]e 
\par agye me afi owu mu. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mede me y]nko mfomso,
\par ne mfomso a way[ me 
\par mefiri, na wo, Nyame 
\par de me mfomso afiri me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me mfomso nyinaa, w]de firii me,
\par m'Awurade, meyi w' ay[; 
\par efis[ w]de w'ad]e 
\par agye me afi owu mu.\f1 
\par \pard\lang2057\f2 
\par }

