\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \}soro ne wiase, 
\par ewim, mframa ne po nso,
\par yi w]n Y[fo no ay[;
\par me kra, beyi n' ay[ bi.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Owia ne nsoromma, 
\par [ne sram de w]n hyer[n 
\par ka Onyame ho as[m 
\par na [hy[ no anu'nyam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wiase ahyehy[de, 
\par nnua ne afifide 
\par nnipa n.e mmoadoma, 
\par [y[ Nyame nnwuma bi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wim nnomaa nso di mu bi,
\par woyi n'anu'nyam adi; 
\par apranaa ne mframa no 
\par ka se: Monsom Yehowa!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{po ne nea [wom 
\par ne nsu a [sen k] mu 
\par Ka kyer[ y[n s[: Monhw[
\par nea Nyame tumi y[!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. O, me Nyankop]n k[se, 
\par wo ho ye me nwonwa s[!
\par Ma menhy[ wo anu'nyam
\par me komam ne m'abrab]m'.\f1\fs22 
\par \pard\lang2057\f2\fs24 
