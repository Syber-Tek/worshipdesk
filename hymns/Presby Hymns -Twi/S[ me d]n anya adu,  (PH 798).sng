\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ me d]n anya adu, 
\par na meretu mafi ha
\par mak] Onyame anim yi, 
\par [nde, Yesu, nnyaw me!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, Yesu Kristo, me wu mu 
\par mede me kra mehy[ w'ak'rum, 
\par wo nky[n na menya home.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me b]ne so, minnim ano, 
\par na papa bi nni me mu, 
\par na enti me wer[ ahow; 
\par misuro w'atemmu no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na s[ mekae wo wu no a, 
\par [no de, me kra nya nea 
\par [ma me wer[ kyekye.\cf1\ul\b 
\par \cf0\ulnone\b0 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mey[ wo ho akwaa no bi, 
\par enti na me ho t] me; 
\par owu, ahohia ne yaw 
\par rentumi ntetew y[n mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Miwu a, miwu meky[ wo, 
\par na wo na woafa wo wu so
\par de daa nkwa no abre me. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ woanyan afi wu mu nti, 
\par me nso renka ]da mu. 
\par Wo sorok] ma m'ani gye, 
\par na minsuro biribi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea wow] h] na m[ba, 
\par na mab[tena wo nky[n h] daa,
\par enti mek] ahodwom. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Minim s[ m[k] Yesu k'rom, 
\par na enti hwee renhaw me; 
\par na mek]da, na mada komm, 
\par obiara rennyan me, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par gye Yesu Kristo, Nyame Ba; 
\par ]no ahi[ pon dedaw
\par s[ memmra n'ahot] mu.\f1 
\par \pard\f2 
