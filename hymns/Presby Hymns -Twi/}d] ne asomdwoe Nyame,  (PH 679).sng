\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \}d] ne asomdwoe Nyame, 
\par ma wiase akodi nnyae. 
\par Siw b]nefo abufuw kw]n. 
\par O, Nyankop]n, ma asomdwoe.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Awurade, kae wo nnwuma no, 
\par W'anwonwade a kanfo hui. 
\par Yi w'ani fi y[n b]ne ho. 
\par O, Nyankop]n, ma asomdwoe.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo Awurade nko na y[nim 
\par wo nko mu na y[nya home,
\par na wunni obi huamm] da.
\par 0, Nyankop]n, ma asomdwoe.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Treneefo fi w] soro h],
\par w]n koma nyinaa y[ baako.
\par Ka y[n b] mu w] soro h].
\par O, Nyankopon, ma asomdwoe.\f1 
\par \pard\lang2057\f2 
\par }

