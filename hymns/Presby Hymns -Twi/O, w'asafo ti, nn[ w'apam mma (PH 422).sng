\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Gyidi ne ]d] ne anu'nyam, 
\par wo ara na wode ky[ y[n; 
\par y[dan wo w] y[n akw]n nyinaam, 
