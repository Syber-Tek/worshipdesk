\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[b[kae y[n asub] apam, 
\par na y[ay[ nokwafo w] mu.
\par O, ma y[nnyin nk] so wo dom mu, 
