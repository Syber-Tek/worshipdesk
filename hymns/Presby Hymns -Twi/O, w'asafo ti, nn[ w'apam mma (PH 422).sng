\par 1. O, w'asafo ti, nn[ w'apam mma 
\par reba wo nky[n. Hu w]n mm]b]; 
\par Fa anigye hw[ wo nguamma no. 
\par Oguanhw[fo, yeyi w' ay[. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. B]ne ay[ ma abu so, 
\par na y[ba s[nea y[te, 
\par s[ fa y[n nneb]ne firi y[n,
\par na gye y[n fi atemmu mu.
