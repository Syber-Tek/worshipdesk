\par 1. Kristo Asraafo pa,
\par monhy[ mo akode,
\par mo ho ny[ den Onyame mu,
\par w] ne Ba no dom mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Asafo Awurade 
\par n']w] tumi k[se.
\par Nea otweri Yesu no,
\par di nkonim boro so.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Gyina ne tumi mu,
\par Na ]b[hy[ wo den.
\par Fa Nyankop]n akotade
\par gye wo ho di d]m nsam.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Hy[ akodi fitaa,
\par y[ anem w] ho daa.
\par Kae s[ wo Sahene hw[ wo,
\par enti fa mpaeb] w[n.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Mia wo ho so daa,
\par k] so ka na b] mpae.
\par B]ne nnwuma de, nni akyi,
\par Na w'anim atew daa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[ wohw[ wo ho so
\par na ]haw no twam a,
