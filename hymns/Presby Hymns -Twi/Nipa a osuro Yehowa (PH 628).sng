\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nipa a osuro Yehowa
\par n' ]nam ne kw]n so nya nhyira;
\par ne nsam nnwuma no k] so ma no,
\par n' onya nea ehia no.
\par N'adifi ne ne fieba:
\par ne n'ade nyinaa y[ nhyira
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ne yere te s[ obobe a
\par etwitwa ne fi ho hyia.
\par Ne mma b[y[ s[ ngo dua bi,
\par na wotwa ne pon ho hyia.
\par Yehowa ma na ne agya
\par nya mma ne mmanananom pii.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Hw[, [fata s[ wobehyira
\par nea ]d] Yehowa no.
\par Sion, Yehowa befi h]nom'
\par ama nea wo koma p[
\par Yerusalem nnepa pii no'
\par Israel asomdwoe n' onya.\f1 
\par \pard\lang2057\f2 
\par }

