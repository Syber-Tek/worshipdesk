\viewkind4\uc1\pard\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Sorofo, monkamfo Nyame.
\par n'ab]fo, monkoto no;
\par owia, ]sram ne ns'romma, 
\par mo nso munyi n' ay[ bi;
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Awurade n' ]maa ne nne so;
\par n'ase[ n' eb]] wiase 
\par wama n'ahy[de atim h] 
\par de kyer[ aman no kwan.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Monkamfo Onu'nyamfo no,
\par ]remmu ne b]hy[ so; 
\par ]ma n'ahotefo di nim 
\par w] b]ne ne owu so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Monkamfo Nyame, mo Gyefo 
\par momma ne din so k[se
\par wim ne fam ab]de nyinaa 
\par mma ne din k[se no so!\f1 
\par \lang2057\f2 
\par }

