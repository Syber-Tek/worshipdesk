\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ me ho te yiye a, 
\par meda Nyame ase; 
\par mede m'ano ne
\par mereyi n ay[ ni.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anadwo ne awia,
\par aseda ne dwonto
\par s[ Onyankop]n ara;
\par ]hw[ y[n nkwa so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me nkwa ne m'akwahosan
\par y[ m'adek[se pa;
\par efi Nyankop]n nsam
\par y[ me f[ sen sika;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ahode biara
\par nn[n ]honamden da,
\par nanso nea [ky[n saa
\par ne ]soro daa nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ nkur]fo di me ni,
\par n' anka midi hene,
\par na me tumi so k[se,
\par na m'ahonya d]]so,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par nanso me ho ny[ me den,
\par meda yarepa so,
\par na [yaw ka me ara a,
\par so mew] mfaso bi?
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na Nyame adaw'roma
\par me ho y[ me den ni;
\par mihu sram ne nsoromma
\par ne owia haran yi
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M'aniwa hu ade p[, 
\par na m'aso te kasa;
\par m'aduan y[ m'anom d[,
\par m'ani kom me mpa so.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. M'Agya pa, meda w' ase 
\par s[ woadom me s[[ yi!
\par Ma minyi wo din ay[,
\par na mensom wo yiye!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par K] so hw[, me so ara!
\par Da bi wob[f'[re me,
\par na woama me wo daa nkwa
\par ne wo soro home.
\par \lang2057  \f1 
