\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Agya Onyankop]n, wo dan 
\par ne dan yi a y[ahyia wom, 
\par wo din mu na yeasi yi. 
\par Y[sr[ so s[ behyira so; 
\par hw[ so yiye ma ensi h] 
\par mma w'anu'nyam ne nidi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo na wote sorosoro, 
\par wote fam bi hw[ wo mma so.
\par W'ahumm]b] na y[kamfo. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n Wura Yesu, Nyame Ba, 
\par ma dan yi ny[ wo de daa; 
\par wo din no nti na y[asi. 
\par Mma wo nkwa as[mpa no ka 
\par mmpa as]redan yi mu da;
\par nya mu asomfo pa pii. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo na wufi Nyame soro 
\par anu'nyam mu begyee nnipa. 
\par Wo d] nti, yeyi w'ay[ daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame Honhom Kronkron no, 
\par ma wo hann pa mm[tew y[n mu
\par na y[nhu wo nokware! 
\par Fa w'ahotew ne wo tumi 
\par ma [ny[ w'asafom ade, 
\par ma [ny[ nnipa fofro. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fr[ y[n, twe y[n ma w'asafo 
\par [ne w]n hw[fo nnya daa nkwa, 
\par na y[akamfo w'anu'nyam daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Agya, \}ba ne Honhom pa! 
\par Anuonyam ne aseda
\par na y[n nyinaa de ma wo.
\par \}dan yi a yebue yi
\par w'ad]e k[se no na efi,
\par nanso y[san de ma wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Gye, na hw[ so! Behyira y[n, 
\par na begye y[n k] wo daa nkwa 
\par ne wo soro anu'nyam mu!\f1 
\par \pard\lang2057\f2 
\par }

