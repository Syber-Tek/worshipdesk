\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Wo, mm]b'r]hunu Awurade,
\par ]d] a enni awiei, 
\par me ne nneb]ney[fo nyinaa 
\par de ayeyi b[ma wo din 
\par Woy[ wiase mfiase 
\par wode nkwagye abr[ nnipa
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wiase nyinaa nkwagye no nti,
\par woabetua y[n b]ne ka, 
\par woab[fr[ nneb]ney[fo
\par ama w]ate w'as[mpa no.
\par W'as[mpa no mu tumi nti,
\par me koma da wo ase pii.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. W'awer[kyekye b] a woahy[
\par ne w'anuonyam w] h] daa.
\par Mmep]w woso na abo pae a,
\par w'apamhy[de y[ nokware.
\par Soro ne asase betwam 
\par Nyankop]n y[ nokwafo daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wo dom aky[de abo]den 
\par na wode s]w w'as[m ano. 
\par Wo a yetumi gye wo di no,
\par woma y[kae w'anwowade 
\par W] saa ]dom bere yi mu.
\par Eyi nti, y[da w' ase daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Koma ne ano beyi w'ay[, 
\par koma ne ano reba saa, 
\par na koma ne ana rempo wo.
\par Boa y[n na y[ay[ no saa 
\par w] nokware ne ]d] mu, 
\par na y[atumi ab[n wo daa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Na s[ satan mpo ne wiase 
\par ne n'ak]nn] gyigye me a,
\par [no de, fa wo ky[m no ma me,
\par na satan tumi ayera.
\par S[ s]hw[ bi gyigye me a, 
\par ma meny[ den wo tumi mu. 
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Ahumm]b] woy[[ nnipa,
\par ogye a wugyee nnipa,
\par ]fr[ a wofr[[ adasamma 
\par anigye a wiase nyae
\par ne ]dom ak[de pii no
\par n'ay[ y[n gyidi nnyinaso.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Me nso woadom ahyira me saa 
\par na manya me ky[fa w] mu.
\par Me a kan no meda b]ne mu,
\par na woba besii m'anan mu. 
\par W'as[m a [de nkwagye ba,
\par na ab[y[ me de koraa.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Na eyi na [ma mihu s[ 
\par Mab[y[ wo d]ba ampa,
\par na m anim aba nyam w] w'anim,
\par s[ me nti na wo Ba no bae.
\par Wuyii no maa b]ney[fo 
\par \pard te s[ me a meda b]nem.\f1\fs22 
