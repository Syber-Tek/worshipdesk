\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Yesu, ma menn] me y]nko nipa,
\par na mamfa atemmu bi anto no so
\par na mamfa ntwiri anhy[ no
\par anib're annidi n'ase.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma memfa ]d] nkata ne mmer[w
\par w] wiase ahohora anim;
\par s[ ]h we ase a, medi no nk]mm]
\par na mama no so.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma memm] ne yiyedi ho mm]den pa,
\par na ma minhu s[ ne kra som bo yiye;
\par na w]de wo fam as[ndua no ho  
\par w] ano nso nti
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ne ho ade pa no nso medi no ni,
\par wo ara ne nea ]de maa no no
\par ne saa nti, [ns[ s[ m'ani here no;
\par ma m'ani nnye mmom
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma me ahobr[ase pa koma no,
\par na memfa nidi memma obiara;  
\par na mannwen ade b]ne biara ho;
\par ma minni w'akyi.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \{no na m[tena wo ntamadan mu daa,
\par na wiase ne bonsam atwe ninkun';
\par wo de, wob] me ho ban,
\par meyi w'ay[ w] ha ne noh].\f1 
\par \pard\lang2057\f2 
\par }

