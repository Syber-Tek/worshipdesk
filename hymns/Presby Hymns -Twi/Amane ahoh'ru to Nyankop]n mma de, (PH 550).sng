\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Amane ahoh'ru to Nyankop]n mma de,
\par nanso w]n honhom mu nkwa no hyer[n daa.
\par Ade a ]soro h] Hene de ma w]n,
\par obiara nnim da, gye s[ w]n nkutoo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea obi nhui da, na nsa bi nkae da,
\par na w]de hyehy[ w]n honhom ne w]n kra no
\par na [ma wonya Nyankop]n anu'nyam no
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[nea w]te no, w]y[ Adam honam mma,
\par na wokura famfo suban no nso bi,
\par na wohu amane s[ nnipa nyinaa hu,\tab 
\par wodidi na w]nom s[nea ehia;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par honam asetena ho, s[ w]n nna ne nyan ho
\par wunhu s[ w]y[ ade bi a [sono,
\par gye s[ wokyi wiase anigye hunu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nso w]y[ Nyankop]n adehye honhom mu, 
\par ]no n' ]de n'as[mpa no awo w]n.
\par Onyame d] no na [d[w w]n koma mu,
\par nufusu a w]nom ne Yesu as[m.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}soro ab]fo y[ w]n nuanom a
\par w]bom to w]n ayeyi nnwom ma Nyame daa,
\par na dwonto no mu tew na [y[ w]n d[ s[
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Da bi w]n Nkwa, w]n Agyenkwa ne w]n Wura
\par beyi ne ho akyer[ wiasefo,
\par [no na ne nnamfo nso b[ba hann mu
\par na w]n ho ay[ amansan ahobow,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na w]anya w]n Yesu h] daapem ahot].
\par \{nna w]renkae w]n wiase br[ bio,
\par na w]n anigye b[y[ daapem anigye.\f1 
\par \pard\lang2057\f2 
\par }

