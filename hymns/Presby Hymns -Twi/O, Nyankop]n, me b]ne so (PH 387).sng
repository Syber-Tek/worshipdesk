\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Nyankop]n, me b]ne so, 
\par [d]]so, emu y[ d'ru! 
\par \{he po na ogyefo w]? 
\par \}boafo nni baabi.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ mise meguan mafi ha 
\par mak] asase ano, 
\par na mafi ha amanem a, 
\par [reny[ hwee mma me da.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo na misu mefr[ wo yi,
\par fa mm]b'r]hun' hw[ me! 
\par Na mfa me nk] atemmu mu! 
\par Wo Ba adi ama me.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ etwa s[ wohy[ me yaw
\par tua b]ne kaw a,
\par k] so hw[ me w] ha yiye,
\par na ky[e me so w] h] daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Awurade, ma mentaa me bo!
\par Ma m'aso ny[ mmer[!
\par Mma memmfa me nk]mm]di bi
\par mens[e me dom gye bere.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Nea eye w] w'ani so,
\par fa y[ me, na metie!
\par \}soro anika mu nko
\par na ma memm[tena h] bi.\f1 
\par \pard\lang2057\f2 
\par }

