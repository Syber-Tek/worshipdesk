\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n, ma [ny[ ye! 
\par S[ mifi m'adwuma ase, 
\par S[ misom, s[ miwie a, 
\par mehw[ wo Nyankop]n ara! 
\par Ma [ny[ ye!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ mey[ biribiara a, 
\par ehia me wo nhyira daa; 
\par enti mebr[ me ho ase 
\par mesr[ wo m'Agya'Nyame s[: 
\par Ma [ny[ ye!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{ny[ m'anem ne m'adwempa, 
\par me nsiy[ ne me nyansa pa, 
\par na [b[ma asi yiye; 
\par wo, Nyame, na mesr[ wo s[, 
\par Ma [ny[ ye!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wo, Nyame, nnim' a, mintumi 
\par memfa me tumi meny[ hwee; 
\par wo na woma nk]so nyinaa,
\par enti mehw[ wo daa nyinaa. 
\par Ma [ny[ ye!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wode w'ad]e y[ me yiye,
\par me nso meda wo ase
\par W'as[m no nti, megu m'as[m, 
\par miso m'adem mempa aba. 
\par Ma [ny[ ye!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Mede me ho ne m'adwuma
\par ne m'ade nso mehy[ wo nsa;
\par wunim nea eye ma me;
\par nea woma no, mapene.
\par Ma [ny[ ye!
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Amane bi b[to me a,
\par womma entu me bo koraa; 
\par woboa me, wowaw me wom, 
\par na wob[ma me yaw atwam. 
\par Ma ensi ye!
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Mede me ho meto wo so,
\par wo Agya d] b[hw[ me so;
\par wugye me fi m'ahohiam,
\par na worennyaw me w] d]m nsam.
\par Ma ensi ye!
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Hyira me nn[ fa kosi s[ 
\par menya mawie m'adey[! 
\par Boa me nn[ ne daa nyinaa, 
\par na s[ m'akwantu yi to twa a, 
\par Ma ensi ye.\f1 
\par \pard\lang2057\f2 
\par }

