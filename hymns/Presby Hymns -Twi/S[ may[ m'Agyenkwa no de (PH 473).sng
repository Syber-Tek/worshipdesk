\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ may[ m'Agyenkwa no de,
\par na Yesu nso y[ me de a,
\par [ny[ ade kumaa bi.
\par S[ Yesu ne m'adamfo pa, 
\par me hw[fo ne me gyefo a, 
\par mempe biribi nky[n no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Manya anika ne nhyira
\par ne ahodwo ne ahot] 
\par w] me Yesu ne ne d] mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[ wiase ak]nn]de
\par ne w]n a w]de honamp[
\par di adefunu akyi!
\par Wodidi, nso w]mmee da,
\par w]nom, nanso w]n mu yow ara,
\par na ne nyinaa y[ nsisi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ahuru, at'ro, ahohia,
\par daa amane ne komam haw
\par ne nea w]p[ na wonya.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{sono Yesu mma koraa!
\par W]n de, w]te s[ ne nguamma, 
\par w]w] n'adidibea. 
\par Wohu ne nky[n h] ade a 
\par [ma.w]n honhom mee ampa, 
\par w]n wura pa hw[ w]n so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W]n nneb]ne daa fafiri, 
\par w]n daa nkw] ne asomdwoe pa 
\par ne nea gyidifo benya.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Onipa, hw[, saa adepa
\par na Yesu Kristo, w'Agyenkwa
\par p[ s[ ]de ma wo nso.
\par Eyi nti ofii soro bae
\par behuu amane na owui
\par de yii wo mmusu maa wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ne d], ne dom, n'ahumm]b]
\par ne n'ayamye ne ne nhyira
\par b[ma w'ani agye daapem.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Yesu, wunim s[ mintumi 
\par memfa me tumi meny[ hwee,
\par enti b[hy[ me den daa.
\par Fa wo honhom pa no ma me,
\par na ade a [s] w'ani,
\par emfi m'aho]den mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fa me si wo kw]n pa no so, 
\par na mennantew mu nkosi s[ 
\par m[k] mak]tena wo nky[n h].
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Enti efi nn[ merenni
\par nneb]ne ne honam akyi
\par se kan a minnim Yesu.
\par Me wura a mehy[ no yaw daa,
\par nanso ]d] me pii ky[n saa,
\par ]no na wafa me so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wura, fa me, na mep[ s[
\par mey[ wo de nn[ ne daapem
\par na wo d] nti meda w'ase.\f1 
\par \cf1\ul\b\fs16 
\par }

