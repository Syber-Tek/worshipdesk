\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wi yi ase nnipa mma, 
\par emu ak[se ne nkumaa, 
\par s[ s[ woyi w' ay[ daa, 
\par na w]de wo nidi ma wo.
\par Na w'asafo kronkronfo 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Y[n nso y[fra wo mma mu, 
\par y[ntoto w'ayeyi ase;
\par na wukura y[n nyinaam';
\par wontoto yiey[ ase.
\par Wob]] y[n, wohw[ y[n so, 
\par wugye y[n fi wu mu nso.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Agya Nyankop]n, wo d] 
\par de wo Ba koro ama y[n, 
\par de no agye gyidifo, 
\par na woasi no y[n so hene.
\par Na wo, Honhom Kronkron nso
\par sakra y[n y[ kronkronfo.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Agya Nyame, hw[ y[n so!
\par Yesu Kristo, hu yen mm]b]!
\par Honhom Kronkron, tew y[n ho,
\par fa y[n fa ]soro kwan so!
\par Na s[ yedu h]nom a, 
