\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Kristo fifo fa w]n Kristo s[ nhw[so; 
\par ]de basa a [y[ den w[n w]n. 
\par S[ ahum tu, na asor]kye b] a, 
\par ]no na ]te w]n korow no mu. 
\par Amanehunu mu sum bere mu no, 
\par ]no nko na w]de w]n ho tweri no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ asase mm] aduan s[ [s[,
\par na s[   osu gyae t] ma ]k]m ba,
\par s[ owia hyew mfuw mu nn]bae
\par nyinaa, s[ asase so wo s[ ]bo a,
\par w]n asomdwoe ne ahot] to
\par rentwa; wonim w]n b]fo; ]renwu ara da.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Papay[ nko ne nea ehia wo;
\par [n' na ebedi w'akyi ak] wum.
\par Wo dadwen ase ne d[n? Soro wa wo.
\par D[n nti na wohaw wo ho, Nyame ba?
\par Ma wo koma nt] wo yam bere nyinaa; 
\par [no na wo soro Agya no hwehw[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Daapem anigye, ahot] ne ahosan,
\par daa nkwa ne ]soro nnepa nyinaa
\par b[ka wo nsa wo daapem asetena mu, 
\par na wo ne ab]fo ani begye.
\par \{h] na Nyame de anu'nyam b[ma
\par n'asafo a waboa w]n ano no.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Yesu tum'i a [y[ ade nyinaa
\par b[hy[ w]n a w]y[ mmer[w no den. 
\par Na s[nea w]hy[ no anu'nyam no, 
\par ]b[ma w]n koma at] w]n yam. 
\par Yesu, ma meny[ me soro Agya no de; 
\par ma m'ani nka s[ obedi m'as[m.\f1 
