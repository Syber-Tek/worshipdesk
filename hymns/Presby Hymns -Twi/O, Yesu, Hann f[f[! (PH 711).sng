\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Enti m'Awurade,
\par me kra ne me honhom ni,
\par gye na fa y[ wo de,
\par na fa wo d] no twe me
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na memmata wo ho.
\par Me honhon y[ wo de;
\par fa y[ nea [hy[
\par wo din anuonyam.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Dan me nipadua
\par na [ny[ w'as]refi.
\par W'ankasa ara bra,
\par na b[tena mu s[ wo fi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo nkwa n' ekura me,
\par wo d] aso me mu.
\par Eyi nti me new o
\par abom ay[ baako.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Me Yesu, fa ]d],
\par nney[e pa ne ahotew,
\par boaset] ne odwo
\par y[ nhw[so pa ma me daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
