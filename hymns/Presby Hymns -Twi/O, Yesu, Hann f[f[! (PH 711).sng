\par 1. O, Yesu, Hann f[f[!
\par Anadwo yi atwam k],
\par na w'anuonyam no
\par hyer[n y[ me foforo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Manyan afi nna mu,
\par manya nkwa foforo.
\par Mede anigyina
\par Rep[ wo nky[n aba.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{nde af]re b[n
\par na [s[ m'Awurade?
\par Mede me ho nyinaa 
\par rema  wo s[ m'aseda.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me honhom ne me kra
\par ne me nipadua,
\par ne  nyinaa y[ wo de;
