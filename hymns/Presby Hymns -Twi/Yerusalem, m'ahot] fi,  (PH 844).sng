\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yerusalem, m'ahot] fi, 
\par wo din ho y[ me na! 
\par Da b[n na me haw to betwa 
\par na mahu w'anika?
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Da b[n na m'aniwa behu 
\par wo fasu a [hran, 
\par w'apon a [y[ nhene, 
\par ne wo sika aban?
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Me Nyankop]n kuro f[f[, 
\par m[ba honom anaa? 
\par Nea wo mma ahyia h], 
\par na anigye rensa
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Adiyifo, asomafo 
\par gyina m'Agyenkwa ho, 
\par ne w]n a w]d] Kristo no 
\par behyia mu w] h]. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. W]som w]n Nyankop]n som pa, 
\par na wonya anu'nyam; 
\par yaw ne amane biara 
\par ne wu nni h] koraa. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Yerusalem, m'ahot] fi, 
\par me kra p[ wo dennen. 
\par Minya wo mu ahodwo a, 
\par na me haw asa nen.\f1 
