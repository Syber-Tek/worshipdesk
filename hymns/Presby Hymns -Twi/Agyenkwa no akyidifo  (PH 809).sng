\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Agyenkwa no akyidifo 
\par nam fam ha s[ ah]ho; 
\par w]fa ]haw ne wu mu nso,
\par w]n agyinae ne soro. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wowie kwan no tu, 
\par Yesu y[ w]n atuu;
\par w]n honam deda fam ansa 
\par te s[ w]adua mm'rofua. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo nso woatu wo kwan yiye, 
\par wo ay[hw[ w'atiko; 
\par wo honhom anya asomdwoe, 
\par woanya wo ho koraa po. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Woaba w'Agyenkwa h], 
\par na w'ani gye no ho; 
\par na w'ad]fo asiesie h] 
\par ma wo honam da nwini mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[n ani gye s[ daakye bi 
\par yebehyiam ]soro; 
\par y[n anuonyam b[da adi, 
\par y[b[y[ ]man koro, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu ne Henk[se 
\par na y[b[y[ ne de. 
\par Y[de Yesu honam s[so 
\par bedi asase fofro so.\f1 
