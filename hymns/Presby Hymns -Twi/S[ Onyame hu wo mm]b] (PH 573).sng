\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ Onyame hu wo mm]b]
\par twe wo p[ s[ wodan a,
\par b] mm]den na ma wo honhom
\par nkofi petee mu koraa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. B] mm]den hy[n pon teaa nom:
\par fa ]kwan hihiaa no so,
\par fi wo b]ne ne w'ak]nnom'
\par yi w'ani kyer[ soro.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Fa wo nkotosr[ ne sufre
\par k] w'Agyenkwa anim daa;
\par na ntoto wo mpaeb] ase
\par anadwo ne awia.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma wo d] mu nn] yiye p[,
\par na ]d] a edi kan
\par atwe wo koraa nokwarem
\par de wo aba Yesu fam.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na s[ wagye wo ampa a,
\par [ny[ s[ woawie da;
\par na wunnya nwiee koraa [!
\par Aka nne[ma bebree.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. So wo Gyefo nom pintinn pa,
\par hw[ wo ho so daa nyinaa;
\par na atamfo bi w] h] a
\par w]p[ s[ w]s[e wo daa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. So nea woanya nom' yiye,
\par na obi annye wo nsam;
\par di wo som no mu nokware,
\par b] wo ho so tu wo kwan. 
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. K] w'anim, na nsan w'akyi da, 
\par hy[ wo ho den na ko yiye;
\par guan bonsam ne nnipa nnaadaa 
\par na br[ wo honam ase. 
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Ny[ nea wo honam pene,
\par na mpene ak]nn] bi;
\par s[ wonhy[ so, na wugyaam a, 
\par [nky[ na wo ho y[ fi.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. Kyi wiase adefunu,
\par kyi ahantan, ahupoo;
\par hw[ yiye na da wo ho so,
\par nanso ny[ aniha da.
\par 
\par \cf1\ul\b\'b6 Verse 11\cf0\ulnone\b0 
\par 11. Wiasefo gu w]n b]nem,
\par [b[dan w]n afobu;
\par wo de, tew wo ho fi w]n mu,
\par na y[ nt[m guan gye wo ho.
\par 
\par \cf1\ul\b\'b6 Verse 12\cf0\ulnone\b0 
\par 12. B] wo bra Nyame suro mu,
\par di w'Agyenkwa akyi daa;
\par [nna da bi obegye wo
\par ak]tena ne nky[n koraa.\f1 
\par \pard\lang2057\f2 
