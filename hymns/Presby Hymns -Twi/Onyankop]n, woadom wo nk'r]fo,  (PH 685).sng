\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n, woadom wo nk'r]fo, 
\par na woaboa y[n manfo p[n;
\par woakata w]n amum]y[ so
\par de w]n mfomso nso aky[ w]n;
\par woadan afi wo abufum'
\par 'ma ]mannwoe aba y[n k'rom
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyankop]n, y[ y[n saa bio
\par Ma y[n ho nnwo, na dan y[n bra
\par Wo bo fuw y[n, nanso ma ennwo,
\par twa wo bo t] wo yam ara!
\par So wo wer[ b[how y[n daa,
\par na woatwe w'abufum' ara?
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. So worensan mma y[n home bi,
\par na y[n ani agye wo ho?
\par Awurade, ma y[nhu w'adwene,
\par na ma w'ad]e mmegu y[n so!
\par Ka asomdwoe kyer[ wo man,
\par na mma w]nnsan mmfom kw]n bio!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ampa, wo nkwagye no b[n w]n a,
\par w]de f[re ne suro pa
\par hwehw[ fafiri ne wo nhyira
\par w] wo Awurade Tumfo h]
\par na wob[ma dom foforo 
\par aba "b[tena y[n so bio.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}dom ne nokwas[m behyia,
\par trenee ne asomdwoe b[bom;
\par nokware befifi y[n k'rom ha,
\par trenee befi soro agum.
\par Wo, Nyame, wob[ma nnepa
\par ne asomdwoe ay[ y[n ma.\f1 
\par \pard\lang2057\f2 
