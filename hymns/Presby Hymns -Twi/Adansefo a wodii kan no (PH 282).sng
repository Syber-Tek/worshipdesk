\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Adansefo a wodii kan no,
\par Sion aw[mfo no mu honhom, nyan!
\par Na mma w'asafo nnyae w'as[nka,
\par ma w]mfa nnam nhyia atamfo d]m!
\par Na ma w]n fr[ nnu wiase nyinaa,
\par na ma amansan nyinaa mmra wo nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. B[s] wo gya nt[m w] nnipa mu,
\par ma yenhu s[ [d[w w] mmaa nyinaa;
\par na ma nnipa mma nhu ogye a
\par wode wo mogya agye w]n koraa.
\par Ab'rowbu Wura, w'adwuma so
\par na adwumay[fo no sua dodo!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma Kristofo bebree ns]re [,
\par ma w]mfa nnamy[ nka.
\par B[boa y[n, na fa wo tumi
\par b[s[e ]bonsam ahenni no nt[m!
\par Awurade, dom ma w'ahenni no ntr[w,
\par na enkodu asase ano h]!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma w'as[m mmra amanaman mu,
\par na ma w]n nyinaa nhu w'as[m no hann; 
\par na fr[ abosonsomfo pii no, 
\par na ma wonhu wo k'rom pon ano kwan!
\par Benyan wo man dedaw, Israel no
\par na w]mm[som wo s[ w]n Henk[se!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Aman no Temmufo ne Gyefo,
\par wob[k] so awie w'adwuma.
\par Wubeyi sum awer[how no,
\par ama adan wo hann m'awer[ba.
\par Enti yennyae wo gyidi mpae no b];
\par na wob[y[ y[n pii asen saa po.\f1 
