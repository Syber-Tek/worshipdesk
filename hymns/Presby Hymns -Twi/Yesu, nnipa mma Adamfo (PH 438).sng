\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, nnipa mma Adamfo 
\par ne nneb]ney[fo Gyefo, 
\par wuhuu dua ho amane
\par de tuaa m'aka no maa me 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mekamfo wo ahumm]b]; 
\par ampa, wodom mm]bor]fo
\par me ne nuanom bebree yi, 
\par mekotow wo meda w' ase.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wode wo nkwagye hyira me, 
\par na w'ahonya bu so ma me; 
\par me b]ne ho amane mu, 
\par wode do gye me nokwarem. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wode m'aka afiri me,
\par woagye me hu ne suro mu 
\par de wo daa nkwa ahoto no 
\par ahy[ me koma mu ,mat]. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[n Awurade, bra b[hw[ y[n, 
\par fa w'Adidi yi hyira y[n! 
\par Wo ara ne bobe dua,
\par woma wo abaa nya wo nkwa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Boa me na hy[ me den pa, 
\par na m'ak]nn] anni nim da! 
\par Wo nkutoo so na menam a, 
\par na m'ahotew b[sow n'aba. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Y[n apam no, y[afu[m' ni; 
\par y[n koma na gye y[ wo de! 
\par Yesu, woagyaw y[n nhw[so pa; 
\par yedi w'akyi, ma y[nk] so! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par B] koma fof'ro w] y[n mu, 
\par na y[nantew soro kw]n so; 
\par na y[n asetena ne wu mu 
\par y[n ani nnye w'anu'nyam ho!\f1 
\par \pard\lang2057\f2 
\par }

