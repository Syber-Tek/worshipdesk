\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu Kronkron, Onu''nyamfo
\par Nyame Guammaa a onni d[m,
\par woy[ kronkron, wukyi b]ne,
\par woy[  me kra Damfo pa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par woy[  mm'rante ne mmabaa a
\par w]n  komam tew no nsusuwso.
\par Mesr[ wo s[ mfi me nky[n,
\par fa  wo dom tena me komam.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mede yaw meka me b]ne
\par ne  me kra awer[how;
\par me koma mu fi y[ tan s[,
\par [ma  m'anim gu ase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par B]ne  pii agu me ho fi,
\par ak]nn] hy[ me koma so;
\par efi  me na yam po,
\par na mmusu yi da me so.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M'anu'nyam ho ahura s[,
\par wo  na wo ho wie tew;
\par wode  nea ayera no
\par b[ma  me w] wo mogyam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, me Gyefo, wunni d[m bi,
\par ma me ho nsan me w] wo mu.
\par Guammaa Kronkron, bra beyi
\par me  nneb]ne ne me fi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. M'ak]nn] y[ ad'ru b]ne
\par a as[e me mu nyinaa.
\par Me Kyeame, bedi ma me,
\par na ntua me b]ne ka!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[nea anka [s[ me;
\par mey[ ohianiwa!
\par Wuhwie wo mogya gui,
\par n' [maa m'ak'ru wuwui.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. W]n a w]n komam atew no
\par behu Nyankop]n anim;
\par w]n  a w]as[e w]n ahotew,
\par b[k]  ]bonsamk'rom hawm.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[nea m'awosu te no,
\par mintumi  menhy[ me ho so.
\par M'Agyenkwa b[ka me ho,
\par tew m'ak]nn]  hama no.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ma meny[ akode pa no,
\par na mahy[ m'ak]nn] so;
\par ma memfa nokware gyidi
\par mentew me komam koraa!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma wo Honhom pa no mm[tew
\par me honam, honhom ne kra ho;
\par na meny[ nipa fof'ro
\par me nna adi ahotew mu!
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Tu bonsam fi me koma mu,
\par na  wany[ h] fi bio;
\par yi ne nnaadaa ne nyaatwom
\par fi m'adwene mu koraa!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma wonhu w'anuonyam no
\par [ne w'ahotew w] me mu;
\par s[ ak]nn] haw me a,
\par [nde bra besiw ho kwan.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Ma memfa ]kra ne honam
\par ahotew  minyi me ho
\par mimfi fi sunsum asafo
\par ne abosonsomfo mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W]n a w]da w]n ak]nn]m',
\par na  w]s[e w]n kra ne honam.
\par Gyefo pa, begye me nkwa
\par w] saa b]ne yim' koraa.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Wop[ s[ wohy[ y[n honam
\par anuonyam, na ay[
\par Nyame tenabea kronkron a
\par ne  Honhom tem' daa nyinaa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W]n a w]s[e Nyame fi no,
\par ]b[s[e w]n nyinaa ara,
\par na ommu aguamamm]
\par s[ agoru hunu da.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. Yesu Kronkron, ma menn] wo,
\par na  ma menn] wo nkutoo!
\par Fa wo d] a wode  d] me
\par tew  me kra ne honam ho!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma me kwan na ma me mm[tenawo 
\par Yerusalem fof'ro mu,
\par na m'ani agye wo ho,
\par na mayi w'ay[ w] h]!\f1\fs22 
\par \pard\f2\fs24 
\par }

