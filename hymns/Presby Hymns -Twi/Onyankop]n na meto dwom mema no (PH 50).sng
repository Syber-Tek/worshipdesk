\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n na meto dwom mema no;
\par Otumfu] ne no ne m'Aw'rade;
\par mekamfo no ne ne nnwuma.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea ]p[ na ]y[ ma egyina;
\par ]b]] ade, na ]hw[ ne nyinaa so;
\par oyi n'ani a, na as[e.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ne ho tew p[, na b]ne bi mm[n no da;
\par ]ne panyin, ade nyinaa hy[ n'ase;
\par n'ahengua tim h] daa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}de ne ho; ahonya ne ahot]
\par  ahomeka ne d] ay[ no ma t],
\par na biribi nso nnen no da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nea [w] ]soro h] ne fam ha, 
\par onim no p[, na ne wer[ remfi da;
\par ade nyinaa w] n'ani so.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \}w] me ho, ]ma metena me baabi;
\par waka m' ahy[m w] m'akyi ne m'anim p[
\par ]de ne nsa ato me so.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. \}b[n me daa, hwehw[ me hu me mu, 
\par nim m'asetena, me s]re ne me nantew;
\par onim m'akwan nyinaam yie.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. S[ meforo  ]soro a, m[to no;
\par misian mek] asaman a, m[to no;
\par Onyankop]n w] mmaa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Onim me t'rim, na me nk]mm] bi nsiw no;
\par Mesr[ no a, ]dom tie, boa me, 
\par na n'ani ku me ho yie.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. B'ribiara a mew] no ny[ me de po;
\par Onyankop]n na me ne m'ade w] no;
\par ]no na medan no karaa.
\par 
\par \cf1\ul\b\'b6 Verse 11\cf0\ulnone\b0 
\par 11. Me Nyankop]n, wo din ho y[ me nwonwa,
\par na merennyae w'ayeyi no so ma da;
\par m[kamfo wo, m[som wo daa.
\par 
\par \cf1\ul\b\'b6 Verse 12\cf0\ulnone\b0 
\par 12. Na wo nnwuma y[ f[ nso, na eye s[;
\par owia, 'sram, ne nsoromma ne mframa 
\par reka wo, Nyame, tumide.
\par 
\par \cf1\ul\b\'b6 Verse 13\cf0\ulnone\b0 
\par 13. Ewim ne po ne mfuw, abon ne nkoko, 
\par ne mfutuma ne mmep] ak[se no 
\par reyi w'aho]den adi.
\par 
\par \cf1\ul\b\'b6 Verse 14\cf0\ulnone\b0 
\par 14. Mmoadoma, nnua ne nhabamma nso, 
\par ne ntentrehu ne ntahua nketewa po, 
\par kyere y[n s[ wo nyansa so.
\par 
\par \cf1\ul\b\'b6 Verse 15\cf0\ulnone\b0 
\par 15. Woma osu ma [f]w y[n mfuw so p[, 
\par wom a ]de, ab'row, b'r]de ne kwadu, 
\par [nam, nsa pa ne nsu ka ho.
\par 
\par \cf1\ul\b\'b6 Verse 16\cf0\ulnone\b0 
\par 16. Wow] mu a, na akasanomawa 
\par biako po renwu, na ]nt] fam da;
\par na me ti so nhwi mpo, woakan.
\par 
\par \cf1\ul\b\'b6 Verse 17\cf0\ulnone\b0 
\par 17. S[ [te saa a, merenhow me wer[ 
\par s[ ebia wo wer[ rebefi me;
\par na wohw[ me nkwa so yiye.
\par 
\par \cf1\ul\b\'b6 Verse 18\cf0\ulnone\b0 
\par 18. Wohw[ a, na w'adepa no remm] me;
\par wo ankasa ne ne nyinaam' k[se no, 
\par \pard enti wo nko ne m'adepa. \f1\fs22 
\par \lang2057\f2\fs24 
