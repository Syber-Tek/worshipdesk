\par 1. Nyame, wone me Nyame,
\par An]pa yi, meba wo nky[n.
\par Me honhom ani gyona w'
\par Na me kra rep[ wo dennen
\par s[ asase kesee so nsu.
\par Nyame, miguane metoa wo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nyame, hw[, mehweh[  wo
\par W] wo ahotew fi pa h].
\par Mede nidi b[ma wo,
\par na  mahy[ wo anuonyam.
\par W'ayamye d]]so d[n ara!
\par Mede aseda ma wo daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo na meyi way[ daa,
\par na wo din a [ho tew nti,
\par m[ma nsa ne koma so 
\par de akamfo ayi w' ay[.
\par Wo mu na meanya ahot],
\par m[kamfo w'anuonyam daa,
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wone me Guank]bea,
\par enti  dom di boa me daa.
\par Wo ho na m[bata daa;
\par wo nsa nifa beso me mu.
\par W]n a w]y[ w'atamfo de,
\par w]b[k] atemmu bon mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nyame mma ani begye;
\par W]n ani begye Nyame mu,
\par w]rensuro ade bi.
\par Onyankop]n ne w]n Hene.
\par N'atamfo no ho b[popo,
\par na  n'ad]fo bedi nkonim.\f1\fs22 
