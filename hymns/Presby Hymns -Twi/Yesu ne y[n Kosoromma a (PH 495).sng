\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu ne y[n Kosoromma a, 
\par dom ne nokware hy[ no ma, 
\par wapue hrann ama y[n. 
\par Oguanhw[fo pa, Dawid Ba, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}soro Hene, wode d]
\par atwe me aba wo sr[m. 
\par Wo ho y[ me f[, na woy[
\par onuonyamfo, soro Hene, 
\par w'anuonyam no y[ me nwonwa. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O, Nyame Ba, y[n ayeyi 
\par renso mma wo, na y[ntumi
\par nhy[ wo anuonyam yiye. 
\par \}soro Agya somaa wo; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w'as[mpa ne wo honhom pa 
\par y[ daa nkw] ma w'asafo. 
\par Meso wo mu daa nyinaa'ra 
\par merennyaw wo, Abodoo pa! 
\par Wubekum me k]m ama me. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame Hann ne soro Hran! 
\par Fa wo d] gya hy[ me komam, 
\par ma [ny[ hyew ]d] mu. 
\par Owura, bra b[hy[ me den,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na memm[fra wo ho akwaam, 
\par na mma mimmfi wo nky[n da! 
\par Papa Ti a [w] h] daa, 
\par me koma na [ho p're no 
\par rep[ n'ahodwo w] wo mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ wode w'ani kronkron 
\par b[hw[ me a, anigye hann 
\par fi wo mu b[ba me mu; 
\par me Wura pa, me Yesu pa, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w'as[m, wo honhom, wo mogya 
\par n' edwudwo me koma ho. 
\par Bra, b[fa w'ahumm]b] 
\par ne wo dom hw[ me hiani, 
\par na m'ani agye wo ho daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Agya Onyame, me Gyefo, 
\par wonam wo Ba no so d]] me 
\par ansa na wob]] wiase. 
\par Wo Ba no abata me ho. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na me koma gye no f[w so. 
\par Me wer[ renhow bio. 
\par Miyi w' ay[ s[ woama me
\par daa ahot] [ne daa nkwa;
\par enti anuonyam nka wo!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Munni Agya Onyame ni 
\par w] sankub] ne dwonto mu, 
\par na monkamfo ne din no! 
\par Mep[ s[ me ne m'Agyenkwa
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par fa soro kw]n so daa nyinaa, 
\par na mefa no adamfo 
\par de kosi s[ medu h]nom; 
\par nea ]w] na wasiesie
\par homebea pa ama me.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Me Wura, m'Agyenkwa, woy[ 
\par mfiase [ne awiei, 
\par yiw Alfa ne Omega. 
\par Na wode wo nkwa ama 'wu 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ama me a owu s[ me, 
\par na woagye me ]s[e mu. 
\par Amen, Amen! Me Wia, bra, 
\par bra nt[m [, na ma m'ani nnye 
\par wo nky[n h] w] soro daapem.\f1 
