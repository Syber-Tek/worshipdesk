\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nna yim momm] mm]den pa, 
\par munsiesie mo koma, 
\par mo Hene, mo Agyenkwa 
\par p] nt[m aba mo nky[n!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}no ne Tumfo] a 
\par Nyankop]n nam ne dom so 
\par de no maa mo s[ ]ny[ 
\par mo hann ne mo nkwagye.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Momm] ne kwan p[p[[p[.
\par Na monte[ n'atemp]n;
\par Monhy[ abon nyinaa ma, 
\par Mommr[ mmep] ase!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Monte[te[ k]nt]nkye, 
\par na munkyi nea okyi, 
\par na momp[ nea ]p[,
\par na wanya abaye!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Komam' ahobrease
\par n'Onyame bu no pii; 
\par koma a [ma ne ho so 
\par de yaw bebree b[s[e;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par koma a [te[ t'rodoo 
\par na [fam Nyame ho no 
\par besiesie ne ho yiye 
\par na watumi abam.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, hw[ me hiani!
\par Wo dom n' ehia me;
\par besiesie me komam bi 
\par ]dom bere yi mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu, hy[n me komam 
\par na ten a mu se me hene, 
\par na me koma ne m'ano 
\par ayi w'aye dabaa!\f1\fs22 
\par \pard\lang2057\f2\fs24 
