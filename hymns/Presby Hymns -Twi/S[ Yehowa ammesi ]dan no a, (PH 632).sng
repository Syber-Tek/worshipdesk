\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ Yehowa ammesi ]dan no a,
\par adansifo adwuma b[y[ kwa;
\par na s[ Yehowa anw[n kurow no a,
\par ]w[nfo no si ho p[ ara kwa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}kwa na mos]re an]pa tutu,
\par na motena ase, na mudwennwen pii,
\par ]haw ne amane y[ mo aduan,
\par nanso n'ad]fo de, w]home komm.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[, Yehowa agyapade pa ne mma,
\par yafunum ade y[ akatua
\par S[nea akode te abran nsam no,
\par saa na mmerante bere mu mma te nen.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wobehyira nea n'agyan kotoku
\par ay[ ma w] anidaso pa mu.
\par W]n de, w]remma obi ani nwu da;
\par w]ne 'tamfo kasa kurow pon nom.\f1 
\par \pard\lang2057\f2 
\par }

