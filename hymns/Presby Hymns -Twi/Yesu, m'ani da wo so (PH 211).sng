\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, m'ani da wo so 
\par m'Agyenkwa, woanyan owu mu.
\par Minim saa yi, minsuro 
\par s[ w]de me b[to da mu, 
\par na me wu remfa me nk]; 
\par menya nkwa foforo no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. M'Agyenkwa, wote ase, 
\par Wob[ma matena ase bi. 
\par M[ba nea wow] h], 
\par worennyaw me d]te mu da. 
\par Wone ti, wob[twe me 
\par s[ wo ho akwaa no bi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mede d] ne gyidi nsa 
\par miso wo mu, mikura wo. 
\par M'anidaso ne hama na 
\par [sa wo ene me ntam no; 
\par na owu po rentetew 
\par me ne wo, m'Agyenkwa mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ me honam p'r] ]dam, 
\par na [dan d]te bio a, 
\par minsuro, na ebenyan 
\par s[ aba bi dan y[ dua; 
\par nanso [reny[ s[ kan; 
\par [benya anuonyam. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Minsuro owu ne da, 
\par merentena asaman haw mu. 
\par Yesu benyan me ampa, 
\par de me aba n'anu'nyam mu, 
\par na me ho at] me w]], 
\par na m'ani agye dabaa. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Na s[ mete'fam ha yi, 
\par [s[ me, me ho akyi pa, 
\par meremma m'ak]nn] bi 
\par ntwe me nk] b]ne s[em' da. 
\par Yesu pa, gye me koma 
\par fa b] wo de ho koraa!\f1 
\par \pard\f2 
\par }

