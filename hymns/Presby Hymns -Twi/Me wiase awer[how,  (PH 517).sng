\par 1. Me wiase awer[how, 
\par anigye renky[; 
\par nnepa a [w] soro h],
\par rentwam da, n'[y[ d[.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Enti minnwen asase so 
\par sika, nidi ne d[w; 
\par m'amane ne me yaw mu po, 
\par me Yesu y[ me f[.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mimmisa hwee w] wiase, 
\par [ha nnepa betwam; 
\par me Yesu ho na m'ani gye, 
\par na m[tena da nkwa mu.\f1 
