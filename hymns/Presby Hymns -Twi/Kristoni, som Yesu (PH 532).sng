\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Kristoni, som Yesu
\par wo Agyenkwa pa.
\par Wo nti obehuu yaw
\par wuu dua no ho.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fa tumi ne nnam ka 
\par Onyame as[m no
\par ne ne d] k[se no 
\par w] asase so.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Br[ wo koma ase
\par koto Kristo no, 
\par na woanya ne nky[n h]
\par nkwa abotiri.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Fa gyidi mpaeb] ko
\par w] wiase ha,
\par na woanya asade
\par ama wo Hene. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. K] so som no dabaa 
\par kosi wo wuda,
\par na wama wo mo, mo,
\par w] n'ahenni mu.\f1 
