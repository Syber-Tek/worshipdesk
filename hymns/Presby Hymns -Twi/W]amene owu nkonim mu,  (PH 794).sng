\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. W]amene owu nkonim mu, 
\par na owu agyan no w] he?
\par Owu, wo nkonim w] he? 
\par Na wo nwow]e no nso w] he? 
\par B]ne tumi no ne mmara, 
\par b]ne n' [y[ mmara no ti. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Enti yeda Nyame ase 
\par nidi ne anuonyam mu.
\par \}n' na ]ma nkonimdi 
\par w] Wura Yesu Kristo mu;
\par ]no na owu de gyee y[n,
\par na ne s]re bu y[n bem. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Owu, wo nwow]e no w] he?
\par Wo nkonimdi a woanya no, 
\par [w] he owu sum mu?
\par Onyame ma yedi nkonim,
\par na nkonimdi amene wu.
\par Kristo ne nkonim Hene.\f1 
\par \pard\f2 
\par }

