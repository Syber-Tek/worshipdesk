\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me Wura ne m'Agyenkwa pa,
\par eyi  ansa  na mek]da;
\par meda a, minim me ho bio,
\par na wo de, wob[hw[ me so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me b]ne a may[ won n[,
\par mesr[ wo s[, fa firi me!
\par Me Yesu pa, fa wo mogya,
\par na  hoh'ro me komam koraa!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Merek]da wo asomdwoem,
\par fa  me hy[ wo ntaban ase;
\par ma w'ab]fo mm[w[n me ho,
\par ma b]ne bi amma me so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Agya Onyame, hw[ y[n so;
\par Yesu, wo dom no mmra y[n so;
\par Honhom kronkron, tew y[n komam,
\par na  s[ yewu a, y[ak] nkwam.\f1\fs22 
\par \pard\f2\fs24 
