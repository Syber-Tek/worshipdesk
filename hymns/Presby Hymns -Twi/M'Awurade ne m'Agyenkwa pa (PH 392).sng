\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M'Awurade ne m'Agyenkwa pa, 
\par \}domfo] ne Gyefo! 
\par M'amun]y[ bebree nti, na
\par me kra rehu [yaw pii.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me b]ne d]]so s[ agyan,
\par awow] me komam, akam.
\par Awurade, hu me mm]b].
\par \i 
\par \cf1\ul\b\i0\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Dom kae me yi me b]ne no, 
\par m'adesoa pemee no; 
\par efis[ w]ahu amane 
\par dua no ho, w] me nti. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anka me b]ne no b[ma 
\par mamem m'awer[hom koraa, 
\par na mamem daa owu mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo b] a woahy[ me no nti, 
\par Metw[n w'ahumm]b] no;
\par [de awer[kyekye pa 
\par b[ma me yaw no adwo
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par efis[ [ka s[: W] dom
\par w]n a w]de ahonu pa
\par hwehw[ wo s[ w]n Gyefo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me a me wer[ ahow yi, 
\par meba mab[kotow wo.
\par Miyi me yam mesr[ wo s[, 
\par dom hu me-br[fo mm]b]! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me b]ne a manya no ny[e,
\par fa wo dom so fa firi me, 
\par na ny[ me s[ [s[ me
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Fa wo honhom b[hy[ me den, 
\par ma memfa soro kwan so; 
\par ma mentra wo, Gyefo nky[n 
\par menkosi me wuda mpo! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na ma memfa abot]yam 
\par memfa owum memmra wo nkwam',
\par \pard na menna w' as[ daapem.\f1 
\par \lang2057\f2 
\par }

