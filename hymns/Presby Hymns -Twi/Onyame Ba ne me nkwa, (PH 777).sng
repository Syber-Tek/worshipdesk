\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame Ba ne me nkwa,
\par miwu a, minsuro;
\par ]no ara de me kra
\par b[k] nea ]w].
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}soro h] ne me k'rom,
\par na  Yesu nso w] h];
\par m'ani begye h] daapem,
\par me ho benya adwo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Fam ha amanuhunu
\par ne haw nni h] koraa;
\par yaw  biara nni h]nom,
\par me ho b[t] me daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Anka mens[ ]soro
\par ne  h] anuonyam,
\par na mey[ ]deb]n'y[fo
\par fi sor' besi me fam.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na m'Agyenkwa amane 
\par ne  ne yaw new u nti,
\par m[fa wum' mak] nkwa mu:
\par wama me ho afi.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Wafr[ me afi sum mu
\par aba ne hann no mu
\par ab[ka Nyame mma no
\par ne n'ahotefo ho.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Enti mek]da n' ase,
\par na m' ayi n'ay[ daa;
\par m[to dwom mama Yesu,
\par Amen, ma [ny[ sa!.\f1\fs22 
