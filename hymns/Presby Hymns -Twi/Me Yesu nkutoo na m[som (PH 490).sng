\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Me Yesu nkutoo na m[som,
\par owum Guank]b'ea nen!
\par Agya, fe me fra wo mma mu,
\par na many a wo nkwa no bi.
