\viewkind4\uc1\pard\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Halleluya! y[n Nyame pa! 
\par y[kamfo no ne ne nnwuma, 
\par yeyi n' ay[ da n'ase, 
\par mmeresanten ne mfe mpemmpem 
\par atwam dedaw; na obi nnim 
\par da a ne nkwa fii ase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea ]ye onu'nyamfo 
\par ne ]domfo, munyi n'ay[!
\par ]no na oye daa ampa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Halleluya! Y[de nyansa, 
\par anuonyam ne aseda 
\par ma Onyankop]n. Guammaa;
\par ]no ara n'  ]baa y[n nky[n, 
\par ]de ne mogya at] y[n 
\par enti yeyi n'ay[ daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Oyi y[n fi y[n nneb]nem;
\par obu y[n bem ne mogya nom; 
\par de y[n fra ]soro manfom.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Halleluya! Honhom Kronkron, 
\par yeyi w' ay[, y[to wo dwom;
\par wo na wowoo y[n fof'ro, 
\par na wode gyidi hyehy[ y[n 
\par de y[n k] Kristo Yesu nky[n 
\par ma y[n bo wie y[n yam t].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[ka Nyame mana no hw[, 
\par [y[ d[ s[, na ]soro, 
\par yebewie mee n'anim h].
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Halleluya! y[n Nyankop]n!
\par Ne nti ara na y[to dwom;
\par ne din ho tew na [so.
\par Woyi n' ay[ ]soro h], 
\par y[b] ne din w] fam ha nso;
\par na n'anu'nyam bunkam so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea ]y[ Onu'nyamfo
\par Ne ]domfo ne y[n Wura;
\par munyi n' ay[, Halleluya!\tab\f1 
