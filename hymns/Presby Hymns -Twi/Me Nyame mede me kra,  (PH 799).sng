\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me Nyame mede me kra, 
\par me honhom hy[ wo nsam. 
\par Wode ]d] hw[ me so, 
\par w] b[ a woahy[ nti. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hena so na m'ani da 
\par s[ obegye me nkwa? 
\par Akra nyinaa y[ wo de,
\par me kra nso y[ wo de
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo na wode aky[ me, 
\par enti san gye w'ade, 
\par na ma [ntena wo nky[n daa. 
\par Wo na woy[ me de.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. B]ne a as[e me nti, 
\par daapem gya fata me, 
\par na w'anuonyam no nti, 
\par meda so te ase.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wo de wo ba no mogya 
\par agu me honhom so. 
\par Me Wura Yesu trenee 
\par b[ma madu w'anim.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Me gyidi de ne ntaban 
\par betu ak] soro,
\par me honhom benya nkwagye 
\par ]dom b]hy[ no mu.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Wo Nyame ne me Gyefo
\par w] me b]ney[ mu. 
\par Na s[ me wu da du a, 
\par worennyaw me koraa. 
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Wote ase, wod] me, 
\par woadi w'as[m no so. 
\par Me Nyame, me honhom no, 
\par mede mehy[ wo nsam.\f1 
\par \pard\f2 
\par }

