\viewkind4\uc1\pard\sl276\slmult1\cf1\expndtw-4\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. Yesu mogya hwie gui
\par \expndtw-2 t'rom h] w] ne ho fifrim;
\par \expndtw-3 na w]hwee no mpire pii no,
\par \expndtw-7 w]de ns]ekyew hy[[ ne ti;
\par \expndtw-4\ul\b\'b6 \ulnone\b0 
\par w]de mprego b]] ne nan mu
\par \expndtw-1 ne ne nsam no, egugui pii;
\par \expndtw-4 na peaw no w]] ne mfem
\par \expndtw-3 tuee ne mu mogya twem.
\par 
\par \ul\b\'b6 Verse 2\ulnone\b0 
\par 2. Yesu kae s[ ne mogya no,
\par \expndtw-2 ne apam fofro de no;
\par \expndtw-1 nnipa pii nti wohwie gui
\par \expndtw-3 de maa b]ne fafiri.
\par \expndtw-2\ul\b\'b6 \ulnone\b0 
\par Ne honam y[ aduan pa;
\par ne mogya na [ma daa nkwa;
\par \expndtw-3 nea odi na ]nom,
\par obenya ne daa nkwa worn.
\par 
\par \expndtw-4\ul\b\'b6 Verse 3\ulnone\b0 
\par 3. Yesu mogya n' ]de ay[
\par Nyankop]n mpatade no;
\par \expndtw-3 ]de ay[ y[n anonne,
\par y[n nneb]ne so ad'ru.
\par \expndtw-4\ul\b\'b6 \ulnone\b0 
\par \{te se ]soro bosu,
\par \expndtw0 [te se daa nkwa asuti.
\par \expndtw-5 Me Ntamgyinafo mogya
\par \expndtw-2 ne nea mekamfo daa.
\par \cf0\expndtw0 
\par \cf1\expndtw-1\ul\b\'b6 Verse 4\ulnone\b0 
\par 4. Saa mogya no hy[ abr[fo
\par \expndtw-2 ne awer[hofo den;
\par \expndtw-1 [kyer[ s[ Yesu d] y[n,
\par \expndtw0 na ]de ne ho maa y[n.
\par \ul\b\'b6 \ulnone\b0 
\par \{ye me ka ano mogya,
\par enti nso mibu no pii pa.
\par Gyidi mu maso mu bi,
\par na me ho asan me yi.
\par 
\par \expndtw-1\ul\b\'b6 Verse 5\ulnone\b0 
\par 5. Af]re kronkron na ]b]e,
\par \expndtw0 na [ho nni d[m koraa,
\par enti ebetumi atew
\par y[n ahonim nyinaa ho.
\par \ul\b\'b6 \ulnone\b0 
\par Yesu nti Onyame d] y[n,
\par ne nti ]de y[n ka ky[ y[n.
\par \expndtw-1 Nyame d] nti y[b[y[
\par nea y[n Agyenkwa p[.
\par 
\par \expndtw0\ul\b\'b6 Verse 6\ulnone\b0 
\par 6. Y[de y[n honam ne y[n kra,
\par Hy[ y[n Yesu pa no nsam!
\par \expndtw-1 S[ ]de ne ho ky[[ y[n no,
\par \expndtw0 y[de y[n ho hy[ ananm'.
\par \ul\b\'b6 \ulnone\b0 
\par Na [da a yetu fi ha no,
\par y[nam ne mogya tumi so
\par fi fam akwantu mu ha
\par k]tena nea awa daa.\f1\fs22 
\par \pard\cf0\f2\fs24 
