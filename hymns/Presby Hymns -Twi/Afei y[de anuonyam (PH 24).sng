\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Afei y[de anu'nyam 
\par ma Nyame da no ase 
\par n'aky[de ahorow a 
\par wadom de aky[ yen ho.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n nkwa, y[n kra ne honam 
\par ne nko na ]de ma y[n.
\par Oyi ne yam hw[ y[n so 
\par na ]mfa hwee nkame ne mma.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Anka y[n kra ne nkwa yi, 
\par pe s[ [tena h] daa;
\par nanso b]ne asetena
\par n'[ma owu yi yen fi ha.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wama y[n yaresafo:
\par ]no ara ne daa nkwa;
\par Agyenkwa no wu maa y[n,
\par nanso wanyan k] soro h]
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. N'as[m no ne n'asub]
\par ne n'adidi kronkron no
\par siw asiane nyinaa kwan 
\par s[ Honhom Kronkron kyer[ no.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ne nkutoo mu na yenya 
\par b]ne fafri ne daa nkwa;
\par na y[ak] ]soro h].
\par Onyame, w'aky[de yi so.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Fa wo nhyira ahorow,
\par ak[se ne nketewa
\par behyira y[n nney[e so:
\par nea woy[ nyinaa ye mm'roso.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Y[n y[n daa nokware mu,
\par ma y[n soro ahot]
\par na y[afa Yesu din so 
\par ayi w'ay[, Amen Amen!\f1\fs22 
\par \pard\lang2057\f2\fs24 
