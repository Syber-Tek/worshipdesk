\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O Daapem Hann, O Daapem Hann!
\par Me kra p[ wo ahw[,
\par nanso entumi ny[ hwee da,
\par gye s[ wotew me ho koraa 
\par na mahu w'anu'nyam.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W'ahengua ho asomfo no 
\par w] w'anu'nyam no bi;
\par efi wiase asefi,
\par wonnim ]s[e ne asehwe 
\par s[nea mewom yi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M[y[ d[n po na mapue 
\par me Y[fo no anim?
\par Me a mete sum kabii mu,
\par na m'adwene ne me mu nso
\par ase[ na ay[ fi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nanso ]kwan pa bi w] h] a
\par w]fa so k] soro.
\par Nyame Honhom n'[boa y[n 
\par na y[n ahofama ay[ 
\par Onyame af]re.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Honhom tumi ne n'adwuma 
\par n'esiesie nnipa mma .
\par ma sum mu mma a wonnim hwee 
\par ten a Nyame Daapem Hann no mu 
\par w] ne Daapem D] mu.\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

