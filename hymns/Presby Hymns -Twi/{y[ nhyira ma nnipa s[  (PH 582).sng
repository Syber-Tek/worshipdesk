\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \{y[ nhyira ma nnipa s[ 
\par w]remfa b]nefo kwan so, 
\par w]rennyina w]n agyinam, 
\par na wokyi f[wdifo nney[e.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]p[ Yehowa mmara so di, 
\par w]de anigye susuw ho 
\par an]pa ne anadwo daa,
\par na wodi so de y[ w]n de.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. W]te s[ dua a esi
\par asub]nten k[se k]n so,
\par na [sow aba daa nyinaa
\par w] ne here mu daa daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. W]n de, w]n ahaban mpo da, 
\par nea w]y[ wie yiye; 
\par w]k] so fef[w daa nyinaa. 
\par Yiw, nhyira ne saa nnipa no.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ab]nefo de, w]nte sa; 
\par na w]te s[ nt[t[wa a 
\par [b] pete w] mframa mu.
\par Saa na ab]nefo te nen.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Enti nneb]ney[fo de,
\par w]rennyina atemmu mu;
\par na treneefo asafo no,
\par w]n de, w]remfa mu bi da.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. \{te saa s[ Yehowa nim
\par atreneefo akwan nyinaa, 
\par na ab]nefo b]ne nti, 
\par w]n akwan nyinaa 'ra b[s[e.\f1 
\par \pard\lang2057\f2 
