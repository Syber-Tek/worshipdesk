\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, s[ wok]] soro no, 
\par saa na w'asuafo no huu wo. 
\par Wok]] no w] nkunimdi mu, 
\par na saa na wob[san aba, 
\par na ateasefo behu wo, 
\par na awufo nso behu wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wode nyam bepue
\par soro apranaa mu,
\par daapem Hene. 
\par Anigye ba y[n yaw akyi, 
\par w'anuonyam ahenni mu. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Sakra y[n, wo, tumi Wura,
\par na ama y[agyina w'anim h] 
\par w] wo wiase ba no mu, 
\par s[nea y[n ani renwu 
\par w] wo ne w'akronkronfo anim, 
\par na y[ankogyina ehu mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma y[n nyinaa ny[, s[
\par wo mma a w]b[fra
\par treneefo mu.
\par O, ma y[n kwan w] wo nky[n h], 
\par na fura y[n trenee ntama.\f1 
\par \pard\f2 
\par }

