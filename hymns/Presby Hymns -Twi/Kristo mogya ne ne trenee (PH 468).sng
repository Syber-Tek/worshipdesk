\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Kristo mogya ne ne trenee 
\par ne me ntama, m'ahyehy[de, 
\par na da a Nyame b[fr[ me no, 
\par mede menya n'anim mak].
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Enti Kristo mogya no nko 
\par ne me nkwagye ne m'ahot], 
\par miwu oo, mete ase oo, 
\par mede me ho meto no so.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na s[ me b]ne haw me a, 
\par memma [nhy[ me so koraa; 
\par na mekae s[ saa b]ne nti, 
\par na [maa Yesu huu yaw pii.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ m'ak]nn] bi gyigye me, 
\par na wiasefo daadaa me, 
\par na ]bonsam s] me hw[ a,
\par meguan matoa Yesu daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Mesr[ no s[ ]mmoa me,
\par ]nhy[ me den ]ko no mu, 
\par ]mmma menny[ nea ]mp[
\par na ]mma meny[ nea eye.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Na s[ misu mefr[ no saa a, 
\par ]nto m'ase w] yi mu da; 
\par ogye me w] me b]ne nom 
\par de n'adepa besi ananm.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. M'Agyenkwa pa, miyi w'ay[ 
\par s[ w]woo wo onipa bi, 
\par na wuhwiee wo mogya gui 
\par w] y[n nnipa mma nyinaa nti.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Y[n Gyefo ne y[n Henk[se, 
\par ma amansan nyinaa 'ra nte 
\par s[ wuhu nnipa mm]b] sa, 
\par na woma w]n ho t] w]n daa.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Na ma w]ny[ aso yiye 
\par mmetie s[nea [s[, 
\par na w]ne y[n mmenya daa nkwa
\par ne ahot] w] wo mu daa!\f1 
