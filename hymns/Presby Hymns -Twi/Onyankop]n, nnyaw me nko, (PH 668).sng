\par 1. Onyankop]n, nnyaw me nko,
\par me nkwakoraa berem' 
\par \i (me mmerewea berem'),\i0 
\par na ntow me nky[ne ara,
\par na boa me mmer[w m'!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Manya wo dom k[se nhui,
\par woahw[ me so ara;
\par n' afei a manyin yi,
\par wie me hw[ koraa!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M'aho]den no nn]]so,
\par na m'adwuma a mey[ 
\par [ny[ yiye s[ kan no, 
\par na enti boa me!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me honam ani ha yi
\par nipa res[e nso a,
\par dom ma me mu nipa no
\par nnyin nnan foforo daa!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. As[m aba m'adwenem'
\par minhu ade yiye;
\par na ma menkae wo fie,
\par ma Yesu ny[ me f[!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. M'aso nso nte s[ kan no; 
\par na ma wo dom as[m 
\par mm[tena me koma mu daa, 
\par na enni m'asom d[m.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Me t[kr[ma y[ dur' a, 
\par [nka as[m yiye; 
\par nanso mesr[ m'Agyenkwa
\par s[ ]nkasa mma me.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Me honam y[ me yaw a,
\par wokyekye me wer[;
\par mekae w'apirak'ru a
\par manya mu nkwagye no.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Me nsa ne nan popo a,
\par me wu renkye bio; 
\par na minim s[ wo daa nkwa 
\par na menya w] soro.\f1 
