\par 1. Hu Yehowa akwan, 
\par na ama woay[ papa.
\par Tena asase so p[,
\par di wo bra mu nokware.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fa abot]yam y[, 
\par Yehowa ap[de.
\par N' ]b[ma wo koma, 
\par anya nea [p[.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}kwan a wonam so,
\par fa hy[ Yehowa nsa [
\par Ma w'ani nka no ho,
\par na ]b[y[ ama wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}no na ]b[ma, 
\par wo trenee ada 'di;
\par na w'atemmu no nso, 
\par b[y[ se owia.
