\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nyankop]n b[w[n w]n 
\par afi nn[ akosi daa,
\par na ab]nefo de, 
\par w]b[b] w]n apete.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W]n a w]y[ papa, 
