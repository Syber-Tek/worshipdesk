\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma abufuw to ntwa,
\par na nnipa nnyae ahiiyi
\par Gyae komam abufuw,
\par na [de b]ne n' [ba.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na ab]nefo de, 
\par wobetwa w]n agu
\par Yehowa asafo, 
\par bedi asase so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Y[ trenee ade bi,
\par na [ntena h] daa nyinaa.
\par B]ne nnwuma no de
\par [b[yera nt[m ara. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nneb]ney[fo no, 
\par w]abubu w]n tumi, 
\par na atreneefo de, 
