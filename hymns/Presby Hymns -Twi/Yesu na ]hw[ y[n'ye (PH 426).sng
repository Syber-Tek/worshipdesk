\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu na ]hw[ y[n'ye 
\par sen nipa a ]hw[ ne nguan so;
\par oyi n'adepa adi 
\par gu ne mmofra nyinaa'ra so.
\par Yesu nguan no bi ne y[n,
\par ]de mogya at] y[n. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n nnipa mma nkwagye nti, 
\par na ]dan ne ho y[[ nipa; 
\par y[n anan mu na osii, 
\par na ogyee y[n ka no tuae
\par Y[de y[n ho ma no a,
\par na yebenya n'adepa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nea ne ho k]m de no, 
\par nea n'ani gyina Yesu, 
\par saa onipa no behu
\par s[ n'Agyenkwa d] no d]]so; 
\par obenya ne ho w] ha, 
\par na wamee w] soro daa\f1 
\par \pard\lang2057\f2 
\par }

