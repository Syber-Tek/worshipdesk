\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \}home da so w] h] ma y[n.
\par Me kra a woabr[, bra b[hyer[n!
\par Wo fam ha mpokyer[ dennen mu
\par wo wia befi ama wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Behw[ Oguamma a ]de d[w pii
\par b[y[n wo w] n'anim h] daapem;
\par tow w'adesoa kyene, bra!
\par \{nky[ na woawie wo ko no,
\par na w'akwantum'amane asa,
\par na woak] homebea h].
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}home a [to rentwa da
\par n' \}nyankop]n de ato h];
\par ne d] k[se no nti, n' ]y[[ saa 
\par ansa na w]b]] wiase
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyame Guamma p[ s[ owu,
\par na y[anya ne nky[n daa ]home,
\par enti na ]fr[ nnipa s[: 
\par Mo a moabr[, mommra me nky[n [,
\par momm] me home ho mm]den [,
\par na momfa f[w ne nnam mmra nt[m!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mo a mo nnosoa aden mo,
\par na moabr[ no, mommra afei,
\par na mumfi mo amane bon mu,
\par na monk] mo Gyefo no nky[n!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Adekyee wia ahyehye mo,
\par enti na Yesu ka kyer[ mo
\par s[: Home pa no, [ne me.
\par Ne man ne mo a ]hw[ mo so;
\par s[ satan p[ s[ ]s[e mo a,
\par munnsuro da, mommra ara!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \{den na ebedwudwo nea
\par ]y are no s[ k[t[ bi?
\par \{d[n n' ]kwantuni a wabr[
\par p[ tit'riw s[ ]home bi?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ yarefo nya ne dabere
\par n' ]kwantuni nya homebea a,
\par na w]n baanu ani agye.
\par Na saa ]home yi renkye bi;
\par Oguamma no w] home pa a
\par w]de b[home komm dabaa
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{nna w]de afiafi no 
\par b[ba n'anim w] anigyem; 
\par y[n nusu ne y[n br[ no asa, 
\par na y[b[tena y[n Agya fi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{h] na w]to ayeyidwom, 
\par na w]b] sanku di no ni daa; 
\par ]yaw, ahomete ne wu 
\par beguan ak] akyirikyiri, 
\par na yebehu y[n soro hene, 
\par ]no b[ma y[amee koraa.\f1 
