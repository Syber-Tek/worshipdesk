\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Munti' oo! Aw[mfo nne ni! 
\par S[ munnyan nkohyia mo Wura, 
\par \}henk[se no reba oo! 
\par Adu ]dasu k]nk]n mu, 
\par ]reba n'ayeforohyia; 
\par mmabaa mmadwemma, mow] he?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Munnyan na montase 
\par mo akanea nk], nanso monhy[ 
\par n'atade pa, munhyia no, 
\par na hw[, n'afahy[ d]n adu. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Sion te aw[mfo nne no,
\par ne ho resan no, n'anigye mu, 
\par onyan, n']s]re nt[mnt[m pa. 
\par N'adamfo fi Nyame soro 
\par reba ]dom ne anu'nyam mu
\par ne hann pue, ne wia h'ran.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, Yesu, Nyame Ba, 
\par ayef rokunu, bra! Hosiana! 
\par Yehyia wo di wo akyi, 
\par na y[ak]tena wo pon ho bi. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nnipa ne ab]fo kasa
\par ne sankub] ne daapem dwonto
\par na w]de hy[ wo anu'nyam.
\par Y[fa ]pon a [h'ran mu
\par k] w'ahotefo sika kurom
\par kogyina w'ahengua anim. i
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Saa anigye k[se,
\par obiara nhui da, na ]ntee da.
\par Y[nkamfo wo, na edi sa;
\par yeyi wo din ay[ dabaa.\f1 
\par \pard\f2 
