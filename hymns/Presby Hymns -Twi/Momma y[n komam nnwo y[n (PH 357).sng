\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Momma y[n komam nnwo y[n; 
\par [nn[ da yi y[ homeda. 
\par Momma y[n nyinaa nhome 
\par w] y[n soro Agya no mu, 
\par na y[mma nn[ da yi ho ntew, 
\par na y[anya emu daa nhyira. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nyame mp[ s[ y[n koma 
\par b[fam wiase nnipa ho, 
\par na sika ne ahode 
\par besiw y[ne no d] ntam kwan.
\par \}p[ s[ y[de y[n koma 
\par ma no nn[ s[ n'as]refi
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Homeda w] h] ma y[n; 
\par [ma yenya Nyame nhyira. 
\par Y[n Nyame, behyira y[n,
\par tew y[n komam ne wo fi ha,
\par na da bi y[n nna nyinaa'ra 
\par ay[ Sabaot homeda \f1 
\par \pard\lang2057\f2 
