\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ wosom w'Agyenkwa, de kosi wum a,
\par wubedu soro Paradise h];
\par s[ woko na wudi emu nkonim a,
\par wubedi [h] nkwadua aba.
\par Onyame mma no, wobedi n'ade;
\par ]no b[kyekye w]n wer[ daa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O, Yesu, boa me ma, minni nkonim bi;
\par ko a mereko yi mu y[ den.
\par Minnim me ho so hw[ yiye koraa po,
\par enti mesr[ wo s[ b[hw[ me so,
\par na begyigye me, na siesie me,
\par hy[ me baninha, na minyi d]m!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Obiara a obedi saa knkonim no,
\par owuprenu no, [renka no da;
\par na mmom, owu a , okohu n'Agyenkwa,
\par na n'ani agye daa w] daa nkwa nom!
\par \}ne 'hotefo ne Nyame 'b]fo
\par b[bom atena ase w] nkwa pa mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. O, Yesu, boa me ma, minni nkonim bi,
\par me gyidi a mew] taa y[ mmer[;
\par enti mesr[ wo, dom me ma me gyidi,
\par na ma minso wo tumi mu dennen.
\par Ma menn] wo yiye; na minni w'akyi,
\par na woanya nidi w] me mu bi.\f1\fs22 
\par \pard\f2\fs24 
