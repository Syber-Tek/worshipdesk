\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Ayeyi dwom na meto mema Nyame, 
\par mete ase yi, minnyae saa y[.
\par \}n'na ]mma me me honam ne me kra,
\par Na ]san hw[ me so dabatee. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M[kamfo madi m'Aw'rade no ni 
\par akosi da a m[k] n'ankasa fi.
\par Halleluya! Halleluya!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nnipa na wotumi boa nnipa a?
\par Otumi pa bi nni w]n fam da.
\par Aka kakra na w]n mu nkwa no asa 
\par na w]y[ d]te ne nso 'rakwa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ahen', atumfo k[se po te sa;
\par boafo nko ara ne Yehowa.
\par Halleluya! Halleluya!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo a wob[hwehw[ Nyame ahu no, 
\par Nyame remma wo ani nwu da 
\par Wo a w'ani da w'Agyenkwa no nko so, 
\par Yesu nso, ]rempa w'akyi da. .
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ Nyame Tumfo] boa y[n a,
\par Y[w] ogyefo ne boafo pa.
\par Halleluya! Halleluya!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}n' na ]b]] ]soro ne asase
\par [po ne n'ade y[ n'adwuma.
\par Nnipa a wonni bi na ohu w]n mm]b], 
\par nanso odi w]n nokware daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Aman ahemfo no hene ne no. 
\par momfa mo ho nto Tumfo no so 
\par Halleluya! Halleluya!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. W]n a amane mu wonni dimafo, 
\par nea odi w]n as[m ne no.
\par W]n a ]k]m de w]n aduanmafo 
\par ne nnommum gyefo ne ky[m ne no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na ]y[ nnipa nyinaa'ra yiye, 
\par ne mm]b'rohunu no d]]so bebree.
\par Halleluya! Halleluya!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \}n' na ]ma 'nifuraefo hu ade, 
\par ma asitifo te as[m.
\par \}ma n'ahobr[asefo nso ti so, 
\par gyidifo behu ne d] no nt[m.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}hw[ akunafo [ne nyisaa 
\par ne amamfrafo so yie dabaa.
\par Halleluya! Halleluya!
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. W]n a w]n wer' afi Nyame trenee no,
\par ]dan w]n akwamm]ne ani;
\par ne saa nti wotutu anamm]n hunu 
\par k]tot] w]n ara afirim.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yehowa n']w] tumi dabatee, 
\par enti enhia ne mmofra 'no hwee.
\par Halleluya! Halleluya!
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Adasamma, so munhu Nyankop]n din?
\par So munhu n'anuonyam k[se?
\par N'aho]den ne ne d] ne ne nyansa 
\par ne n'ahumm]b] d]]so bebree!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Agya ne Ba no ne Honhom papa.
\par Mo Nyame mma, munyi no ay[ daa.
\par Halleluya Halleluya!\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

