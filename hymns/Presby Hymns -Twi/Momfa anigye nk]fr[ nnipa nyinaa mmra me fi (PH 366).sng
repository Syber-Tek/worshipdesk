\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. "Momfa anigye nk]fr[ nnipa nyinaa mmra me fi."
\par Saa na Awurade kasa kyer[ n'asuafo nen.
\par So wunnim s[ woy[ ne de bi ana?
\par Wiase aman pii nnim no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Momma y[mfa y[n koma ankasa nyinaa mm no
\par na y[n nso y[atumi afra n'asuafo no mu.
\par Y[ahu no s[ ne gye w] h] ma y[n yi,
\par momma y[mpa y[n nneb]ne.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yesu Otumfo, aho]den nyinaa y[ wo de.
\par \}soro ne fam ade nyinaa, wo ne so Wura.
\par Yesr[ wo s[ kae wo b]hy[ a ese:
\par "M[twe nnipa maba me nky[n".\f1 
\par \pard\lang2057\f2 
\par }

