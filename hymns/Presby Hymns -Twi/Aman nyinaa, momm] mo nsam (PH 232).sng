\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Amanaman mu ahene\tab 
\par aba abepue n'anim
\par Abraham Nyame mma no.
\par Efis[ y[n Nyankop]n y[
