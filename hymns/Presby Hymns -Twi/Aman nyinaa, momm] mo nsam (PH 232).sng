\par 1. Aman nyinaa, momm] mo nsam,
\par momfa anigye mm] ose, 
\par momm] ose mma Nyame. 
\par Yehowa ne soro Hene,
\par ne ho y[ hu sen obi bi,
\par ]no ne \}henk[se.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Aman b[br[ w]n ho ase,
\par amanaman b[kotow no.
\par Yakob ayeyi ma nhw[so.\tab 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyame huro k] soro,
\par Yehowa t'rob[nto gyigye;
\par monto dwom mma y[n Nyame.
\par Monto dwom mma \}henk[se
\par asase nyinaa so Hene,
\par ]y[ wiase Wura.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
