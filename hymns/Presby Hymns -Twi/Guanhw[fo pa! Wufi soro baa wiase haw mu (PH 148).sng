\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. Guanhw[fo pa! Wufi soro baa wiase haw mu; 
\par Woy[ me Hene, me S]fo, ne me Diyifo pa; 
\par wode w'as[m y[n me honam ne me kra. 
\par \expndtw-2 S[ mew] wo a, [d]]so.
\par \cf0\expndtw0 
\par \cf1\ul\b\'b6 Verse 2\ulnone\b0 
\par 2. Guanhw[fo pa! Wode wo kra too h] maa wo nguan no; 
\par d] a emu d] na wode gyee w]n w] nnebanem. 
\par \expndtw-2 Wode mogya t]] w]n s[\scaps  \scaps0 w]ny[ wo de, 
\par \expndtw0 na wonnya soro ahot].
\par \cf0 
\par \cf1\ul\b\'b6 Verse 3\ulnone\b0 
\par 3. Guanhw[fo pa! Wunim wo de, na wo de nso nim wo; 
\par wunim w'Agya no s[nea ano nim wo ara. 
\par Saa ]d] yi maa wode wo kra too h] 
\par maa wo nguan a wod] w]n no nyaa ahot]
\par \cf0 
\par \cf1\ul\b\'b6 Verse 4\ulnone\b0 
\par 4. Guanhw[fo pa! Wone nnipa nyinaa Guanhw[fo no; 
\par abosonsomfo na wode w'as[mpa no fr[ w]n. 
\par Wubetie w]n a w]fr[ wo no nne, 
\par na w]ab[fra wo nguan kuw mu.\cf0 
\par 
\par \cf1\expndtw-7\ul\b\'b6 Verse 5\ulnone\b0 
\par 5. Guanhw[fo pa! Ma mintie wo nne a [fr[ me!\cf0\expndtw0 
\par \cf1\expndtw-1 Ma minni w'akyi w] anigye ne ahohiam;\cf0\expndtw0 
\par \cf1\expndtw-1 fa w'as[mpa kyekye me wer[ dabaa.\tab\sub ;\cf0\expndtw0\nosupersub 
\par \cf1\expndtw-4 Yesu, me Wura, tena me mu!\cf0\expndtw0 
\par \cf1 
\par \ul\b\'b6 Verse 6\ulnone\b0 
\par 6. May[ hiani na   m'aho]den no so ahuan,\cf0 
\par \cf1\expndtw-1 na ]bonsam no hwehw[, m'akyi kwan ab[s[e me.\cf0\expndtw0 
\par \cf1 Kora me so, wo na miguan med] wo,\cf0 
