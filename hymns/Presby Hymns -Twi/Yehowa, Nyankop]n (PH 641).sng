\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yehowa, Nyankop]n, 
\par wo din no y[ k[se 
\par asase nyinaa so. 
\par Wo a wode w'anuonyam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par akata ]soro nyinaa. 
\par Yehowa, y[n Wura,
\par y[n Nyankop]n, 
\par wo din no y[ k[se.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ mehw[ wo soro, 
\par wo nsa ano nnwuma, 
\par ]sram ne nsoromma, 
\par Nne[ma a woahyehy[ 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]dasani ne hena a 
\par [s[ s[ wokae no?
\par onipa b[n
\par na ]fata wo nkae.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Woama aka kakra
\par na was[ Onyame.
\par Wode anuonyam
\par ay[ ne ti abotiri;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par woama odi wo nnwum
\par na woama no nidi
\par aboro so;
\par Yehowa n' ]ma pii.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Anantwi [ne nguan;
\par ne wuram mmoa nso, 
\par wode ahy[ ne nsa. 
\par Wim nnomaa ne po mu mpataa, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w]n a w]nam po mu kwan so 
\par Yehowa, y[n Wura,
\par woy[ k[se 
\par \pard asase nyinaa so.\f1 
