\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mifi akyiri
\par mahu me Nyame k'row,
\par na anka mep[ s[ me nso w]
\par h] dedaw po,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na mede soro h]
\par nkwa mu anigye no
\par asi amane a mihu anan mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea honhom mu
\par mahu y[ f[ mm'roso.
\par Wo ho tew kronkron nti na
\par w'anu'nyam te s[[ yi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ minya [h]nom
\par kwan na mak] mpo a,
\par anka nn[ yi ara metu mak] h].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Me b]ne nti na
\par [s[ me fam ha tena;
\par ne saa nti, Yesu ma minya
\par Nyame honhom no,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na me komam' atew
\par s[ Nyame p[ ara; 
\par na wunim s[ minnya men]] wo yiye.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. M'ani gye pii s[
\par womfa hwee nhinta me,
\par na me ho t] me da a
\par m'Awurade no fr[[ me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na nea aka no,
\par [ne me mm]denb]
\par ne s[ mehu amane ama wo daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Hwee renhia me,
\par mahu me Nyame k'row;
\par ne saa nti, mimmu asase so
\par br[ ne yaw bi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M[taa mama m'ani
\par so mahw[; kuro no
\par de akosi s[ medu n'ab]nten so.\f1 
