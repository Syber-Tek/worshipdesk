\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mey[ h]ho nantefo
\par w] wiase haw yim,'
\par na m'asetena nni hanom
\par [wa ]soro h]
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. M'ani gyina w] fam ha
\par me nkwa nna nyinaa mu;
\par m'ani gyina me fi pa
\par [h] na me haw sa.   
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}home ne ahot] 
\par w] ha ma Nyame mma;
\par eyi n' [w] soro h],
\par enti yehwe ha kwan.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. O, Yesu, ma me h] kwan
\par na memmra w'anim h].
\par Mereny[ h]ho bio,
\par na m[tena h] daapem.\f1 
\par \pard\lang2057\f2 
\par }

