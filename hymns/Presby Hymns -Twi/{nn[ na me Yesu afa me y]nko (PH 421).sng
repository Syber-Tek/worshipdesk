\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \{nn[ na me Yesu afa me y]nko;
\par Me kra ani gye s[ may[ Yesu de;
\par mede d] foforo m[som me Yesu daa, 
\par na manya ne nky[n daa ahot]. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yesu mu na menya daapem anigye;
\par wiase ak]nn] renky[ na atwam; 
\par s[ minim biribi w] m'asetena mu a 
\par [y[ Yesu ne n'as[mpa no.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Oguanhw[fo pa no b] ne nguan ho ban; 
\par nguan no bi yera a, ne d] hwehw[ w]n; 
\par [y[ ayamhyehye, [y[ ahumm]b] 
\par na Yesu de hw[ ne nguan kuw no
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Mey[ Yesu guamma, ne nky[n na m[tena;
\par ]b] me din fr[ me, ky[ me n'adepa; 
\par d[n na ebeyi me afi me Yesu ho? 
\par Yiw, Yesu na w]fa me y]nko. \f1 
\par \pard\lang2057\f2 
\par }

