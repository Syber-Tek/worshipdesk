\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M'asub] apam a w]hy[e mu,
\par W]de me hy[[ Onyame mu;
\par Agya, \}ba ne Honhom no mu
\par [no ne asase pa a
\par w]adua me w] mu s[ minnyin.
\par M[fef[w w] mu asow aba.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Sor' Agya ay[ me ne ba nn[,
\par na ]ne me apam fofro.
\par O, me Nyame, dom na ma meny[
\par wo ba a ne koam w] wo.
\par Me nipadua yi ne me kra, 
\par ne me honhom y[ wo de koraa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na obiara a ogye di, 
\par na w]ab] no asu saa no, 
\par ]no na obenya daa nkwa no, 
\par na ]renyera ne kra da. 
\par M'Awurade, ma minnye minni 
\par s[ ]ba, na woay[ me Agya.\f1 
\par \pard\lang2057\f2 
\par }

