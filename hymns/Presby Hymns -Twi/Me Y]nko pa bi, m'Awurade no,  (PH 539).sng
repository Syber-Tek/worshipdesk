\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me Y]nko pa bi, m'Awurade no, 
\par ]w] fam ne soro nyinaa. 
\par Onim me hia ne me haw, 
\par ofi soro di boa me. 
\par Asase so ne soro tumi, 
\par w]de ama soro Y]nko yi.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]ama no din a [y[ Yesu 
\par efis[ Ogyefo ne no. 
\par Wagye me afi me nneb]ne 
\par ne me daapem ]s[e no mu. 
\par O, Yesu, \}d]fo ne Gyefo,
\par woy[ daapem Y]nko mmoroso.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}y[ nnipa nyinaa \}y]nko
\par na ]y[ wiase Gyefo.
\par Ne saa nti, y[n nyinaa ba ne ky[n,
\par na yebenya ne d] mu d[w.
\par Obi nni h] s[ ]y]nko a
\par ]s[ y[n Wura Yesu Kristo.\f1 
\par \pard\lang2057\f2 
\par }

