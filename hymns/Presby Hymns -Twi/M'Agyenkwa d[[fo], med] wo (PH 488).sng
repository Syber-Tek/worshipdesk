\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M'Agyenkwa d[[fo], med] wo! 
\par Me nkwa aho]den ne wo. 
\par Mede me honam nso mema wo, 
\par wo nko na m'ani gyina wo. 
\par Me Hene ne me Nyankop]n, 
\par hwie d] gu me mu. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Many[ nt[m ara anhwehw[ wo; 
\par n'afei manu me ho w] ho. 
\par \{y[ me ya s[ mank]som wo 
\par na mama b]ne abu so.
\par M'ani awu, me wer[ aho,
\par s[ mapa wo maky[.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Kan no anka m'ani afura;
\par mikyinkyinii mefom wo kw]n.
\par Wofr[[ me, na mekaa akyiri,
\par na mekaa me s[efo no nsam.
\par Na wo na wudii m'akyi daa,
\par na woahu me ampa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. N'afei mesr[ wo s[, hw[ me bo,
\par na mank]fom wo kw]n bio,
\par na ma minni w'akyi wo kw]n so
\par na manhintiw manka akyi.
\par Pue me kram s[ me wia,
\par na tew me ho koraa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Med] wo s[ Onyame Guammaa a
\par owui w] asendua ho;
\par med] wo se me kra Agyenkwa,
\par m[kamfo wo mama wo so.
\par Meda so mew] fam ha yi,
\par \pard m[d] w' madi w'akyi.\f1 
