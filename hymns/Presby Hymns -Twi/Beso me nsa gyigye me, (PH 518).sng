\par 1. Beso me nsa gyigye me,
\par m'Agyenkwa pa,
\par w] m'asetena mu nn[ yi
\par ne daa nyinaa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mep[ s[ metena wo nky[n,
\par minnyaw wo da;
\par nea wode m' b[k] h] no, 
\par mep[ ara.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fa dom ne ahumm]b]
\par Kyer[ me kwan.
\par Ma memfa d] ne gyidi
\par minni w'akyi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M'anigyem ne m'amanem:
\par ma menye komm.
\par Mebr[ a, ma me ho nnwo
\par w] wo kokom.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Memp[ b'ribi mahu da
\par s[wo nkutoo.
\par Me kwan so duru sum a
\par me hann ne wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na enti beso me nsa
\par na ma y[nk]!
\par Ma minnu soro ha a
\par m[tena h] daa.\f1 
