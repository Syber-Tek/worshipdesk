\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Gyidi ne s[, y[de y[n ho
\par to Nyame d] ne dom so.
\par \{ny[ s[ y[pene so nko
\par s[ Yesu ne y[n Gyefo; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na [s[ s[ yesi y[n bo 
\par s[ y[b[fa ne kw]n no so
\par na yeamman ank] baabi.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{s[ s[ y[n koma mu tim, 
\par y[nnye n'as[m akyinne, 
\par na yeso Kristo mu pintinn 
\par sua no daa di n'akyi; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na y[amfa y[n ho anto y[n ho 
\par ne y[n ara trenee bi so; 
\par na y[n nneyee nte[ da.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nanso saa gyidi ba beyi 
\par ne ho adi nney[e mu; 
\par na nea [ny[ ade bi 
\par k]y[ s[ gyidi hunu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea ]ka s[ ogye di, 
\par na onni nnwuma pa no bi, 
\par ne gyidi te s[ awu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na saa gyidi pa no mfi wo; 
\par [y[ Nyame aky[de. 
\par Enti sr[ no s[ ]mma wo 
\par saa gyidi ne nney[e no; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [no na w'asom bedwo wo, 
\par wo ho b[san wo, na wo bo 
\par b[t] wo yam nokwarem.\f1 
\par \pard\lang2057\f2 
