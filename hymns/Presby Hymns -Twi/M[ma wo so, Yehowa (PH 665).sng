\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M[ma wo so, Yehowa
\par Efis[ woagye me,
\par m'atamfo ani annye
\par m'asehwe ho, wo yam ye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yehowa, me Nyankop]n,
\par misu mefr[ wo daa.
\par Wo dom sa me nyarewa,
\par enti meyi w' ay[.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yehowa, woagye me kra
\par afi owu-see mu.
\par Woagye me nkwa, na mank]
\par awufo tena bea.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Monto dwom mma Yehowa,
\par mo, n'anuonyam mma.
\par Munyi ne nkae din ay[
\par ne nkae din kronkron no
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nanso [nky[ koraa po
\par na n'abufuw asa.
\par \{no nti n'ad]e wo h]
\par ma wohu ne nkwagye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anadwo nk]mm]di mu
\par n'ahumm]b] w] h];
\par na s[ adekyee ba a,
\par ]ma anigye ba.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yehowa, hu me mm]b]; 
\par wodan me nk]mm]di 
\par ma m'ani gye na mesaw
\par wuyi me ntamagow.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wufura me anigye,
\par M[to w'anu'nyam dwom, 
\par na wo, Yehowa ara 
\par \pard na m[da w' ase daa\f1 
\par \lang2057\f2 
\par }

