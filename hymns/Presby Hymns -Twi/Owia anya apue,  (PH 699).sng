\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Owia anya apue, 
\par ne hran b] m'ani so; 
\par Onyame nokware de, 
\par [retew me mu nso.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyame wia, b[hyer[n, 
\par b[hran m'adwene mu, 
\par b[twe me kra bra wo nky[n, 
\par na wo nso, tena me mu!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ewim' awia pue a, 
\par [pam wiase sum; 
\par s[ wo nso, woba me mu a, 
\par wopam me b]ne nen.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wone me hann ne me nkwagye; 
\par ma me nso menhyer[n. 
\par Ma mens] w'an'unyam no hw[, 
\par na tew me mu koraa
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}k]re tu k] soro a,
\par ]hw[ owia tee;
\par bue me honhom aniwa,
\par na minhu wo pefee.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Nipa a ne komam atew
\par b[hw[ wo ne wo hann,
\par na ]br[ ne ho ase 
\par ahy[n wo soro prann.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Baabiara a menam w] ha, 
\par m[nante wo anim; 
\par nea mey[, nea mepa, 
\par ma emfata wo din.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Ma w'aniwa mmegya me daa, 
\par na mamfom soro kwan! 
\par Hw[ me so na di m'akyi daa, 
\par fa me k] wo daa nkwam!\f1 
\par \pard\lang2057\f2 
\par }

