\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Esum kata asase so
\par Kwaem ha ne Sarem ne Mpoano;
\par na satan nnaadaa fur a w]n ani
\par ma w]kotow abosonhuhu pii.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[, w]n koma rep[ b'ribi,
\par na yaw k[se ma w]n bo tutu pii;
\par amane aba w]n ade nyinaam,
\par na w]resu afr[ w] damoam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na Yesu hu w]n mm]b] nn[
\par ma w]n mu binom te ne dom no fr[;
\par na nn[ ]p[ s[ w]nka n'as[mpa
\par na w]mm] Yesu din w] mmaa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}kwan da h] ma amansan;
\par ma w]n nyinaa 'ra mmra Onyame fam!
\par Na mo a ne hann atew mo ani,
\par momm] mm]den mma mo nk'r]fo nso bi!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. O Yesu, y[n Agyenkwa pa,
\par wode wo wu agye amansan nkwa!
\par Dan sare so ne kwaem y[ w'afuw pa,
\par na ma aman nyinaa mm[som wo daa!\f1 
