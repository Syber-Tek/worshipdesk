\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me Dimafo no te ase, 
\par awer[kykyes[m no ni! 
\par Nea owui no te ase yi, 
\par ]te ase ma me.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}te ase, wadi 'wu so,
\par ]te ase, y[n daa 'Gyenkwa; 
\par ]te ase, ewim noh],
\par odi ne hene daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}te ase, n' ohyira me, 
\par na odi ma me soro h]; 
\par ]te ase, twe me fi dam
\par ]b[ma me daa nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}te ase, m'Adamfo pa, 
\par reboa me asi ase; 
\par enti na m[to dwom yi se,
\par me S]fo, me Hene.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}te ase, siesie
\par tenabea pa bi ama me;
\par anuonyam, nidi, nhyira
\par nka ne din dabatee!\f1 
\par \pard\lang2057\f2 
\par }

