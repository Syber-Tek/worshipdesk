\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade, wo da baako atwam
\par na  sum nam wo hy[ so aba.
\par Y[de dwom kamfo wo an]pa,
\par y[k]da a, yebeyi w' ay[.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ asase bob]w k]da a,
\par w'asafo de, [renna da.
\par Awia n e anadwo nyinaa,
\par [b] wiase ho ban p[.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Owia  de adekyee hann no
\par twitwam  w] nsase horow so.
\par W'as]re mpae nso nenam saa'ra,
\par na w'ayeyi gya no s] daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Owia t], na y[da w] ha,
\par enyan  afofro w] noh].
\par \{no nti bere nyinaa mu no,
\par w'ayeyi w] nnipa anom.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Awurade, w'ahengua tim h] daa,
\par wiase  tumi no betwam.
\par Ma w'ahenni nk] aman nyinaam,
\par na  akra nyinaa adan wo.\f1\fs22 
\par \pard\f2\fs24 
\par }

