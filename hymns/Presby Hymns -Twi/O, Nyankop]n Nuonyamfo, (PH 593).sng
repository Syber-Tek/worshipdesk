\par 1. O, Nyankop]n Nuonyamfo,
\par wo na mete[m fr[ wo yi,
\par me d]te mu nipa!
\par Me a anka memfra koraa,
\par na mey[ nkwa ne owu de,
\par b]nefo, ayisaa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[ migyina ]botan so,
\par mew] po abien no ntam,
\par na minnya ahosan.
\par Bere a w]ahy[ no du a,
\par Onyankop]n nky[n na m[k]
\par anaa bonsam kurom!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame, sakra m'adwene,
\par na fa wo daapem nnepa no
\par b[hy[ me nso mu bi.
\par Ma minhu ne bo a [som
\par na mapere s[ me nsa ka,
\par na mansee ara da!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ wo da k[se no redu,
\par na wode anu'nyam ba a,
\par hy[ me w'atade no. 
\par S[ wubu wiase nt[n a
\par Ka kyer[ me na mensom wo,
\par na w]ammu me nt[n!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma eyi ny[ m'adwene daa,
\par na mede mm]denb] ara
\par ahwehw[ daa nkwa no!
\par Nea wohy[e no aba mu;
\par fa wo trenee nney[e pa no 
\par bra b[hy[ me mu daa
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Me Gyefo, hu me mm]b] [;
\par dom ma me kra nya wo nkwagye
\par na [ne wo atena!
\par \{h] no, gyidi to betwa,
\par na anidaso nso b[sa
\par w] daapem ]d] mu!\f1 
