\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mey[ Yesu guammaa nti
\par [ma m'ani wie gye;
\par na saa Hw[fo a mew] yi,
\par onim s[nea ]b[y[n me;
\par ]d] me, ]b] me din,
\par fr[ me s[ memmra ne nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yesu hw[ me w] me fi,
\par na ]ma mifi adi;
\par nanso daa ]ma ne nguammaa a
\par wodi n'akyi aduan pa
\par na s[ osuk]m de m'  a
\par ]kyer[ me n'abura.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Enti m'ani begye daa 
\par s[ way[ me n'aguamaa. 
\par Nanso nna pa yi akyi no, 
\par ]b[ma ne sor' ab]fo 
\par ab[fa me afi ha 
\par ak]tena ne nky[n h] daa.\f1 
\par \pard\lang2057\f2 
