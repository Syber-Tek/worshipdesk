\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame, wone m'Agya pa a
\par woma me nea ehia;
\par wo dom no nti s[ mehome a,
\par me nkwa no w] wo nsam koraa.
\par Wode me baa asase so, 
\par wod] me na wohw[ me so. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mma nea me honam hwehw[ no
\par ne nea [y[ honam d[ 
\par mm[twe me nnk]hwe b]ne bi mu, 
\par na mank] daa amane mu.
\par Ma menkae w'as[mpa ara, 
\par na ma minni wo mm'ra so daa!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mma memmpene m'ak]nn] no da,
\par na ma minkyi aguamamm];
\par yi adwemm]ne fi me tirim nso
\par ne as[ntantan fi m'asom:
\par na ]bonsam ne n'afiri
\par anyi me na wans[e me da.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yi b]nep[ fi me koma mu
\par na ma [ny[ w'as]redan;
\par Agya, ma m'aso ne m'aniwa 
\par ne m'ano ne me t[kr[ma 
\par ne me honam ade nyinaa 
\par ny[ wo de, na asom wo daa!\f1 
\par \pard\lang2057\f2 
\par }

