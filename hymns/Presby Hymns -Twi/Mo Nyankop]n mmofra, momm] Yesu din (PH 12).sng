\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mo Nyankop]n mmofra, momm] Yesu din;
\par monkamfo mo Wura w] wiasefom;
\par Munyi mo Agyenkwa ay[ w] mo mu;
\par ]se s[ mosom no, hy[ no anu'nyam.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyame di hene ]soro h] daa, 
\par nanso wab[hw[ y[n, n']te y[n mu daa.
\par Onyame Ba Yesu abedi nkomm, 
\par na wagye y[n w] b]ne ne satan nsam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na enti n'asafo da no so ase, 
\par na w]ka s[ ne mu na y[anya ogye.
\par ]soro ab]fo to Yesu ho dwom; 
\par na saa n'[s[ ne mma w] wiase ha. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \{no nti na momma y[mmata ne ho, 
\par na y[ne n'ab]fo no mmedi no ni.
\par Yeyi n'ay[ daapem, y[kamfo no daa, 
\par y[bom to Halleluya ne Amen dwom. \f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

