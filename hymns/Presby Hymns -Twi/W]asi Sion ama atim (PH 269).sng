\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. W]asi Sion ama atim;
\par esi botan so n' [nhwe ase.
\par Nyame so na w]de atim.
\par Osuro biara nni h],
\par enti s[ wiase s[e po a,
\par [h] anigye w] h] daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yehowa ne n'aban,
\par ]y[ ne Dimafo\tab ,
\par ne ne Gyefo.
\par \}no n']ma nnipa tumi,
\par na odi ma ne mma nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea onim Awurade no
\par benya nhyira w] Sion man mu,
\par n']b[y[ mu nnepa difo.
\par Ne mu na nkwa nsu befifi,
\par na ne mma nyinaa ho b[san w]n,
\par efis[ Awurade nim w]n,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Asetena pa w] h],
\par woyi ne din ay[
\par Halleluya.
\par Momma y[mfa anigye mmra
\par na y[ny[ Sion man mufo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. W]n a w]w] akyiri no behu
\par Onyame aho]den, na w]aba
\par n'abobo ano. \{ho na 
\par wobenya nnepa, na w]n a 
\par wodi w]n ho so benya nkwa 
\par pa w] Yesu mu\tab 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, Yesu, Nyame Ba,
\par wone y[n Gyefo no.
\par Hosiana.
\par Wiasefo b[te w'asem
\par na w]aba w'anuonyam mu.\f1 
\par \pard\f2 
