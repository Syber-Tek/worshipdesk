\par 1. Daakye bi, Daakye bi
\par ogya b[hyew wiase 
\par te s[nea nsu yirii no,
\par na [s[ee honam nyinaa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Aso]den asotwe no 
\par Saara na w]de gya hehyew no. 
\par Da bi h], Da bi h]
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me Nyame!, Me Nyame!
\par ma meny[ ]treneeni 
\par na s[ wiase nya hyew a, 
\par ma meny[ s[ Noa bi,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na me nso manya wo daa nkwa, 
\par na agye me w] daapem s[e mu.
\par Gyefo pa!, Gyefo pa!\f1\fs22 
