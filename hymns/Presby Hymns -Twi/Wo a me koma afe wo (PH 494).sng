\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Damfo Yesu, ma minhu wo! 
\par me kra reham hwehw[ wo, 
\par s[ nnyaw me nnto me b]ne mu, 
\par dan b[hw[ me mm]bor].
