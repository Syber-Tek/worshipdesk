\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n ne m'Adepa,
\par ]kyen fam ha nnepa koraa;
\par ]hw[ me, gye me, tew me ho;
\par mede me ho me to no so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}ne me Hann ne me Nkwagye;
\par me Botantim, m'Abank[se,
\par m'Aho]den, me Boafo ,
\par me Ky[fa a m'ani da so.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ose wo a wunim me din 
\par na wop[ se wofra me mmam, 
\par su fr[ me, na megye wo so,
\par magye wo, na mama wo so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Meyi wo w'ahohia mu 
\par na mahy[ wo anuonyam 
\par M[ma woadi nkwa pa amee,
\par na mama woahu me nkwagye.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Onyame, s[ wo din te no 
\par s[ w'ayeyi nso te ne no.
\par Ma amansan nhu wo din [,
\par na w]n nyinaa mmra w'ahennim.\f1\fs22 
