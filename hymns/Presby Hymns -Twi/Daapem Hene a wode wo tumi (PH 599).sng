\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Daapem Hene a wode wo tumi
\par kyer[ wim ab]de horow no kwan
\par wokyer[ aman kwan gye w]n sum
\par na wode w]n ba adekyee hann 
\par Bedi y[n komam hene nn[ ne daa,
\par na woakyer[ y[n kwan ahy[ y[n den
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wonam wo d] so de y[n aye mma
\par wo Bakoro no ay[ y[n nua.
\par O, Honhom Pa, fi soro bra y[n so;
\par B[tena y[n komam na y[ y[n baako.
\par Ma y[ne wo ny[ baako s[ Agya,
\par na y[ne Wura Yesu ny[ baako 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[de nkabom bekyi nea enye,
\par na y[ay[ baako w] papaye mu
\par Y[b[y[ baako w] anigye mu
\par na awer[how mu, y[b[y[ sa.
\par Y[de biakoye mu tumi no
\par b[kyer[ mmofra na w]adi w'akyi
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Awurade, fa w'akode dura y[n
\par ma wo d] ny[ te s[ y[n nkatabo
\par ma w'as[m nhy[ y[n den daa nyinaa 'ra.
\par Ma yennyi nkonim a efi wo p[n;
\par ma yenni yaw anaa d[ s[ wop[ no
\par na y[mfa nhu s[ y[y[ w'asomfo\f1 
\par \pard\lang2057\f2 
\par }

