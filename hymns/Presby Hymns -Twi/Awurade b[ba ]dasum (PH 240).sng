\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade b[ba ]dasum, 
\par Ses[[ de, [y[ dinn. 
\par Me de, misiesie me ho, 
\par na mahyia no nt[m.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yesu aka n'as[m. ansa,
\par wahy[ ne da dedaw; 
\par nnipa ani nni so koraa a, 
\par ]b[ba aworaw.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wiase ani afura,
\par w]da w]n b]ne nna;
\par wose: Ne da mm[n koraa, 
\par na b]ne bi remma.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Monw[n na munsiesie mo ho, 
\par na moy[ ne nkoa!
\par Mo Wura ba a, ]b[fr[ mo
\par mo ma moabu akontaa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Yesu, b[kanyan me koma,
\par na mma mennt] nko da;
\par na ma m'ani nhw[ wo sanba 
\par ne w'ahenni no kwan.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Woreb[ba s[ anyinam
\par abeyi nnipa hu,
\par ama w]n anigye adan
\par awer[how ne su.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Na wo nokware nkoa no 
\par benya abotoyam, 
\par na wob[fr[ w]n ma w]aba wo
\par soro anikam.\f1 
