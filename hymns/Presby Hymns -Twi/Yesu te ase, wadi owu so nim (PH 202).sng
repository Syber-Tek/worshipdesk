\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu te ase, wadi owu so nim, 
\par was]re afi ne dam.
\par Yesu te ase, wadi bonsam so nim,
\par was]re afi ne dam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu nwow]e, owu, owu w] he?
\par Owu w] he? 
\par Owu akyi asaman nso, asaman nso w] he?
\par Owu w] he? 
\par Hw[, Yesu te ase, Yesu te ase, 
\par Yesu te ase ne manfom nn[,
\par na wanyan afi ne dam.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yesu te ase, minsuro wu bio,
\par ]rennyaw me w] me dam.
\par S[ me honam hu amane mpo a,
\par mes]re mafi me dam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu nwow]e, owu, owu w] he?
\par Owu w] he? 
\par Owu akyi asaman nso, asaman nso w] he?
\par Owu w] he? 
\par Hw[, Yesu te ase, Yesu te ase, 
\par Yesu te ase ne manfom nn[,
\par na wanyan afi ne dam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yesu te ase, Nyame mma
\par momm] ose; was]re afi ne dam.
\par Wadi kan k] mo fi, n' ohyira se:
\par Asomdwoe n'[nka mo daa!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu nwow]e, owu, owu w] he?
\par Owu w] he? 
\par Owu akyi asaman nso, asaman nso w] he?
\par Owu w] he? 
\par Hw[, Yesu te ase, Yesu te ase, 
\par Yesu te ase ne manfom nn[,
\par na wanyan afi ne dam.\f1 
\par \pard\f2 
