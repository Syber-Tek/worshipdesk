\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \{b[y[ d[n mpo na menya
\par m'Agyenkwa mogya ho mfaso?
\par Me a me b]ne hy[[ no yaw,
\par na[de no k]] wu mu no?
\par Anwonwa d] b[n ara ni
\par se Nyame bewu ama me!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ne d] a [boro so no
\par ma ogyaw soro ahengua.
\par ]de d] paa ne ho akyi,
\par na obewu maa Adam mma.
\par \{y[ ahumm]b] ne dom
\par na ]nam so de hwehw[[ me.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. B]ne sum ne mu nnwuma no
\par faa me honhom dommum koraa,
\par na wo hann maa sum no yerae.
\par Minyane, na sum bi nni h],
\par na me mpokyer[ no san gui,
\par [nna mes]re dii w'akyi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Minsuro afobu bio;
\par Yesu ne m'adem adepa;
\par ]ne ne me nkwa nnyinaso.
\par Trenee b[y[ m'adurade 
\par w] daapem agua no anim,
\par na menya Kristo ahenkyew.\f1 
\par \pard\f2 
\par }

