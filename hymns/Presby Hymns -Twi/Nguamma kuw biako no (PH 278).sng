\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nguamma kuw biako no,
\par ]hw[fo koro n' ]y[n w]n.
\par S[ ne here du so a,
\par asase benya ahosan.
\par S]re na wo hann nhyer[n;
\par Yesu b]hy[ b[ba mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Sraani, so ade nkyee [?
\par anim gu so retetew po,
\par na Yehowa wia hann 
\par repue amanaman so,
\par na nnipa ahu ade. 
\par Yesu b]hy[ b[ba mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Bra, oguanhw[fo pa no; 
\par ma sum kabii nnan awia. 
\par Nguammaa a w]ayera no, 
\par bra na b[hwehw[ w]n bra mu. 
\par Kuw ketewa, munnyina; 
\par \}hw[fo pa w] mo nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Hw[, adekyee hann reba,
\par na owia hann ma sum guan. 
\par Wura mu mmoadoma 
\par reb[kotow nsubura ho; 
\par ade kye w]n w] h]nom. 
\par Yesu asem tim h] daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Adamoa bebue,
\par na nnompe b[keka w]n ho
\par na w]as]re afi dam.
\par Awurade da k[se no mu.
\par Yesu na waka n'as[m
\par ne b] a wahy[ no mu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. O, s[ da k[se no du a,
\par Yesu Kristo, y[ y[n wia.
\par B[hyer[n asase so,
\par na nnipa anya hann ne nkwa,
\par fi nn[ akosi da a
