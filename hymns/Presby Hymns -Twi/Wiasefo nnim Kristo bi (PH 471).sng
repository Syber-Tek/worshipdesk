\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Wiasefo nnim Kristo bi,
\par na wonni ne honhom; 
\par na w]n a wogye Yesu di
\par nya ne nkwa ne ne dom.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]n honhom hu no s[nea 
\par ]s[n dua no ho; 
\par wonya ne mogya mu mpata 
\par ne n'ak'rum asomdwoe.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[n Yesu ne Onyame Ba, 
\par Y[n Wura a ogye y[n 
\par w] b]ne ne ]bonsam nsam, 
\par n' ]ma y[ba ne nky[n. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Y[n na kan y[y[ nkwasea, 
\par y[nnim Onyame kwan; 
\par y[n nyansa ne aho]den 
\par ne Kristo ne n'as[m.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Y[n na y[y[ nneb]n'y[fo,
\par na n'abufuw s[ y[n,
\par na Kristo nam ne mogya so 
\par b[y[[ trenee maa y[n.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Na y[y[ nnipa hunu nso, 
\par ne nkwa no ab] y[n, 
\par na y[n ahotew ne Kristo,
\par ]tew y[n mu kronkron.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Daakye na ]b[ba bio 
\par w] n'anu'nyam k[sem, 
\par abebu ateasefo 
\par [ne awufo nt[n.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. O, Yesu, ma minnye wo nni
\par na ma minni w'akyi,
\par na mamma w'atemmu no mu,
\par \pard\sa200\sl276\slmult1 na maba w'anigyem!
\par \f1 
\par \lang2057\f2 
\par }

