\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nkonim! S[nea w]bom nn[; 
\par ]kofoni ako ama y[n, 
\par na nkwa ayi owu so d]m. 
\par Agyenkwa amane asa; 
\par ne nkwa awie y[n wu mene. 
\par Owu, wo ano nnam akum. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0\i 
\par Y[n nkwa \}hene no 
\par afi ne dam aba; 
\par was[e y[n wu 
\par ne asaman aho]den. 
\par \i0 Y[n Gyefo ni! Y[da w'ase! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. N'atamfo nyinaa hy[ n'ase! 
\par Na wontumi nyi y[n hu bio, 
\par na wonni y[n so tumi bi. 
\par Y[n abank[se ne wura a 
\par wap[tew w] no ti ama y[n, 
\par enti y[n ho asan koraa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0\i 
\par Yesu de ne mogya
\par atua b]ne ka,
\par na daa mpata
\par w] h] ma y[n; y[de y[n ho, 
\par \i0 n'afei y[fra n'adehye mu. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ nneb]ne how y[n wer[, 
\par na y[n koma nso bu y[n ho f] a, 
\par y[n Wura du trenee br[ y[n. 
\par Nyame di no ho adanse 
\par s[ vvapaae nc Ba nney[e, 
\par enti wahy[ no anu'nyam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0\i 
\par Nneb]ne fafiri,
\par ne daa ahodwo no 
\par n']de ky[ y[n; 
\par y[n ani gye, yeyi n' ay[, \i0 
\par s[ y[anya Nyankop]n trenee. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nyame awufo b[s]re
\par na w]n amu anya nkwa bio, 
\par efis[ Kristo benyan w]n. 
\par Na ]da renyi y[n hu da, 
\par yebu no s[ y[n homebea, 
\par na Yesu dii awufo kan. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0\i 
\par Enti ]de twe w]n
\par s[ wommedi n'akyi
\par w] ne hann mu.
\par Y[n Hene pa, dom fa wo nkwa
\par \i0 ne w'anu'nyam b[hy[ y[n ma! \f1 
\par \pard\f2 
