\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Abosomfo rewie hyew!
\par w]n mpemmpem retwa mu ak], 
\par O, Kristofo, monka mo nsa, 
\par munnye w]n mma w]n Agyenkwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ mop[ w]n nkwagye de a, 
\par momfa ]d] mu adwuma,
\par yiw, momfa mo nkwa mpo nsi so,
\par na momfa nkamfo Yesu d].\f1 
\par \pard\lang2057\f2 
\par }

