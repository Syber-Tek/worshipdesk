\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nea Onyame y[ n' eye! 
\par N'ap[de nam ne kwan mu; 
\par na s[nea ]ye n'ade fa, 
\par mep[, mey[ komm w] mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me Nyame a ogye me nkwa 
\par w] wiase amanem, 
\par ]no nko na mehw[ no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea Onyame y[ n' eye! 
\par Na onsisi ne nk'r]fo, 
\par na ]kyer[ me kwantrenee; 
\par m'ani gye w] ne dom ho, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na metw[n no; ]no b[hw[ 
\par atwa m'amane to p[ 
\par ama asi me yiye.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nea Onyame y[ n'eye!
\par Onnyaw me nko w] yaw mu; 
\par me Yaresafo pa ne no, 
\par n'aduru ne daa nkwa no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}ma n'as[m bam w] me ho, 
\par na mede me ho mato 
\par n'ayamye ne ne dom so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nea Onyame y[ n' eye! 
\par ]ne me hann ne me nkwa; 
\par ]mp[ s[ b]ne ba me so; 
\par m'ani da ne nkutoo so
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w] anigye ne ahohiam; 
\par ne papa a osusui no 
\par b[da adi w] gua so.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nea Onyame y[ n' eye! 
\par S[ me k'ruwam y[ nwene, 
\par na me kra wer[ how ho a, 
\par memma enyi me hu pii.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hw[ daakye bi m'ani 
\par begye na me wer[ akyekye, 
\par na me yaw adan yiye.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Nea Onyame y[ n' eye! 
\par As[m yim, na mikurae;
\par s[ mew] ahohia mu 
\par n' owuyaw ba me so a, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyankop]n ne m'Agya pa, 
\par mey[ ne ba a ]d] no; 
\par ma ]ny[ s[ ]pe no!\f1 
\par \pard\lang2057\f2 
\par }

