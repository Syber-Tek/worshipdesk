\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nyame na ]b[y[!
\par Mede me ns[m nyinaa ahy[ ]no nsa.
\par Ne p[ nti n' ]faame 
\par ansa na w]woo me baa wiase ha.
\par Na s[nea ]p[ no, 
\par ]de nea ehia me ma me w] wiase. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nyame na ]b[y[; 
\par wama m'ani agye, manya bot]yam.
\par Ne wer[ remfi me,
\par aduan ne ntama, n' osiesie ma me.
\par M'as[ndua k[se no,
\par s[ [y[ duru dodo a, ]no na ogye me.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nyame na ]b[y[;
\par ma aprannaa mpaapae, na ahum nso ntu,
\par na [po nso nyiri;
\par na [nworo dennen, ]ne me w] h]. 
\par Yona dii nnansa w] mu. 
\par Enti s[ amane to w' a, Nyame kura wo mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nyame na ]b[y[;
\par osusuw na ]hw[, w'ahokyere mu.
\par S[ w'amane no mu,
\par wo koma tutu a, w'Awurade no
\par w] wo nky[n, na ogye wo 
\par [nde hu biara betu, te s[  omununkum.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nyame na ]b[y[;
\par nea ]y[ mmer[w, tumi b[d]]so.
\par Nyame ad]fo mu 
\par hefo na w]yerae, ahokyere mu?
\par Nnwen amanehunu ho;
\par ade nyinaa w] Nyame nsam; n'ap[de nyinaa ye.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Nyame na ]b[y[; 
\par ]domankoma 'wu, bue n'ano yaa 
\par wo nkwa nna bere mu, 
\par owu to wo nt[m a, obenyan wo kra 
\par de woak] ne nky[n ]sor', 
\par na wo amu no koraa mpo, renhu da mu por]wee.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Nyame na ]b[y[. 
\par Wadi ]bonsam so, as[e ne tumi.
\par Agya Nyame mma no
\par fa kwan kusuu no so, ma [y[ nwonwa; 
\par anigye ne aw'r[how, 
\par ne nyinaa w] ne tumi mu!, Awurade no b[y[!\f1 
