\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Awurade, w'as[m nti,
\par wugye y[n fi atamfo nsam.
\par W]n a w]nam Yesu kwan so , 
\par remfi n'ahengua no ho da.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O, Wura Yesu, w'anu'nyam
\par b[da adi ama y[ahu.
\par B] w'asafo kumaa ho ban,
\par na wanya daapem ahot].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. O, y[n Nyame Honhom Kronkron
\par dom kyekye wo mma wer[ daa.
\par Ma y[n koma ny[ biako,
\par na gye y[n fi owu s[e mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. O, Wura, hw[ w'asafo mma;
\par fi wo d] no mu dwen y[n ho.
\par Dom ma y[n gyidi mu ny[ den,
\par siw atamfo kwan w] y[n ho. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Atamfo s]hw[ b[y[ kwa,
\par [remfa y[n nkosi baabi.
\par W]n mfiri a w]asunsum no,
\par w]n ankasa b[tot] mu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \{nna nnipa nyinaa behu
\par s[ wo, y[n Nyame, w] h] daa.
\par Wob] wo mma ho ban yiye 
\par efis[ wo na w]hw[ wo.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. \{nna wo mmabehyira wo,
\par wo Agya, \}ba ne Honhom,
\par Onyame Baasakoro no;
\par wow] h] nn[ de kosi daa.\f1 
