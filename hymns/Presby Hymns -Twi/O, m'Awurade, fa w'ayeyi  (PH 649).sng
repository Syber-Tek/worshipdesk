\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, m'Awurade, fa w'ayeyi 
\par hy[ me koma mu daa; 
\par ma m'asetena nyinaa nkyer[ 
\par s[nea w'ap[de te.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. M'anom ]y[yi renn]]so, 
\par me komam nso saa 'ra; 
\par Me nkwa nyinaa mu ayeyi 
\par na ma [ny[ wo de.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wiase ade biara
\par yi w'ayeyi adi;
\par dwuma k[se ne ketewa
\par ma w'ayeyi da 'di.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma m'asetena nyi w'ay[ daa,
\par na me su nyi w ay[; 
\par me mmer[wy[ nyinaa mu no, 
\par ma menkyer[ wo d]. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Me nky[n ara na wohwehw[ 
\par wo anu'nyam ne nidi; 
\par enti mete wiase yi,
\par m[to wo dwom pa daa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Awia ana anadwo
\par rensiw w'ayeyi kwan;
\par me fam ha kwan nyinaa mu no,
\par \pard m[tena w'ay]nkofam.\f1 
\par \lang2057\f2 
\par }

