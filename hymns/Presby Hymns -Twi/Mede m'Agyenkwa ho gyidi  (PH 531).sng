\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mede m'Agyenkwa ho gyidi 
\par menam soro kwan no so. 
\par Midi me Hw[fo pa akyi; 
\par odi m'anim hw[ me so. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mitu me kwan s[ sare so;
\par nnipa pii kyinkyin h] kwa. 
\par Me kwankyer[fo ka me ho, 
\par mehw[ no a, menyera. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Atamfo pii resiane me,
\par na w]asum me afiri; 
\par nanso me Gyefo pere me, 
\par ]mma wonnya nea w]p[. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Midi n'akyi, na menhwehw[ 
\par adefunum anigye; 
\par na mmom, nea mehw[ ne s[ 
\par Yesu bewie me nkwa gye.\f1 
\par \pard\lang2057\f2 
\par }

