\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade, mey[ mm]bor]! 
\par Kyekye me wer[, taa me bo! 
\par Mede m'amane nyinaa ara 
\par ne nusu meba w'anim ha! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wuhu me s[ mete ara, 
\par wunim me mu sen m'ankasa. 
\par Medan mefa baabiara a,
\par me ho rennwo me ara da. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Gye s[ wo, Yesu, wugye me 
\par na minya wo h] fafiri. 
\par O, Yesu, hw[ me mm]bor]; 
\par sakra me y[ me foforo.\f1 
\par \pard\lang2057\f2 
\par }

