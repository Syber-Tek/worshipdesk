\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nyame, wo tumi so, w'ab]de y[ hu;
\par w'apranaa bobom, w'anyinam paapae.
\par Yi w'ahumm]b] kyer[ y[n nnipa mma.
\par O, Nyankop]n, ma y[n w'asomdwoe.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nyame, w'ad]e d]]so ma wiase mma;
\par ma wonhu wo yiyey[ ne wo dwo.
\par T] wo bo ase, na sianka w'abufuw.
\par O, Nyankop]n, ma y[n w'asomdwoe.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nyame, w'akwan ho tew; sum p[ as[e-no;
\par nanso w'as[m mu tumi hwete mu.
\par Nnaadaas[m ne b]ne de, [remm[n wo.
\par O, Nyankop]n, ma y[n w'asomdwoe.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na wo nyansa mu d]; wo nteeso pa
\par de wiase bedu wo trenee mu.
\par W'ahenni bepue sum kabii no mu.
\par O, Nyankop]n, w'asomdwoe b[ba.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wo mmofra b[som wo; w]b[da w' ase,
\par efis[ woagye w]n w]n haw mu.
\par W]b[to wo dwom w] w]n nkwa nna nyinaam.
\par Wo d] no nti, ma y[n w'asomdwoe.\f1 
