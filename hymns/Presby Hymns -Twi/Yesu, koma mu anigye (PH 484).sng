\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, koma mu anigye 
\par daa asuti ne nnipa hann. 
\par Y[pa wiase anigye, 
\par na y[de ]kom ba wo nky[n. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo nokware fi w] h] daa; 
\par wugye w]n a w]ba wo nky[n. 
\par Wohu wo d] ne w'ayamye, 
\par na woy[ w]n ade nyinaa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Woy[ y[n daa nkwa abodoo, 
\par na y[n k]n d] s[ yedi bi. 
\par Y[nom no mogya bobesam 
\par na y[de kum y[n kra suk]m
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Y[n honhom pere hwehw[ wo 
\par bere a y[afi wo nky[n no. 
\par Yehu wo a, y[n ani gye; 
\par yegye wo di a, y[n ho san. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. O, Yesu, dom tena y[n nky[n daa, 
\par na dwudwo y[n asetena mu. 
\par Pam b]ne sum no fi y[n so, 
\par na ma wiase nhu wo hann.\f1 
\par \pard\lang2057\f2 
