\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Wuhu me b]ney[fo mm]b], 
\par woagye me a mens[ koraa; 
\par saa gye k[se yi y[ me nwonwa
\par na me koma mpo nhwehw[e da; 
\par nanso m'ani gye ho daa nti
\par mekamfo mm]b'r]hunu yi. :/:
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyame abufuw n' [s[ me; 
\par na ]no de, ]dom me pii; 
\par ]no na wapata ama me, 
\par na ne Ba mogya tew me ho
\par \{d[n nti na ]y[ me s[[? 
\par \{y[ ne mm]b'r]hunu nko. :/:
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Eyi ho na midi adanse 
\par w] Nyame ne nnipa-anim; 
\par mimmu me ho s[ minim 'de bi, 
\par gye n 'ahumm]b] no nkutoo; 
\par meda n' ase, miyi n' ay[, 
\par ne mm]b'r]hunu y[ me de: /:
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Eyi n' obi rennye me nsam da, 
\par eyi nko na m[kamfo daa; 
\par menam ne mm]b'r]hunu no so
\par migye midi na meb] mpae; 
\par amanehunu ne owu mu, 
\par na mede me ho m[to so. :/: 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}dom ne mm]b'r]hunu Nyame 
\par nyi wo dom mfi me so ara. 
\par Ma memfa wum memmra wo nkwa mu
\par w] m'Agyenkwa no wu no nti; 
\par [nna m'ani begye koraa, 
\par m[kamfo w'ahumm]b] daa. :/: \f1 
\par \pard\lang2057\f2 
