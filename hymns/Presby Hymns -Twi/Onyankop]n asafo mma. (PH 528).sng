\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n asafo mma.
\par munyi mo ho adi!
\par \}hene Kristo retu sa,
\par na mo ne no nk] bi!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wasi ne hen' frankaa,
\par way[ [ho fitaa,
\par as[ndua bea mu k]],
\par wama so de rek].
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na s[ moy[ n'asuafo
\par sua kyer[ no a,
\par ]de mo fra n'asafo mu
\par na ]ne mo k] sa.
\par \cf1\ul\b\'b6 
\par \cf0\ulnone\b0 Wotu ne sa no d[n?
\par Na wonya ade b[n?
\par \}hene tamfo no w] he?
\par Na w]reko w] he?
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ wok]som saa Hene n' a,
\par ]hy[ wo ne trenee, 
\par na ]ma wo ne honhom 
\par pa de hy[ wo den yiye. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo nsu ne w'aduan 
\par ne ne nkwagye as[m 
\par na n'ahenni mu daa nkwa no
\par b[y[ w'akatua.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}ko no, [w] wiase,
\par ]tamfo ne bonsam;
\par ]de ne nnaadaa n' egyigye
\par nnipa w] w]n komam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ne bo afuw wo s[;
\par ]ko kosi ase;
\par na enti som Yesu koraa
\par na woatumi no daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{se s[ wo ne b]ne ko,
\par wo Hene hy[ wo sa;
\par na enti di n'as[m no so,
\par di n'akyi ko ko pa,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na so no mu ara,
\par na di nokware daa;
\par wo ho akyi a wob[pa,
\par benya n'akatua.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Hw[ s[ wo Hene ankasa
\par adi n'asafo kan;
\par ]faa ]br[ ne wum ara
\par kogyee n'anuonyam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}n'na ]boa wo,
\par na ]de ne somfo
\par b[k] ne soro anu'ny anu'nyam
\par ne daa ahomekam.\f1 
\par \pard\lang2057\f2 
\par }

