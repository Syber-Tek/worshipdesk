\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me Nyankop]n ho y[ nwonwa,
\par ne k[sey[ ho tew;
\par ne dom agua no hyer[n s[;
\par ne hann no rennum da.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Woy[ daapem, daapem Nyame,
\par wo nna to rentwa da;
\par ahonhom koto s[re wo,
\par awia ne anadwo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nanso metumi mad] wo
\par suro wo, d] wo s[;
\par na mede ahopopo nko
\par ne nusu nso som wo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nanso metumi mad] wo
\par s[ wo k[sey[ te,
\par efis[ woadi kana ba
\par hwehw[ me komam d].
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Agya bi d] nto wo d] da,
\par [na d] nto wo de,
\par s[ ]b[t] ne bo ase
\par s[ woy[ ma me yi.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Agya a wode Yesu mae 
\par s[ wo d] so ade,
\par s[ woma midu soro a,
\par m[hw[ w'anim daapem.\f1\fs22 
\par \lang2057\f2\fs24 
