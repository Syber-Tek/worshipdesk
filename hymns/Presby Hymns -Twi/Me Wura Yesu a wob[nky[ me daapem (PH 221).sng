\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me Wura Yesu a wob[nky[ me daapem,
\par na wo ad]e no dwudwo me koma.
\par Wode wo dom hw[ me ma me ho t] me,
\par na me honam ne kra ho nso asan nie.
\par Meda w' ase, meda w' ase.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{wom yentumi mfa y[n honam ani yi
\par nhu wo anim a [hyer[n kronkron no,
\par nanso y[n kra hu wo, na yehu wo d] no.
\par Wode wo d] hyirahyira w]n a wonhu,
\par na wogye di, na wogye di.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{s[ s[ daa adekyee ne daa adesae nso
\par y[kae w'ahumm]b] k[se ne w'ad]e.
\par S[ obi kae wo saa a, [y[ ampa s[
\par n'Agyenkwa d] ne n'animtew no b[mee no
\par Nyame ye daa, Nyame ye daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Y[da so te fam ha yi, Owura Yesu,
\par ma yennya w'ahumm]b] ky[fa nso bi,
\par na hw[ y[n koma so ma [nna wo nko so,
\par na y[n adwene ak] wo ad]e no so,
\par na y[ammr[ da, na y[ammr[ da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. O, ma y[ntena wo ay]nkofa mu daapem,
\par ma y[nk] so w] w'akyidi mu ara.
\par Ma y[ny[ s[ mma y[, na ma y[n ani nnye,
\par  na ma yenso wo mu yiye nkosi ase.
\par Yesu, gye y[n, gye y[n koraa.\f1 
\par \pard\f2 
\par }

