\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \{hena ho na m'ani gye?
\par \{y[ m'Aw'rade Nyankop]n.
\par \}ne m'ade nyinaa 'ra.
\par Me ky[m a [kata me so, 
\par me hann a [ma sum mu tew 
\par ne m'asetena awia.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wop[ fam ha anigye bi 
\par akyi kwan a, enni baabi,
\par gye me Nyame ne ne d] mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{hena ho na m'ani gye?
\par \{y[ m'Aw'rade Nyame Ba.
\par \}ne me kwan ne me nkwa.
\par Me yare b]ne safo pa, 
\par me hia mu ahode pa, 
\par m'amane mu Dimafo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me nneb]ne ho mpata no,
\par me trenee pa, m'aduan pa 
\par w] m'Agyenkwa pa no nko mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{hena ho na m'ani gye?
\par \{y[ Onyame Honhom pa, 
\par Yesu de no aky[ me.
\par \}ne kyer[kyer[fo pa, 
\par na ]kyekye me wer[ daa, 
\par ]hy[ me den, te me mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nimde[, nyansa, afotu pa,
\par nokwas[m pa ne ahotew 
\par w] Honhom Kronkron no dom mu.\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

