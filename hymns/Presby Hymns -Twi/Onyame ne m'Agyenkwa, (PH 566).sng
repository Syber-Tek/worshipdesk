\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame ne m'Agyenkwa,
\par minsuro tamfo bi;
\par ]no tie me mpaeb],
\par ma me wer[ kyekye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ose: Moy[ me nguan a,
\par muntie m'as[m nko, 
\par na me nso m[pam w]n a 
\par w]p[ s[ w]s[e mo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Minim eyi nokwarem
\par na [ma m'ani ka, 
\par s[ Nyame Tweduamp]n 
\par na ]hw[ me so daa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]n' na ogyina m'akyi;
\par ]pam m'atamfo d]m; 
\par ]ka me ho, ogye me,
\par ]p[ s[ metena komm., 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Miyi me Yesu [y[,
\par mehwehw[ n'adepa
\par s[ Yesu ny[ m'Adamfo
\par na onni me mu a,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par merentumi minnyina
\par ]temmufo anim,
\par na menya m'akatua
\par w] afobu gye nom.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu afa me b]ne
\par ne ho amane k];
\par me b]ne nti ohwiee
\par ne mogya no guu h];
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [no n']de hoh'ro
\par me honhom ho fitaa
\par ansa na me ho adwo,
\par na manya anika.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}no kyekye me wer[, 
\par ]ma me yaw no sa;
\par asase so amane
\par rentu me bo koraa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Honhom no di adanse 
\par kyer[ w] me komam,
\par s[ wiase amane
\par renky[n h] anu'nyam. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ma wiase yi mmubu,
\par me Yesu gyina h];
\par n'aho]den no nsa do,
\par nanso onnyae me d].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M'atamfo no rennye me
\par w] Onyankop]n nsam;
\par Yesu ho na mebata, 
\par na daa m[tena ne nky[n.\f1 
