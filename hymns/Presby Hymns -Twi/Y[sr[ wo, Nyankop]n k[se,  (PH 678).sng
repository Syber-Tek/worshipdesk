\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[sr[ wo, Nyankop]n k[se, 
\par ama ]man yi hene, 
\par s[ ma onhu wo nimde[ 
\par na ]mfa nni ne tumi! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma ]nkae wo ns[ntrenee no, 
\par n' ]ny[ nea wo, Nyame, p[ 
\par s[ wokyer[ no kw]n no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma y[n nso nhy[ n'ase daa yi, 
\par y[mfa ne nidi mma no, 
\par y[nni n'anim as[ntrenee, 
\par na y[ntena n'asomdwoe mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma Nyamesom pa ne bra pa 
\par ase ntim yiye w] y[n mu. 
\par Boa y[n y[ y[n yiye!\f1 
\par \pard\lang2057\f2 
