\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Ade baako na [y[ me f[ daa,
\par na [te s[ m'aduan,
\par na s[ saa ade no ka me nsa a,
\par mede f[w nam nusu bonm;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [ne s[, mehw[ m'Agyenkwa Yesu
\par s[nea me nti ohuu amane pii
\par w] Getsemane t'rom ho ne
\par Golgota koko so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Daa nyinaa m[kae no s[ oguamma a
\par mogya w] ne ho koraa,
\par s[ ]yarefo a ]y[ mm]b],
\par ]fam n'as[ndua ho;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]de ne suk]m peree me kra bi,
\par na w]nya me afra ne mmofra mu
\par na ose: 'W]awie' no, 
\par ]kaee me hiani nso.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. O, m'Agyenkwa d[[fo,
\par mma me wer[ mmfi
\par m'adebone ne wo dom;
\par bere a mete b]ne sum mu no,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na wot]] wo bo ase.
\par Wudii wo guan akyi ma [ky[e,
\par ansa na ]tee ne Hw[fo nne bi.
\par Wot]] me fii wiase maa nnwensa a [y[ na
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Mey[ wode, nanso woy[ me de,
\par Yesu, ma as[m yi mmram;,
\par fa wo din hy[ me komam denneenneen
\par na ay[ hyew aky[n gya.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me ne wo b[y[ s[nea wop[ daa,
\par na matena fam ha mawu maky[ wo.
\par Yesu, ma y[n asetena ne
\par apam yi nwie sa!\f1 
\par \pard\lang2057\f2 
