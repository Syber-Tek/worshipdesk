\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade, gye wiase nkwa. 
\par Wo mma su fr[ wo hw[ kwan s[ 
\par wobeyi w]n nkoasom mu 
\par ama w]ade w]n ho koraa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Awurade, gye wiase nkwa. 
\par Y[kwati wo a, y[ny[ hwee; 
\par nea y[n nyansa, nimde[ 
\par de ba no nky[ na asen k].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Awurade, gye wiase nkwa. 
\par Ehu ne ahomaso pii
\par akyekye y[n kra ne honam 
\par ama y[n ntam po atetew.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Awurade, gye wiase nkwa. 
\par Woama y[n Agyenkwa ampa. 
\par Y[n nti obehuu amane 
\par gyee y[n fii b]ne tumi mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Fa Yesu tumi gye y[n nkwa, 
\par na nnipa a w]ade w]n ho 
\par aboa na 'somdwoe aba 
\par ama wiasefo nyinaa.\f1 
\par \pard\lang2057\f2 
\par }

