\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me wer[ remfi Yesu,
\par na ne wer[ remfi me, 
\par ne d] a ]de d] me 
\par de gye me nkwa renhi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Medaa [yaw k[se mu,
\par ]n'na oyii me wom; 
\par na daa mihu d] foforo 
\par w] m'Agy[nkw] no d]m
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea wadom me saa no
\par menn] no bi ana? 
\par Obaa m'amanehunum
\par s[ minnya n'anika; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w]de no b]] wuduam',
\par oyii me mmusu k]e; 
\par na ofi soro fr[ me 
\par s[ mimmedi n'akyi. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Me yaw pii kaa no nti, 
\par na ]fa ]yawm' ara 
\par de daa nkwa ne ahot] 
\par br[[ me a memfra no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na daakye a mewu no,
\par ]b[te[ ne nsa, 
\par awaw me owu bon mu,
\par na me gyidi ansa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ne honam ne ne mogya 
\par na ]de ma me yi;
\par m'ahohora na wayi,
\par n'anigye hy[ me ma.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}p[ s[ ]de ne dom 
\par ne ne hann tena me mu; 
\par enti m[tena ne nky[n bi, 
\par na manya ahot].
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. O, Yesu, haran w] me mu 
\par anigye ne yaw mu; 
\par na ma menkae wo mogya a 
\par wuhwie maa me no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mede d] pa med] wo, 
\par m'ani da wo so daa. 
\par Ma minnu me fi pa h] 
\par na m'ani agye daa!\f1 
\par \pard\lang2057\f2 
\par }

