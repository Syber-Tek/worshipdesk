\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n mu na m[tena,
\par \}domfo a ohu mm]b] daa,
\par ne d] y[ kronkron n' [te[.
\par Hw[ s[nea me nneb]ne
\par ma midi yaw w] me koma mu,
\par efis[ emu y[ duru.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hw[ m'amanehunu,
\par wo dom no ab] me,
\par met] mu sin
\par W'ahumm]b] ne w] d] no 
\par ma mihu s[ memfata po. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fa me nneb]ne firi me.
\par Ampa, s[ wutua so ka a,
\par hena betumi w'abufuw? 
\par Wo d] no nti, wob] k]k], 
\par nanso komapirim w] h] daa; 
\par me de, wo nne na metie. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma me odwo koma;
\par Mete[m dennen s[, 
\par hu me mm]b]!
\par O, ma memmra wo pon no ho, 
\par na manya w'asomdwoe w] h].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Me de, magu me ho fi pii,
\par na wo nko na wubeguare me
\par ama me ho awie tew.
\par S[ woamma me aho]den
\par ahot], tumi ne honhom a, 
\par medi f] na mawu koraa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Enti mesr[ wo s[
\par ma minnya w'anim dom,
\par O, me Nyame!
\par Wo nko ara ne ]safo,
\par na woma me nkwa foforo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Baabiara a mek] no,
\par nea mete ne nea meda,
\par s[ minyan o, s[ meda o,
\par mete ase o, miwu o,
\par dom me, w] mm]bor]hunu nti;
\par na ma wo nhyira nni m'akyi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea mep[ ne s[
\par menya w'anuonyam 
\par nne ne daakye.
\par Me ho t] me w] Yesu mu;
\par ]no ne ]dom Wura no.\f1 
\par \pard\lang2057\f2 
\par }

