\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, m'Agyenkwa pa
\par daa damoa mu;
\par nanso ]b[s]re, ]renka wum.
\par Wanyan afi ]da mu,
\par de nkonim adi n'atamfo so!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}de nkonim s]re fii owu sum mu;
\par ]ne n'ahotefo te h] di ade. 
\par Was]re, was]re! 
\par Halleluya! Was]re! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]w[n m'Agyenkwa pa 
\par Yesu da no kwa; 
\par w]s]] ne da ano, na was]re. 
\par Wanyan afi ]da mu 
\par de nkonim adi n'atamfo so! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}de nkonim s]re fii owu sum mu
\par ]ne n'ahotefo te h] di ade. 
\par Was]re, was]re! 
\par Halleluya! Was]re! 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na owu antumi 
\par amfa m'Agyenkwa. 
\par Yesu, m'Awurade no adi so nim. 
\par Wanyan afi ]da mu, 
\par de nkonim adi n'atamfo so! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}de nkonim s]re fii owu sum mu;
\par ]ne n'ahotefo te h] di ade. 
\par Was]re, was]re! 
\par Halleluya! Was]re!\f1 
