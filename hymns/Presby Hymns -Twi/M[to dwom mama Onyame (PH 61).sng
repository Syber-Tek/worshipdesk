\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M[to dwom mama Onyame 
\par na mada no ase daa;
\par na mihu ade nyinaa mu
\par s[ ]p[ me yiye pa.
\par Ayamye ne mm]b'r]hunu ,
\par [ne d] ahy[ no ma.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}de d] hw[ ne mmofra 
\par w] w]n asetena nyinaa mu.
\par Nne[ma nne[ma sen ak]
\par na w]nne me Nyame d]
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nyame de ne nsa akata
\par me honam ne me kra so, 
\par s[ ]k]re ntaban a 
\par ]de tr[w ne mma so no.
\par Efis[ ]maa me me nkwa,
\par mew] me na yam no po, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [ne me nna nyinaa nso 
\par abedu nn[ na wahw[ me.
\par Nne[ma nne[ma sen ak]
\par na w]nne me Nyame d]
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ne Bakoro a ]d] no 
\par na oyii no mae maa me, 
\par s[ onnye me mfi me b]nem 
\par ne amanehunuk'rom.
\par Ampa, saa ]d] yi d]]so:
\par me honhom hwehw[ mu a, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par enhu ne nyinaa mu da;
\par enti na me nso med] no.
\par Nne[ma nne[ma sen ak]
\par na w]nne me Nyame d]
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ne honhom na ]de ma me 
\par s[ ]mfa n'as[m no so 
\par mmra me mu, na ]nkyer[ me 
\par kwan a [de k] soro, 
\par na ]mmetew me koma mu, 
\par na ]mma me gyidi a 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [d[d[w s[ kanea 
\par w] awer[how ne wu mu 
\par Nne[ma nne[ma sen ak]
\par na w]nne me Nyame d]
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}de saa hw[ me kra yiye;
\par na ]hw[ me honhom nso;
\par nea ehia me, onini 
\par ansa na mesr[ no po.
\par S[ m'aho]den no nn]]so, 
\par n'anka mehwe ase a, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]no Nyame no ara 
\par beso me mu ama me so.
\par Nne[ma nne[ma sen ak]
\par na w]nne me Nyame d]
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Meda a, Nyame na ]w[n me.
\par na ]hw[ me anadwo,
\par nanso ]ma ade kye me 
\par s[ minhu ne dom fof'ro 
\par S[ me Nyankop]n anhw[ me,
\par na wamfa me honhom pa 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ankyer[kyer[ me a, 
\par anka meyerae aky[ po.
\par Nne[ma nne[ma sen ak]
\par na w]nne me Nyame d]
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Yiw, Onyame d] no nsa da,
\par na ne d] no so ampa!
\par M'agya pa, meyi w'ay[ daa, 
\par na mesr[ wo s[ ]ba 
\par s[ fa me y[ wo de koraa, 
\par na ma minso wo mu daa 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par anadwo ne awia, 
\par na memfa wo kwan so yiye 
\par enkodu s[ mehu wo 
\par ne wo d] no ]soro!
\par \pard\lang2057\f1 
\par \cf1\lang1033\ul\b\f2\fs16 
