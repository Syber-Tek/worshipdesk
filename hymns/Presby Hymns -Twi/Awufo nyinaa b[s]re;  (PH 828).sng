\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awufo nyinaa b[s]re; 
\par Nyame Ba no b[fr[ w]n, 
\par na ne saa nti, w]n amu no 
\par benyan anya nkwa bio. 
\par \}ne Nipa Ba no nti, 
\par nnipa mma b[s]re bi.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na ebinom befi da mu 
\par ak] daa nkwa ne s]rem; 
\par na ebinom nso befi mu 
\par ak] atemmu s]rem'
\par S[nea y[n ha tena te,
\par s[.y[n wus]re te nen.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. W]n a w]agye Yesu adi
\par anya ne mogyam trenee, 
\par na ne honhom te w]n mu no, 
\par benya ne nky[n atenaye.
\par S[. w]n ti dii kan no nti, 
\par ]rennyaw w]n wo n'akyi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Daapem wu renhaw ne manfo, 
\par na w]n Wura hw[, w]n so; 
\par w]remma daa atemmu mu, 
\par na w]afi wum ak] nkwam. 
\par Woka w]n Agyenkwa ho; 
\par wodi ne nkonim no bi.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nyame honhom na awo w]n! 
\par Ne nkwa na [w] w]n mu; 
\par honhom no benyan w]n honam
\par na ahy[ no anuonyam 
\par Yesu hann no hran w]n mu, 
\par na w]ahran w] n'ahennim. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[nea Agyenkwa no 
\par nipay[ bewie nen. 
\par Y[n honhom, y[n kra, y[n honam 
\par n' ebenya ne mu nkwa no
\par na y[ay[ Onyankop]n
\par ne \}hene Kristo man.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Yuda Gyata, soro Hene, 
\par wo na woadi saa nkonim! 
\par Ma mempa wiase fi yi 
\par minni wo, m'Agyenkwa, 'kyi! 
\par S[ wo d]n k[se du a, 
\par nyan me honam fi ne dam!\f1 
\par \pard\f2 
\par }

