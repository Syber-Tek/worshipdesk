\par 1. Me honhom, ma w'ani nna h]
\par na da Onyame ase.
\par Kae ne yiyey[ ne n'ad]e
\par Nn[ da yi ne daa nyinaa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}de d] ne ayamye 
\par W[n me anadwo sum mu,
\par enti ]bonsam tumi no
\par rentumi nhaw me ara da.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. M'Awurade, wo din no mu
\par na m[hy[ me kwan ase.
\par Gye me koraa, na ma memfa
\par wo kw]n a eye no so,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par s[nea kanfo no y[e, 
\par na wodii wo mmra so no.
\par Ma menantew wo kwan so p[,
\par na madu soro fie h].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma y[n nyinaa ani nnyina 
\par soro kurow kronkron no. 
\par \{h] na ab]nefos[m, 
\par amane ne yaw bi nni. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{h] na wode ]d] 
\par Hw[ y[n ma y[n ho t] y[n.
\par Y[w] wo mu anidaso 
\par s[ wob[hw[ y[n nn[ ne daa. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[nea wo nhyehy[e te no, 
\par ma [nk] so saa ara. 
\par Nea m[k], nea m[tena, 
\par wo ara na kyer[ me. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par B] me ho ban w] ahum, 
\par aprannaa ne mframa ho. 
