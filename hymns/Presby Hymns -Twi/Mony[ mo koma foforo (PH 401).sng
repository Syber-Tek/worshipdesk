\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mony[ mo koma foforo, 
\par Awurade n'ose. 
\par Onyankop]n ahenni no
\par asi fam awie. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nneb]ne a y[y[ nyinaa, 
\par Nyame de aky[ y[n. 
\par Hw[, Onyame Oguammaa no, 
\par asoa ne nyinaa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yiw, Nyame de ne Ba koro 
\par sii y[n ananmu mae. 
\par \{no nti y[ank] ]s[e mu, 
\par na w]agye y[n nkwa mmom. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wasiesie daa nkwa bi 
\par ato h] ama y[n. 
\par Ampa,y[n Nyame d] y[n s[[;
\par saa n']d] wiase. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{no nti, momma y[nsakra,
\par na y[nkyi nneb]ne
\par Momma y[nsan y[n akyi nk]
\par soro Agya no nky[n. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. O, sakra me, me Nyankop]n, 
\par fa me b]ne ky[ me. 
\par O, fa me y[ wo ba bio, 
\par na ma minnya nidi.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Yesu, Onyame Guammaa no,
\par woatua me ka no. 
\par Dom twe, na memmra wo nky[n; 
\par ma minnya w'asomdwoe.\f1 
