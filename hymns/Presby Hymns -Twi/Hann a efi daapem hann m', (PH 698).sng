\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Hann a efi daapem hann m',
\par daa nkwa a [hran w] y[n so,
\par an]pa yi b[hyer[n,
\par yi y[n kra anifurae no.
\par Fa w'aho]den k[se
\par pam y[n sum.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma w'ayamye bosu no,
\par [nt] ngu kra ne honam so; 
\par ma asase a awo 
\par nnya wo h] awer[kyekye, 
\par na bedwudwo wo mmofra, 
\par daa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma wo d] k[se no nhyew 
\par y[n nney[e a womp[ no, 
\par na ma y[n koma mu ntew
\par s[ 'soro ani atew yi.
\par Na ma y[n nnyan ampa
\par mmenya nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Adekyee a efi sor'
\par da a edi akyiri no,
\par nyan y[n honam fi ne dam',
\par na yi haw nyinaa tow kyene,
\par na y[n ani agye daa,
\par w] w'anim.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Y[n dom wia, bra b[hran
\par y[n so, na kyer[ y[n kwan a
\par eyi y[n fi nusu bonm'
\par de y[n k] ahot] k'rom h];
\par [h] na y[n anika
\par rentwa da.\f1 
\par \pard\lang2057\f2 
\par }

