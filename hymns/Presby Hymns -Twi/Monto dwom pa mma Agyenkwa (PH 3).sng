\viewkind4\uc1\pard\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Monto dwom pa mma Agyenkwa
\par ]ne Yehowa!
\par Monna n'ase, munyi n'ay[
\par w] mmaa nyinaa.
\par \{s[ Kristo gyidifo 
\par S[ w]ma ne din no so.
\par Monna n'ase, munyi n'ay[, 
\par munhyira no daa!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Kristo manfo ne ne mpamfo 
\par ho ka w]n ho p[;
\par na w]n yie ne asomdwoe 
\par y[ w]n Wura f[.
\par ]d] ne mmofra papa, 
\par na wohu amane a, 
\par ]boa w]n ma w]tena komm, 
\par hye anu'nyam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ atamfo at'rosomfo 
\par d]]so pii nso a, 
\par Yesu mmofra bo rentu da, 
\par w]de few k] sa;
\par wokura anyamesem 
\par na w]b] mpae dennen nso, 
\par saa nkrante ne akode yi 
\par na w]de yi d]m.
\par \cf1\ul\b 
\par \'b6 Verse 4\cf0\ulnone\b0 
\par 4. Israelfo, Nyame nkr]fo!
\par mo ani nnye daa, 
\par se mo Y[fo ne mo Gyefo 
\par hw[ mo so yiye.
\par Mo a moy[ Sion mma, 
\par momma mo ani nka daa, 
\par s[ mo Hene anya tumi 
\par ]soro ne fam!\f1 
