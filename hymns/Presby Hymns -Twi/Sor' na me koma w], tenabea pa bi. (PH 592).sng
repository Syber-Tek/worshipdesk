\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Sor' na me koma w], tenabea pa bi.
\par Nneb]ne nni h] nom, dadwene nni h]
\par Hena na ]ne me, b[k] soro h],
\par nea y[n Nyame w], n' odi hene daa?
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n wura ne Kwan a, [k] soro h].
\par Yesu ne \}kwan no, enti fa no so.
\par Fa gyidi kora no, w] wo koma mu,
\par na ma ]nye wo de, na woay[ ne  ba\f1 
\par \pard\lang2057\f2 
\par }

