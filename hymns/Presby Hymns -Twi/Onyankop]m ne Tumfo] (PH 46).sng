\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]m ne Tumfo]
\par Mo nnipa, monhy[ n'ase!
\par \{hena na ]te s[ no?
\par N'anim n'ewie nyam y[.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par N e din ne ne nney[e so, 
\par munyi n'ay[, momma no so!
\par Monkamfo ne k[sey[!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ne nimde[, ne nyansa so,
\par n'ahonya bun mu d] s[! 
\par N'akwan mu nni ahw[ye;
\par na n'atemmu y[ nwonwa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Obi nhu n'adwene mu da,
\par na obi ny[ ne fotufo,
\par ]no nkutoo ne Wura.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}nsen soro, na menne fam!
\par Obunkam ne nyinaa so.
\par N'agua ho w] ogya ne hann,
\par na obi nnya ho kwan po.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nanso wayi ne ho adi 
\par ma nnipa hu n'anwonwade 
\par w] n'adeb] ne gye mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}w] akyiri ne mm[nee;
\par onim nnipa akwan mu.
\par Obi ntumi nhintaw ne ho 
\par kokoam ne esum mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Esum nnuru sum mma no da,
\par anadwo hran s[ awia,
\par esum y[ no s[ hann p[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Okura fam ne wim adem,
\par anka awia sen k].
\par \}de ne tumi ntaban nso 
\par tr[w ne nnipa mma so daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hw[ n'anu'nyam ne n'animte,
\par ne timm]b] ne n'ayamye,
\par ne d] a [ky[e y[n so!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \}y[ kronkron, ne ho tew p[
\par ne ho tew sen owia.
\par Wo a wuhu n'ap[de p[, 
\par wubenya ho nhyira bi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}w] nkwa a owu nni mu, 
\par ne ho t] no daa anigyem;
\par ]de mu bi ky[ nnipa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Onyankop]n s[ ayeyi 
\par ne aseda ne nidi.
\par \}sorofo kamfo no pii;
\par mo, nnipa, momm[fram bi! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyankop]n ne Tumfo]
\par \{hena na ]te s[ no.
\par Yennyae no anu'nyam hy[.\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

