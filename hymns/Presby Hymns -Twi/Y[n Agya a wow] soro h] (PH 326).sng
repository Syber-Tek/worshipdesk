\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[n Agya a wow] soro h], 
\par wop[ se y[y[ baako 
\par w] Yesu, y[n Agyenkwa mu, 
\par na yesua mpaeb] daa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma y[mfa y[n koma nyinaa 
\par ns]re wo; na anosom de, 
\par [ny[ wo d[, na wukyi. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo din k[se no ho ntew p[, 
\par na w'as[m ntena y[n mu daa, 
\par na y[n adwene, y[n kasa 
\par ne y[n bra mu atew bi, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na y[afata wo din kronkron
\par siw atoro ne nnadaa kwan; 
\par gye w]n a w]da b]nem.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma w'ahenni mmra wiase 
\par [nn[ ne nna nyinaa 'ra; 
\par ma wo honhom no ne nnepa 
\par ah'row bebree mmra y[n so, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na s[e bonsam no abufuw, 
\par n'aho]den ne ne tumi, 
\par na hw[ w'asafo yiye.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nea wop[ [ny[ w] ha,
\par s[nea [y[ soro
\par s[ y[rehu amane a 
\par ma y[nt] y[n bo ase;? 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ma y[ny[ s[nea wop[;
\par tu ]honam ne mogya gu;
\par w'ap[de no na [ny[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nn[, ma y[n y[n daa aduan 
\par ne nea ehia y[n; 
\par siw ko ne k]m ne yare kwan, 
\par yi y[n p[p[e ne nkyekye,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na y[n asase so adwo, 
\par na y[n honam nyinaa 'ra nso 
\par ne y[n asom adwo y[n
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Fa y[n aka no firi y[n
\par s[ y[de firi w]n a
\par w]de y[n bi, na boa y[n
\par na y[anni obi amim,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na y[asua atimm]b]y[,
\par ay[ y[n nuanom yiye,
\par na y[de f[w asom w]n.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Na mfa y[n nk] s]hw[ mu da, 
\par na b] y[n ho ban yiye
\par \cf1\expndtw-2 Satan p[ y[n as[e y[n a,
\par \expndtw-1 b[hy[ y[n gyidi d[n [! 
\par \expndtw0\ul\b\'b6 \ulnone\b0 
\par Na ma y[mfa w'akode pa 
\par ne gyidi ky[m no mfa no so, 
\par na waguan afi y[n so.
\par \cf0 
\par \cf1\ul\b\'b6 Verse 8\ulnone\b0 
\par 8. Gye y[n w] b]ne nyinaa mu, 
\par na y[n nna mu w] b]ne; 
\par \expndtw-1 gye y[n w] owuprenu mu! 
\par \expndtw0 S[ y[rey[ awu a, 
\par \ul\b\'b6 \ulnone\b0 
\par [nde kyekye y[n wer[ bi, 
\par na ma yenwu ahot] wu, 
\par na y[ak]tena wo nky[n daa!
\par 
\par \ul\b\'b6 Verse 9\ulnone\b0 
\par 9. Amen, ase ne: \{ny[ sa! 
\par Ma yennyae akyinnyegye, 
\par na ma y[n gyidi a [so, 
\par na y[anya adepa a 
\par \ul\b\'b6 \ulnone\b0 
\par y[nam wo din ne w'as[m so, 
\par na y[asr[ afi wo nsam no, 
\par na y[ada wo so ase.\f1\fs22 
