\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse\b0  1\cf0\ulnone 
\par 1. W]ka wo ho anu'nyanne,
\par Sion, y[n Yehowa man!
\par Nea ]rensan n'as[m no
\par b]] wo s[ ne k'row, n' ]tenam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wugyina daa ]botan so;
\par d[n n'[b[woso wo nnae.
\par Nkwagye y[ [ho afasu;
\par wob[s'rew w'atamfo no. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[ daa nkwa nsu a [sen fi
\par Nyame daapem d] no mu,
\par ma wo mma no mee, na eyi
\par hia ho hu fi w]n so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hena na ]b[t] piti . 
\par saa asub]nten yi ho? 
\par Hw[, ]domfo no de dom a
\par [to rentwa da ma mo. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ogya ne mununkum dum no
\par twa wo fi no ho hyia.
\par Nyame yi ne ho kyer[ wo.
\par s[ w'ahyehy[de ne ky[m
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hann ne nwini ne ahot]
\par fi frankaa nom ba wo so;
\par wode ahodwo di mana, 
\par ]de ma ne gyidifo. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Sion Hene de ne mogya 
\par ab[tew ne manfo ho; 
\par w]anya nhyira a [nsa da. 
\par Yesu hy[ w]n anu'nyam. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{y[ ne d] n' [ma w]n so, 
\par na w]adi ahene daa, 
\par na w]ay[ n'anim as]fo 
\par ayi n'ay[ daa nyinaa. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. M'Agyenkwa, menam wo dom so
\par mefra Sion manfom daa. 
\par Ma w]ntaa me na w]ns'rew me, 
\par mede wo din kamfo daa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wiase ne mu nne[ma 
\par ne ahokyer[ resen. 
\par Soro anigye ne ade, 
\par obi nnya, gye Sion mma.\f1 
