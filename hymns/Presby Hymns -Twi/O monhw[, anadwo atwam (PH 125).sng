\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O monhw[, anadwo atwam, 
\par ampa hann no reba!
\par Afei de, owia refi, 
\par [refi w] apuei.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Aman nyinna mommra mm[hw[,
\par [nn[ w]awo wiase Hann no.
\par Yesu Kristo ne ne din.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ahene nyinaa mu Hene 
\par afi soro aba fam.
\par Wab[y[ fam ha abofra;
\par onipa a w]awo no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}daa inmoa adaka mu;
\par w]woo Dawid ba no w] mu;
\par wiase Ogyefo no.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yiw, Ogyefo, m'Awurade 
\par Yesu, daapem Nyame Ba,
\par woaba b]ne asase so;
\par wufi soro nidi mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ano b[n n'[b[kamfo wo,
\par na afata wo Nyame su?
\par Ada w'anu'nyam adi?
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Deb]ney[fo hiani, 
\par minni aho]den bi, 
\par na [y[ wo na wofr[[ me.
\par Me nti na wobaa fam ha; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par fa me koma y[ wo de daa, 
\par na fa me b]ne firi me.
\par Fa me y[ w'aseda daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Me Wura, wufi soro bae 
\par b[y[[ nnipa Agyenkwa.
\par O, dom hu w]n nyinaa mm]b], 
\par na fa w]n b]ne firi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma asase so fo nyinaa 
\par mmra. wo nky[n, na w]mm[som wo.
\par Ogyefo ne Nkwamafo.\f1\fs22 
