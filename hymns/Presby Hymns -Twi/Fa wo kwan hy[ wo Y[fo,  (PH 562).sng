\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Fa wo kwan hy[ wo Y[fo, 
\par wo Nyankop]n no nsam, 
\par na fa wo ho to no so 
\par w] wo yaw nyinaa mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Suwusiw [ne mframa 
\par na ]kyer[ ne kwan,
\par wo nso ]b[kyer[ wo 
\par ]kwan ama wo nan.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo ho na fa to Nyame
\par ne ne tumi no so,
\par [nna wo ho b[t] wo
\par na w'adwuma ak] so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{ny[ adwenem haw kwa
\par na w]de nya b'ribi;
\par Kot] Onyame sr[ no,
\par na ]b[boa wo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}domfo ne Nokwafo
\par ne no, nanso onim
\par nea [ma nk]so pa
\par ne nea [pempem.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na n'ade a ]pawee
\par w] ne nyansa mu no,
\par na ]b[y[ ama wo,
\par na asi wo yiye.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Akwan pii da n'anim h], 
\par nne[ma w] ne nsam, 
\par na nyansa [ne nhyira 
\par w] ne nnwuma nyinaam. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ ]b[y[ ne mmofra 
\par yiye agye w]n a, 
\par onipa bi rensan 
\par no mma onnyae saa y[ da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. S[ satan ne n'asafo
\par besiw no kwan po a, 
\par so Nyankop]n besuro 
\par ak] n'akyi ana?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Dabi! Na nea ]p[ 
\par na ]hwehwe[ b[bam; 
\par na daakye wubehu s[ 
\par Yehowa ayi d]m.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Me kra, fa anidaso 
\par beso no mu dennen; 
\par Onyankop]n begye wo 
\par w'awer[how ne b'r[m. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma w'ani nna ne dom so, 
\par na tw[n n'ayamye daa, 
\par [no na wubehu s[ 
\par w'ani begye koraa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. W'adwenem a [haw wo,
\par nni akyiri koraa;
\par gyae osu ne nk]mm]di, 
\par na kyekye wo wer[. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{ny[ wone ]hena' a
\par wudi amansan so;
\par Onyame te ne soro 
\par n']hw[ ade nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. \}no ne nyansa Hene
\par onim ne hene di; 
\par ]nam ne nyansa pii so 
\par hwe hantanni ase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na s[ ]de ne tumi 
\par y[ nea [den wo 
\par ma ewie yiye a, 
\par [b[y[ nwonwa po.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Daapem nhyira nka wo a
\par wugye Awurade di,
\par na daakye ]b[ma wo
\par daa nkwa botiri,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na woato ayeyi dwom 
\par ama wo Boafo,
\par s[ wadan wo amane 
\par abot]yam k[se.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. O, Yesu, y[n Agyenkwa,
\par twa y[n amane to!
\par Y[n ha tena nyinaa mu no,
\par b[to y[n gyidi so!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na s[ owu reb[n a,
\par nnyaw y[n nkutoo w] mu
\par na ma yen ha kwan ase
\par mmedu wo soro h]!\f1 
