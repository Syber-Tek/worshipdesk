\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame Ba, me Hann ne me Nkwa,
\par me Hw[fo pa, me Henk[se!
\par Mede me ho mahy[ wo d] nsa,
\par ]kra ne honam y[ wo de.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Memfa me kwan dedaw so bio;
\par fa me si wo nokware kwan so!
\par Hw[ w'abofra so daa nyinaa!
\par Gye me taataa, di kan, di m'akyi,
\par hw[ me nantew ne m'ahyemfiri!
\par Me nko, mintu me nan koraa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wugya me kwan a, meremfom da.
\par w'as[m no nso ahy[ me b]
\par s[, w'ani b[kyer[ me kwan pa
\par na wo anim ne me b[k].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mep[ no sa; [y[ me f[ s[
\par wo mm]b'r]hunu, w'ayamyede,
\par hyia me ho y[ me atuu
\par Me tirim nso ne s[, m[som wo
\par metaa miyi me yam mesr[ wo,
\par s[, ma mens] wo nko ani!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Kyer[ me w'asomdwoe no kwan so,
\par yi nea egye m'asabawm,
\par dom me ma minyi me ho nt[mso?
\par mimfi wiase kwan so hawm!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mma minntie nnaadaas[m bi da,
\par n' any[ m'adwenem basaa 'ra da
\par na ma menw[n na memm] mpae;
\par Mesr[ wo s[: Beso me kra mu
\par ma [ny[ den; ma minso wo mu; 
\par na mma wo ho anem nnyae da. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Awurade, fa me hy[ wo mma mu, 
\par na ma meny[ wo ]ba pa.
\par W'ap[de a ne nko y[ p[ no,
\par na ma ensi m'ani so daa!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na biribiara a emfi wo
\par anaas[ nso [ne wo nka no,
\par ennye m'ani, [ny[ me f[.
\par Wo din k[se no anu'nyam no
\par ne ade titiri a mehw[,
\par na mep[ s[ mesom wo p[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma wo honhom no ntu me fo pa
\par na memm] mpae mensr[ wo daa!
\par Ma w'as[m no ntena me komam sa,
\par na [ny[ mu honhom ne nkwa,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na memfa f[re ne ahodwo
\par memm] me bra w] wo anim h];
\par fa me kra b] wo ho koraa!'
\par Ma m'adwene ny[ te s[ wo de,
\par na menhw[ wo ne wo ap[de
\par mensow aba memma wo daa! 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[ [te saa a, me ho b[t] me,
\par wo d] mu na m[home komm;
\par w'ahonya ne wo dom amee me
\par ehu ne haw nni me komam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na nea mehwehw[ titiriw 
\par ne s[ me nsa ka soro k'row no
\par ne s[ mey[ me Yesu de.
\par O, Yesu, twe me kra fi fam ha
\par na ma minnya wo soro daa nkwa!
\par Wo nko mu na m[mee yiye. \f1 
\par \pard\lang2057\f2 
\par }

