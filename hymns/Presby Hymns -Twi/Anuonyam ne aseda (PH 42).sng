\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Anuonyam ne aseda 
\par Y[ soro Nyankop]n de daa
\par \}dom y[n pii hw[ y[n so daa
\par na b]ne bi antumi y[n
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu mu na y[s] n'ani
\par afei y[n bere so ]dwo,
\par na y[n as[m no w]adi p[.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yeyi w' ay[, y[da w 'ase
\par y[hy[ wo anu'nyam ara;
\par y[n agya a onni adannan
\par n'odi y[n so p[p[ ne wo;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w'aho]den no so dodo,
\par nea wop[ b[y[ ampa;
\par mo, mo, s[ woy[ saa Wura!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. O Yesu Kristo, Nyame Ba,
\par woagye y[n w] y[n b]ne mu,
\par y[n patafo ara ne wo,
\par woama y[n ho at] y[n ho.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyame Guammaa, fa wo dom 
\par gye y[n kra fi awer[hom, 
\par na hu y[n mm]b] daa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Honhom papa, kyigyinafo, 
\par wo a wode daa adepa 
\par ma gyidifo no, y[sr[ wo,
\par s[ mma ]bonsam mmfa y[n so,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par beyi awer[ho nyinaa,
\par na Y esu ab] din awu.
\par Wo na yehw[ wo kwan ara!\f1\fs22 
\par \pard\lang2057\f2\fs24 
