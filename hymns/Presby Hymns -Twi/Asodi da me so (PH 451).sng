\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Asodi da me so
\par s[ m[kamfo Nyame,
\par gye me kra a enwu da nkwa,
\par na afata soro.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. M[som mm'resanten yi, 
\par adi me dwuma daa, 
\par mede m'ade nyinaa b[y[ 
\par me Wura ap[de.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma menhw[ me ho so
\par te s[ mete wo nky[n; 
\par me Wura, boa wo somfo
\par na m'adwuma 'y[ yiye.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma menw[n, memm] mpae, 
\par mintweri wo nko daa;
\par migoru m'adwuma ho a, 
\par mewu owuprenu.\f1 
\par \pard\lang2057\f2 
\par }

