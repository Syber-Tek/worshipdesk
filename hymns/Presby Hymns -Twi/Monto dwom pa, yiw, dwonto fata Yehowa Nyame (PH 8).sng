\viewkind4\uc1\pard\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Monto dwom pa, 
\par yiw, dwonto fata 
\par Yehowa Nyame, 
\par y[n nnipa b]fo ne yen Agyenkwa!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Sor' ab]fo 
\par to dwom w] soro!
\par Ma y[n Nyankop]n guammaa 
\par a wokum no.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame yam ye, 
\par yiw, Nyame yam ye, 
\par wohu y[n mm]b], 
\par n']de ne d]ba koro no maa y[n.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Hyira ne din 
\par yiw, hyira ne din;
\par ]no ne Yesu, 
\par y[n nnipa nyinaa Agyenkwa pa no! 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wonyi n' ay[, 
\par yiw, wonyi n' ay[, 
\par ]dan onipa 
\par de ne ho maa yen w] y[n nkwagye nti!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Monto dwom pa, 
\par y[n nyinaa nto dwom 
\par y[n Nyame din ho;
\par y[n Nyankop]n ne y[n Agyenkwa no \f1 
\par \lang2057\f2 
\par }

