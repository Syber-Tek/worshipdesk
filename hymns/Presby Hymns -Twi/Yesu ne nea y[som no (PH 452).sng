\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu ne nea y[som no; 
\par na Yesu wu sii y[n anan mu, 
\par n' ]de ne mogya at] y[n. 
\par Y[n honam ne y[n koma ni!
\par Y[nni b'ribi a [ny[ wo de; 
\par wo d] mu na y[home komm.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Befa y[n s[ w'ade,
\par besiesie wo mmofra
\par ma wo nidi!
\par Na nyi wo dom no mfi y[n so, 
\par na nnyaw wo mma,na hw[ w]n so!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{ny[ y[n na y[apaw wo a 
\par wonam wo daapem dom so huu y[n
\par ansa na y[baa wiase. 
\par Y[n aho]den no nso da; 
\par y[ns[ wo som no, na y[mfata, 
\par na wo na woy[ y[n yiye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Twa y[n ahantan to;
\par na ahiafo nko
\par benya soro.
\par W'akyidifo y[ mmer[w de, 
\par na wo tumim na w]y' ade.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wura Yesu, Nidi Hene
\par afuw no so, na twafo sua s[, 
\par enti soma adansefo; 
\par fa wo dom so soma y[n bi 
\par na y[nkohyia nnipa mma wo, 
\par na w]mmra w'Agya pon no ho. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na nhyira ne w]n a 
\par wopaw w]n s[ w]mmra 
\par w'ahemman mu! 
\par \{h] n' ]ko awie sa, 
\par na daa ahot] boro so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.
\par Monhw[ nnipa mma mpemmpem a 
\par w]da so te wu sunsuma 'se, 
\par na w'ahenni no ntoo w]n [! 
\par \{b[y[ mfe ahe ni a
\par w]ntee Onyankop]n as[m da?
\par Afei ade nnya nkyee w]n [! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Trenee wia, pue, 
\par b[haran, na ber' adu! 
\par Wura Yesu,
\par bra bedi kan, b] y[n akw]n,
\par na hi[ wo apon ma y[n!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.
\par Wo d] pa ne wo ak'ru n'a 
\par yehu y[n nkwagye w] mu daa no
\par ne wo koma a edi ma y[n, 
\par y[b[kamfo akyer[ nnipa, 
\par na y[akyer[ w]n w'as[ndua 
\par de akosi s[ wogye di.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na w'as[m no y[ nnam;
\par [k] nnipa komam
\par y[ no fofro
\par Wo k]ndua, [ny[ y[n den, 
\par na wo honhom boa y[n.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.
\par Agyenkwa,w'ade k[se no,
\par wufi ase w] nketewa mu;
\par na y[n de, wunim s[ y[mfra.
\par Nanso wob[ko ama y[n,
\par na wode w'animtew begya y[n,
\par na y[hw[ wo anim ara.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo sinapi fua
\par kan no, esua ampa,
\par nanso enyin
\par na [rey[ dua k[se,
\par na wo na wohw[ so yiye.\f1 
\par \pard\lang2057\f2 
