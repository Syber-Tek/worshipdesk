\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame a wow] soro,
\par woma w]woo y[n afi mu,
\par woama mmofra awofo pa,
\par ahw[fo a w]boa w]n.
\par Agya, hwie wo nhyira no
\par fi soro gu y[n afi so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fa afi mu b]ne firi, 
\par gye y[n fi ahomaso mu, 
\par na awofo ne w]n mma no 
\par mmr[ w]n ho ase mma wo daa. 
\par Agya, hwie wo nhyira no 
\par fi soro gu y[n afi so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 3. Kristo, y[n mmofra ne mpanyin,
\par Wura; ma w]ny[ biako
\par anigye ne amane mu,
\par agorudi ne dwumadim
\par Agya, hwie wo nhyira no
\par fi soro gu y[n afi so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. O, Agya, di y[n afi so,
\par na kyer[ y[n nea y[ny[.
\par Anigye ne amane mu
\par y[ y[n \}kwankyer[fo daa.
\par Agya, hwie wo nhyira no
\par fi soro gu y[n afi so.\f1 
\par \pard\lang2057\f2 
