\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[n bo at] y[n k[se, 
\par na Ye.su Kristo k] soro. 
\par Agyenkwa pa, yeyi w'ay[, 
\par y[sr[ wo nhyira foforo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[sr[ wo s[ b[hw[ y[n so; 
\par y[n b]ne nti y[n wer' aho; 
\par wo na wopata y[n bio. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Awer[kyekye no ne s[ 
\par ]kwan da h] de k] soro.
\par Kan no w]aka soro atom,
\par nn[, Kristo ahi[ bio
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea ogye as[m no di
\par de f[w di ne wura akyi, 
\par daakye obedu h]nom bi. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nea onni n'akyi anaa 
\par ]ny[ s[ ]kyer[ no no, 
\par Renk] sor' ahemmam mu da; 
\par honam ne mogya renk] h]. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Gyidi na ]hwehw[ y[n ho; 
\par na gyidi no nni tirim nko, 
\par na wohu no nney[e mu nso.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nea onni n'akyi anaa 
\par ]ny[ s[ ]kyer[ no no, 
\par Renk] sor' ahemmam mu da; 
\par honam ne mogya renk] h]. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Gyidi na ]hwehw[ y[n ho; 
\par na gyidi no nni tirim nko, 
\par na wohu no nney[e mu nso.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na nea ofi ase saa
\par k] so nam soro kwan so no, 
\par ]n'na Yesu di n'akyi daa, 
\par de kosi soro man mu h], 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ]de no ak] ne nky[n,
\par na wanya Onyankop]n nsam 
\par ahomeka a n'ani nna so.\f1 
