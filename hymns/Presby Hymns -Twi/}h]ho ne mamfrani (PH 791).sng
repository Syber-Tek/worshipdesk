\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \}h]ho ne mamfrani
\par na mey[ w] fam ha.
\par M'asase mm[n ha baabi,
\par minni fi pa w] ha.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}haw, ]br[, amane
\par na y[ de tu ha kwan;
\par n' ]soro h] na Nyame
\par b[ma mahome sann.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. So mamfi me mmofraase 
\par manhyia haw ne br[,
\par ahoguan ne amane,
\par ]ko ne ]pere? 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mannya nea me k]n do,
\par m'ani anwie gye; 
\par enti mema m'anan so
\par na mentena ha menky[.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{ha amane kwan no, 
\par bebree adi so kan; 
\par Onyame adiyifo, 
\par ne ne man mu mpanyin.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Boaset] ne gyidi 
\par na w]de tuu w]n kwan;
\par na w]n akyi na medi 
\par w] nkwa ne wu nyinaam'.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Kae Abraham akwantu, 
\par na kae ne nhyira bi! 
\par \}h]ho ne mamfrani, 
\par na sua no y[ bi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Atamfo no, di w]n so.
\par amane no fa mu!
\par \}sraani pa nokwafo 
\par bedi nkonim dabaa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{nde meremia so
\par makodu kwan n'ase.
\par Nea ses[[ maso[ yi,
\par [ny[ me fi no nen.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyankop]n kuro no,
\par soro Yerusalem,
\par hann ne d] kuro no,
\par m'ahot] fi no nen!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \{h] na m'ani gyina,
\par 'h] tena na meregye.
\par Awurade, bra begya me,
\par na minhu kwan yiye!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Bra b[ma m'anw'ramanb]
\par ne me br[: d]m to ntwa!
\par B[fa me ha br[. kwan so
\par konya h] anika.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. \{h] no m[tena daapem,
\par meny[ h]ho bio.
\par Me ne w'ahotew mma no
\par b[tena daa homem h].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M'ani b[pa akwantum'
\par ]haw ne br[. no so;
\par me yaw b[ka akyiri;
\par me ho benya at].\f1 
\par \pard\f2 
