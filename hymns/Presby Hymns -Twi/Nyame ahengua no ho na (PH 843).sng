\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nyame ahengua no ho na
\par ne mma mpempem gyina.
\par Nyame de w]n b]ne afri,
\par ahot]fo kuw nen.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anu'nyam, nidi, anu'nyam,
\par anu'nyam, nidi, anu'nyam,
\par anu'nyam dwom na w]to daa. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ebinom ay[ krado tw[n,
\par ay[ n'ap[de p[.
\par Binom nso y[ n'asomafo,
\par w]w[n ne mma fam ha.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anu'nyam, nidi, anu'nyam,
\par anu'nyam, nidi, anu'nyam,
\par anu'nyam dwom na w]to daa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Awurade, soma w'ab]fo
\par ma w]mm[w[n y[n daa;
\par soma w]n daa anwummere;
\par y[da a, ma w]nw[n y[n.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anu'nyam, nidi, anu'nyam,
\par anu'nyam, nidi, anu'nyam,
\par anu'nyam dwom na w]to daa. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Siw b]ne kwan w] y[n ho daa,
\par na amma y[ansuro;
\par na s[ y[n nkwa yi to twa a,
\par y[ab[ka w]n no bi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anu'nyam, nidi, anu'nyam,
\par anu'nyam, nidi, anu'nyam,
\par anu'nyam dwom na w]to daa. \f1 
