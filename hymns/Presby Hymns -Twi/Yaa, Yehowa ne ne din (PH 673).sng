\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yaa, Yehowa ne ne din
\par di ahurusi w] n'anim.
\par Ayisaa Agya ne no,
\par \}ho]denfo, Tumfo no,
\par Yaa, Yehowa ne ne dio;
\par ]y[ ayisaa Agya
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}no ne Onyame a
\par odi akunafo as[m.
\par \}n' na odi w]n as[m 
\par w] ne tenabea kronkron h]. 
\par \{h] na obu w]n bem, 
\par na ]popa w]n nusu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Akunafo ne nyisaa,
\par mo nyinaa nyi Nyame ay[.
\par \}y[ Otumfo k[se 
\par n' ]b[ma mo haw to atwa
\par \}de mo nyinaa b[ka 
\par ne soro asafo ho.\f1 
\par \pard\lang2057\f2 
\par }

