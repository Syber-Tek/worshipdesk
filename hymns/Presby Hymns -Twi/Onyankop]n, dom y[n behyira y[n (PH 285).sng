\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n, dom y[n behyira y[n
\par na tew w'anim kyer[ y[n, kyia y[n,
\par na ma yenhu wo kwan asase so
\par ne wo nkwagye amanaman no mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyankop]n, aman beyi w' ay[,
\par aman nyinaa beyi wo din ay[
\par Y[n ani gye, y[to ahosan dwom
\par s[ wokyer[kyer[ w]n wo nkwa kwan
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. K], so kyer[ y[n wo trenee mu kwan,
\par na s[ asase ab] n'aduan no,
\par ma y[nsow trenee aba saa ara,
\par na yensuro wo, na y[nn] wo daa,\f1 
\par \pard\f2 
\par }

