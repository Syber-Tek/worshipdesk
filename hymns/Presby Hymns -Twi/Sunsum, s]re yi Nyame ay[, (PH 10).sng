\par 1. Sunsum, s]re yi Nyame ay[, 
\par me sunsum, s]re yi n'ay[. 
\par Sunsum, s]re yi Nyame ay[, 
\par me sunsum, s]re yi n'ay[.
\par Na nhyira nka y[n Nyankop]n ne ne Ba, 
\par na nnaase nka y[n Nyankop]n ne ne Ba.
\par Ayeyi nka y[n Nyankop]n ne ne Ba, 
\par Nyan, me sunsum, s]re yi n'aye.\f1 
