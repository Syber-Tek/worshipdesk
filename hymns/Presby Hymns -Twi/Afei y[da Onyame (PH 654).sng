\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Afei y[da Onyame 
\par ayamyede so ase: 
\par ]de nkwa pa ama y[n 
\par de aduan amee y[n. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ ]y[n honam a, 
\par ne were remfi y[n kra;
\par ne nti na y[n Agy[nkwa
\par fii soro baa fam ha.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}ne y[n kra 'Duan pa,
\par ]ma y[n Nyame daa nkwa. 
\par Y[mpo ne d], yegye di a,
\par yebenya ne nkwa bi.\f1 
\par \pard\lang2057\f2 
