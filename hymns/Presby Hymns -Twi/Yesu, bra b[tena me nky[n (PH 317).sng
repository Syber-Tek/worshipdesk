\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, bra b[tena me nky[n! 
\par Mannya wo a, m[y[ d[n? 
\par Bra, me kra adamfo pa, 
\par b[fa me y[ wo de daa!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Daa mep[ wo nky[n atena; 
\par biribi twe me koma, 
\par enti [ma misu daa.
\par Yesu, d]fo, bra menky[n
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Minhu ade biara a 
\par [b[y[ me honhom ma! 
\par Yesu d] no nko ara
\par na [ma me ahodwo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Fa nea mew] nyinaa,
\par m'ani nna biribi so.
\par Wo, me Yesu, wo nkutoo
\par ne me daapem anigye
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. S[ b'ribi gye me koma
\par na womp[ saa ade a,
\par yi, prapra me ho yiye
\par na ma minnya wo nkwagye.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Yesu, m'ani da wo so! 
\par Wubegye me mpaeb] so; 
\par wob[sakra me koma, 
\par na mab[y[ wo de daa.\f1 
\par \pard\lang2057\f2 
