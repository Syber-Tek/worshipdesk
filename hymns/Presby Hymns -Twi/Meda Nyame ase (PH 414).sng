\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na satan akw]n de, 
\par metwe me koma fi ho. 
\par Nea [ho tew no,
\par [no na me koma p[ 
\par W'asub] mu tumi, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w'as[m ne w'aduan,
\par [n' na ahy[ me den 
\par ama madan wo ba. 
