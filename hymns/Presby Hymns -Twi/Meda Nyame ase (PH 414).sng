\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mede me ho ma wo
\par w] nkwa anaas[ owu 
\par anaas[ ]haw mu, 
\par s[nea wo p[ no te.
\par Mede nea mew]
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
