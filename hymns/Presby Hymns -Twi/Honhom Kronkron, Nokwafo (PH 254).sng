\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Honhom Kronkron, Nokwafo 
\par bra b[tew me mu koraa; 
\par Nyankop]n as[m ne Hann, 
\par nyan me honhom, tew m'an
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Honhom a woy[ ]d], 
\par b[hyer[n me mu yiye. 
\par Ma meny[ nea eye, 
\par b[hyew me mu b]ne no.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Honhom a woy[ tumi
\par Hy[ me p[ mu den ma me
\par Ma minso wo mu dennen
\par Meny[ den menk] so yiye
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Honhom a wop[[ me mu,
\par bra b[tena ma'dwene mu,
\par ma was[m nni me so yiye,
\par n'[nka me mm] wo ho daa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Woy[ asomdwoe Honhom,
\par Bedwudwo me mu koraa,
\par Me kra bo y[ atu a,
\par Kasa, na [b[y[ komm.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Woy[ anigye Honhom
\par Bra ma me kra ani nnye.
\par Menam sare so po a,
\par b[y[ me asub]nten.\f1 
\par \pard\f2 
