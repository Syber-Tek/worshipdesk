\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Boaset] fi Nyame, 
\par ]de ne h]nh]m ky[. 
\par Onyame de b[ma me, 
\par otie m'adesr[
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyame honhom pa 
\par te me mu a, ogye me, 
\par na ]mma me bo nntu da, 
\par ogye m'adesoa.
