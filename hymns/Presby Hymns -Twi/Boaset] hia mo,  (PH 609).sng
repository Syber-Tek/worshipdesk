\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Boaset] fi gyidim
\par miso Onyame mu
\par na migyina n'as[m so;
\par na m'ani gye no ho
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Boaset] fi d]m; 
\par minim s[ Yesu d] me; 
\par ]kae me na onnyaw me; 
\par med] no mey[ komm. 
