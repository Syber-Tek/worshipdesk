\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Boaset] hia mo, 
\par [s[ mo Kristofo. 
\par Awer[ho ne yaw mu 
\par biribi nte s[ no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}br[ me nk]mm] mu
\par ]taa mu ne amanem, 
\par montaa mo bo nokwarem 
\par munnwo na mony[ komm. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea Onyame p[ no
\par mode boaset]
\par rey[ a, obegye mo
\par ama mo h] adwo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Amane no renky[; 
\par Onyame asotwe no 
\par ]bonsam s]hw[ no
