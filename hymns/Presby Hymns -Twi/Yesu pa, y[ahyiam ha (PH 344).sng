\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu pa, y[ahyiam ha,
\par rebetie w'as[mpa no. 
\par Kyer[ y[n kra ne honam 
\par wo soro pa h] ns[m no,
\par na y[n koma afi fam ha 
\par aba wo nky[n w] ]soro.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n nhumu ne ntease
\par ne esum kabii di afra;
\par ma wo Honhom Kronkron no
\par mfa ne hann no mm[hy[ y[n ma
\par na y[n bra, nsusuwi, kasa, 
\par ay[ nea wokyer[ daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wohyer[n sen owia!
\par Hann mu hann, wufi Nyame mu.
\par Siesie y[n mu tenabea, 
\par bue koma, ano ne aso. 
\par Y[n mpaeb], aseda, dwonto, 
\par ma ennu wo, Yesu nky[n daa. \f1 
\par \pard\lang2057\f2 
