\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Dabida, y[ntw[n ]fofro! 
\par Me kra reny[ nyaa 'fei. 
\par Di w'Agyenkwa a ]de daa nkwa 
\par [ne hann aba akyi!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wunim s[ wo Wura no 
\par aba wi yi ase s[ 
\par obegye wo afi b]ne 
\par [ne ]bonsam s]hwe mu?
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nifuraefo n' ehu ade 
\par na apitifo ho fi, 
\par abubuafo n' [nante;
\par d[n na wugye akyinnye?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyan awufo fi wum, 
\par na w]te ase bio.
\par So wunim bi a ]ky[n no?
\par Dabi, k]dan no na som no!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Anka [s[ se ne nk'r]fo
\par ba ne nky[n akuwakuw 
\par na wobisa ne nky[n dom a 
\par ]de dom nneb]neyefo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu ahobr[ase 
\par y[ w]n s[ hintidua;
\par w]hwehw[ anuonyanne 
\par na wokyi Kristo amane.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, me nso mete saa bi, 
\par Memp[ ahobr[ase.
\par Boa me na ma me gyidi, 
\par na me de madi nkonim! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo hia ne haw ne br[
\par [ny[ y[n ahantan f[, 
\par y[mp[ s[ yehu amane, 
\par fa w'as[ndua di w'akyi.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Yi me kra fi wi yi ase 
\par ne ade a [s[e me 
\par ma memfa ahobr[ase 
\par mempa m'ahantan koraa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ahobr[ase som mu 
\par na mede m[s] w'ani,
\par ma me honhom nso wo nko 
\par mu na me ho at] me dabaa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Yi m'anim nkatanim no [, 
\par gye me fi afiase;
\par mm'ra nom merennya nkwa bi da,
\par dom mu na menya me ho.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu, ma w'anuonyam, 
\par wo nokware ne wo dom 
\par mm[hyer[n w] me koma mu, 
\par na atew me b]ne sum no. 
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. M'ani gye w'anuonyannem,
\par na me bo at] me yam 
\par se wubegye me m'amanem 
\par [ne fam ha yaw nyinaam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Daakye na mehu w'anim 
\par w] wo soro ahennim 
\par na mahu s[ [y[ wo na 
\par woma y[n nkwa a [nsa da.\f1\fs22 
\par \lang2057\f2\fs24 
\par }

