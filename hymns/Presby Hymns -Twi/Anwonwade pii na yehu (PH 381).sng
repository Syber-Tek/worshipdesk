\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Anwonwade pii na yehu
\par w] Onyame as[m no mu;
\par [y[ gyidifo nnwuma pa,
\par na gyidifo nko na w]y[
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Gyidi na w]de di nkonim,
\par na ede hann fi soro ba.
\par \{de abran mpo hwee as[e,
\par na [ne Nyame tentamee.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{ma awufo nyan bio,
\par na .[sa nyarewa nyinaa.
\par Nokware gyidi so aba
\par ma y[n ho dwiriw y[n ara.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ade nketewa a yemmu,
\par [no- mu na yehu gyidi.
\par S[ obi ye gyidini a,
\par ne kra nya daa nkwa, na onwu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Gyidi ma y[n nkwa fi soro,
\par na eyi owu tumi h].
\par Nkonim ye y[n Awurade de;
\par y[ne no bedi nkonim bi.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Yesu, w] so na m'ani da,
\par enti bra na bedi ma me.
\par Ma me w] mu aho]den,
\par na may[ gyidi mu nnwuma.\f1 
\par \pard\lang2057\f2 
\par }

