\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. B] me koma a emu tew; 
\par Nyame, me koma as[e! 
\par N' awosu as[e me koraa,
\par ne mu, ]te ]yaw nka
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par B]ne a maye dedaw no
\par [y[ me yaw; minu me ho
\par Ma me koma foforo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma me wo honhom foforo,
\par na madwen nea eye,
\par na mede me ho ama 
\par ay[ nea wop[ nko.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma minkyi honam fam nnepa,
\par na mafa gyidi so anya
\par ]da ne anidaso.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{s[ s[ wotow me kyene
\par Efis[ [fata me.
\par Me d]fo pa, hu me mm]b],
\par br[ w'ani ase hw[ me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu, pata me ne wo ntam,
\par na mma mennka me b]ne mu;
\par ma mentena wo nky[n koraa!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Dom ma w'asomdwoe honhom [no
\par mmeso me mu nhy[ me den,
\par na ]bonsam ne owu mpo
\par antumi anyi me hu
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, Awurade, wo nkutoo mu 
\par na minya anidaso s[
\par menya daapem ahot].\f1 
\par \pard\lang2057\f2 
\par }

