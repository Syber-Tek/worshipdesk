\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. B[tena me nky[n, na onwini redwo;
\par esum rey[  aduru me ampa;
\par minni boafo ne aw'r[kyekye
\par ahiafo Boafo, boa me.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Esum reba,  y[n nkwa nna nky[ mu twa;
\par asase so anigye resen k];
\par por]wee ne nsakrae nko na mihu.
\par Wo a wonsakra da, b[tena me nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mehwehw[ wo d]nhwere biara;
\par wo  dom nko pam bonsam ne ne s]hw[.
\par Obi nte s[ wo, me kwankyer[fo.
\par Osum o, wiam o, b[tena me nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}tamfo b[n, na minsuro bio?
\par Amanehunu ntumi ny[ ya bio.
\par Owu nwow]e, owu nwow]e w] he?
\par Asaman, wo nkonim no nso w] he?
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. W'as[ndua  nnyina m'ani so daa.
\par Hyer[n ma me, kyer[ me soro kwan.
\par \}soro h] na ma ada nkye me;
\par Owum ana nkwam o,  b[tena me nky[n.\f1\fs22 
