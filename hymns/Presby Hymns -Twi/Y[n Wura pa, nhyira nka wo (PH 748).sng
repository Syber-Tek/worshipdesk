\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[n Wura pa, nhyira nka wo
\par s[ y[n anantewanantew
\par de  y[n asi awiei pa,
\par efis[ wob[n y[n daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wone y[n nkwa Asuti no,
\par [no mu na yenya nhyira
\par wo nky[n na y[b[tena daa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ Y[kan y[n nna ne y[n  mfe,
\par na  y[hw[ ne dodow a,
\par [ma y[n ani gyina mpo
\par s[  y[p[ wo  nky[n aba.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fam nnwuma a [ma owu
\par na ahy[ y[n honhom mu ma,
\par nanso woma y[n daa nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo d] no kanyan y[n koma,
\par [d[w y[n mu s[ ogya;
\par [ma  y[n adwene  nyinaa
\par sakra dan y[ s[ wo de.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{nde afei wotena y[n mu
\par na [ma y[n nso tena wo mu
\par na [ma yetim wo mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. O, da b[n mpo na w'ankasa
\par b[baa ma y[ahu wo?
\par Y[n koma pere hwehw[ wo;
\par y[renky[ w] honam mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Bra nt[m w] anuonyam mu
\par hyia y[n s[ w'ay[foro;
\par wo ara na y[retw[n.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nanso bere a [s[ no,
\par wo nsam ara na [w];
\par woka kyer[ y[n s[ y[nw[n,
\par efis[ yennim d]n no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ y[da y[n ho so w[n a,
\par [b[y[ w'anigye ampa.
\par Hy[ y[n den na y[aw[n sa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Anigye ahy[ y[n komam ma;
\par obi rensiw ano da.
\par Y[ka na nnipa ate s[
\par woay[ y[n w'ay[foro.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[y[ wo de, enti da bi
\par wob[ba abehyira y[n
\par de y[n ak] w'ahennim.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. O, Yesu, y[n koma w] wo,
\par na  [new o w] soro.
\par Wo d] no kanyan y[n koma,
\par na [twe y[n k] wo nky[n.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Enti ber' nyinaa mu no,
\par y[w] gyidi y[n Yesu mu;
\par ne mu na y[n nkwagye w].\f1\fs22 
