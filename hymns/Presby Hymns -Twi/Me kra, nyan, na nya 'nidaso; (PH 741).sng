\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me kra, nyan, na nya 'nidaso;
\par afe  baako atwam,
\par asram pii aba na [k],
\par na dap[n pii atwam.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me kra, kae nkwa yi awiei,
\par na  [da k[se no,
\par da no adasamma nney[e
\par benya  so atemmu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na s[ mede anihaw  po
\par hweree m'adagyew a,
\par ata k] na [erensan bio;
\par so manu me ho ni?
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me Nyame, kanyan me koma,
\par na  ma minsua wo;
