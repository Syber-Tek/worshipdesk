\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Afe rek], afe reba,
\par na  s[ me nna retwam ni!
\par Mema m'ani ba so ara
\par s[ m'asetena rehi bi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anka [s[ s[ daa afe,
\par me  gyidi sow aba bebree.
\par Afe rek], afe reba
\par na  s[ me nna retwam ni!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me Nyame, s[ woba b[p[
\par me h] aba no bi a,
\par wubehu nea wohwehw[
\par anaas[  misi h] kwa?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wunnya nea wop[ no a,
\par ebeyi w'abufuw ara!
\par Afe rek], afe reba,
\par na  s[ me nna retwam ni!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Anka wubese: Dua no
\par nye  mma hwee; nti twa  kyene!
\par Mab[hwehw[ aba w] so,
\par na  minnyaa bi koraa [,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu, fa wo atwapo bra;
\par twa  kyene [, na y[ gya.
\par Afe rek], afe reba,
\par na  s[ me nna retwam ni!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nanso m'Agyenkwa pa no se:
\par Ma ensi h]  saa 'fe yi!
\par M[b] no ho mm]den yiye.
\par ebia [b[sow bi,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na s[ ansow afe yim' a,
\par [no de s[ wop[ a, twa!
\par Afe rek], afe reba,
\par na  s[ me nna retwam ni!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. O, me Yesu, kanyan me [,
\par ma  meny[ ye, saa 'fe yi.
\par Ma wo Honhom baninhahy[
\par nni  me honam so tumi!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W'aho]den ne wo nhyira
