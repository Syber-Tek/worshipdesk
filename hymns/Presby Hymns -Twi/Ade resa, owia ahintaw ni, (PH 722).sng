\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{nn[ dwuma, honam mu de no, madi;
\par nea aka ne me kra mu de no,
\par na me honhom hwehw[ wo, me Nyankop]n;
\par [no ansa na menya mada komm.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Esum ad'ru, nnipa ne mmoa k]home;
\par Me home pa ne s[ med] Onyame.
\par Mes]re wo; mekae w'anwonwade no,
\par meda  w' ase na miyi  wo ay[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Fa me koma!  Mede b] wo af]re;
\par m'adwene ne m'ap[de y[ wo de!
\par Na mma  b'ribiara nnyi ne ho adi,
\par gye  nea wop[, na [s] w'ani.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Esum mu nso b[y[ me khonhom Wia;
