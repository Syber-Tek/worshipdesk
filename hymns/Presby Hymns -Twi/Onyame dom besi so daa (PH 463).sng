\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame dom besi so daa, 
\par ne nokwas[m tim h]; 
\par [fam ne soro po sakra,
\par na n'ad]e nsen nk] da.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyame ny[ onipa bi,
\par na ]renni at'ro;
\par ]nte s[ ]desani bi 
\par na ]rennu ne ho.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}de ne dom ahy[ y[n b]; 
\par yegyina so ara; 
\par y[nnye akyinne, y[nsuro; 
\par odi nokware daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ne b] a wahy[ me no nti,
\par migye midi ampa 
\par s[: \}renni me b]ne akyi, 
\par na manya Agyenkwa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Onyame dom tim Yesu mu, 
\par enti yegye no di. 
\par Yesu af]re mogya nom
\par na y[anya fafiri.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. M'Agyenkwa pa, miso wo mu,
\par mikura wo ara;
\par mekura wo makosi wum,
\par na merempa wo da.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Wodom ahobr[asefo;
\par mebr[ me ho ase;
\par woma nea [w] fam no so,
\par wo nti m[y[ k[se.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Yesu, mma menny[ biribi
\par w] me nney[e mu da,
\par gye s[ wo dom no di m'akyi
\par na wopene ara.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Wo da k[se nom ma me so
\par na ma minkonya nkwa;
\par na ma minhu ]soro h]
\par s[ wo dom si so daa!\f1 
