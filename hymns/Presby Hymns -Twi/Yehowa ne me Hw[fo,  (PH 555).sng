\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yehowa ne me Hw[fo, 
\par na hwee renhia me. 
\par \}hw[ me na ]y[n me,
\par de n'adepa ky[ me. 
\par Amanem odwudwo me kra 
\par na ]kyer[ me ne kwan pa. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Menam wu bon mu po a, 
\par minsuro b]ne bi; 
\par na wo na wudi m'akyi,
\par wokyekye me wer[. 
\par Yehowa, wode wo poma 
\par b[pam m'atamfo nyinaa'ra; 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wotow me pon ma wohu, 
\par wof]w me tirim ngo; 
\par me k'ruwa y[ ma bu so; 
\par yiye di m'akyi daa. 
\par M[tena Yehowa fi koraa, 
\par na mahu n'ad]e daa nyinaa.\f1 
\par \pard\lang2057\f2 
\par }

