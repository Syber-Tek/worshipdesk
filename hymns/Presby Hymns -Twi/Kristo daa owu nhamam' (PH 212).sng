\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Kristo daa owu nhamam'
\par y[n b]ne peewa no nti,
\par na afei wanyan bio
\par de nkwa foforo aba;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par enti y[n bo t] y[n yam,
\par de aseda br[ Nyame,
\par to no Halleluya dwom se:
\par Halleluya, Amen!  ,
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Eny[ nnipa mma nyinaa
\par na w]ayi w]n wu yi h],
\par y[n b]ne n'ama ay[ saa,
\par obiara nni mu bem;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par enti Yesu ho y[ den,
\par na wadi wu so ampa,
\par na w'ayi y[n nkoasom h]:
\par Halleluya, Amen!  ,
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yesu Kristo, Nyame Ba
\par abesi y[n anan mu
\par ab] wu ahwe fam, na
\par watu ne b]re nyinaa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par wagye n'aho]den no
\par ma aka ne sunsuma;
\par Yesu ayi wu mu yaw;
\par Halleluya, Amen! 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Enti na yedi Twam no,
\par apiti foforo no.
\par Munyi mm]kaw no mfi h],
\par na [nka mm]re pa no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Kristo adan abodoo,
\par y[n kra ho san no w] ho,
\par y[mp[ aduan foforo.
\par Halleluya, Amen!\f1 
\par \pard\f2 
\par }

