\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \{ha na mihu m'Awurade anim; 
\par [ha na me nsa ka nea wonhu. 
\par \{ha na miso ]dom mu dennen, 
\par na [ma minya me dadwen tobew. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{ha na midi Nyame abodoo; 
\par [ha na me ne no nom bobesa. 
\par \{ha na mede m'adesoa to, 
\par [ha na minya b]ne fafiri, 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Adidi pa ne nnwonto bere ni, 
\par soro pon a w]atow ama me ni., 
\par \{ha na ma minni w'aduan yi, 
\par na manya wo mu daa ay]nkofa,
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Minni ]boafo bi gye wo nko,
\par wo basa ara so na metweri, 
\par Awurade, [no ara d]] me so; 
\par wo tumi mu na m'ho]den w]. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Adidi biara a mek] no, 
\par ma m'ani ba soro apontow so. 
\par \{h] na daakye mede anigye
\par b[tena Oguamma pon k[se no ho.\f1 
\par \pard\lang2057\f2 
\par }

