\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Daa nkwa 's[m subura kronkron, 
\par [soro baa wiase; 
\par nkwa hann na wode ma nea 
\par obue ne koma mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nhwiren f[f[ a atwintwam 
\par na awia ahye no, 
\par de ne suk]m no b[ba h] 
\par ab'[nom wo nkwa nsu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wunni h] a, nnipa y[ d[n? 
\par Wiase te s[ sum bon. 
\par Wunni h] a, soro y[ d[n?
\par Anigye dan a w]atom. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wunni h] a, nkwa mpo y[ d[n? 
\par Owu sum ne huhuro. 
\par Wunni h] a, owu y[ d[n? 
\par Ehu sum a hann bi nnim
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Daa nkwa's[m won a woma nkwa,
\par woma y[n komam y[ hyew. 
\par S[ woma yehu yaw mpo a, 
\par yehu ]soro man nso
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par woy[ apranaa huhuuhu
\par ma ]deb]ney[fo;
\par nea ne b]ne y[ no yaw,
\par wonam d] so de ky[ no.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}temmufo pa Treneeni,
\par w'atemmu y[ nokware;
\par wokyer[ sor' Agya d] a
\par [hwehw[ y[n yiedi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wokyer[ Nyame akyi kwan, 
\par nea ]de ne Ba mae, 
\par na wapopa y[n ho b]ne 
\par n']de agye nnipa nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nea ]te nkwa kasa no 
\par te ne nkwagye ho as[m; 
\par na ne wura ara nko 
\par benya nkwa ahenky[w no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{no nti na m[tena wo nky[n, 
\par Honhon Nkrante, Nyame no; 
\par ma menko nokware ko pa
\par na manya nkonim ky[w no.\f1 
