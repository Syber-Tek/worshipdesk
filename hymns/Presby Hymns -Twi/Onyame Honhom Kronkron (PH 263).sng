\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame Honhom Kronkron, 
\par bra b[tena me komam! 
\par Kan no na me na woo me, 
\par na wo woo me bio. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Woy[ Onyame bi, 
\par wufi Agya ne Ba no,
\par w'anu'nyam te s[ w]n de,
\par yebeyi w'ay[ daa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fa wo tumi bra y[n mu,
\par begye y[n b]nem!
\par Na y[br[ b]ney[ mu,
\par yenni aho]den.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Bra betu y[n komam
\par ne y[n tirim b]ne no,
\par b[sa y[n honhom yare,
\par b[tew y[n ho koraa
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Woye mpaeba Honhom pa,
\par na wokyer[ y[n s[
\par y[mfa gyidi mu mpaeb]:
\par mmra y[n Agya anim.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo ankasa p[ s[ 
\par wosr[ w] y[n koma mu.
\par Wo mpaeb] no k] ]soro,
\par na Nyankop]n gye so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Woy[ anigye Honhom;
\par Womp[ s[ yesuro;
\par na s[ y[n wer[ how a,
\par y[n patafo ne wo;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par s[ y[n kra amuna
\par na y[n honhom botow a
\par wo na woy[ y[n hann a
\par [ma y[n ani ka
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nanso woy[ d] Honhom; 
\par s[ y[de abufuw 
\par ne atutuw ne manso 
\par ne nitan s[e y[n ho,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na y[b[sr[ wo a,
\par wubetumi apata,
\par na wo d] te s[ ogya a
\par wode gu y[n komam.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Bra, fa nokware gyidi' 
\par B[hy[ y[n koma ma, 
\par na y[adi Yesu akyi,
\par na yeanya ne nhyira. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Pam sunsumm]ne a
\par ]y[ wo ne y[n tamfo 
\par na ]p[ s[ yekyi wo, 
\par na y[annya wo nnepa. 
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Y[n asetena nyinaa mu, 
\par kyer[ nea wop[; 
\par ma y[mfa w'adeky[ no 
\par mm] y[n bra yie daa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na s[ y[n da redu, 
\par na yerey[ awu a, 
\par ma y[nhw[ y[n Agyenkwa, 
\par na y[mmra n'anikam!\f1 
