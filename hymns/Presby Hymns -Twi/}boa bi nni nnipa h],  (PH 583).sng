\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \}boa bi nni nnipa h], 
\par enti hw[ wo Nyame nkutoo. 
\par Nyame nkutoo n' ]w] h] daa; 
\par daapem ahot] nni fam ha.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Okristoni, di wo ho ni, 
\par gyae aniwude akyi di. 
\par Fa w'ani kari papa nko; 
\par na wo din pa atena h] daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Kora w'ano nnaadaas[m ho, 
\par na mma wo t[kr[ma ny[ nta. 
\par Fa nokware y[ wo botae, 
\par na ma w'as[m ny[ baako p[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Br[ wo ho ase fa nidi 
\par ma ]y]nko a wuhu no. 
\par Papa bi a wohwehw[ no, 
\par y[ bi ma afoforo nso.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ahomaso ne ahantan
\par saa suban yi de, gu koraa.
\par Nyame siw ahantanfo kwan, 
\par na ]dom ahobr[asefo.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. D] Onyamesom sen sika; 
\par [no n' eye, sika y[ 'kwa. 
\par Wubegyaw nne[ma nyinaa, 
\par na wo som pa bedi w'akyi
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Y[ ade ma ahiafo
\par s[nea Nyame adom wo.
\par Enti ny[ sikanibere,
\par na Kristo amm[kyer[ saa.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Ma nea eye ns] w'ani;
\par Da nea wunya so ase.
\par S[ ]y]nko bi te yaw a,
\par Fa ]d] te nka ma ho bi.\f1 
