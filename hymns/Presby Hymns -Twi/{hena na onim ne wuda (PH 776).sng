\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \{hena na onim ne wuda?
\par Y[n nna retwam, n' owu reba.
\par Enni da bi a wu mpatu mma,
\par na  [nto nnipa mpofirim.
\par Me Nyame, Kristo mogya nti,
\par ma me ha tena nsi me yiye!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone 
\par \b0 2. Me Wura, ma minnwen me wu ho,
\par na  ma kra nna Yesu wum';
\par ma mensakra m'adwene nn[ yi,
\par na manwu w] me b]ne mu.
\par Me Nyame, Kristo mogya nti,
\par ma  me ha tena nsi me yiye.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma ]soro h] ny[ me d[ s[;
\par efis[ honam de no mfra;
\par wi yi ase k]ree ne bae mu
\par ma menkae daakye atemmu!
\par Me Nyame, Kristo mogya nti,
\par ma  me ha tena nsi me yiyi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. O, m'Agya, fa Yesu trenee no
\par b[kata me nneb]ne so,
\par na me ho at] me w] hanom,
\par na m'ani agye daa w] h].
\par Me Nyame, Kristo mogya nti,
\par ma  me ha tena nsi me yiye!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Me nkwa new u, [fam ne soro
\par rentetew me ne Yesu mu;
\par mede me nsa meto me mfem se;
\par me Wura ne me Nyankop]n!
\par Me Nyame, Kristo mogya nti,
\par ma  me ha tena nsi me yiye!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Mahy[ Yesu w] m'asub] mu,
\par na  me ne no ay[ biako;
\par wode me b]ne afiri me,
\par agye m' afra wo mma no mu.
\par Me Nyame, Kristo mogya nti,
\par ma  me ha tena nsi me yiye!
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Madi me wura Yesu honam,
\par masan  manom ne mogya no;
\par ne wer[  rentumi mfi me da,
\par mew] no mu, n']w] me mu.
\par Me Nyame, Kristo mogya nti,
\par ma  me ha tena nsi me yiye!
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. \{nde mete ase, na mewu
\par wo  asomdwoem, minsuro hwee.
\par \{mmra me so s[nea wop[,
\par na minim s[ wode wo dom
\par ne Kristo mogya bewie
\par me fam ha tena nyinaa yiye.\f1\fs22 
\par \pard\f2\fs24 
\par }

