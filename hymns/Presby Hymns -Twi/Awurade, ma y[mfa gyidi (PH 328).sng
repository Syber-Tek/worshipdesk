\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade, ma y[mfa gyidi 
\par ne f[re mm] wo mpae! 
\par Y[y[ nso [ne d]te de, 
\par nanso wunsiw y[n kwan. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[amm] wo mpae a, y[yera; 
\par b[hy[ yen gyidi den,
\par na s[ y[y[ ato wo a,
\par behyia y[n ]kwanm!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[n b]ne hy[ y[n so dodo,
\par Y[n honam y[ mmer[w,
\par ]ko ne yaw ne hu atwa
\par y[n ho ahyia daa
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Mm]bor]hunu Nyankop]n, 
\par br[ y[n koma ase; 
\par fa wo nokware hy[ y[n ma, 
\par ma y[n aso]mmer[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma gyidi na yennye nni s[
\par y[n Wura Yesu no 
\par ne nea ]de ne mogya 
\par agye y[n b]ne mu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ma y[nt] bo ase daa,
\par na hy[ y[n baninha,
\par na y[n koma antu koraa,
\par na mmom y[ako ko pa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Ma wo daa nkwa no ny[ y[n de 
\par na y[n ani agye; 
\par na s[ y[n wuda redu a, 
\par y[awu w] asomdwoem.\f1 
\par \pard\lang2057\f2 
\par }

