\par 1. Yesu ne m'Agyenkwa. 
\par Meretu me kwan ni; 
\par Yesu, woanya fam kwan ntui [da.
\par Wo nid] n' [kaa wo, 
\par n' [ma wonante br[e,
\par na wuhuu ]bram amane. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me nso nti wobr[e bi,
\par wo na wone tumfo, 
\par na me de, memfra po!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wod] nneb]ney[fo 
\par rey[ w]n treneefo;
\par w]n amane y[[ wo mm]b]. 
\par Enti wobaa fam ha 
\par bekyinii wo nk'r]fom,
\par na woda so nam w'asafom.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wop[ s[ wubegye 
