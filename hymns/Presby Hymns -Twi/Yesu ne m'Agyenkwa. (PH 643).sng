\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me kwan a mitu yim,
\par ma menkae w'akwantu,
\par na menhw[ wo minni w'akyi
\par Ma men] me nk'r]fo
\par s[ wo nso wod] me,
\par na ma memp[ w]n yiye bi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Awia, anadwo,
\par hw[ me w] me kwan mu
\par ne m'ah]hodan mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. M'Agya Nyame d] no,
\par ne m'Agyenkwa dom no,
\par ne ne Honhom asomdwoe no,
