\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M'ani gye m'asub] ho 
\par sen me honam mu awo ho, 
\par na Onyame de ne nkwa 
\par maa me honhom w] [no mu, 
\par ma meny[ onipa kwa, 
\par na madan Onyame ba.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Kan no na Onyankop]n
\par de ne hwenem' home maa me; 
\par nanso ]de ne honhom
\par  guu me kram' w] m'asub] mu. 
\par Kan no minyaa fam nkwa no, 
\par m'asub] nom' de, daa nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M'asub] nom wode me
\par hy[[ nokware Nyame din mu, 
\par na mey[[ Onyame ba a
\par Yesu de ne mogya t]] me. 
\par Nea [w] Nyame mu 
\par na w]de bi hy[[ me mu
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ amane to me a, 
\par m'ani begye m'asub] ho; 
\par s[ me wuda redu a, 
\par [b[ma me wer' akyekye. 
\par W]ahy[ me agyirae s[ 
\par mey[ Nyankop]n dehye. \f1 
\par \pard\lang2057\f2 
\par }

