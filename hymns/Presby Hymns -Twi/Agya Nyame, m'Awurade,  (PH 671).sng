\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Agya Nyame, m'Awurade, 
\par hw[ me, may[ ayisaa! 
\par Wone m'Agya ne me Hw[fo, 
\par minni gyefo biara.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me honam agya ne me na, 
\par wonni h], na w]da dam. 
\par Mede me ho mato wo so; 
\par hw[ me, na kyer[ me kwan!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yesu, woase wo mmofra s[
\par Merennyaw mo nyisaa da;
\par m[ba mo nky[n ab[hw[ mo,
\par na mo ani agye daa! 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, hw[, na mey[ mm]b]!
\par bra me nky[n, bra me komam"!
\par Ma m'ani nnye wo dom ho daa,
\par na hw[ me fa me k] nkwam'. \f1 
\par \pard\lang2057\f2 
