\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Kristoni, s]re k]ko,
\par na woadi mu nkonim bi;
\par na worenhu ahot] pa
\par w] wiase ne nna yim
\par Nea ]mp[ s[ ]ko no,
\par rennya nkwa ahenky[w no da,
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[, ]bonsam ne wiase
\par ne wo honam na abom
\par na w]de nnaadaa, ahantan
\par ne ak]nn] res[e wo. 
\par S[ wonko mmarima so a,
\par w]fa wo so ma woyera.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Kae s[ woasua akyer[
\par wo Henk[se frankaa no;
\par kae s[ ]no ayi wo nti,
\par etwa s[ wok]ko bi.
\par Na kae s[ woank]ko de a,
\par w'anim remma nyam ara da.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 4. \}sraani a ]dan n'akyi 
\par kyer[ d]m no, w]s'rew no; 
\par na s[ ogyaw ne mpasua so
\par de hu guan a, wokyi no.
\par S[ ]k]t] adomfiraw
\par n']y[ dommum a, [y[ yaw.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}kofo a wadi nkonim, 
\par na wak] ne kwan yiye, 
\par bedi nkwa abodoo no bi
\par w] soro Paradise, 
\par na daa owu renhaw no da,
\par na daa nkwa b[hy[ ne mu ma
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. D]mmarima a wadi nkonim, 
\par remfi ne Nyame dan mu, 
\par na ]b[tena ne fi daapem,
\par na way[ mu odum bi, 
\par na w]akyer[w ne Nyame din 
\par ne moma so, na ahyer[n 
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Enti y[ nnam, na ko kopa, 
\par na woadi saa nkonim no; 
\par na b] mm]den daa nyinaa'ra, 
\par na woanya saa nnepa no. 
\par Nea ]nko w] ky[w no ho 
\par benya ho daapem aniwu.\f1 
\par \pard\lang2057\f2 
