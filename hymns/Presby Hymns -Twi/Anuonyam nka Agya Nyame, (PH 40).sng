\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Anu'nyam nka Agya Nyame,
\par anu'nyam nka \}ba no;
\par anu'nyam nka Honhom Kronkron 
\par Nyame Baasakoro daa!
\par Anu'nyam mu anu'nyam na 
\par [nka Nyame daa nyinaa!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Anu'nyam nka Yesu Kristo,
\par nea ]d] y[n nyinaa, 
\par nea watew y[n ho koraa, 
\par s[ y[ne no nni hene!
\par Anu'nyam mu anu'nyam na 
\par [nka Nyame Guammaa no! 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Kristo ye ]sor' ab]fo
\par ne n'asafo no Hene.
\par \}ye amansan Hene nso, 
\par soro ne fam koto no.
\par Anu'nyam mu anu'nyam nko, 
\par Anu'nyam ye Kristo de.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Sor' ab]fo to no dwom s[:
\par Anu'nyam [ne nhyira!
\par Na ab]de gye so ka s[:
\par Ahonya, nidi, tumi!
\par Anu'nyam mu anu'nyam y[
\par soro ne fam Hene de.\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

