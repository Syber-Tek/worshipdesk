\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu ne me Botantim,
\par mede wo mewaw m'ani.
\par wo mfe mu mogya ne nsu
\par ne me b]ne ho ad'ru;
\par [n' na edwira me ho\tab 
\par gye me b]ne tumi mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me nsam y[nya biara
\par rentumi ns] w'ani da.
\par S[ meb] mm]den s[ d[n
\par na me nusu sen s[ d[n,
\par b]ne de, [rempopa,
\par gye wo nko ne Gyefo pa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Hwee, hwee ara nni me nsam; 
\par mikita w'as[nduam.
\par Dagyani rehw[ wo kwan, 
\par mm]b'r]ni resr[ wo dom. 
\par W'asuten ho na maba; 
\par guare me m'Agyenkwa pa
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ m'ahome sa me mu,
\par na meka m'ani metom 
\par na me honhom tu fi ha 
\par hu wo w'ahengua so,
\par Yesu y[ me botantim, 
\par ma memfa w' menwaw m'ani.\f1 
\par \pard\lang2057\f2 
\par }

