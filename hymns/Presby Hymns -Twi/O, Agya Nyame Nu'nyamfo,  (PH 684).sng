\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Agya Nyame Nu'nyamfo, 
\par wonam w'agyinatu so 
\par ay[ nnipa mma ahene, 
\par atumfo ne adehye. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[nea wonam w'as[m so 
\par Ahyehy[ ama y[n, no, 
\par saa na woama aba mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[sr[ wo ama nnipa a 
\par wode w]n ahy[ y[n nsa. 
\par Fa wo Honhon Kronkron ma w]n, 
\par na w]de wo tumidi, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par wo ho suro ne wo ho d] 
\par ay[ w]n abrab] botae, 
\par na w]any[ s[ ahufo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma w]ntena ase yiye daa 
\par honhom ne ]honam fam. 
\par Ma wonni w]n ho so 
\par w] amans[m nyinaa mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, Awurade, ma w]n 
\par wo nhyira ne w'ayamye 
\par na woanya aho]den.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. W'aheman mu tenabea h] 
\par na daa ahot] pa w]. 
\par Nea eye na [fata 
\par w] wiase yi mu no 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na w]de b[y[ w]n botae 
\par de ahy[ wo anuonyam, 
\par ]kasa ne nney[e mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Y[n af]re a y[bob] 
\par ne y[n tow a yeyiyi, 
\par ma yemfi koma pa mu ny[ 
\par s[nea [s] w'ani. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na nea y[y[ nyinaa no, 
\par ma [ny[ nea [boa 
\par s[nea wo mma hwehw[.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. O, b[sakra y[ne y[n man, 
\par na y[mmra wo, Nyame, nky[n. 
\par Ma y[nhy[ wo anuonyam, 
\par na y[mfa nidi nsom wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo, ahene mu \}hene, 
\par ma wo soro ahenni no 
\par mm[tena y[n koma mu daa.\f1 
