\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Honhom Kronkron, aky[de pa,
\par woma ahot] ne nkwa.
\par Wo a w]hy[[ wo ho nk]m s[
\par Woy[ kyer[fo no, bra!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo na Agya no somaa wo,
\par fii n'ahengua no anim h].
\par Honhom a wow] tumi,
\par ma me komam ntew mma wo
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O, Apam Foforo b]fo, 
\par agya no aky[de pa, 
\par bra na b[home gu y[n mu 
\par na afei tena y[n komam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nipadua ne ]honam,
\par ]kra ne mu ade nyinaa 
\par benya nkwa foforo no 
\par bere a woba y[n mu
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[de ahopere k[se 
\par Hwehw[ soro h] ak], 
\par na y[anya wo s[ aky[de 
\par w] Agya Nyame no nsam. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea wubehyira no no, 
\par b[sakra w] Kristo din mu. 
\par S[ ofi wiase a, 
\par wob[tena ne koma mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Kristo akyidifo no
\par b[hyer[n s[ nsoromma.
\par Ma anigye here mmra,
\par na y[adi ahurusi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea ]pa wiase
\par b[fa Yesu s[ n'ade 
\par na watena ne h] gyidim. 
\par Dom y[n, na yennya no sa. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wo daa nkwa ns[m a wokae so 
\par na ]nam kaa n'as[mpa 
\par W' awer[how a wudii no 
\par n']de dan nnipa koma. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[nea Yesu suban te,
\par y[ s[nea n'as[m se. 
\par N'anu'nyam ne ne d] no, 
\par wudii ho adanse sa.\f1 
