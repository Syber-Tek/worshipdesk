\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nyame, ma minnya w'anim adom
\par w] w'ahengua anim h] 
\par W'ayamye a [d]]so nti, 
\par popa me b]ne nyinaa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Guare me, yi me ho b]ne 
\par ne m'amum]y[de nyinaa,
\par na dom tew me ho koraa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ampa ara, me mmrato no, 
\par m'ankasa ara mahu; 
\par me b]ne nyinaa w] m'anim
\par awia ne anadwo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo nko ara na mafom wo, 
\par wo na may[ w'anim b]ne, 
\par na woadi bem wo ns[m mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Woy[ Onyame treneeni; 
\par trenee mu na wubu nt[n.
\par B]ne mu na wonins[n me, 
\par na w]woo me b]ne mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wonam w'at[n trenee no so 
\par hu me b]ne a ahintaw, 
\par na [da adi w'anim. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me Nyame, nyi me mfi w'anim
\par na ntow me nky[ne koraa. 
\par Fa Honhon Kronkron gu me mu, 
\par na guare me, tew me ho. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Dom ma minnya wo nkwagye no, 
\par na manya anidaso 
\par [b[hy[ me gyidi den.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Awurade, dom bue m'ano 
\par na ma menka w'ayeyi. 
\par M[ka wo tumi akyer[, 
\par na nnipa akamfo wo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wonhwehw[ m'af]reba kan; 
\par [no nko, [rens] w'ani. 
\par Wop[ komam ahonu.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 6. B] koma foforo ma me, 
\par na ma m'adwene mu ntew. 
\par Ma wo honhom mmehu me mu,
\par na pam m'adwene mu sum.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea meka, nea mey[, 
\par ma [mm] nkwagye kw]n mma me, 
\par na manya w'anim dom daa.\f1 
\par \pard\lang2057\f2 
\par }

