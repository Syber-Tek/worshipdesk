\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame, fa anu'nyam 
\par hyira aware so, 
\par na ]honam ne ]kra 
\par anyin w] honhom mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Okunu ne ]yere, 
\par de anidaso b[hw[ 
\par wo kwankyer[ pa kwan.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{nam Onyame p[ so
\par na w]hy[ aware.
\par S[ aw]regyae ba a,
\par awarefo fom kwan.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{y[ Onyame p[ s[, 
\par awarefo b[bom daa
\par W] nokware d] mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Awurade, ma ]d]
\par ne nokwaredi ntena
\par awarefo nyinaa mu,
\par na w]ny[ fof'ro daa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma w]nwo, na ma w]nn], 
\par na wonnya adwenkoro 
\par ne honhom biako.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma w'as[m no ntena w]n mu, 
\par na enni w]n fi so. 
\par Ma w]nnan ny[ wo fifo, 
\par na ma w]n w'asomdwoe. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma w]n adwene, 
\par kasa, ne w]n nnwuma nna adi 
\par s[ w]y[ wo fifo.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma w]n bo nt] w]n yam daa 
\par s[nea wo p[ te. 
\par Ma w]n wo dom aky[de 
\par w]n nkwa nna nyinaa mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea [hy[ w]n so no, 
\par ma w]mfa 'nigye nsoa,
\par na w]anya mu home.\f1 
\par \pard\lang2057\f2 
