\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, komam D]fo ne Awurade, 
\par wo d] y[ me f[ d[n ara! 
\par M[foro mafi ]yaw bon mu 
\par matwe me ho maba wo nky[n. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{no na s[ nk]mm]di nyinaa 
\par to tw] w] m'asetena yi mu a, 
\par wo d] no bedwudwo me mu. 
\par Fam ha mpo b[y[ me s[ soro, 
\par efis[ wo d] no boro so, 
\par na [ma minya ahot]. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wiase nitan reny[ me hwee, 
\par na [remma minsuro da. 
\par S[ ]haw s]re w] me so a, 
\par [no mu na menya home. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo mu ara na me ho t] me, 
\par wo na woma me wer[ kyekye, 
\par wutim h] daa, n' obi ns[ wo. 
\par Wiase ]haw renhwe me fam, 
\par na ahohia 'sor]kye mu 
\par na wo nsa dennen kura me. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ Sinai so ogya yi me hu, 
\par na mm'ra mu nnome tu me bo, 
\par na f]bu ho dadwen haw me a, 
\par [nde m[k] Golgota so, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na mak] w'as[ndua ase;
\par [h] na meso wo mu dennen,
\par na b]ne nnome anka me. 
\par S[ nnipa nyinna s]re hy[ m' a, 
\par w]rentumi mmu me f] wo nky[n,
\par na wo d] b[b] me ho ban. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ wuso me mu k] sare so, 
\par na mihu amane h] a, 
\par wo soro nsu bedwudwo me kra, 
\par na m[mmee w] w'abotan so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W'anwonwakw]n awiei kyer[ 
\par wo daapem d] ne wo nhyira nko, 
\par minim s[ wo ne me w] h]. 
\par Minim s[ w]n a w]y[ kronkron 
\par na wohw[ w]n so hyira w]n no, 
\par wobr[ w]n ase kan ansa. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Obi bi nsuro owu bio, 
\par na me nso minsuro ara. 
\par Wo Yesu, wo so na m'ani da, 
\par worempa wo nkur]fo da. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{hena na obetu ne kw]n 
\par na w]fa kw]em ne mmep]w so, 
\par na ]rennu fie dwoodwoo? 
\par Me Hann, [nde mede anigye 
\par befi wiase sum mu ak] 
\par na mak]hy[n w'ahot] mu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \{no nti, me komam d]fo pa, 
\par ma wo mu gyidi ny[ me d[. 
\par Wiase ha yaw renkum me da, 
\par wo ho na m'ani gye koraa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma anigye ne ahot] yi 
\par ny[ ]soro de no nsusuwso
\par w] wo dom ne w'ayamye mu
\par Wiase anigye ny[ me de,
\par me Yesu nkutoo mu na memee,
\par me komam ade a mep[.\f1 
\par \pard\lang2057\f2 
