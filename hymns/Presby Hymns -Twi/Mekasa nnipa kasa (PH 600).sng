\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mekasa nnipa kasa
\par [ne ab]fo de,
\par na me komam nni d] a,
\par mete s[ ayowa 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ne d]n a [ma nnyigyei
\par nanso enni nkwa bi,
\par na m'adwuma y[ hunu:
\par may[ magu' ra kwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na s[ minim Onyame 
\par as[mpa ka yiye,
\par na mpo n'ahintas[m no
\par da adi p[ ma me,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na minim soro nyansa
\par na mew] gyidi pii
\par nanso minni ]d] a,
\par [ho nni me mfaso.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ mekyeky[ m'ade mu
\par de  ma ahiafo
\par na mehyew me honam po,
\par nanso ]d] nnim a,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [no reny[ me mfaso
\par na [renwie m' yiye;
\par ]d] ne nea [ma
\par me Kristosom y[ p[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Boaset] w] d] mu;
\par ]d] y[ d[[fo];
\par ]d] mu nni nitan bi,
\par [nhoahoa ne ho;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]d] nso mma ne ho so,
\par na emmuna n'anim;
\par [nhwehw[ n'ankasa de,
\par na ne bo mfuw ade.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}d] nnwen nneb]ne bi;
\par [no ho,n'ani nnye;
\par na n'ani gye nokwarem,
\par [soa haw ne br[;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [w] nokware gyidi
\par ne anidaso pa
\par [ne abot]ase
\par ade nyinaa 'ra mu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Nanso d] to rentwa da;
\par nne[ma nyinaa betwam,
\par na as[nka ne kasa
\par ne nyansa wie sa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par s[ gyidi dan ohu a,
\par ]d] tim h] ara,
\par na anidaso bam a,
\par ]d] b[tena h] daa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. O, Yesu fa saa d] yi
\par b[hy[ me honhom ma,
\par na me de, minni d] bi,
\par ahop[ hy[ me ma.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma memfa saa ]d] yi
\par menhyehy[ me kra ho,
\par na mas] w'ani yiye
\par fam ne soro h] daa.\f1\fs22 
