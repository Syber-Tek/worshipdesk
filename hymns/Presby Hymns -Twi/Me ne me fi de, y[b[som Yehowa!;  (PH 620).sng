\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me ne me fi de, y[b[som Yehowa!; 
\par \}ne y[n Agyenkwa ne y[n Hw[fo;
\par ]ne y[n Nnyinaso a [rentwiw da, 
\par na y[de gyidi begyina no so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na ma wiasefo nhwehw[ as[mpa 
\par w] adefunu ne ak]nn] mu; 
\par y[n de, y[anya nkwa ne asomdwoe y[n 'ra
\par y[n Agyenkwa ne ne mogya no mu. 
\par 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}ne y[n ti, y[ne ne ho akwaa bi,
\par ]de ne mogya kronkron at] y[n;
\par ne d] k[se no, y[n wer[ remfi da;
\par ne nhyira na y[p[ no titiriw.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ofi a ]nte mu na ]bonsam wom,
\par na mmusu w] saa fifo no so daa;
\par ofi a ]te mu na ne nhyira ba 
\par w]ne w]n asefo so daa nyinaa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma nnipa hunu pii no nkyi w]n nkwa ti;
\par nka s[ w]mp[ w]n Yesu ahenni;
\par na me ne me fi de, yebedi n'akyi
\par w] gyidi pa ne d] kronkron mu daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ahot]m na y[n ani gye w] no mu,
\par amanem ogyina y[n akyi,
\par ]ka y[n ho owum po, na ]de y[n
\par b[k] soro ahomeka nom bi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me ne me fi de, y[b[som Yehowa:
\par y[n daaahode ne y[n nkwa ne no
\par As[m yi ne y[n mm'ra a me ne me fi
\par befa so adi y[n ha nna nyinaa
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mesr[ me Wura pa s[ ]mma me mma,
\par me mmanana  ne m'asefo nyinaa
\par nhwehw[ w]n nkwa w] Yesu Kristo nko mu
\par na y[n ani agye [nn[ ne daa.\f1 
\par 
\par }

