\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n, wo din y[ nwonwa!
\par Obi ns[ wo anuonyam da!
\par Y[n ayeyi nnu ho koraa.
\par Woso k[se, w'anim y[ nyam s[,
\par Woahy[ ]hran, wo ho hyer[n s[,
\par wufura hann s[ wo ntama.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wode wo tumi ay[ soro, 
\par owia, sram ne ns'romma no;
\par w'ahengua tim ]sorosoro;
\par adasamma ani nnu h]
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Woma osu muna ]soro,
\par na [te s[ wote ne nsu so
\par de wo mframa ntaban nenam;
\par wopa nyinam ma ]prannaa bom 
\par ma osu tue suwusie nom 
\par te s[ wubed'ru aba fam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wode mframa n'[y[ w'ab]fo,
\par de gya Ii [d[w y[ w'asomfo, 
\par de w]n rey[ wo tumide no, 
\par na nnipa mma asuro woo
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mfiase no wob]] ade,
\par wob]] ]soro ne asase 
\par asase de, woama atim.
\par Na kan no de, nsu kata so,
\par nsu no gyinaa mmep] mpo so,
\par na [te s[ wokaa n'anim:
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W'animka no nti eguanguanee,
\par na wo prannaa no nti [k]e;
\par n'afei mmep] momaa w]n ho so, 
\par na nsu no sen kok]] po mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Osu no nti na nwura fifi, 
\par na aduan fifi asasem, 
\par na nnua pa resow aba.
\par Nnipa didi da Nyame ase, 
\par w]ma w]n fie mmoa nya bi,
\par na nkae no mee mmoadoma.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na ahaban mu ntakraboa 
\par tete nnua abaa no so
\par de nne horow ne w]n dwonto no 
\par yi Nyankop]n ay[ w] so.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Mete ase yi, m[to wo dwom,
\par na mew] h] yi, mehyira wo
\par m[b] wo din makamfo wo,
\par Adasamma, munnyae no din b]
\par na momm[ka me ho ne dwonto,
\par opumpuni s[ nidi pii.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nneb]ney[fo rentena h] da,
\par Ab]nefo besa koraa;
\par na atreneefo som Yehowa 
\par na w]n ani agye no mu daa.\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

