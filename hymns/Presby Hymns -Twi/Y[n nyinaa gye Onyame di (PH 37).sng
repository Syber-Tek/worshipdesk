\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[n nyinaa gye Onyame di:
\par ]b]] soro ne fam ade, 
\par nanso oyii ne ho adi 
\par s[ agya a ogye y[n s[ mma;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]y[n y[n honam ne y[n kra,
\par n'amane bi b[to y[n a,
\par ]de ne tumi gye y[n wom!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na yegye Yesu Kristo di,
\par ne Bakoro ne y[n Wura;
\par n'anu'nyam ne ne tumi 
\par te se Agya no ara de.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Honhom Kronkron de Maria 
\par n'[woo no s[ onipa ba a
\par ]de ne ho sii y[n ananm'.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ohuu amane pii ara
\par wui as[ndua ho ky[[ y[n;
\par wosiee no, na ne honhom 
\par sian k]] asaman h] nnansa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]s]re fii awufo mu, 
\par k]]  soro, te n'Agya nifa, 
\par na daakye wafi h] aba.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na yegye Honhom Kronkron di,
\par ]no nso y[ Onyame bi, 
\par ]s[ \}ba ne Agya no,
\par ]y[ y[n wer[kyekyefo,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]tew Kristo asafo ho;
\par b]ne fafri, honam s]re 
\par ne daa nkwa nam no so reba.\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

