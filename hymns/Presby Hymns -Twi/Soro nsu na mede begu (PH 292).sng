\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. "Soro nsu na mede begu
\par asase kesee no so.
\par Daa nkwa nsu no na mehwie
\par agu asasetam so
\par me honhom ma mehwie
\par magu w'asefo so daa"
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Osuk]m de nnipa ara;
\par [y[ asase nnome
\par Israel afom ]kwan no,
\par na n'ah]den asa.
\par Ne nnwuma pa biara
\par te s[ nt[t[wa bi kwa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nyame s[m y[ nokware,
\par n'anuonyam tim h] daa
\par W]n a w]de nusu gu no,
\par w]de anigye betwa.
\par Onyame nhyirab[ba,
\par [b[ba s[ nsuyiri.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \{no nti, m'ad]fo nyinaa,
\par monk]  so na mony[ nnam.
\par monhwehw[ w]n a w]ayera
\par afi Israel nguan kuw mu.
\par Munhyira w]n na w]mmra
\par Ay[frohyia ase.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Awurade, dom tie y[n,
\par Na soma wo honhom no
\par n']mm[hy[ w'akofofo den 
\par wiase haw ne br[ mu.
\par Yiw, y[n ani da wo so;
\par Wode Sion besi h].\f1 
