\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Wo, Nyame, na miguan med] wo,
\par [nna m'anim rengu ase.
\par Fa wo trenee yi me m'amanem,
\par begye me, y[ aso ma me!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[ me s[ ]botan a atim,
\par na maba h] matena so daa!
\par Wone me ho fasu, wowaw me,
\par na woahy[ s[ wonnye me nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me Nyame, gye me nneb]ney[fo
\par ne at'rimm]denfo no nsam!
\par Na wo nko na m'ani da wo so,
\par na wuyii me fii me na yam!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na enti mifi me mmofraase
\par mede me ho metoo wo so,
\par na [te s[ mifi m'awo mu
\par mede m'akyi mitwerii wo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ampa, wone me Guank]bea,
\par na woay[ me \}botantim;
\par woahw[ me so ma ay[ nwonwa
\par w] nnipa mma bebree anim.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Enti nso miyi w'ay[ daa yi,
\par na m'akamfo wo daa nyinaa.
\par Woayi wo tumi akyer[ me,
\par na w'ayeyi hy[ m'anom ma.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. M'atamfo ka me ho as[m bi 
\par te s[ Onyame agyaw me;
\par wotu me tiri so agyina,
\par wobuw me, p[ s[ was[e me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wose: Muntiw no, monk] d[n no;
\par ogyefo bi nni h] mma no!
\par Na wo, me Nyankop]n, nnyaw me nko,
\par na y[ nt[m na b[boa me!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Me ho as[mp[fo rennya me,
\par na w]n anim begu ase.
\par Na me de, m[tw[n ara daa yi,
\par na meyi Nyankop]n ay[;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na m'ano b[ka wo treneede 
\par ne wo nkwagye daa adesae,
\par s[ wufi me mmofraase hw[[ me,
\par de w'adonne no y[[ wo nkae
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Yiw, wo trenee bunkam  m'adwene,
\par wo na woay[ ade k[se!
\par \{hena na ]te s[ Nyame?
\par Wo mu na manya me nkwagye!
\par \cf1\ul\b\'b6 
\par \cf0\ulnone\b0 Enti mekamfo wo nokware
\par na m'ano to wo dwom ara;
\par na mam nso da wo so daa yi,
\par me ho ara me ho koraa. \f1 
\par \pard\lang2057\f2 
\par }

