\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Fa me nkwa fa y[ wo de, 
\par Awurade, na ma ho ntew. 
\par Fa me nna ne m'adagyew, 
\par na fa kyer[ w'ayeyi
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fa me nsa, kyer[ no kwan, 
\par na [ny[ ]d] nnwuma. 
\par Fa me nan, kyer[ no kwan 
\par ma [nk] nea wop[.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Fa me nne na mento dwom, 
\par me Hene pa no ho dwom. 
\par Fa m'ano na ma menka 
\par w's[m a nkwa wom no daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Fa me sika ne dwet[,
\par m'ade nyinaa y[ wo de.
\par Fa me nyansa, m'adwene?
\par na fa y[ nea wop[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Fa me p[ fa y[ wo de,
\par [reny[ me de bio.
\par Fa me koma y[ wo fi, 
\par tena mu di mu hene daa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Fa me d], m'Awurade pa, 
\par wunim nea [w] mu. 
\par Fa me ne m'ade nyinaa, 
\par na me nso may[ wo de.\f1 
