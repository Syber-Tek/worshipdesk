\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Afei ade anya asa,
\par Owia ak]t].
\par W]n a w]br[ haw w[n ho no,
\par benya home afei.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na wo, y[n Nyame de, wonna,
\par na  wote s[ wote.
\par Sum ntumi nnuru w] wo ho,
\par Hann mu nko na wote.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Enti Awurade, kae me
\par anadwo  sum yi mu.
\par Y[ me ho nkatabo ne ban
\par w] wo hw[sie mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wo ne w'ab]fo no mmesi
\par y[n atamfo no kwan,
\par na w]amfa biribiara
\par anyi me nkwa hu da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ampa, b]ne pii gu me so,
\par n' [twe m'adwene.
\par Nanso wo Ba abetua,
\par na  wadi m' agyinam.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Afei m[ka m'ani at]m,
\par na mafa mu mada.
\par Me Nyankop]n b[w[n me ho,
\par na  manya asomdwoe.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. S[ anadwo yi betwa to
\par w] nusu bon yim' a,
\par [nde  fa hy[n ]soro,
\par na  mentena w'asafom.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Mete ase, miwu ma wo,
\par wo,  m'Agya Nyankop]n.
\par Woy[ nkwa ne owu Wura,
\par y[ me Hintabea!\f1\fs22 
\par \pard\f2\fs24 
\par }

