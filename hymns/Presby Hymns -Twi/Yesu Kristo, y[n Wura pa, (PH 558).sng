\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu Kristo, y[n Wura pa,
\par efi tete bere nom
\par de kosi daakye akyiri,
\par way[ y[n S]fo Panyin.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}y[ me honhom Ahot]
\par ne me gyidi Nnyinaso.
\par \}y[ me nkwagye Owia,
\par nn[, ]kyena, ne daapem.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Bere a me kan asetena
\par maa m'anim guu ase no,
\par ]ma mihuu n'anuonyam,
\par n' akyer[[ me nkwagye kwan.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{y[ n'ahummab] ne dom
\par na [de me te h] nn[.
\par \}ma mihuu n'ad]e nn[ra,
\par na nn[ nso ]y[ me sa
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nn[ s[ ]tamfo no bo fuw,
\par na nnipa huru me a,
\par nn[, ]no na mitie no.
\par Minim no s[ me Nyame;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par nn[, mede anigye soa
\par m'as[ndua di n'akyi.
\par \}no ne nea ne b]hy[
\par ba mu nn[ ne daa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, s[ me wuda redu,
\par na merey[ mawu a,
\par ma mente w'as[m d[d[ s[:
\par \{nn[ wubedu Eden h].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, me Yesu, ma me mm[y[
\par wo mogya kronkron no de,
\par na woay[ daa Yesu Tumfo
\par de ama me nn[ ne daa.\f1 
\par \pard\lang2057\f2 
