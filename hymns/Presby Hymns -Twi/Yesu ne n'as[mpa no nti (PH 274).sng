\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu ne n'as[mpa no nti,
\par monk]ka nkwagye as[m.
\par N'asomafo begye so s[:
\par Y[b[ka n'anuonyam,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par n'awo, ne nkwa, n'as[ndua,
\par ne d] a [y[ nwonwa,
\par ne wus]re ne sorok].
\par Eyi ne w]n as[nka.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Monhw[ s[ wode anigye
\par pae mu ka nkwagye as[m,
\par anafo kosi atifi,
\par de fa nsase ne po so
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{y[ as[m a [pam hu,
\par na [ma anidaso.
\par \{y[ hann a efi soro,
\par na [pam wiase sum. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. W]k] yi, w]de nnwom ara; 
\par w]n dwom ne Halleluya. 
\par W]de ahos[p[ rek], 
\par na wonsuro owu po. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hw[ w]n ntade mu nkekae no, 
\par na tie w]n sankudwom. 
\par Fam ne soro gye w]n dwom so, 
\par na nkonimdi da w]n h]
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. W]n Sahene di w]n anim; 
\par na w]to w]n akodwom; 
\par Immanuel, woadi hene, 
\par woy[ hotefo Wura. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wone nkwa ne hann ne ]d],
\par daa Nyame Baasakoro. 
\par Wo na Nyame ahengua no 
\par y[ wo de nne ne daapem.\f1 
\par \pard\f2 
