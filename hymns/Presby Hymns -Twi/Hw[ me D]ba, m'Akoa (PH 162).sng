\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Hw[ me D]ba, m'Akoa, 
\par obedi no nvansam
\par ay[ m'ap[de ara 
\par akogye me mantam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Obeyi ne ho adi 
\par dom mu ne nokwarem, 
\par nanso w]b[ma no so' 
\par ab] no wuduam!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Okohu amane pii,
\par na n'anim as[e s[;
\par nnipa beyi no ahii
\par abu no akyide.\tab :
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nanso saa amane no
\par b[y[ aho]denne.
\par \}de ne nkwa foforo
\par b[ba nnipa mma mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M'akoa no ad'ru fam, 
\par na ]te nnipam yi, 
\par ]nkyer[ n'anuonyam 
\par nni aho]f[ bi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wobu no animtia, 
\par nnipa pii nso mp] no; 
\par woyi w]n ani hintaw, 
\par y[ no ayayade.
\par 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Efi d[n so? Way[; d[n? 
\par B]ne b[n na way[;, 
\par na ama Onyankop]n 
\par abufuw d'ru no so? 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par So ]de anu]den 
\par afom Nyankop]n nti, 
\par na ]de amane yi 
\par tua no so ka yi?
\par 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ampa, y[n nyarewa no, 
\par ]no na wafa yi; 
\par y[n ayayade no nso, 
\par ]no na wasoa! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n amum]y[ no nti, 
\par w]hwee no piraa no;
\par y[n asotwe daa no so, 
\par na y[n ho at] y[n.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Wohy[[ no aho]yaw pii, 
\par ]y[[ komm kwa w] mu; 
\par w]y[[ no s[ oguanten 
\par de no k]e kokum no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ oguamma at] mum' 
\par twitwafo anim no, 
\par saa ara na way[ komm, 
\par na wammue n'ano.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. W]ahwim ne kra nso af'i
\par ateasefo mu. 
\par \{mo de, na w]ayi no 
\par afi n'ahoguan mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onya de ne kra to h] 
\par s[ kum af]re a, 
\par obehu n'asefo pii, 
\par na ne nna aware.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Nnipa santen b]ne nti, 
\par wahu [yaw ne wu, 
\par na nea ogye no di 
\par benya ne nkwa w] mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ofi ne kra br[ no mu 
\par benya atreneefo, 
\par de w]n abr[ n'Agya 
\par s[ ne mma ad]fo.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Nyankop]n b[ma wamee, 
\par ]b[ky[ no nnipa; 
\par ak[se [ne nkumaa 
\par bey[. n'akatua. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu, wop[ pii no nti, 
\par y[n a y[wo ha yi, 
\par fa y[n hy[ wo mma mu bi, 
\par ma yennya wo nkwa bi!\f1 
