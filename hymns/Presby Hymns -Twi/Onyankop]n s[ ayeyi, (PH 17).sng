\viewkind4\uc1\pard\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n s[ ayeyi, \tab 
\par ]s[ s[ y[da n' ase. \tab\tab  
\par Onyame ye anwonwade. \tab 
\par ]y[ ne manfo yiye
\par Y[n Wer[kyekyefo ne no,
\par ne amane mu Gyefo nso,
\par Yeyi n'ay[ da n' ase
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Otumfo] B]ade[
\par Ade nyinaa h[ w' ase!
\par ]soro asafo yi w' ay[
\par wo fam ab]de wom bi.
\par Na ne tit'riw no, nnipa mma
\par Na [s[ w]n s[ w]y[ saa,
\par woyi w' ay[ da w' ase.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame ade a ]b]e,
\par [so hw[ ny[ no hw[na;
\par na awia ne anadwo
\par ]de dom hw[ no hw[ pa.
\par ]soro n'ade te[ p[,
\par [fam, ]y[ nea [s[.
\par Yeyi n' ay[ da n' ase.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. M'amane mu mefr[e se:
\par Onyame, hu me mm]b]!
\par ]no Nyame atie me,
\par na wakyekye me wer[; 
\par na [no nti me Nyame pa 
\par meyi w' ay[ daa nyinaa'ra; 
\par na m'aseda rennyae da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Onyame da so hw[ ne man,
\par na odi y[n so yiye. 
\par ]no mu y[w] abodam, 
\par Ogye ne nkwa ne nhyira;
\par ]y[ ne ho s[ ena pa 
\par de d] k[se gyigye ne mma 
\par Yeyi n' aye da n' ase.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[ wiase ne mu nnepa 
\par amma awer[kyekye, 
\par na nnipam' boafo nni ha, 
\par na y[repa abaw a,
\par ]no a hwee nnen no da no,  
\par \}b]ade[, Tumfo] Ba, 
\par b[boa mm]bor]fo.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Enti, mehyira no dabaa 
\par makamfo n'ahumm]b] 
\par na n'ayeyi w] m'anom daa, 
\par na merennyae no dwonto.
\par Mo a moy[ ne gyidifo 
\par n'Onyame bu mo kronkronfo, 
\par mony[ no sa abia!
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Y[n a w]fr[ y[n Kristofo 
\par de anu'nyam ma Nyame;
\par y[bom rema ne din no so, 
\par yekamfo ne kesey[.
\par Ma wiase am an nyinaa 
\par mmedan Agyenkwa no koraa!
\par Yeyi n' ay[ da n'ase.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Mommra Nyame B]ade[ anim 
\par anigye ne asedam.
\par Munni nea wahy[ no so p[, 
\par momma y[nto no dwom pa.
\par Nyame y[ n'ade yie p[, 
\par senea wahyehy[ no ara.
\par Yeyi n'ay[ da n'ase.\f1 
