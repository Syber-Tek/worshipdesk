\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me kra, wo ne owia nnyan,
\par na k] wo daa dwumadi so.
\par yi aniha, fa anigye
\par k]b] wo an]pa 'f]re.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fan nn[ s[ da a etwa to
\par si nna a woas[e no kwa 'nan mu.
\par Y[ wo dwt'ri ho adwuma,
\par na kae [da k[se no nso.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma wo kasa ho ntew p[p[,
\par ma w'ahonim ntew s[ 'wia,
\par na Nyame hu ade nyinaa.
\par Kari w'adwene ne w'akwan.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me koma, nyan ma wo ho so,
\par fa w'ano to ab]fo dwom;
\par dwom a anadwo mu nyinaa
\par w]to de yi Nyame ay[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Kamfo Nyame, nhyira fi no;
\par ab]de nyinaa nkamfo no,
\par wonyi Nyame Baasakoro 
\par ay[ s[ ab]fo no bi.\f1 
\par \pard\f2 
\par }

