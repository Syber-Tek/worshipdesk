\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Manya me b]ne tobew, 
\par [da Guammaa no so! 
\par Me b]ne ne me so no
\par y[[ me so d'ru dodo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mede m'asodi maba 
\par Yesu wudua 'se, 
\par na Yesu de ne mogya 
\par popa, na [nka hwee. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Manya me hia tobew: 
\par m'Awurade so n' [da. 
\par \}ky[ me ne nnepa bi
\par na ogye me kra nkwa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu asoa me yaw,
\par me nnosoa ne dadwen;
\par wayi m'afi me haw mu;
\par midi bem ne mogyam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Manya me kra no tenabew
\par me kra a way era.
\par Yesu nifa n' abam me
\par atweri ne kokom.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Med] m'Agyenkwa din yi,
\par Yesu pa Immanuel;
\par [y[ me s[ ngo huam a 
\par eyi hua pa ma me. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Manya me Yesu may] 
\par w] kommy[, odwo ne d]m; 
\par manya me Yesu may], 
\par Agya no Ba Kronkron.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Manya ne nky[n matena bi,
\par na mafra ne manfom; 
\par na me ne n'ahotefo 
\par de f[w bekamfo no.\f1 
\par \pard\f2 
\par }

