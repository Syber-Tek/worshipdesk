\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nyame n' ]maa me me nkwa, 
\par ]maa me nea ehia; 
\par nea menom na midi. 
\par \}w[n me ma metena ase, 
