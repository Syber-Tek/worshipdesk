\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M'Agyenkwa pa k] soro 
\par kogye n'anuony am; 
\par ]katena n'Agya nifa, 
\par na n'ahenni rentwam. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Momma yenyi n' ay[,
\par na ]te soro ma y[n, 
\par di amansan so ma y[n, 
\par ]hw[ y[n so yiye.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. N'anuonyam a kan no 
\par ]w] no soro h],
\par ne d] no nti ogyawee, 
\par ]baa asase so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Osii nnipa ananm',
\par ogyee nnipa amane 
\par ne nnipa yaw y[[ ne de, 
\par w]b]] n'as[nduam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ne wu na ]de wiee 
\par ne gyedwuma k[se; 
\par nnansa p[ na ]s]re 
\par fii wum, n' ]te ase. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Agyenkwa dii nkonim, 
\par na Nyankop]n ab]fo 
\par ne w]n a w]te soro 
\par ne fam kotow n'anim.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. N'anuonyam k[se yi 
\par na ]de hyira y[n; 
\par ne nky[n h] na wasiesie 
\par tenabea pa ama y[n. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n a yegye no di, 
\par hu Nyame fi h] kwan no; 
\par nea odi y[n kan no, 
\par ]twe y[n di n'akyi.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}fr[ y[n ba ]soro, 
\par muntie ne fr[ no, 
\par na papa bi nni hanom, 
\par y[n ha asetena nky[. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Momma mo honhom so, 
\par na mompa fam ns[nhunu
\par na momp[ soro ade 
\par w] nea Yesu w]
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Yesu ne soro Hene, 
\par na ]hw[ n'Agya fi, 
\par na ]soma ne honhom 
\par ma w]n a wogye di. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Adepa biara, 
\par y[n b]ne pii fafiri,
\par ]d] ne nkwa ne nhyira 
\par na ]de ky[ y[n kwa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Obiara a ]p[ s[
\par ne ho b[t] no no,
\par ]mmra na ommetie
\par n'Agyenkwa koro no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Obi nni h] bio;
\par obi rentumi nnye y[n
\par s[ Yesu a ]fr[ y[n
\par se y[mmra soro h] 
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Wob[y[ d[n na woahu,
\par ]soro kwan yiye?
\par Sr[ no ne honhom pa no,
\par na wakyere w' pefee
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par s[nea odii kan;
\par na wo nso kodi n'akyi,
\par na woadu soro h] bi;
\par na n'ankasa ne kwan.\f1 
