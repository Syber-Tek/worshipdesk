\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, me Gyefo ne wo, 
\par mereba wo nwini mu; 
\par [po as'r]kye reb], 
\par na as]re w] me so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fa me sie, m'Agyenkwa,
\par kosi s[ egyae huru;
\par hw[ me so w] m'asetenam,
\par na s[ to twa a, gye me kra!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo nko ne hintabea a
\par mede me kra m[to h];
\par wo nko so na m'ani da,
\par wo nko ne me Boafo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mesr[ wo s[ nnyaw me nko,
\par kata m'adagyaw no so,
\par gyigye me, kyer[ me kwan,
\par fa me sie wo nwini mu! 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo na wo ho hia me,
\par wo 'mu na minya me ho;
\par meda fam a, ma me so.
\par sa me yare, hy[ me den.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo ho tew, woy[ kronkron,
\par na me de, mente[ koraa,
\par na mense[ w'ahot] k'rom,
\par b]ne na ahy[ me ma.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na wo nsam na mihu dom,
\par fa me b]ne firi me;
\par ma wo dom asub]nten
\par mm[hoh'ro me ho yiye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Daa nkwa Asuti ne wo;
\par Mek]nom wo nsu no a,
\par osukam nne me bio,
\par enti fa ma me saa daa.\f1 
\par \pard\lang2057\f2 
\par }

