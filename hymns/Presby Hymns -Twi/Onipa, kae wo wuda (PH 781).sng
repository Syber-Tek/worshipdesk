\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onipa, kae wo wuda
\par ne  wo nkwa awiei!
\par Owu taa ba nt[m ara;
\par Wuguan a, [ny[ 'ye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[s[[ ]kyena, nn[ po,
\par wo d]n  benya adu;
\par enti, ]deb]n'y[fo,
\par kae wu na nu wo ho!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onipa, kae wowu da,
\par nanso kae atemmu!
\par Emu na nnipa benya
\par bembu anaa fobu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na w]rennyaw befua,
\par na mmom obiara
\par benya h] akatua
\par s[ ne bra te w] ha.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onipa, kae wow u da,
\par na mfra ahuhufom,
\par na amma woank]s[e kwa
\par amanuhunu k'rom.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na nkwaseafo pii pa
\par hwehw[ ha anigye;
\par na wo de, sua nyansa
\par na hw[ wo ho yiye!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Onipa, kaw wow u da,
\par kae s[ fam ade twam!
\par S[ wop[ a, wubenya
\par soro anu'nyam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Agyenkwa Yesu gyidi
\par na  fa so b] wo bra.
\par \}ky[ wo ne trenee bi
\par ne daa ahomeka.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Onyame, ma menkae wo
\par ne Yesu as[mpa.
\par na  ma minnwen me wu ho
\par minsiesie me koma!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea wode b[ma me,
\par ma  memfa f[w minnye!
\par na nea [b[s[e me,
\par ma [no mpare me!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Dom me ma meny[ nt[mpa
\par minnu me ho w] ha,
\par na memmata m'Agyenkwa ho,
\par na minni n'akyi daa!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu ne atemmu mu
\par m'ani da Yesu so.
\par Fa me k] soro hannn mu, 
\par na mnsom wo w] h]!\f1\fs22 
\par \pard\f2\fs24 
