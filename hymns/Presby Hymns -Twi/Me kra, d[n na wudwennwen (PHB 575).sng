\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me kra, d[n na wudwennwen 
\par haw wo ho w] fam ade ho? 
\par Ne nyinaa b[sen ak] 
\par ay[ mfutuma ne d]te. 
\par Hwehw[ w'Agyenkwa no nko, 
\par gyefo fofro bi nni h]! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Tase w'adwenem yiye, 
\par yi w'ani fi fam hw[ soro; 
\par hwehw[ Nyame akyi kwan,
\par sr[ no dom ne mm]b'r]
\par \{w] w'Agyenkwa no mu, 
\par gyefo fofro bi nni h]!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo honhom fi Nyankop]n, 
\par na wo honam nko fi fam ha; 
\par na wo b]ne s[ee wo no, 
\par Yesu ba begyee wo bio.
\par Enti fa wo ho ma no, 
\par gyefo fofro bi nni h]!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wohwehw[ ]home pa a,
\par worennya w] fam ade mu
\par wubenya ahomey
\par w] w'Agyenkwa d] k[se mu. 
\par Fa wo ho bata no ho, 
\par gyefo fofro bi nni h]!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Hw[ w'Agyenkwa anu'nyam 
\par ne nea way[ ama wo; 
\par fa y[ w'ani so as[m 
\par na woanya [so mfaso bi,
\par Yesu begye wo nso, 
\par gyefo fofro bi nni h].!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Kae no w] ade nyinaam, 
\par na di n'asem a ]kae so. 
\par Na wagyaw wo nhw[so pa, 
\par na aho]den w] no mu. 
\par \}de b[hy[ wo nso bi, 
\par gyefo fofro bi nni b].
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Di w'Agyenkwa akyi daa, 
\par na ntoto wo mpaeb] ase, 
\par na fa wo nsennii nyinaa 
\par fa kyer[ se woda n'ase
\par \}ne w'adepa koro, 
\par gyefo fofro bi nni h]! 
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Wuso w'Agyenkwa mu saa a,
\par ]de wo b[k] ne soro,
\par na wo ho at] wo daa,
\par ]no ne n'Agya anim h].
\par Hwehw[ w'Agyenkwa no nko, 
\par gyefo fofro bi nni h].\f1 
\par \pard\lang2057\f2 
