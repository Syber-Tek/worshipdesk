\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo kwan ase ne soro,
\par nea Nyame w];
\par wiase nnepa ho de,
\par mmoa nhaw wo ho!\cf2 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
