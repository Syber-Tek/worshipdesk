\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ wo wer[ ahow a,
\par y[ nt[m hw[ soro;
\par na wo soro Agya no
\par de d] hw[ wo so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par D[n n'[haw wo? 
