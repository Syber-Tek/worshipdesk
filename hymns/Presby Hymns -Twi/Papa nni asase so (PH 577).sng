\par Sum nni h], emu y[ hann; 
\par ma w'ani nka!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Soro na w'Agyenkwa w], 
\par ]nam aniwu
\par ne awer[hom k]] h];
\par wo nso di n'akyi!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
