\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. B]ne benya n'akatua; 
\par b]ne so ade ne wu! 
\par Na s[ Yesu wu ammam' a, 
\par y[renkwati afobu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Yesu agye y[n amane 
\par ne y[n wu ay[ ne de; 
\par Yesu mogya na Onyame 
\par agye te s[ mpatade.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nyame de ne wu kyer[ s[,
\par ne trenee mene owu,
\par ]nam n'ahumm]b]
\par ne wu so agye y[n nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}w] kwan s[ ]de b]ne 
\par befiri ne gyidifo, 
\par na w]anya ne d] mu home, 
\par daa nkwa [ne ahot].
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{y[ saa a, na ne trenee no 
\par b[boro y[n b]ne so
\par ne trenee mene y[n mm'rato, 
\par na ne nkwa mene y[n wu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[ b]ne dii hene kan no, 
\par de y[n k]] owu mu no, 
\par saa na trenee bedi hene 
\par de y[n ak] nkwa mu nso.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Na afei de, y[nsom b]ne, 
\par y[nto Nyame mm'ra bio;
\par Yesu di koma mu hene, 
\par n']sakra y[n nney[e nso.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Y[hwehw[ s[ Kristo mogyam 
\par yebenya y[n bembu a
\par y[mfa b]ne bi ny[ Kristo
\par atamfo bi mpo anaa?
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Dabi! Mawu mama b]ne; 
\par me ne Kristo te ase; 
\par Kristo de ne wu agye me, 
\par na ne nti mete ase.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. Na [nde, [ny[ me bio; 
\par Kristo te ase me mu, 
\par na mete ase mema no, 
\par ne d] ne ne gyidi mu.\f1 
