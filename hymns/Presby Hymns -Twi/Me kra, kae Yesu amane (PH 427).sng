\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me kra, kae Yesu amane, 
\par kae ne wu a owu ky[[ wo! 
\par S[ ne dom ho k]m de wo a, 
\par di ne honam, nom ne mogya! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ m'Agyenkwa d] me s[[ yi, 
\par [ma m'ani gye w] ho pii; 
\par wagye me yaw ay[ ne de, 
\par de ne papa ay[ me de.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mahu m'Agyenkwa no dedaw,
\par manya ne mu aw'r[kyekye
\par na ]ye me Kw]nkyer[fo 
\par w] ]soro ]temp]n so
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ m'Agyenkwa ka me ho yi 
\par memp[ anigye fororo bi,
\par ]n' na mafa no adamfo
\par n'ahumm]b] na mekamfo. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nanso mede anigyina
\par m[k] m'Agyenkwa pon ho;
\par mek] n'adidi ase a, 
\par menya mu abot]yam pa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par efis[ mihu ampa s[ 
\par ]n'na wahy[ saa apam yi, 
\par na ]de ne wu agye me, 
\par na ]de ne ho aky[ me.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Abodoo a wobubu yi, 
\par mede aseda medi bi; 
\par [y[ m'Agyenkwa honam a
\par ]nam so ma me ne daa nkwa
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me gye nti, na wopiraa no
\par kum no w] n'as[ndua ho, 
\par na w]de no too boda mu,
\par na onyan w] n'anu'nyam mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  Bobesa a wohyira so yi,
\par mede aseda m[nom bi;
\par na [y[ m'Agyenkwa mogya a
\par wahwie agu ama me. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ ne ho suk]m de me kra, 
\par na m'ani gyina no nko a,
\par ]de nsa yi di m'adanse 
\par s[ manya b]ne fafiri. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. O, m'Agyenkwa, mey[ mm]b], 
\par na wo dom k[se yi tra so;
\par woagye me afi me b]nem, 
\par na wo nti me ho at] me. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Enti siesie me koma mu, 
\par na fa wo honhom b[tena mu,
\par na ma me honhom ne me kra
\par [ne me honam nnya daa nkwa. 
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. O, m'Agyenkwa ne me D]fo,
\par d[n n' afei menhwehw[ bio? 
\par D[n na [so s[ wo d] a 
\par wode d] y[n, ky[n y[n daa nkwa? 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ manya saa Agyenkwa yi, 
\par hwee nni h] a [b[haw me; 
\par minsuro wu ne asaman; 
\par m'Agyenkwa b[b] me ho ban. \f1 
\par \pard\lang2057\f2 
\par }

