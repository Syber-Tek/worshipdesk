\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Baabiara a 'wia fi,
\par efi po ano k] n'agya,
\par Yesu Kristo bedi hene
\par akosi wiase ano.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]b[b] no mpae ara daa, 
\par nidi b[y[ n'abotiri, 
\par na an]pa biara mpae 
\par b[ma ne din ak] soro.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. W]b[b] no mpae ara daa, 
\par nidi b[y[ n'abotiri, 
\par na an]pa biara mpae 
\par b[ma ne din ak] soro.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}dom pii w] n'ahenni mu,
\par nneduafo fa w]n ho di;
\par abr[fo nya home pa daa;
\par ahiafo y[ adefo.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma wiase mu ab]de
\par mfa ayeyi mmr[ y[n Hene,
\par na asase ne sorofo
\par ato dwom ayi n'ay[ daa.\f1 
\par \pard\f2 
\par }

