\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu, wo nky[n na m[tena; 
\par daa na m[som wo nkutoo! 
\par Ade biara rempam me, 
\par m[fa wo kwan pa no so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wone me nkwa mu nkwa pa no, 
\par me kra mu anuonyam; 
\par s[nea bobe ma ne baa nkwa, 
\par s[ woy[ ma me nso nen.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hena na ]y[ me yiye 
\par sen wo a wodom me daa? 
\par Dom nnepa bebree w] wo mu 
\par ma me a midi hia. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hena na ]ma me wer[ 
\par kyekye sen wo, me wura a 
\par w]de soro ne asase so 
\par tumi ahy[ wo nsa?
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{he na mehu saa wura a 
\par way[ nea Yesu y[e?
\par \}de ne mogya at] me
\par w] owu ne b]ne mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Meny[ nea ]de ne nkwa 
\par ama wu no de anaa? 
\par So minnsua mennkyer[ no 
\par s[ medi n'akyi ara?
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Anigye mu ne amanem
\par m[tena wo nkutoo nky[n daa; 
\par mede me honhom, me honam 
\par ne me kra mehy[ wo nsa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea wop[ no na m[y[, 
\par wofr[ me fi ha a, m[k]; 
\par s[ mebata wo ho daa a, 
\par wu po reny[ me wuna.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ka me ho ewi yi ase, 
\par na s[ me da y[ adu 
\par na s[ ade ye asa me, 
\par na owu sum adur' a, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [nde te[ wo nsa gu me so 
\par hyira me na se me s[: 
\par Me ba, wo fam tena ahi ni, 
\par enti bra b[tena nkwa pam!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[ owu reyi me hu a, 
\par Wura Yesu, ka me ho! 
\par Y[ me Hann owu bon sum mu, 
\par na ma daa ade nkye me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M'ani so rey[ kusuu a, 
\par b[haran ma me honhom, 
\par na mafi ha mak] h]nom 
\par s[ ]h]ho k] ne k'rom.\f1 
\par \pard\lang2057\f2 
\par }

