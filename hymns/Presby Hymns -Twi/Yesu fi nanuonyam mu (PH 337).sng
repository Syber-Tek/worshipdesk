\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu fi n'anuonyam mu 
\par soma ne Honhom Kronkron 
\par ba n'asuafo koma mu, 
\par s[ ]de b[hy[ w]n den,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na w]afi ak] aman so
\par akodi nnipa adanse 
\par s[ w]nsakra w]n koma,
\par na way[ w]n Agyenkwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na n'asomafo as[m yi
\par abedu y[n k'rom ha bi;
\par na obiara a ]te no,
\par [s[ no s[ ogye di.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me nso na ne d] aka me
\par s[ memfa me ho memma no;
\par manya no s[ m'Agyenkwa,
\par enti meda n'ase daa.\f1 
\par \pard\lang2057\f2 
\par }

