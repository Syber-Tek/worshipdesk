\par 1. Yesu, me kra adamfo pa, 
\par m[hw[ wo d] k[se no a 
\par [ma wuwui dua ho no, 
\par de gyee y[n w] y[n b]ne mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me b]ne na as[e me s[, 
\par na [ma m'anim gu ase;
\par nanso wotow wo pon ma me, 
\par mitwi meb[n a, wompam me
\par \cf1\expndtw-2 
\par \ul\b\'b6 Verse 3\ulnone\b0 
\par 3. \cf0\expndtw0 Minim s[ me ho ay[ fi, 
\par mey[ mm]b], ohia de me; 
\par meyare, m'ani afura,
\par mente[, na meda 'dagya.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na wone y[n duruy[fo, 
\par y[n kanea a [tew y[n ho;
\par wone Wura a enhia no hwee, 
\par y[n ho tam pa ne wo trenee
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Enti, Yesu,mesr[ wo s[,
\par b[sa me yare no ma me;
\par me ho y[ fi a,guare me, 
\par wo mogya nti, me ho befi.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Fa wo dom b[hw[ me koma,
\par b[s] me gyidi kanea; 
\par me hia mu, ky[ me w'ade, 
\par na mammu wiase'de hwee.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Tu ak]nn] fi me komam,
\par na fa wo d] ne gyidi hy[m;
\par wo ankasa nso b[tena mu, 
\par na daa ma me ne wo mmom p[.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Boa me, ma me b]ne no 
\par mfi me mu w] ]pon yi ho;
\par nea may[,fa firi me,
\par na m'ani nnye wo dom no ho.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Bra b[pam m'atamfo nyinaa; 
\par di me koma mu hene daa;
\par na as[mpa a [w] me t'rim,
\par ma wo honhom no nhy[ no den.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. Ma m'abrab] ne me nney[e, 
\par [ny[ s[ wo ara wop[, 
\par tu me fo daa, na m'asetena 
\par ak] so yiye nna nyinaa. 
\par 
\par \cf1\ul\b\'b6 Verse 11\cf0\ulnone\b0 
\par 11. Ansa na wo, Yesu, woaba, 
\par na woab[fa me w] fam ha, 
\par na mak]tena wo soro daa, 
\par na mamee wo nky[n h] koraa! \f1 
