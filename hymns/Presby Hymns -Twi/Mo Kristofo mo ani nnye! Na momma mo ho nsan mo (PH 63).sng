\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mo Kristofo mo ani nnye! 
\par Na momma mo ho nsan mo!
\par Momfa ahosan nto dwom pa 
\par y[n Nyame d] k[se ho!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}de ne D]ba no maa y[n, 
\par n']nam ne wu so begyee y[n, 
\par saa gye yi bo y[ den s[[.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}tamfo no akyere me, 
\par na mayera owu mu, 
\par na awia ne anadwo 
\par me b]ne how me wer[.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Metaa mey[ b]ne ara
\par na papa bi nni me mu da, 
\par me b]ne boro me so.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M'amanehunu yi nti na 
\par Onyame huu me mm]b];
\par ]kae ne mm]b'r]hunu no
\par na ]p[ s[ ogye me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Oyii ne d] kyer[[ me fee, 
\par [nye agoru n'ogoru;
\par wankame me ne D]ba.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Osee ne Bakoro no s[:
\par Timm]b] bere adu;
\par enti na wo, m'ahyehy[de,
\par kogye w]n fi w]n b]nem,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par yi w]n, fi awer[how mu;
\par fa wo wu kum w]n wu m'a w]n
\par na ma wo nkwa mmra w]n mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}ba no tee n'agya as[m,
\par  ofi soro baa fam ha,
\par na ababaa kronkron woo no 
\par \}d] me s[ ne nua;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ]koraa ne tumi so,
\par b[y[[ hiani te s[ me,
\par ]p[ bonsam as[e no.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \}baa me nky[n, n'osee me se;
\par "B[ka me ho, di m'akyi;
\par mede me ho masi w'ananm 
\par na hw[, m[ko mama wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mey[ wo de, woy[ me de,
\par nea m[tena, wobetena bi,
\par na y[ay[ baako daapem. '\f1\fs22 
