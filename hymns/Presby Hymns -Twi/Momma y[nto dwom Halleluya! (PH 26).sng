\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Momma y[nto dwom Halleluya!
\par mma y[n Nyame daa w] soro.
\par Mo soro asafo, monto dwom;
\par mo ab]fo, monka ho bi! '
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owia ne sram, monto mo de,
\par mo nsoromma, momm[ka ho!
\par \}soro mu soro, monto dwom,
\par mo nsub]nten, munyi n' ay[!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ab]de, monkamfo mo Nyame!
\par \}de n'as[m na [y[[ mo.
\par \}kyer[ mo kwan a monam so, 
\par na obi anyera ne kwan,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mo a mote asase so no,
\par monkamfo ne din kronkron no,
\par n']sorofo ne famfo nyinaa
\par mommom nyi Ony'ame ay[.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Suwisiw, ogya, ahum nyinaa,
\par mo a moy[ n'asomfo no, 
\par mo mmep], nkoko ne mo nnua, 
\par mmoadoma ne nnomaa nso;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par mo ahemfo ne mo atumfo, 
\par atemmufo ne ]manfo,
\par mo mmofra ne mpanyin,mm'rantewa 
\par ne mmabaa, munyi n' ay[ daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ne din kor]n sen din biara,
\par n'anu'nyam kata s'ro ne fam,
\par ne nk'r]fo a w]tete fam no 
\par na ]de n'ad]e ma w]n so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par N'ab]de horow, momm[ka ho, 
\par monto Amen, Halleluya!
\par Munyi y[n Yehowa din ay[, 
\par mo Kristo a munim no!\f1\fs22 
\par \lang2057\f2\fs24 
\par }

