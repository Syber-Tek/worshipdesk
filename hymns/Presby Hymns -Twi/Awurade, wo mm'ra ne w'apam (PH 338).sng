\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade, wo mm'ra ne w'apam,
\par wode ma s[ wonni so.
\par Wo a woy[ nokwafo no,
\par woakyer[w w] me komam
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par s[ minni papa akyi,
\par na minnyae nkontompo nney[e
\par na madi wo mm'ra no so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma m'ani nna wo nkutoo so,
\par na ma minsuro wo daa.
\par Na mede me koma nyinaa
\par ad] w', asom wo nkutoo,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nnipa ak[se, wiase,
\par aho]den ne anu'nyam
\par reny[ me anyame bi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma me wo Honhom Kronkron no,
\par na [mm[y[ me mu hyew,
\par na entu me mu b]ne no,
\par n'ada me adi ampa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wow] kyer[w nsem kronkron mu;
\par ma mimfi honhom mu nsom wo,
\par na minyi wo din ay[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma wo din kronkron no ho ntew
\par w] me kasa nyinaa mu;
\par hw[ me koma ne m'ano so.
\par na many[ adehunu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na daa nyinaa masusuw 
\par s[ wo din kronkron no nko mu
\par na w]b]] m'asu hy[[ mu!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma menkae wo homeda no;
\par na me nso menhome bi;
\par m[kae s[ wo da no ho tew,
\par na mafa so asom wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo kasa ho na m'ani gye;
\par me, ne m'asafo behyiam
\par anigye ne asedam'!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ma me y]nko bra ne n'akwan
\par ny[ kronkron ne f[ mma me;
\par m[b] ne nk]so ho mm]den
\par na madi no nokware.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Enti daa mekyi atoro,
\par nsisi ne yaw ne nkontompo;
\par meyi afi me komam!
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 7. Mma m'ani mmere ade a
\par [y[ me y]nko bi de;
\par ne fi, ne yere ne ne mma.
\par Ma minnya w]n ho koma,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ma nea [ho hia,
\par na ma m'ani nnye [no ho
\par w] wo dom k[se no nti.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. O, Awurade, hw[, mawie 
\par w'ahy[de ne wo som no;
\par hw[, aho]den na minni, 
\par enti dom ma minnya bi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par O, Agya Onyame, dom me! 
\par Nyame Ba Yesu, hu ma me! 
\par Honhom Kronkron, boa me.\f1 
\par \pard\lang2057\f2 
\par }

