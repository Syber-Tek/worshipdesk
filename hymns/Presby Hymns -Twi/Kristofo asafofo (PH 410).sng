\par 1. Kristofo asafofo,
\par monhy[ akode pa! 
\par na momma mo ho ny[ mo den 
\par Onyame tumi mu! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Asafo Yehowa, 
\par Onyame Tumfo] 
\par de ne tumi b[hy[ ne mma 
\par n' w]atumi ako 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Eyi nti munkura
\par Onyame akode, 
\par na moatumi agyina daa 
\par de akosi ase.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Munnyina h] yiye, 
\par mony[ mo ko mu nnam, 
\par n']b[ma awie yiye 
\par ne daa ahomekam.\f1 
