\viewkind4\uc1\pard\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Kamfo Yehowa, Otumfo, Nu'nyamfo ne Hene!
\par Wo a wagye wo, na [s[ s[ woda no ase!
\par Mommehyiam! Momfa asanku ne nnwom 
\par mmeyi ne din ay[ yiye!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Kamfo Yehowa, ne tumi di ade nyinaa so;
\par ]de ne k]re ntaban asoa wo wo kwan so;
\par ]de nnepa ne anigye hy[ wo ma;
\par da n'ase na yi n'ay[ daa!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Kamfo Yehowa, ne nyansa na ]de nwenee wo 
\par ma wo ho ay[ wo den na woda so te h] nn[.
\par W'ahohiam ]de timm]b] ne dom 
\par ahw[ wo akata wo so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Kamfo Yehowa ne ne d] a ]de hyiraa wo!
\par ]ma n'ad]e su t] gu wo honam ne wo kra so.
\par Kae no na hw[, way[ wo ade k[se!
\par ]de d] da so di w'akyi.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Kamfo Yehowa, me kra, b] ne din a nkwa wom, 
\par na fa wo dwonto fra soro asafo no de nom!
\par ]ne wo hann; ]kyere wo soro kwan.
\par Koyi n'ay[ w h] daapem!\f1 
\par \lang2057\f2 
\par }

