\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Yesu a wusian
\par fii Agya no kokom bae;
\par wode w'as[m br[[ y[n
\par s[ [nkyer[ y[n wo d].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[b[fa w'as[m so
\par ahu y[n Nyame d]
\par W'ab]fo as[nka
\par ma w'asafo som wo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nnipa a wofr[[ w]n
\par y[[ w]n w'asafo mma no
\par fa wo kyer[ pa no 
\par hy[ w]n mu w] wiase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fa wo honhom pa no 
\par hy[ w]n koma mu ma, 
\par na ma w]n ano nka 
\par wo ns[m a [ma nkwa
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Hyira w'as[m no so
\par na [ny[ nnam y[n komam. 
\par Fa w'aduan pa no 
\par ma w'asafo nguan kuw no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fr[ nguan a w]ayera 
\par na sa w]n nyarewa; 
\par nyan w]n a w]ada no, 
\par na tu w]n mmer[wy[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Siw kyer[ b]ne kw]n,
\par na s[e w]n adwenhunu; 
\par ma y[nsua ns[m a 
\par [kyer[ y[n nkwagye kwan. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yi nsisi fi y[n mu,
\par na y[ny[ biako; 
\par ma y[nnya nnepa a
\par efi wo dom no mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wo nguan a w]apete,
\par fa w]n bra wo ban no mu;
\par na w]n a wo wo mu,
\par hy[ w]n den na boa w]n.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma w'as[m no nnyina,
\par na nguan ne nguanhw[fo
\par any a wo mu gyidi,
\par na w]anya wo nkwagye.\f1 
\par \pard\lang2057\f2 
