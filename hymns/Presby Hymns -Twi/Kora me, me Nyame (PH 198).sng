\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Kora me, me Nyame, 
\par wo na miguan toa wo. 
\par Mise Yehowa s[, 
\par m'Awurade no ne wo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}no ne m'ade pa, 
\par n'akyi, obi nni h]. 
\par Asase so teefo, 
\par w]n nyinaa' ra w] no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nnipa a w]te[,
\par w]n na n'ani s] w]n daa. 
\par \}haw a [d]]so 
\par n'[to w]n a w]po no, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w]ne w]n a w]w] 
\par anyame foforo; 
\par wohwie mogya gu, 
\par enti Nyame kyi w]n.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Enti Yehowa y[
\par me kuruwa mu ky[fa. 
\par \}no na ]ma me 
\par nnepa a [tena h] daa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}ma mihu n'ad]e,
\par ne dom d]]so ma me;
\par agyapade pa no
\par na [y[ me ky[fa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. M[som Yehowa daa, 
\par ]kyer[ me kwantrenee, 
\par na otu me fo pa
\par awia ne anadwo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mede Awurade 
\par asi m'anim daa yi.
\par \}w] me nifa nti,
\par merenhim ara da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Me koma t] me yam,
\par me mu di ahurusi,
\par me honam tena h] komm,
\par na [rens[e ara da.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na worennyaw me kra
\par w] asaman koraa;
\par w'ahotefo nyinaa
\par renhu ]dam' por]w
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Afei woma mihu
\par wo nkwa kwan turodoo no
\par na woma me kra mee 
\par wo w'anim anigye mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Anika a [mee 
\par w] w'anim h] bebree;
\par koma pa, anigye 
\par w] wo nifa h] daa.\f1 
\par \pard\f2 
