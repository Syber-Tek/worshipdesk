\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mm]b'r]hunu Nyame gyaa me, 
\par ]de m'aka aky[ me. 
\par Saa s[mpa kyekye me wer[ 
\par ma me gyidi ani gye. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me kra, da Onyame ase; 
\par n'adeky[ yi y[ k[se;
\par n'ahumm]b] na ayi me
\par duam ne afiase.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. M'aka no renhaw me bio,
\par Yesu bedii m'agyinam. 
\par Me Yesu de ne mogya mpo
\par abetua ne nyinaa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me kaw a mede me Wura 
\par so boro mpempem ara; 
\par na s[ w]b[dan me kaw a,
\par anka mehu daapem yaw.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M'aka no d]]so pii nti na
\par anka me kra wer' ahow;
\par na \}hene abufuw no
\par ma hiani ho popo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na \}kagyinamdifo no
\par di ma me w] Nyame h], '
\par enti na me ky[wpa ka no,
\par na ]dom ne defirifo. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Afei mede me ho fofro,
\par na ]t]n bi ntu me bo;
\par na Onyame gye me bio; 
\par Yesu ne me Patafo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mede anigye mewu po, 
\par gyidim na m[kamfo s[: 
\par Mm]b'r]hunu Nyame gyaa me, 
\par na me wer[ akyekye.\f1 
\par \pard\lang2057\f2 
