\par 1. Asafo no nnyinaso 
\par ne Yesu Kristo nko; 
\par n'as[mpa ne asub] 
\par n' ]nam so hy[[ ase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ofi soro b[hwehw[e, 
\par y[[ no n'ayeforo
\par ]de ne mogya t]] no, 
\par na owu gyee no nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Asafo no mu apae 
\par nanso [y[ baako, 
\par w]n wura ne w]n gyidi.,
\par ne asub] y[ k'ro'.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu din nko na w]b], 
\par w]n aduan y[ k'ro;
\par anidaso baako nso
\par n']de ko k] n'anim
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nnipa hu asafo yi 
\par s[ w]apete mm'roso; 
\par wohu s[ emu apae 
\par na at'ro kyer[ wom!,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par nanso ahotefo pii
\par k] so w[n, b] ho mpae
\par na [renky[, nusu yi
\par b[dan anigye dwom.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}ne Nyame Baasak'ro
\par y[ baako w] fam ha. .
\par \}ne ahotefo a
\par W]anya soro h] kwan
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par y[ baako Nyame dom mu.
