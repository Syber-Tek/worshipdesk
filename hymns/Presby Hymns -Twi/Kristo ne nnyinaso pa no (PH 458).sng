\par 1. Kristo ne nnyinaso pa no,
\par Kristo y[ tweatibo.
\par On'na Awurade ayi no,
\par na ]ka n'asafo bom,
\par Sion Kronkron h] boafo
\par ne h] daa ahotoso.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Awurade, bra y[n dan yi mu,
\par nea y[ahyia ha yi.
\par Fi w'ayamye k[se no mu
\par tie wo nkoa mpaeb].
\par Na fa wo nhyira bosu no
\par pete ]dan yi mu daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Br[ w'aso ase ma wo mma,
\par na tie w]n adesr[.
\par Nea wonya fi wo nky[n no,
\par dom ma [ny[ w]n de daa,
\par na da bi w]ne wo adi
\par hene w] w'anu'nyam mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nidi ne nhyira nka Agya,
\par \}ba ne Honhom Kronkron,
\par Onyame Baasakoro no.
\par Tumi ne nidi w] wo.
\par Woy[ mmeresanten Nyame,
\par w'ahenni w] h] daapem.\f1 
