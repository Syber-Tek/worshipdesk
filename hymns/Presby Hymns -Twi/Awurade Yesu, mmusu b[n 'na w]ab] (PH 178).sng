\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade Yesu, mmusu b[n 'na w]ab],
\par na ama wo man abebu wo kum f]?
\par Wo so ne d[n? Amum]y[de
\par b[n po na [da wo so?
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]kaa wo mmaa, na w]de ns]eky[ hy[[ wo,
\par b]] w'ani so, hinam wo so ntasu nso,
\par w]maa wo b]nwoma, na w]tr[w
\par wo nsa mu b]] wo wuduam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{d[n so na efi ma w]y[[ saa yi?
\par Ampa, me b]ne na agu w'atifi!
\par Me wura Yesu, me na mab]
\par mmusu, na wo de, woafa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ampa, w'asotwe yi y[ me nwonwa s[!
\par Wokum wo, Guanhw[fo, de maa wo nguammaa!
\par Wo, Awurade no w]ma
\par wutuaa ka maa wo nkoa po.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{y[ wo d] k]se a wode d] me,
\par enti na wubehuu amane maa me!
\par Migye m'ani w] ha nneb]ne
\par mu a, woda amanem!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. M'Agyenkwa, d[n na memfa menna w' ase?
\par Menkamfo wo d] d[n na ay[ yiye?
\par \{tra m'adwene, me nney[e
\par Ne m'ano; meny[ wo d[n po?
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. \{d[n ade na meny[ na woapene?
\par M[pa me ho akyi, ]honam ak]nn],
\par na meremma [nhy[ me so
\par ntwe me da, na many[ b]ne.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Meb] m'akonn] no as[ndua mu.
\par \{wom, eyi po nni m'aho]den mu,
\par enti mesr[ wo, dom fa wo
\par honhom so b[hy[ me den sa!
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Ma menhw[ wo d] ne  wo dom no yiye,
\par na mammu wiase nnefunu hweet[!
\par M[b] mm]den pa.may[
\par w'apede sa; boa me w] mu.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. Medi wo akyi; meye wo suani,
\par na meremmu ewiasefo nsopa.
\par W]haw me taa me a,ma
\par minnyinam pi, na mamfi w'akyi.
\par 
\par \cf1\ul\b\'b6 Verse 11\cf0\ulnone\b0 
\par 11. Eyinom nyinaa sua ampa, [nn]]so,
\par nanso minim s[   m'Agyenkwa rempo da.
\par Dom gye me nsam nea
\par Mew] de ma yi! Gye me koma bi.
\par 
\par \cf1\ul\b\'b6 Verse 12\cf0\ulnone\b0 
\par 12. Awurade Yesu, wote w'Agya nifa!
\par S[ da bi midu w'ahengua anim a,
\par Meb] hemtnot'fi, m[to h]
\par dwom pa bi mayi w' ay[ daa!\f1 
