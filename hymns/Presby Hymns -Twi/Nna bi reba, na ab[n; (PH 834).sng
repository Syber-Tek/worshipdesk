\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nna bi reba, na ab[n; 
\par wiase behu b'ribi. 
\par Anu'nyam Hene no reba, 
\par nnipa nyinaa behu no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea ]de ayamye
\par fr[ y[n nnipa nn[ da yi,
\par ]no na ]rebebu nt[n,
\par na wapae nnipa mma mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}b[y[ akuw abien
\par w] nnipa mma nyinaa mu. 
\par Ne nnipa ne 'bonsam nnipa,
\par w]n nyinaa benya w]n fa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nea ]d] b]n[y[fo
\par tena ab]nefo afa.
\par Nea ogye Yesu di no,
\par ne nky[n na ]b[tra daa
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma meny[ wo suani pa,
\par nea ]tw[n ne Wura, 
\par ne nea ]y[ nokwafo 
\par w] n'asafo kronkron mu. \f1 
