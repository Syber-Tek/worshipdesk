\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Nokware ne ]d] Nyame,
\par nidi, aseda s[ wo.
\par Wode w'as[mpa abr[ y[n,
\par na wonam so agye y[n.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma menna wo so ase daa;
\par w'as[m ahy[ me koma mu,
\par [y[ dwetriri ma me;
\par [b[tena me komam daa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo mmra ye na [ho tew p[,
\par na ade bi ns[ no da.
\par \{y[ koma mu anigye;
\par [ma nkwa ne ahot].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo nokwas[m no tim h] daa;
\par anyansafo behu no sa.
\par Nyame ahy[de ho tew,
\par na ebegyina ho daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame mmra t[w yen kwan ho
\par w] asetena nyinaa mu.
\par Ne bo y[ den sen sika,
\par na [sen ademude.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{y[ d[ sen 'wo biara
\par na [sen ahwerew mu nsu.
\par W'asomfo gye eyi di,
\par wonya mu akatua.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nyame Apam Foforo no
\par kura n'as[m kronkron no.
\par Emu na n'anom as[m w],
\par n'[kasa kyer[ nnipa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nyame as[m y[ abura;
\par emu nsu d]]so pii ara.
\par \{y[ daa nkwa asuti,
\par Na[y[e daa nkwa dua.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Awurade, w'ad]e d]]so
\par ma wo mma a w]mfata.
\par \{no nti meda w' ase daa;
\par ayeyi fata wo din
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wode wo Ba koro maa y[n,
\par na ]de ne mogya gyee y[n
\par Honhom Kronkron a woba
\par anuonyam nka wo daa.\f1 
\par \pard\lang2057\f2 
