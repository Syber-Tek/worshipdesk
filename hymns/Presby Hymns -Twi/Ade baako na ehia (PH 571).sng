\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Ade baako na ehia, 
\par Yesu na ose y[n saa.
\par Enti Yesu, mesr[ wo s[ 
\par ma minhu saa ade no,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na minim s[ wiase nne[ma funu 
\par ne anigye rentena onipa koma mu, 
\par na wo ade baako no ky[n ne nyinaa, 
\par ne s[ me nsa ka a, me ho t] me daa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me kra, wop[ saa ade n' a,
\par  nk]hwehw[ wiase da;
\par fam ha nne[ma no nn]]so, 
\par ma wo ho so k] soro, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w] nea Onyame ne nnipa y[ baako, 
\par na nea anu'nyam nyinaa w] no no
\par ]no nkutoo na mep[ no koraa.
\par ]ne m'ade baako ne m'ade nyinaa
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Da bi h] Maria p[e s[ 
\par ohu ade baako no,
\par na Awurade baa ne fi no, 
\par ]b[tenaa ne nan ase;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na nea n'Agyenkwa no kasa kyer[[ no,
\par otiei, na ]de siee ne koma mu;
\par na ]de ne ho maa n'Agyenkwa koraa,
\par onyaa ade baako ne ade nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Saa 'ra na m'ani gyina wo, 
\par Yesu, m'Agyenkwa pa no,
\par na mede me ho mema wo; 
\par wo nso fa wo ho ky[ me!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ nnipa bebree hwehw[ wiase nne[ma a,
\par ma menn] na menhwehw[ wo s[ m'Agyenkwa;
\par w'as[m na [ma y[n nkwa a [nsa da no;
\par wo, Yesu mu na menya m'ade nyinaa,
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Yenni nyansa pa bi gye s[ 
\par nea [w] Yesu mu
\par na nea onim no saa no 
\par y[ nokware nyansafo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na enti ma memmr[ m'adwene ase daa
\par na menhwehw[ wo ne w'as[m mu nokware;
\par na minhu wo, Yesu m'Agyenkwa, hu pa,
\par ma mempa at'ro ne ahantan koraa
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Yenni trenee bi a y[de ba 
\par Nyankop]n anim h],
\par gye mogya a wuhwie gu no, 
\par [no nti na yedi bem.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo asetena ne w'as[ndua ho wu nom
\par na y[anya trenee w] Nyankop]n anim h];
\par [no na mefura s[ me ntama daa,
\par na me honhom anya n'ahyehy[de pa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Enti Yesu, ma m'adwene 
\par nk]y[ te s[ wo de bi! 
\par \{s[ wo a, may[ wo de 
\par s[ afei wotew me ho 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par B'ribiara a [fa Onyankop]n som ho,
\par s[ m[y[ kronkron p[ w] ns[m ne nney[e mu.
\par Wubetumi ama me, mesr[ wo ara:
\par ma wo Honhon Kronkron mm[tena me mu daa!
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. D[n n' afei mehwehw[ bio? 
\par Yesu, wo nnepa no so!
\par Wode wo mogya no pr[ko 
\par k]] soro kronkron mu h].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{no mu na woanya daa gye no ama y[n,
\par ama y[afi wu ne bonsam tumi ase; 
\par wo sorok] na [b]] kwan no maa y[n
\par s[ y[mmra ]soro, wo Agya no nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Wo, Yesu, ne m'ade baako, 
\par na m'ade nyinaa ne wo, 
\par nanso ma minni nokware 
\par na mempa nkontompo daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hw[ s[ menam kwan a [de k] s[em so,
\par bra bekyer[ me wo kwan a eye no!
\par Mma mimmu me nkwa no minnnwen me wu ho,
\par me Yesu nko na ne ho hia me daa.\f1 
\par \pard\lang2057\f2 
\par }

