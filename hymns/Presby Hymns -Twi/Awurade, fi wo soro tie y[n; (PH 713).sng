\par 1. Awurade, fi wo soro tie y[n;
\par s[ woanni y[n kan anaka y[n hoa a,
\par twa bere mu y[rennya nn]bae,
\par enti bra, Awurade, ma yenhu wo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[te s[ apofofo nam po so,
