\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Soro ne asase Wura,
\par Agya, Ba, Honhom Kronkron,
\par woma ade kye na [sa,
\par woma  owia ne sram;
\par wode won as dennen no
\par kura wim ne  mu ade m'.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Miyi me mu meda w'ase
\par s[ woahw[ me anadwo,
\par na woamma [yaw anka me,
\par na ]haw amma me so.
\par Me de, meny[ wo ba pa,
\par na wohw[ me s[ agya.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ anadwo sum atam yi,
\par na  me b]ne sum no nk],
\par na  ma wo koma mu mmue
\par mma me deb]ney[fo.
\par Yesu, wo mogya no nti,
\par mesr[ wo h] fafiri.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Boa me, na an]pa yi
\par ma  mens]re honhom fam!
\par Ma menhw[ me kra so yiyi,
\par na mamma n'anim ansiam 
\par da no a wode won t[n
\par bebu me ne amansan.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. M'Awurade, bra begye me,
\par ma  memfa wok wan so daa!
\par B[hw[ me so, na di m'akyi,
\par ma  mentena wo nky[n ara!
\par N wo, Nyame, wo nkutoo
\par ne nea ]hw[ me so.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Mede me kra ne me honam
\par ne  me fifi nyinaa 'ra
\par mehy[  wo, y[n Hw[fo pa no
\par [ne y[n Gyefo no nsa.
\par Y[ y[n ky[m ne kanea,
\par na  fa y[n y[ wo dea!
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Ma wo b]fo mmra mm[w[n me,
\par na ]mm] wo mma ho ban,
\par na onsiw y[n tamfo b]ne
\par ne n'asisis[m no kwan!
\par Daakye nso ma ]mfa me,
\par na menk]home wo fi!\f1 
