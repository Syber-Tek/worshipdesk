\viewkind4\uc1\pard\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Agya Nyame, miyi w'ay[, 
\par w'anu'nyam no so ara!
\par Woy[ soro ne asase 
\par wura a wohw[ y[n nyinaa.
\par Wo tumi ne w'anu'nyam no 
\par da adi w] mma nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Soro Nyame, wone tumfo, 
\par woky[n ade nyinaa
\par wo nsam na ade nyinaa fi.
\par Wode w'as[m b]] ade 
\par na wukuta ne nyinaa mu, 
\par wo nney[e no y[ nwonwa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nna ne mfe, wiase bere,
\par na wohy[ ansa n'edu, 
\par da koro ana a mfe mpempem 
\par ye p[ w] wo ani so;
\par na wo nkwa no, hwee ntew so da,
\par woye daapem Nyankop]n.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wode wo tumi ne  wo nkwa
\par hy[ sor' ne wiase ma;
\par nanso wo ne y[n ntam mpan da, 
\par wob[n y[n w] mmaa nyinaa;
\par wo honhom twa yen ho hyia, 
\par na warna y[n daa nkwa nso.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Soro ne asase wura, 
\par y[w] wo nsam ara daa;
\par yi w'ahoden kyer[ y[n, 
\par na yeasom wo yie daa!
\par Ma yensuro na y[nn] wo, 
\par na daakye yeahu w'anim!\f1 
\par \lang2057\f2 
