\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame na mehw[ no, 
\par na mekot] mesr[ no 
\par s[ ]nhw[ me so daa. 
\par May[ okunafo yi, 
\par Onyame na metweri, 
\par na m'ani da no so koraa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mahu ]bram amane,
\par [yaw k[se aka me, 
\par me ho nso hia me. 
\par Nanso mehw[ me Y[fo, 
\par me Gyefo ne me Hw[fo,
\par na [ma me wer[ kyekye,
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Woma due ne hy[den,
\par efis[ w'ani hw[ me,
\par w'aso te m'adesr[.
\par Ade kye a, mehw[ wo,
\par na me nk]mm]m' mesr[ wo,
\par na adesa a, miyi w'ay[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. M'Agyenkwa, hu me mm]b], 
\par m'ani da w'ayamye so, 
\par na m'ani gye wo ho. 
\par Me kw]n a meretu yim',
\par mesr[ wo s[., di m'akyi 
\par na hy[ me den ara w] so! 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Dom ma mensom wo yiye, 
\par Kyer[ me nea meny[, 
\par b[y[ me Fotufo! 
\par Na s[ nnipa mma mmu me, 
\par s[ mpo w]de w]n b]ne 
\par rehaw me a, na wow] h]! 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Me mma yi nso y[ wo de; 
\par wo na wode w]n maa me, 
\par woafa w]n agya k]'
\par Me nyansa de, [nso w]n, 
\par na mintumi meny[n w]n, 
\par na mede w]n mehy[ wo nsa. 
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Wo, Nyame, ne y[n Agya!
\par wo, Yesu ne Agyenkwa 
\par ma me nso ne me mma. 
\par Na s[ y[w] saa Nyame 
\par ne saa Agyenkwa pa yi de,
\par papa bi remm] y[n da!\f1 
