\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Momma y[mfa y[n mpaeb]
\par ne  aseda mmr[ Nyame,
\par efis[ wahw[  y[n so
\par w]  afe yi nyinaa mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Afe ba, na afe k],
\par y[te s[ akwantemfo;
\par yefi afe dedaw mu,
\par na yesi afe fofrom.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo Nyame de, wonsakra,
\par w'aho]den no nsa da;
\par won a wohy[ y[n den s[
\par y[nk] so nkodu ase.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ nn[ y[hw[ y[n akyi,
\par na  y[kae y[n nneb]ne
\par ne  Nyame mm]b'r]hun' a,
\par ne dom b[y[ y[n nwonwa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Anka obi annye y[n
\par w] b]ne ne amanem,
\par y[n ankasa nnim hwee y[,
\par na Nyame p[ y[n yiye.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \}soma y[n Agyenkwa,
\par ]ma w]ka n'as[m pa.
\par \}ma nea ehia
\par y[n honam [ne y[n kra.\tab 
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Wo ayamyede pii nti,
\par y[da wo, Nyame, ase;
\par nanso afei y[sr[ wo,
\par ma wo nhyira nk] so daa!
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Ma engugu w'asafo
\par ne  nnipa mma  nyinaa so,
\par na ma mpanyin ne mmofra
\par mmenya wo dom nhyira bi.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. B[y[ nyisaa nso Agya,
\par tu nkwasea nso fo pa;
\par ma w]n  a w]y[  mm]b]
\par mmehu wo s[ w]n Gyefo.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10. Na mma aduan mm] y[n,
\par na y[n ho tam nso mpa y[n,
\par y[n adwuma a y[y[ no,
\par ma wo nhyira mmra so.
\par 
\par \cf1\ul\b\'b6 Verse 11\cf0\ulnone\b0 
\par 11. Ma yensua wo nyansa;
\par y[mfa nkodi as[mpa;
\par ma w'aho]den nn]]so
\par w] y[n honam mmer[w mu.
\par 
\par \cf1\ul\b\'b6 Verse 12\cf0\ulnone\b0 
\par 12. Nea ehia y[n pii,
\par ne wo honhom pa no;
\par ma  ]nhy[ y[n komam ma
\par na yennya soro daa nkwa!
\par 
\par \cf1\ul\b\'b6 Verse 13\cf0\ulnone\b0 
\par 13. Y[n Nyame a wod] y[n,
\par y[ 'yi  nyinaa fa ma y[n!
\par Y[n nkwa ne y[n ahot]
\par ne  wo w] fam ne soro.\f1\fs22 
