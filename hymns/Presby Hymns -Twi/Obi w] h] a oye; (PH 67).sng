\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Obi w] h] a oye;
\par na n'anim nso y[ nyam s[;
\par ]no na [s[ y[n s[ 
\par y[kotow s]re n'anim:
\par Yesu, onipa ba no.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Obi w] h] a oye, 
\par wagye wiase b]ne 
\par ne [so akatua 
\par de ak] damoa mu;
\par Yesu, nea wanyan no.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nea wama hann aba 
\par na wapam owu sum no, 
\par wapue s[ nsoromma 
\par na ahyer[n w] y[n mu;
\par Yesu, nea wanyan no.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wab[b]  daa af]re 
\par de apata abufuw.
\par Way[ ]s]fopanyin 
\par ama y[n adasamma; 
\par Yesu a ]k] soro. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nea n'adwuma asa 
\par te ne kronkronbea h],
\par ]fr[ nnipa ay[ w]n 
\par n'aydoro asafo;
\par Yesu, nea waba no.\f1\fs22 
