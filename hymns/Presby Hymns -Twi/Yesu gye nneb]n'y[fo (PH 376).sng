\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu gye nneb]n'y[fo! 
\par Monka eyi nkyer[ w]n a 
\par w]afom kw]ntrenee no so
\par na w]afa kwamm]ne so no
\par Nea ogye w]n w] h];
\par Yesu gye nneb]n'y[fo
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[ns[ ]dom biara,
\par ]no na waka y[n ntam s[ 
\par obegye y[n nyinaa 'ra: 
\par wahi[ dom pon ama y[n 
\par s[ y[n nnipa nyinaa mmram, 
\par Yesu gye nneb]n'y[fo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ oguan bi ayera a,
\par Hw[fo pa bi rehwehw[ no! 
\par Yesu na ]kae y[n daa 
\par de nokware d] hwehw[ y[n, 
\par na y[ans[e y[n b]ne mu; 
\par Yesu gye nneb]n'y[fo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Mo nneb]ney[fo a
\par adeb]ne haw-mo, mommra! 
\par Yesu fr[ mo, na ]dan 
\par Nneb]n'y[fo Nyankop]n mma. 
\par Monkae as[mpa no s[ 
\par Yesu gye nneb]n'y[fo
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Me a me wer[ ahow, 
\par Meb[ka me b]ne peewa. 
\par M'Agy[nkwa, b[dom me bi
\par fa me b]ne no firi me, 
\par na me wer[ akyekye; 
\par Yesu gye nneb]n'y[fo.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Mehy[ me ho baninha
\par s[ me b]ne y[ k]k]] a
\par minim s[ w[ mogya nti
\par [b[dan fitaa koraa po.
\par Mede gyidi meka s[
\par Yesu gye nneb]n'y[fo.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Me koma rentu bio,
\par nanso mm'ra bi ntoto m'ano; 
\par Yesu a ogye me no, 
\par atua me b]ne ka no, 
\par na b'ribi ammu me f];
\par Yesu gye nneb]n'y[fo.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Yesu gye nneb]n'y[fo! 
\par Na wagye me nso afei; 
\par nanso wama me ho kw]n, 
\par s[ memmra ne nky[n ]soro.
\par Me w'r[ akyekye w] wum; 
\par Yesu gye nneb]n'y[fo.\f1 
