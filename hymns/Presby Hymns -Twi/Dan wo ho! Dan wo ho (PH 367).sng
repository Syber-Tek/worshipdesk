\par 1. Dan wo ho! Dan wo ho! 
\par B]ney[fo, dan wo ho! 
\par S[nea Yehowa se nen; 
\par na ne bo amfuw wo daa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}no y[ nokware domfo, 
\par na ommuna n'anim daa njrinaa. 
\par Dan wo ho, dan wo ho, 
\par b]ney[fo, dan wo ho!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nu wo ho, na behu
\par s[nea wo b]ne te,
\par wo ne Nyame ntam atetew,
\par na woahura ne din ho.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}no d] wo, na wagye wo;
\par wo de, wugyaa no de b]ney[
\par yiyii no abufuw;
\par nu wo ho wo b]ne mu!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Woayera wo Hw[fo
\par na woafa owu kwan so 
\par ak]hwehw[ adefunu, 
\par na biribi mma wo nkwa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par wob[s[e kwa w] wo b]nem;
\par Yesu nko ne Agyenkwa a ose
\par Mommra [, mommra [,
\par na mama mo home pa! 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Agyenkwa, Agyenkwa! 
\par Wohwehw[ y[n nyinaa "ra. 
\par \}do nko na [ka wo ma; 
\par wudi y[n nyinaa akyi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma yemfi yen adeb]ne, 
