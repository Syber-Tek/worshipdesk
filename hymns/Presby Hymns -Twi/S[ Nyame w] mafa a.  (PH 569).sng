\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ Nyame w] mafa a. 
\par minsuro 'b]nefo. 
\par S[ misu fr[ Nyame a,
\par w]t[tew hwe ase. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nyame ne m'Adamfo pa, 
\par ne d] kura me daa.
\par Atamfo d]m biara 
\par rentumi ny[ me hwee.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Minim na migye midi, 
\par na m'ani da so s[ 
\par me soro Nyankop]n no 
\par b[ma m'ani agye. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ as[m bi to me a, 
\par ogyina me nky[n daa. 
\par S[ ahum tu me so a, 
\par odwudwo ano nt[m.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Me nnyinaso dennen no 
\par y[ Kristo mogya no. 
\par \{no ne m'ademmude, 
\par na me nkwagye w] mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Biribi nte s[ [no 
\par w] m'asetena mu da. 
\par Na nea Kristo ma no, 
\par [no nko na mep[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me Yesu ne m'Ahohoahoa,
\par m'Anu'nyam ne me Hann. 
\par Na s[ ]ny[ me de a,
\par anka me nko ara,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par remma me Nyame anim,
\par na manya n'anim dom. 
\par M[ye s[ nwura gunguan,
\par na mahyew w] 'gya mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ne honhom te me komam, 
\par n' edi m'adwene so. 
\par Dadwene bi nni me so, 
\par na mew] asomdwoe. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea ]y[ me nyinaa,
\par [ma midi yiye. 
\par \}kanyan me koma, 
\par meka s[: "Abba" bi.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[ ade bi yi me hu
\par na me ho popo a, 
\par ]no na ]hy[ me den 
\par w] n'as[mpa no mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na s[ [y[ den ma me, 
\par na mente ase a, 
\par nea ]hw[ komam no,
\par na onim ne nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. S[ obi ne no nam a,
\par na satan kyi no s[[?
\par \}de nitan k[se pa 
\par tan gyidini no daa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]de no k]  s]hw[ mu
\par n' ogu n'anim ase. 
\par As[ndua no tumi
\par [y[ hunu ma no.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Ab]fo ne tumidi,
\par anu'nyam, ahenni,
\par ahodwo, ahohia,
\par anigye, 'komatu,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par adewa, ade k[se,
\par wiase nne[ma 
\par ne ahode biara 
\par rentwe me mfi ne nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Me komam ahurusi
\par b[y[ k[se daa daa.
\par Anigye hy[ emu ma,
\par n' [to anigye dwom.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M'ahosan owia no
\par y[ Wura Yesu no.
\par Nea [ma meto dwom
\par y[ soro nnepa no.\f1 
