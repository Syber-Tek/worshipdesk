\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mommra Yesu pon yi ho! 
\par Nyame ahyia mo.
\par Momfa gyidi ahonu 
\par mmegye Nyame dom no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Momm] mpae! Momm[kae 
\par mo Agyenkwa wu no 
\par ne ne d] k[se no!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mudi Agyenkwa honam
\par na monom ne mogya a, 
\par ]de ne nkwa b[ma mo, 
\par na adan mo daa nkwa 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu wu agye mo, 
\par mo nneb]ne haw mu; 
\par ne wunyan anyan mo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Momfa f[w ne ayamye.
\par nna mo Wura ase! 
\par Munni Yesu akyi bi, 
\par munni no n'kware!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu nyan,n'anu'nyam
\par b[y[ mo nhyira pii,
\par na asakra mo bra.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, nnepam adepa,
\par ahiafo Gyefo,
\par hw[, mabue me komam,
\par bra mu s[ wop[ no!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo nkutoo na med] w'.
\par Wo na wubegye me,
\par na me ho at] me.\f1 
\par \pard\lang2057\f2 
