\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S]re, k] wo Nyame nky[n, 
\par me kra a woabotow. 
\par \{d[n na wotwentw[n kwa, 
\par na wo koma tu yi? 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{ny[ satan nnaadaas[m 
\par ne n'anifere no 
\par n' ]de s[e w'anigye a 
\par Yesu de ma wo no? 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma wo ti so na ka s[
\par Fa me so k], ]w]! 
\par Wop[ me aka me kwa, 
\par na woatew me koma.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W]ap[tew wo ti dedaw,
\par na me Yesu mogya 
\par w]n me, na [twe me k]
\par soro daa nkwa no mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyankop]n y[ me de,
\par na mey[ ne de bi;
\par hena n' ]b[tew y[n mu?
\par As[ndua no so
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na mihu Onyame d];
\par [sen ]d] nyinaa.
\par Nyame n' onim bere a
\par saa ]d] yi to twa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. W]n a Nyame y[n w]n no,
\par w]dan y[ ne mma pa
\par W]n na ]twe w]n aso,
\par na ]ma w]sakra.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mey[ Nyame de saa a
\par meremfi ne nky[n da.
\par \}twe me fi b]nem a,
\par ]p[ me papa nko.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Kristofo amane no 
\par nam Onyame d] so.
\par Nea ]nam nusu mu,
\par ]renk] daa gya mu;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par anigye w] h] ma no.
\par Kristo turom h] no,
\par ]b[hw[ anigye kwan,
\par na n'ani begye daa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Nyame mma gu w]n aba,
\par w]de nusu n' egu.
\par Nanso twabere mu no,
\par w]n ani begye pii.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nyame mma benya nn]bae
\par na w]n yaw to betwa.
\par W]de ahurusidi
\par b[to dwom daa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. \{nde Kristo somfo no
\par bu ne br[ ohunu.
\par \}mfa ne koma nto so,
\par ]ma ne wer[ fi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par N'ani gye, na [to dwom
\par yi ne Nyame ay[
\par Onyame fata nidi,
\par ]fata sa! Amen!\f1 
\par \lang2057\f2 
\par }

