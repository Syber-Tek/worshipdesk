\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O Nyankop]n, yi w'asomafo, 
\par na soma w]n, na w]nk]ka 
\par w'as[mpa no aho]den so 
\par w] amanaman nyinaa mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Kyer[kyer[ w]n na ma wonhu; 
\par y[ w'asomafo no foforo; 
\par gyina w]n akyi hy[ w]n den, 
\par na w]afa w]n so adom y[n.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo soro nhyira na hwie gu 
\par w'as[mpa a w]agu no so; 
\par [no na [ma [sow aba, 
\par na [ma w'asafo no nyin. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma w]mma y[n hw[so a eye 
\par na y[n abrab] ay[. yiye 
\par w] nkwa berem de kosi wum, 
\par na da bi y[anya nkonimdi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma nguan a wode ahy[ w]n nsa 
\par mm[tena w'asafo no mu daa;
\par s[ oguan bi yera fi mu a, 
\par w]nhwehw[ no  sarem ne kwaem. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma akra ny[ s[ asase pa, 
\par na s[ wogu w'as[m w] mu a, 
\par ma ennyin na [nsow aba, 
\par na atena h] akosi daa. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wode wo mogya kronkron gyee y[n,
\par [no nti ma [ntew y[n ho; 
\par wo wu mu na wode y[n ahy[; 
\par y[ay[ wo de asub] mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W'agya apaw y[n de ama wo, 
\par n']de y[n asi h] s[ ne man; 
\par y[de anigye sr[ wo s[
\par dom hw[ y[n daa, na hy[ y[n den.\f1 
\par \pard\lang2057\f2 
\par }

