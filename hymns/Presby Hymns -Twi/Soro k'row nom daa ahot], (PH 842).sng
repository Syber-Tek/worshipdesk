\par 1. Soro k'row nom daa ahot],
\par me koma pere rep[,
\par k'row nom h] na anigye w],
\par na nnepa b[y[ y[n f[. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Soro k'row nom daa ahot], 
\par me koma pere rep[,
\par pere rep[, pere rep[
\par rep[ ne fi, soro k'row no. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Soro fie daa ahot],
\par [so bi nni wiase;
\par k'row nom h] na sor' ab]fo
\par ne kronkronfo yi n' ay[.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Soro k'row nom daa ahot]
\par me koma pere rep[,
\par pere rep[, pere rep[
\par rep[ ne fi, soro k'row no. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Soro k'row nom anigye no,
\par [mmaa 'bi koma mu da;
\par fam amane bi nni h]nom,
\par na nkwa abu so ara. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Soro k'row nom daa ahot], 
\par me koma pere rep[,
\par pere rep[, pere rep[
\par rep[ ne fi, soro k'row no. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Soro k'row no, me fi pa nen; 
\par mep[ wo mu h] maba 
\par mabehu me soro Agya 
\par ne m'Agyenkwa no ara. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
