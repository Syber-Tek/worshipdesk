\par 1. O, \}d] kronkron a [tra adwene,
\par Hw[ y[butu w'anim reb] wo mpae,
\par s[ w]n a w]aka w]n ho abom wo mu,
\par mma saa ad]fo yi mu nntete da.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O, \}d] kronkron, y[ w]n anidaso,
\par ma w]n d] ne w]n gyidi mu ny[ den
\par Ma w]n anidaso mu boaset],
\par ahotoso a ennim yaw ne wu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma anigye a [pam awer[how,
\par ma asomdwoe a [remmu yaw da.
\par Ma nkwa yi akyi anu'nyam 'dekyee a
\par [de daa d] ne daa nkwa ma w]n daa.\f1 
\par \pard\lang2057\f2 
