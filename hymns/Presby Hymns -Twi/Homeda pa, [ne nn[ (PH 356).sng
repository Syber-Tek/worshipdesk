\par 1. Homeda pa, [ne nn[;
\par midwen Nyame ho.
\par Woma me ho nso t] me
\par w] me Nyame mu,
\par na m'ani gye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma memmra Onyame nky[n. 
\par Me Wura, bra me nky[n bi,
\par na mamee daa. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma w'as[m a w]ka nn[
\par mm[tena me mu daa,
\par n[ny[ aba a w]agu,
\par na anyin asow.
\par O, so me mu
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na mabedu wo nky[n h]
\par w] nea wo mma hyia;
\par m[mee w] h].\f1 
