\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Sion, Onyame man kronkron, 
\par okura mu ne komam; 
\par wafa no s[ n'ankasa man. 
\par Sion di nk]mm] dodo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}ka s[: Ao, me Nyame, 
\par wapa me m'ahokyerem. 
\par Na w]y[ me ayayade 
\par na woayi w'ani w] me so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Awurade hy[ me b] s[ 
\par ]b[y[ me boafo. 
\par \}n'na ]ma mehwehw[ no
\par w] m'ahokyere mu daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ao, s[ ne bo fuw s[ d[n
\par na akyi ware po a,
\par ohu me hiani mm]b]
\par s[nea ]y[ me kan no.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Sion a w]d] wo bebree,
\par Yehowa as[m ka s[
\par Ampa, afei woy[ mm]b],
\par woapira w] honhom mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nanso mma wo koma ntu
\par so [na bi w] h] a 
\par obetiimi agyaw ne ba 
\par na wapo no koraa anaa?
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ agya baatan bi w] h]
\par na n'agya d] so huan a, 
\par me, Yehowa, me d] w] h]
\par na [b[tena h] daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me nokware tim h] daa 
\par ma so wo Sion, me dwet'ri.
\par Wow] me koma mu daa yi 
\par na merentumi mpa wo da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na s[ satan ne ne nnaadaa
\par gyigye wo yi wo hu a,
\par mede me nsa beso wo mu,
\par na mede wo asie. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na [b[y[ d[n ara 
\par na m'ani befi wo so?
\par Mede w'afasu mesi h]
\par na mahw[ wo so daa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ampa, wob[tena me nky[n daa, 
\par mede wo mahy[ me yam 
\par s[ abofra ketewa a 
\par ]da nufu ano num.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me nokwaredi tim h],
\par obi rentumi nnye da. 
\par Biribiara w] me nsam, 
\par enti kodi nokware daa.\f1 
\par \pard\f2 
\par }

