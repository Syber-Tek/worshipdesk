\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Daa nkwa ne papa Nyankop]n,
\par woab] y[n wo suban no so,
\par na wop[ s[ yehu wo; 
\par na wuhyira y[n, y[ y[n yiye,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na y[n mu tena b[y[ wo f[,
\par nanso wob]] aware.
\par Hw[, eyinom gyina w'anim 
\par Ma wo nhyira mmegu w]n so, 
\par nanso ma w]mfa wo yanko! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. 
\par Wo, Yesu, ne w'asafo ti; 
\par w'asafo ne wo honam a 
\par wode d] pa hw[ w]n so. 
\par Wode wo mogya ata w]n; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par woayi w]n afi w]n b]nem, 
\par na woafa w]n ay]nko.
\par Y[sr[ wo s[ fa wo d] no
\par ma okunu ne ne yere,
\par na w]ad] wo ne w]n ho ho
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Agya ne Ba ne Honhom pa,
\par wode Onyankop]n nnepa    
\par ba gyidifo koma mu,
\par na wudwira h]nam ne kra 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ma [y[ wo fi kronkron a
\par Onyame di mu tumi.
\par Fa eyinom y[ wo fi bi, 
\par na tena w]n mu nna nyinaa 'ra
\par na w]anya Onyame daa nkwa. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Agya, Agyenkwa, Honhom pa, 
\par y[sr[ wo s[ tena y[n mu daa, 
\par behyira y[n na gye y[n! 
\par B[tew y[n ho na ka y[n ho, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ma y[n ani nnye wo ho daa, 
\par s[ y[yera a, hwehw[ y[n! 
\par Na s[ y[rey[ awu a, 
\par B[fa y[n k] soro nohoa,
\par na y[ahy[ wo anuonyam daa.\f1 
\par \pard\lang2057\f2 
