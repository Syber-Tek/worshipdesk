\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ minya m'Agyenkwa 
\par n' ]y[ me de daa
\par na me nna nyinaam me wer[
\par amfi ne nokware a,
\par merenhu- amane, 
\par d] ne anigye w] me koma mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ minya ne nko a,
\par mepa ha ade;
\par na s[ nnipa pii fa kwan a 
\par nigye kwa wom so a,
\par me de, mede gyidi
\par midi m'Agyenkwa ne Wura akyi 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ minya ne nko a,
\par mekra wiase;
\par daa ahomeka na ]de 
\par ma w]n  a w]ne no bom. 
\par \}w] m'ani so a, 
\par owu po rentumi nyi me hu da.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ ]y[ me de a,
\par soro y[ me de;
\par na me Yesu din bedwudwo
\par me kra ne me honam ho.
\par Yesu, meyi w'ay[
\par w] wo mm]b'r]hunu no nti. Amen.\f1 
\par \pard\lang2057\f2 
\par }

