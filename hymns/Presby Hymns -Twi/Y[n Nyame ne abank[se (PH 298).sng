\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[n Nyame ne abank[se,
\par ahode ne akode pa;
\par amane aba y[n so de,
\par nanso ogye ne mpamfo daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}tamfo bi hwehw[ y[n.
\par ]b] mm]den s[[
\par ne tumi nso so;
\par nnaadaa pii n' ]de ko,
\par obi ns[ no w] wiase.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nnipa aho]den no sua,
\par [nky[ na tamfo fa y[n so. 
\par Y[n Gyefo ne barima a
\par Nyame ayi no asi h].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wop[ ahu ne din?
\par Yesu Kristo nen 
\par Asafo Wura
\par ]no ne Yehowa,
\par na ne nsam na nkonim w] daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ ]bonsam d]m nyinaa po
\par ba y[n so ab[s[e y[n a,
\par mommma y[n bo nntu koraa da,
\par na Yesu twa y[n ho hyia,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}tamfo no bo fuw pii,
\par [ny[ biribi,
\par ontumi ny[ hwee
\par w]abu no f] dedaw;
\par as[m baako b[hwe n'ase.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nyame As[m no gyina h],
\par nneb]ney[fo renyi da.
\par Y[n Yesu na ]ka y[n ho; 
\par ]ma y[n ne honhom nnepa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na s[ w]fa y[n honam, 
\par ahode, atam
\par ]yere ne mma, 
\par wonnya ho mfaso da; 
\par ]soro man w] h] ma y[n.\f1 
\par \pard\f2 
