\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. "Mommra me nky[n", Yesu n' ose, 
\par "mo a mo nnosoa d]]so 
\par na mo b]ne y[ duru". 
\par Mo mpanyin ne mmofra nyinaa, 
\par mmarima, mmea, megye mo, 
\par na m[sa mo nyarewa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. "M'adesoa, [y[ hare, 
\par nea ]fa di m'akyi no, 
\par ]n'na obenya daa nkwa.
\par Me ara na m[wowaw no, 
\par na megye no de no ak] 
\par me daapem aheman mu."
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wias[ hwehw[ ahot],
\par na Kristofo amane de,
\par [ma wias[ b] hu.
\par Nanso [y[ ]kw]n baako,
\par [no so ara na daa haw
\par b[fa anya n'awiei.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ab]de horow nyinaa 'ra
\par [pom' de, asas[ so de, 
\par wim de nyinaa kyer[ s[ 
\par ]haw, ]br[ n' [da h]; 
\par [no nti, y[hy[ y[n ho den, 
\par na ammu amfa y[n so.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{nn[, onipa si so p[
\par na ]ky[na na onni h],
\par s[nea Nyame p[ te.
\par Wias[ yi ade besuw, 
\par te s[ nhwiren w] sare so 
\par na [renky[ na as[e.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. B]ney[fo suro owu,
\par na s[ w]da wu pa so a,
\par na w]hwehw[ ahonu. 
\par Nnipa mma y[ nea w]p[ 
\par enti w]n honhom di hia, 
\par na w]n ani bu w] ha.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Nimde[ rennye nimdefo,
\par anuonyam b[y[ ]kwa, 
\par na nnipa nyinaa bewu.
\par S[ obi gye Kristo as[m 
\par w] saa ]dom bere yim a
\par daakye ]renyera da.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Na nea Onyame ahy[
\par afi n'as[m mu ato h],
\par n'egyina n'apam so no
\par [so ara na obedi, 
\par obegye y[n w] Kristo mu 
\par na y[ako soro! Amen.
\par \lang2057  \f1 
