\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Soro h] dakorodi ye
\par sen fam ha nna pa apem
\par Memmata fam ha ade ho?
\par Dabida, afono me.
\par \cf1\ul\b\'b6 
\par \cf0\ulnone\b0 S[ obi de anigye pii
\par ky[ w] wi yi ase a,
\par soro anigye ma obu
\par ha de s[ awer[how
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fam ha na wugu ahome
\par Hu amane, haw ne yaw'
\par na ehu a owu yi wo,
\par [mma w'ani nnye ampa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na ]soro, wonnim nusu,
\par na awer[how nni h],
\par na owu rentumi w]n a
\par w]te soro hann mu h].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Anigye b[tena h] daapem;
\par Nyame k'row mu awia
\par ne n'anuonyam k[se no,
\par h]fo hann ne Guammaa no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fam ha nnipa bi ntumi nhu
\par s[nea [h] nkwa no te,
\par na obi nso nhu h] papa
\par ne anigye s[ [te.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wohu Nyame, na w]som no,
\par eyi nko n' [y[ w]n f[.
\par Na Onyankop]n hw[ w]n so,
\par na ]y[ w]n Nyankop]n.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu, ma memp[ ]soro,
\par twe m'adwene fa k] h];
\par ma m'ani nna h] ade so,
\par na m'ani agye h] daa.\f1 
