\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Asase so ]h]ho 
\par tu kwan k] ne fi pa; 
\par ne nsoromma w] soro, 
\par ahw[ ne hann ara.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Egyigye, na [twe no, 
\par na n'ani gyina h]; 
\par na w]n a ]d] w]n no, 
\par w]agyaw no k] soro.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. W]n honam da ]da mu; 
\par w]n da so w] nhwiren, 
\par [nn[ afifi fr]mfr]m, 
\par ]kyena n' agunguan.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nsu a [k] pom no, 
\par [sen k] nt[m ara; 
\par [po b] n'as'r]kye no, 
\par afra mu ayera.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ahenk'row ne mu sika
\par y[ f[ hyeren ara,
\par na dak'ro p[, na w]ab]
\par ahenk'row no pasaa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Na emu hran ne tumi,
\par gyegyeegye, oseb], 
\par asankub] ne dwonto, 
\par na mframa de rek].
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Na s[ [nonom k] no,
\par s[ kwantufo k] nen;
\par gye s[ ]da ne dam a,
\par na wadu fie nen.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Enti na n'akwantu mu
\par n'ani gyina h] daa 
\par kosi da bi a wadu 
\par ha asomdwoem koraa.\f1 
\par \pard\f2 
\par }

