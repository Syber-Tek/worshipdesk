\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame nhyira nni w'akyi daa,
\par ]mma wo kw]n so ny[ dwoodwoo,
\par ]mm] wo ho ban s[ ne guammaa,
\par kosi s[ da bi yebehyia.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyame nhyira nni w'akyi daa,
\par ]mfa ne dom nkata wo so,
\par ]mma wo soro nnepa daa
\par kosi s[ da bi yebehyia.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame nhyira nni w'akyi daa, 
\par s[ amane bi to wo a 
\par ]mfa ne basa nyi wo wom
\par kosi s[ da bi yebehyia.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Onyame nhyira nni w'akyi daa,
\par na ]mfa ]d] nhw[ wo so
\par \}mpam owu hu mfi wo mu,
\par kosi s[ da bi yebehyia.\f1 
\par \pard\lang2057\f2 
\par }

