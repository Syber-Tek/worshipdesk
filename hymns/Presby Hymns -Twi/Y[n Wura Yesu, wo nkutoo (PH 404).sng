\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[n Wura Yesu, wo nkutoo 
\par na woy[ m'anidaso. 
\par Wo na woy[ me Gyefo pa; 
\par minnim obi foforo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onipa, bi a w]awo no, 
\par anaa Onyankop]n b]fo 
\par rentumi nnye me w] owum,
\par gye wo nkutoo 
\par Wo nkutoo so na m'ani da. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me b]ne daaso n' [y[ d'ru, 
\par n'eyi me awer[how; 
\par ne saa nti, Yesu, fa fri me, 
\par wo wu a wuwui no nti. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Dom fa me kyer[ w'Agya s[ 
\par woatua me ka ama me; 
\par enti me b]ne akyi no,
\par manya nkw]gye
\par s[nea wo b]hy[ no te
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo mu gyidi na mesr[ s[ 
\par ma mu ny[ den w] me mu, 
\par na wo mm]bor]hunu nti, 
\par atim,me mu daa nyinaa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma men] wo ampa ara, 
\par na menna y]nko s[ me ho, 
\par na me nkw] nna awiei no,
\par woahy[ me den, 
\par na woagye me ]bonsam nsam.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Anu'nyam nka soro Agya, 
\par trenee nyinaa wura no, 
\par ne ne Ba Yesu Kristo a 
\par ogyina y[n akyi daa no, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ne ne Honhom Kronkron nso a 
\par odi boa y[n daa nyinaa 
\par s[nea y[b[s] n'ani
\par bere yi mu
\par kosi daakye nkw] no mu h].\f1 
\par \pard\lang2057\f2 
