\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu pa, y[ba wo nky[n 
\par de akokoaa yi br[ wo; 
\par na wo ankasa hy[ y[n
\par s[ y[mfa y[n mma mmr[ wo daa,
\par na woagye w]n b]ne fi nom, 
\par de w]n ak] w'ahenni nom.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W'as[m na ese y[n s[:
\par S[ w]mfa nsu [ne honhom 
\par anwo nipa fof'ro a, 
\par ]ns[ soro ahenni nom; 
\par na womp[ y[n ]honam mu, 
\par na honhom na [b[k] mu
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Enti na y[ba wo nky[n; 
\par begye w'ade w] y[n nsa mu, 
\par na ma wo anim nhyer[n 
\par w] akokoaa yi kra so; 
\par na ]ny[ wo de w] fam ha 
\par [ne daakye nso w] soro
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, fa wo mogya no 
\par hoh'ro ne ho nkekae nyinaa:
\par y[n de, y[b] no asu, 
\par wo nso, fa wo nhyira gu so.
\par Y[n ap[gyade ne b]ne, 
\par w'adeky[ no ne daa nkwa no.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma n'awosu no mu ntew, 
\par yi ne mmusu, na b[dom no;
\par fa asub] nhyira so,
\par yi ]w] dedaw no b]re;
\par na s[ ne ho ay[ fi yi, 
\par fa nsu yi ma ne ho mfi! 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Hw[fo, gye wo guamma yi, 
\par ma ]ny[ wo ho dubaa bi; 
\par wone wo asafo ti, 
\par fa no y[ wo ho akwaa bi; 
\par wone kwan, fa no k] soro, 
\par ma onnya nkwa ne home!
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Nea efi y[n komam 
\par na y[de gu wo de no mu; 
\par ma y[n mpaeb] yi mmra mu, 
\par na y[ nea [b[ky[n yi;
\par na fa din a y[de to no 
\par hy[ wo nhomam w] ]soro. \f1 
\par \pard\lang2057\f2 
