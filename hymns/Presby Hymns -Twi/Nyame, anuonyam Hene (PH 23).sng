\par 1. Nyame, anu'nyam Hene, 
\par M[d] wo daa:
\par Me d] no ano rennwo, 
\par mefitam daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W oama me nea mesr[, 
\par woatie me p[;
\par woahu me komam mmer[w, 
\par woagye me koraa;
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mede me nyansa nyinaa 
\par M[to wo dwom;
\par mede me koma nyinaa 
\par ka ho ma wo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me nneb]ne hy[[ me so,
\par woagye me koraa.
\par S[ w]k] so haw me a, 
\par wutie me.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mede nnaw]twe nyinaa 
\par m[kanfo wo.
\par M[ma wo so me komam 
\par w] ha ansa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me koma sua mmoroso 
\par ma w'ayeyi;
\par saa na nnasanten mu nso 
\par ayeyi sua.\f1\fs22 
