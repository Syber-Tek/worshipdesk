\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Honhom a wufi Agya ne 
\par \}ba no mu reba,
\par hw[, mibue me komam', 
\par fa y[ wo de na b[tenam! 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo nokware na mep[
\par me ara minhu yiye 
\par s[nea m[k] me kwan; 
\par wo na gya me k] nkwa mu!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma me hann ne nyansa pa
\par na minnye minni ampa, 
\par minso Kristo mu yiye 
\par na meny[ nea ]p[!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma niinyi me yam yie 
\par menna Nyankop]n ase;
\par na minya as]reye
\par na me mpae ny[ wo f[ bi!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wiase ne ]bonsam
\par ne me kra ne me honam 
\par s] me hw[, gyigye me a, 
\par waw me, hy[ me den ara!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Tew me ho, tew me komam' 
\par na hy[ Yesu anuonyam; 
\par na menhw[ ]no ara, 
\par na m'asom adwo me daa,
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Ma m'ani nna Yesu so,
\par na ma m'ani nnye no ho; 
\par daakye nso ma mento dwom
\par wo soro ahotefom'!\f1 
\par \pard\f2 
