\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Wura Kristo Yesu pa,
\par tie me b]n'y[fo,
\par wiaseni a mas[e;
\par madan adefunu,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Dom y[ aso ma me daa,
\par Kanaan man ba, Adam 'seni
\par mm]b] nko na wuhu me,
\par me Wura Dawid Ba.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Israel nguan nky[n na w]bae,
\par bere a wufii sor',
\par nanso y[n nmpa nyinaa
\par benya w'asomdwoe no,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma me nso memmra wo nky[n
\par me ]deb]ney[fo no.
\par Mm]b] nko na wuhu me,
\par me Wura Dawid Ba.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mpaapaemu remma y[n mu
\par bere a wob[n y[n.
\par Mm]b] nko na wuhu y[n,
\par me Wura Dawid Ba.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par B]ne mu na w]w]o y[n,
\par enti dom y[ aso ma y[n.
\par Dom y[ [ho bi ma y[n,
\par Yesu, y[n Patafo.
\par 
\par \cf1\ul\b\'b6 Verse  4\cf0\ulnone\b0 
\par 4. Mete d[n mpo w] w'anim
\par Minnim nea mete.
\par \{ny[ f[ s[ ]kraman
\par bedi aduan a
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ofie mma bedi no.
\par Wodi mporoporowa no;
\par w]fa no s[ aky[de,
\par me nso medi bi saa.\f1 
\par \pard\lang2057\f2 
