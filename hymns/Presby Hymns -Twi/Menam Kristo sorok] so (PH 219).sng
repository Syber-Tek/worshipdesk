\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Menam Kristo sorok] so 
\par m[k] soro h] nso bi; 
\par saa gyidi na mede medi 
\par ehu ne akyinnye so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Eti no da so w] h] yi, 
\par eti no da so w] h] yi, 
\par ]b[tw[ ne ho akwaa no 
\par ama w]abedi n'akyi. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na s[ wak] ]soro h] 
\par anya ade nyinaa nti, 
\par [mma me koma ntu koraa, 
\par ampa, minsuro h] da. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea m'ademude w] no, 
\par nea m'ademude w] no
\par m'adwene ne koma w] h], 
\par m'ani gyina [h] daa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Awurade, hy[ me anu'nyam 
\par w] wo sorok] no mu; 
\par ma minnya nokware gyidi 
\par memfa mintu soro kwan. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mede anigye befi ha, 
\par mede anigye befi ha, 
\par maba wo h] ne here mu. 
\par Awurade, tie me [!\f1 
\par \pard\f2 
\par }

