\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Yesu, Nyame Guammaa pa, 
\par m'Agyenkwa ne Gyefo,
\par me b]ne so k[se ampa,
\par nanso w] dom ky[n so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mebr[ me ho as[ w'anim
\par w] nso ne d]te mu; 
\par mede nusu mesr[ wo s[,
\par begye me me b]nem. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Kum b]ne ho ak]nn] no
\par w] me komam koraa 
\par fa wo d] ne w'ahumm]b] 
\par twe me bra wo ho daa. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Beso me nsa kura me mu, 
\par na manhwe ase da
\par na ma menye nea w]pe,
\par nea eye wo f[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Bra me komam, y[ mu yiye
\par bedi mu hene daa,
\par na m'adwene ne me koma
\par ay[ wo de koraa.\f1 
\par \pard\lang2057\f2 
\par }

