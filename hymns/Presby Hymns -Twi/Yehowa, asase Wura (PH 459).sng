\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1.
\par Yehowa, asase Wura,
\par [so ade dodow,
\par ne nyinaa ara y[ wo de;
\par [y[ wo na woy[e.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.
\par Efi po ano k] ano, 
\par wo nnwuma da adi. 
\par Asase so nsub]nten no
\par y[ wo nnwuma mu bi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.
\par Hena n']tena Yehowa fi
\par n' ]k] ne tenabea?
\par Na ne kronkronbea h] no,
\par hena n' ]fata h]?
\par 
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par 4.
\par \{y[ nea onni b]ne, 
\par na ne koma mu tew, 
\par nea onni adwemm]ne 
\par na ]nka ntam hunu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.
\par \}no na obenya nhyira
\par afi Yehowa nky[n.
\par Nyame trenee b[y[ ne de,
\par na w]nya ne nkwagye.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.
\par W]n a w]hwehw[ n'akyi kwan,
\par fra n'abusua mu.
\par W]n a w]hwehw[ n'anim no,
\par Yakob fifo ne w]n.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7.
\par Mo aponk[se, mons]re,
\par na momma mo ti so;
\par mo tete apon nyinaa nso,
\par momm[keka mo ho.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8.
\par Anu'nyam Hene rehy[n mu.
\par Anu'nyam Hene b[n
\par na ]reba ab[hy[n mu,
\par na y[ama no kwan yi
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9.
\par Yehowa a ne tumi so 
\par sen tumi nyinaa no.
\par Yehowa kokodrufo
\par w] akodi mu no.
\par 
\par \cf1\ul\b\'b6 Verse 10\cf0\ulnone\b0 
\par 10.
\par Mo aponk[se, mons]re, 
\par na momma mo ti so; 
\par mo tete apon nyinaa nso, 
\par momm[keka mo ho.
\par 
\par \cf1\ul\b\'b6 Verse 11\cf0\ulnone\b0 
\par 11.
\par Anu'nyam Hene rehy[n mu.
\par Anu'nyam Hene b[n
\par na ]reba ab[hy[n mu,
\par na y[ama no kwan yi?
\par 
\par \cf1\ul\b\'b6 Verse 12\cf0\ulnone\b0 
\par 12.
\par Yehowa Sebaot ne no;
\par anu'nyam Hene no.
\par \}reba ab[hy[n ne fi
\par momma y[mma no kwan.\f1 
