\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mo, Nyame asomfo,
\par montw[n no mo nnwumam;
\par munni ne soro kyer] so,
\par monw[n ne pon ano.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Momma mo kanea
\par nn[w yiye, nhyer[n yiyei
\par momm], mo ho so w] n'anim:
\par Nyame din ho y[ hu
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Monw[n: Nyame n' ose.
\par Y[kasa a, ]te,
\par ]ma ne nsa so kyer[ a,
\par na ne nyinaa y[ yiye.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}somfo a wohu
\par no saa de anigye 
\par behu Awurade, na ]no 
\par ahy[ no anuonyam.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Kristo no ankasa 
\par na ]b[to no pon; 
\par na ]b[ma no so k[se
\par n'ab]fo kuw anim.\f1 
\par \pard\lang2057\f2 
