\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Greenland sukyene tam so,
\par India mmep] tenten so,
\par Afrika aman horow,
\par ne Amerika nso,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nsup] horow so tefo,
\par y[ y[n mf[fo nnipa bi.
\par W]ne y[n y[ Nyame mma,
\par hwehw[ Yesu nkwagye.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. So y[n a y[ahu hann yi
\par ne soro nyansa yin so,
\par remfa nkwa kanea yi
\par nk]ma nnipa fof'ro?
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[b[ka saa s[mpa yi,
\par kosi s[ aman nyinaa
\par b[te nkwagye s[m yi
\par anya daa nkwa no bi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mo, mframa ne nsu horow
\par momma n'asem yi ntr[ yiye
\par na ay[ s[ po p[n bi
\par w] ha ne mmaa nyinaa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par kosi s[ Nyame Guammaa a 
\par wokum no maa b]n'y[fo
\par b[san abedi hene 
\par agye ne manfo nkwa.\f1 
\par \pard\f2 
\par }

