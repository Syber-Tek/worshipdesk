\par 1. \{nn[ da yi atwam k];
\par meda Nyame ase.
\par Mesr[ s[ siw b]ne kwan
\par anadwo  sum yi mu.
\par O, Yesu, dom fa me sie,
\par na  hw[ me so anadwo yi,
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{nn[ anigye atwam,
\par me  koma da wo so.
\par Mesr[ wo h] asomdwoe
\par anadwo sum yi mu.
\par O, Yesu, dom fa me sie,
\par na hw[ me so anadwo yi,
