\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{nn[ dwumadi asa,
\par meto  dwom da w' ase.
\par Siw amane ano kwan
\par anadwo  sum yi mu.
\par O, Yesu, dom fa me sie,
\par Na hw[ me so anadwo yi.
