\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[n nkwagye fi Onyankop]n, 
\par efi n'ad]e no nko mu. 
\par Y[n nnwuma remmu y[n bem da, 
\par na y[n asom rennwo ho 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n gyidi hw[ Agyenkwa no, 
\par ne mpata ayi y[n mmusu; 
\par ne nti y[n ho bedwo y[n. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyankop]n ahy[ ne mm'ra
\par ]pe s[ nnipa di so;
\par na anka ]renhu bi a
\par ]b[y[ na w]mmu so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n honam di y[n honhom so,
\par y[n honhom ayera mu po,
\par na tumi bi nni y[n mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame mm'ra y[ ahwehw[, 
\par na [kyer[ y[n b]ne; 
\par y[n honam mu na b]ne hy[, 
\par na y[n honhom nni home. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Enti b]ne ad] ara, 
\par na mm'ra no antwa to koraa, 
\par na mmom ama abu so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Etwa s[ Nyame mm'ra tim h]; 
\par s[ y[anni so any[ a, 
\par ne nnome no b[ba y[n so 
\par ay[ y[n akatua. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{nom na y[rennyina da, 
\par na anka y[b[mem koraa 
\par aka owuprenu mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na Nyame asoma ne Ba;
\par ma w]awo no onipa; 
\par ]no na way[ Nyame mm'ra, 
\par wawie ka ao tua. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W]de no y[[ abusude,
\par na ]de saa yii y[n nnome, 
\par na Nyankop]n agyaa y[n.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Na s[ w]wie mm'ra so di 
\par ay[ s[ Nyame p[ yi, 
\par [s[ y[n s[ yegye no di
\par bata ne ho b] din se: 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu ay[ m'Agyenkwa pa
\par ama ne wu adan me nkwa;
\par watua ka ama me.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Migye eyi midi yiye,
\par minnye n'as[m akyinne.
\par \}no ara aka no s[:
\par Monk] nkodi m'adanse.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Obiara a ogye me di
\par na w]ab] no asu bi no,
\par obenya daa nkwa no bi
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Agya Nyankop]n ne ne Ba 
\par ne Honhom pa, y[da ase
\par yeyi w'ay[, wo d] n' ara 
\par fitii y[n gye no ase. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[sr[ s[, hy[ mu den ara, 
\par na ma y[nk] so w] mu daa, 
\par na yenkowie p[y[!\f1 
\par \pard\lang2057\f2 
