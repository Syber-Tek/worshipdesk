\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Ayeyi nka y[n wura daa 
\par n'anu'nyam no so bebree, 
\par n'anu'nyam no so bebree 
\par na y[n hann reba, Yehowa, 
\par na y[n hann reba, Yehowa 
\par apue ama y[n p[, 
\par apue ama y[n p[
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Momm[hw[ s[ w]rehyiam 
\par aba w]n Wura pa nky[n, 
\par aba w]n Wura pa nky[n 
\par monhw[ s[ abosonsomfo, 
\par monhw[ s[ abosonsomfo 
\par nam Yehowa hann no mu, 
\par nam Yehowa hann no mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yesu din k[se na w]b], 
\par woyi ne tumi ay[, 
\par woyi ne tumi ay[. 
\par Ah]ho rekyekye Sion,
\par na ahene som Kristo, 
\par na ahene som Kristo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Henk[se, benyan aman no, 
\par di y[n kan, b] kwan petee, 
\par di y[n kan, b] kwan petee 
\par Ma yennua wo aburo no, 
\par Ma yennua wo aburo no 
\par na asow aba bebree,
\par na asow aba bebree
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Anu'nyam nka y[n Wura daa 
\par na wadom ne man no pii, 
\par na wadom ne man no pii
\par w]te s[ afuw pa ma no,
\par w]te s[ afuw pa ma no 
\par onya mu n'anuonyam,
\par onya mu n'anuonyam.\f1 
