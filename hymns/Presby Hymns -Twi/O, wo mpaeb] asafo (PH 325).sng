\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, wo mpaeb] asafo, 
\par ma honhom papa a 
\par [y[ Yesu Honhom no 
\par Mm[tew wo ho koraa
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo koma ne w'ano 
\par b[ka aseda daa, 
\par ab] nkot]sr[ mpae. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma ogya kronkron mm[hyew
\par wo mu adeb]ne. 
\par Yesu de ne mogya 
\par no ama woay[ ne de. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \{no nti [s[ s[ 
\par wob] no af]re 
\par na woda no ase.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Asafo no nkot]sr[
\par ne ne dima mpaeb]
\par y[ af]reb]de
\par w] af]regya so
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Kristo ne Abakan ne
\par \}s]fo Panyin
\par ma n'asomfo nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ gyidini baako bi
\par de ne nkot]sr[ mpae 
\par k] Onyame anim a, 
\par ]y[ aso ma no. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par So nnipa pii mpaeb] 
\par remforo nk] soro, 
\par na enni nnwuma pii?
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. S[ ]soro treneefo 
\par ne asase sofo, 
\par sor' ab]fo ne nnipa 
\par bom, na w]y[ baako, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na w]b] mpae dennen
\par de sr[ fafiri a,
\par adesr[ k[se ni!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Eyi nti, nnipa nyinaa,
\par momm] mpae daa nyinaa;
\par momma ahotew nsa so,
\par montew mo koma mu;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par momm] mpae gyidi mu,
\par n'[b[foro ak]
\par Nyame kronkronbea.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Momm] mpae na nnab]ne
\par anya n'awiei p[,
\par na Nyame anuonyam no
\par apue w] y[n so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ab]fo retw[n daa
\par s[ bere pa b[ba;
\par mo nso montw[n saa bi.
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Mo mpae a mob] no daa
\par de sr[ Awurade no,
\par [b[y[ s[ gyaframa
\par w] af]regya so;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [y[ nnam, gyidi wom.
\par Mo ankasa gya de,
\par mobegyae akyi di.\f1 
\par \pard\lang2057\f2 
