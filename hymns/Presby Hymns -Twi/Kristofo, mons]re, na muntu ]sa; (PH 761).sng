\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Kristofo, mons]re, na muntu ]sa;
\par Kristo as[ndua, n' edi mo anim.
\par Kristo, Sahene no, b] atamfo gu;
\par menk] ]ko n'ano, ne frankaa rehim.
\par \cf1\ul\b\'b6 \cf0\ulnone\i 
\par Nnyeso: \i0  
\par \b0 Kristofo mons]re,\b 
\par \b0 na muntu ]sa;
\par Kristo as[ndua
\par n' edi mo anim.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ mudi nkonim a, na ]bonsam guan;
\par enti monk] anim, na  monkodi  nim!
\par Momm] ose dennen, muntu asaman;
\par monk] s[ d]m baako, monfa f[w nto dwom.
\par \cf1\ul\b\'b6 \cf0\ulnone\i 
\par Nnyeso: \i0  
\par \b0 Kristofo mons]re,\b 
\par \b0 na muntu ]sa;
\par Kristo as[ndua
\par n' edi mo anim.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Monk] s[ d]m k[se, s[ asafo kuw,
\par nea gyidifo fae, na mo nso momfa.
\par Monko s[ kurow baako, honam koro mu;
\par y[w]  anidaso, ne botae baako.
\par \cf1\ul\b\'b6 \cf0\ulnone\i 
\par Nnyeso: \i0  
\par \b0 Kristofo mons]re,\b 
\par \b0 na muntu ]sa;
\par Kristo as[ndua
\par n' edi mo anim.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Fam ahenni b[s[e, tumi b[yera;
\par Yesu asafo de, egyina h] daa.
\par Asaman remfa so, [renhwe n'ase;
\par Yesu b] gyina h], [rensan n'akyi.
\par \cf1\ul\b\'b6 \cf0\ulnone\i 
\par Nnyeso: \i0  
\par \b0 Kristofo mons]re,\b 
\par \b0 na muntu ]sa;
\par Kristo as[ndua
\par n' edi mo anim.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Enti mo nyinaa mmra, monka d]m no ho;
\par mommra mm[ka y[n ho; w]  y[n nkonimdim.
\par Y[to nkonim dwom se; Kristo di Hene;
\par nnipa  ne ab]fo, to dwom yi n'ay[.
\par \cf1\ul\b\'b6 \cf0\ulnone\i 
\par Nnyeso: \i0  
\par \b0 Kristofo mons]re,\b 
