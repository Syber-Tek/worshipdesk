\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Da bi h], mmaatan de w]n mma br[[ Yesu;
\par s[ ]mfa ne nsa ngu w]n so nhyira w]n. 
\par Wuhyiraa w]n pii, na y[n nso resr[ nn[,
\par s[ fa wo nhyira nso gu y[n ba yi so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}hw[fo, fa no fra wo nguammaa nom bi,
\par na bu no s[ w]n a woagye w]n no bi. 
\par Fa w'anuonyam din no fam ne moma so.
\par na ma onni w'akyi w] ne nkwa mu nso.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[n Agya Onyame, fa no y[ wo ba! 
\par \}domfo, Agyenkwa, hw[ no so ara! 
\par Na wo Honhon Kronkron, bra b[hy[ no ma, 
\par na ma onnya fam ha ne soro h] nkwa!\f1 
