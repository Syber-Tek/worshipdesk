\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Da bi h] w] Dawid K'row mu
\par na wohuu mmoa dan bi,
\par emu h] na ]baabun bi
\par woo ba too ]daase[ mu.
\par Maria ne baatan no,
\par Na ne Ba no ne Yesu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea ]y[ Onyame
\par fi soro baa wiase;
\par ne dabere y[ mmoa dan mu,
\par na [sare so n ']da.
\par Agyenkwa no de ne ho
\par b]] nnipa hiafo ho.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ne mmofraase nna nyinaa mu,
\par wannyae osetie da.
\par \}d]] ne na dii no ni p[,
\par na ]daa n'abasa so.
\par Kristofo mmofra nyinaa,
\par Munsua Yesu dwo daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu y[ nhw[so ma mmofra;
\par na onyinii s[ y[n p[;
\par nanso odwo, ]ny[ keka,
\par onim serew ne osu;
\par y[n awer[how ka no,
\par y[n anigye y[ no f[.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Daakye bi yebebu no bi
\par soro h] anu'nyam mu;
\par [ny[ daa s[e mu bio;
\par [y[ n'Agya nifa so.
\par Ne mmfgra nso begyina
\par \pard ne ky[n daa anigye mu\f1\fs22 
