\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Merennyaw me Yesu da 
\par na ]de ne ho ama me.
\par Enti na [s[ me nso
\par s[ mede me ho mema no 
\par Yesu ne m'Agyenkwa pa,
\par merennyaw me Yesu da
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wiase ne mu nnepa,
\par [ny[ no na me koma p[
\par Yesu a ogye me kra 
\par ma me n'adepa a [sen no. 
\par Aseda ne ]d] nti, 
\par merennyaw me Yesu yi. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Merennyaw me Yesu da; 
\par hena na ]d] me ky[n no?
\par Asomdwoe, ahomeka, 
\par ]no nkutoo nky[n na mahu.
\par Anigye, abot] yam w] ne nsam.\f1 
\par \pard\lang2057\f2 
