\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n di y[n nokware! 
\par Onnyaw ne nnipa mma ]s[em,
\par de anigye ana' amane 
\par twe y[n daa s[ y[mmra ne nky[n.
\par Nnipa a wobuu w]m ]yera mma,
\par Onyame ama w]m Agyenkwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyakop]n di y[n nokware!
\par \}y[ y[n s[ y[n Agya pa;
\par Onnyaw ne mmofra w]n amanem, 
\par na ]kyekye w]n wer[ daa.
\par So yesuro y[n kra tamfo?
\par \}de ne tumi kata y[n so!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyankop]n di y[n nokware!
\par \}ye y[n s[ adamfo pa.
\par Minim ampa s[ obegye me 
\par me s]hw[ ne me ko mu daa.
\par Na s[ [y[ afa me so a,
\par ]de n'apam hy[ me baninha.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Onyankop]n di y[n nokware.
\par Odi ne b]hy[ so ampa;
\par ]de ne hann gya me ne kwan so;
\par menam so a, m[to daa nkwa.
\par N'as[m a waka no, odi so;
\par midi so a, m[te mu d[w no..
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Onyankop]n di y[n nokware!
\par Medi no saa nokware bi.
\par Y[n nnipa nkotompo ad]]so;
\par begye me na ma me ho mfi!
\par Meso wo Nyame mu nokwarem,
\par \pard na manya wo mu daa ]home\f1\fs22 
\par \lang2057\f2\fs24 
\par }

