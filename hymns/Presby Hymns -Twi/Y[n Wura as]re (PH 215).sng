\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Y[n Wura as]re
\par afi damoa mu;
\par wanyan afi wum.
\par Yesu as[e owu,
\par na ne nkonimdi no
\par ma y[n ani gye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}bonsam ne 'wu tumi
\par Yesu adi ne nyinaa so;
\par momma y[nto no dwom.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Osian k]] 'wu bon mu,
\par na ]nam so gyee y[n 
\par ma yenyaa daa nkwa. 
\par Y[n nti na ]s]re 
\par fii ne damoa mu 
\par s[ yennya bembu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ayaresa ne daa nkwa,
\par ahot] pa ne asomdwoe, 
\par n' ]de ma y[n nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[n nneb]ne kaw no, 
\par watua ne nyinaa, 
\par na ebi anka.
\par Nea ogyee y[n no, 
\par na was]re nn[ yi, 
\par na ]te ase. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wawie ade nyinaa; 
\par ]de ne wu akum owu, 
\par na y[n ho at] y[n.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Afei y[n ani gye,
\par na yensuro owu
\par ne ]damoa,
\par Na s[ Yesu anyan
\par afi ]da mu nti,
\par y[b[s]re bi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wadi y[n atamfo so,
\par na s[ y[nam gyidi mu a,
\par yebedi w]n so bi.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nokware Kristofo, 
\par s[ Kristo wui a, 
\par wowu ma b]ne. 
\par W]ne no b[s]re 
\par na w]ne no atena 
\par ne daa nkwa no mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}no ara ne y[n ti,
\par na okura y[n nyinaa mu,
\par p[ s[ y[y[ baako. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Y[n ani begye s[
\par y[b[sakra y[n ho 
\par ay[ foforo,
\par Awurade Yesu
\par de ne trenee begye
\par n'ad]fo nyinaa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Daakye wobedu ne fi
\par na w]ahyer[n s[ owia,
\par na w]atena h] daapem.\f1 
