\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yehowa, hu me mm]b], 
\par wo na may[ w] b]ne, 
\par na w] na mafom wo, 
\par nanso [y[ me yaw pii, 
\par na [ye me so duru. 
\par O, gye me fi mu, Ogyefo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ misiw me b]ne so,
\par na manka mankyer[ a,
\par wo de, wunim ara;
\par enti mepae mu maka
\par me nneb]ne makyer[,
\par na wo, Nyame, de afiri.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yesu, wode wo mogya
\par na apata ama me 
\par w] me nneb]ne nti. 
\par O, ma nea woay[ yi, 
\par mm[dan me ny[ wo de daa, 
\par na manya daa nkwa w] wo mu. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wo ne me Hintabea,
\par wo nky[n p]tee na meba,
\par gye me korakora.
\par Wo ho na m[bata daa
\par w] fam ha [ne noh].
\par Wo, Yesu, ne m'Awurade daa.\f1 
\par \pard\lang2057\f2 
\par }

