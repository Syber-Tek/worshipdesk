\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu de n'asuafo 
\par k]] ngo bep] no so h], 
\par na ohyiraa w]n w] h], 
\par maa ne ho so k]] soro.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{nna w]hw[[ n'akyi dinn, 
\par afei ofii w]n anim, 
\par na [kaa w]n nko w] h], 
\par na ]n'de, ]k]] soro.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}k]tenaa n'ahengua so
\par nyaa anuonyam k[se, 
\par ]soro asafo no 
\par de anigye s]re no.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Y[n nso y[n ani begye, 
\par na Yesu de n'adeky[ 
\par hyehy[ n'akyidifo ma, 
\par na ]ma y[n tenabea.\f1 
\par \pard\f2 
