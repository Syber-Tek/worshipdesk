\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu ne m'Anigye
\par ne me komam Ade. 
\par Yesu, med] wo. 
\par \{b[y[ d[n ara 
\par na me koma betu 
\par M'ani da wo so.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nyame Ba, med] wo pii. 
\par Ade bi nni wiase a 
\par me d] w] mu sen wo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wo ntamadan ase
\par na m[tena daa nyinaa,
\par na maguan b]ne.
\par Satan ne ne d]m no,
\par w]b[b] apete,
\par na woakora me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par N'apranaa no b[bobom, 
\par na ne gya no ad[w dennen; 
\par Yesu b[kora me.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo, ]w] dedaw no, 
\par owu ne hu farebae, 
\par hunahunafo! 
\par Wiase y[ hoo kwa, 
\par na mede anigye 
\par m[to dwom pa daa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Onyame b] me ho ban, 
\par na wiase ne asaman 
\par b[b] hu w] n'anim.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Fam nne[ma betwam.
\par Yesu b[ma manya 
\par abot]yam daa;
\par anuonyam hunu
\par b[yera nt[m ara,
\par n'ak]nn] betwam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par As[ndua ne ho haw 
\par ne owu po ntumi ntetew
\par me ne Yesu ntam da.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Fi me so, fi me so;
\par mo ahonhomm]ne.
\par Yesu, bra me nky[n! 
\par Nyame ad]fo no
\par w]n awer[how po
\par dan w]n anigye.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ w]tane m'ani a,
\par [nde wo, me Yesu, b[y[ 
\par m'awer[kyekye daa.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Y[n soro Agya pa,
\par wo din no ho ntew daa, 
\par na y[ y[n Hene. 
\par Nea wop[ n' [ny[, 
\par ma y[n daa aduan; 
\par fa y[n b]ne ky[.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Gy[ y[n w] y[n s]hw[ mu,
\par na b]ne bi amma y[n so,
\par na y[ nea wop[.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Yesu, hw[, me honhom, 
\par me kra ne mu ade, 
\par me nipadua 
\par mede mehy[ wo nsa 
\par w] me nkwa nna yi mu 
\par ne me wu mu nso.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu, me hintabea, 
\par s[ me fam ha nna to twa a, 
\par dom gye me honhom.\f1 
\par \pard\lang2057\f2 
