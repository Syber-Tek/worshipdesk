\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. An]pa hann apue,
\par Me Nyame, meda w'ase,
\par wo mm]bor]huneu  nti,
\par woama  ade akye me.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O, boa me m'adifim'
\par na  kyer[ me wok wan pa;
\par wowaw me, na mamfom kwan,
\par na ma menhw[ wo nkutoo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Me Wura ne me Nyame,
\par mede  dwuma a medi
\par ne nea mew] nyinaa
\par mema wo de yi w'ay[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Fam akwantu to twa a,
\par ma memmra mmedu w'anim;
\par na ma memfa Yesu so
\par meny[ dehye w] soro.\f1 
\par \pard\f2 
\par }

