\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Monk] nkotu me da! 
\par Na mabr[ me fam akwantum'. 
\par Me ne fam adi nkra, 
\par m[k] soro asomdwoe nom. 
\par Sorofo mu home pa
\par b[ma m'ani agye daa. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Monk] nkotu me da, 
\par na mawie me mm'rikatu po; 
\par mede m'akwantu poma 
\par meto h], efis[ madu,
\par enti mede me ho mpo 
\par m[to dam, na minsuro.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Fam ha, meny[ d[n bio 
\par w] amanehunubon yim? 
\par M'aho]den ana me tumi, 
\par [ny[ no n' ama me nkwa 'tim! 
\par Fam abode ne sika, 
\par [ntena h], na [yera.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nn[, makra mo, wiase!
\par Ma menk] no asomdwoe mu! 
\par W'anidaso nni ase; 
\par w'anigye wie ]s[e mu; 
\par na wo papa nky[ koraa, 
\par [y[ ahuhude daa!
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Nanso makra owia
\par ne nsoromma ne ]sram nso. 
\par Munkyini mo wim ara! 
\par Metu kw]ntenten matra mo 
\par makohu Onyame hann, 
\par [ma mo ani sinsiam!
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Na makra me nnamfo pa; 
\par minim s[ mo wer[ how de, 
\par nanso Nyame honhom pa
\par rekyekye n'asafo wer[. 
\par Munnsu honam ani ha! 
\par Menya ]soro daa nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. \{mfata s[ musu s[
\par me ne mo redi ntetewmu. 
\par Me de, me k] y[ me f[, 
\par na medu nea eye mu. 
\par Adehuhu, sunsuma 
\par sene hann [ne daa nkwa?
\par 
\par \cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Munnyae su, na manya nkwa, 
\par efis[ minim m'Agyenkwa, 
\par na me nso mew] ne fa! 
\par Me ne mo nti, na ne mogya 
\par fii n'apirak'ru mu gui, 
\par me ne mo nti, na owui.
\par 
\par \cf1\ul\b\'b6 Verse 9\cf0\ulnone\b0 
\par 9. Merennyaw m'Agyenkwa da; 
\par obenyan me afi da mu. 
\par Manya anidaso pa, 
\par gyidi ma me so k] soro; 
\par Nyame de ne d] agu 
\par me komam, minsuro wu!\f1 
\par \pard\f2 
