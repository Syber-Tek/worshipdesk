\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \{ny[ me nnwuma bi 
\par n' ebegye me kra yi;
\par eny[ me honam mu yaw bi 
\par n' [tew me honam ho.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{ny[ nea mey[ 
\par n'[ma me asomdwoe;
\par m'ahomegu, nusu, me mpae 
\par enyi me b]ne da.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Kristo, w'adwuma nko 
\par n' eyi me b]ne h];;
\par Nyame Guammaa, wo mogya nko 
\par n'[ma me ho t] me.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \{y[ wo d] no nko 
\par n' etwa me yaw no to, 
\par na [ma mede me ho yi. 
\par Me d] de, enka hwee.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Agya, wo dom no nko 
\par n' [ma b]ne fafri 
\par Onyame Ba, wo tumi nko 
\par n' eyi me fi b]mem.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Mekamfo m'Awurade 
\par mehome ne d] mu;
\par mede m'ano ne me koma 
\par mefr[ no me Gyefo.\f1\fs22 
\par \lang2057\f2\fs24 
\par }

