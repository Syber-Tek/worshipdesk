\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo nyansa so b'ro so
\par [sono no ne y[n de;
\par wode wo nyansa no
\par b]] soro ne asase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n asehwe akyi,
