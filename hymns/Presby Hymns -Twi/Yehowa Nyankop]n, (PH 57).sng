\par 1. Yehowa Nyankop]n,
\par honhom ne daa nkwa ti no,
\par wo nkwa no boro so;
\par n'obi ntwa nso nsakra da,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par wo nkwa nso nsakra da,
\par woy[ honhom Agya,
\par wiase yi betwam,
\par wo de, wutim h] daa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nea woy[ nyinaa,
\par Wunim p[ fi teteete,
\par na wosra y[n komam,
\par wuhu y[n t'rim as[m fee;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
