\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Agya a wo p[ ne s[
\par akra nyinaa nya nkwa, 
\par ma w]n a wosianka owu 
\par nka mmom ny[ ay]nko. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma w]ny[ nnam w]n dwumadim'
\par na w]nsa nyarewa. 
\par Ma wontu aho]mmerew 
\par se asraafo yi d]m.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Nea w]sa yare h] no,
\par Yesu d] da adi.
\par \}safo no nhw[so akyi
\par na yaresafo di.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma yaresafo nhu wo p[,
\par na w]mfa w]n nyansa
\par ne ]d] ny[ w]n adwuma
\par nnye ayarefo nkwa.\f1 
\par \pard\lang2057\f2 
\par }

