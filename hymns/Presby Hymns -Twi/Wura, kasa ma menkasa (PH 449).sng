\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Wura, kasa ma menkasa, 
\par ma wo nne nnyigye m'asom daa;
\par wohwehw[[ me nti,mehwehw[ 
\par w]n a w]afom na w]ayera.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Kyer[ me kwan, na menkyer[ 
\par anworamanb]fo kw]n pa; 
\par Wura, ma memmee, na memfa 
\par wo mana nkum afofro k]m. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Hy[ me den, na s[ migyina 
\par botan so a, may[ den daa, 
\par na matumi aso w]n a 
\par w]pere as'r]kye mu nom. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Kyer[kyer[ me, na me nso 
\par matumi akyer[kyer[, 
\par na makasa ama adu 
\par koma nyinaa ara mu t]nn.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. O, ma me home pa no daa, 
\par na mede tumi akasa
\par wo kasa nko na eye ma 
\par w]n a w]abr[ w]n hia mu 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Wura, ma me wo may[ no,
\par na ma me kra ny[ ma mmu so 
\par memfa adwenemtew ns[m pa
\par menka wo d] ne w ayeyi.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Wura, fa me y[ w'adwuma 
\par beae ne bere a wop[,
\par kosi s[ mehu wo anim,
\par anya home ne anu'nyam.\f1 
\par \pard\lang2057\f2 
\par }

