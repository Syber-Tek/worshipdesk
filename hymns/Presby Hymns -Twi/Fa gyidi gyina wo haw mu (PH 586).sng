\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Fa gyidi gyina wo haw mu
\par na amanehunu bi
\par antew wo ne Yesu d] mu.
\par Gyae nk]mm]di, hy[ wo ho den.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Kae s[ ne d] w] h] daa,
\par na ]p[ s[ ogye wo.
\par Wo koma pon na wotoo mu,
\par na so eyi reny[ no yaw?
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. So wo gyidi mu daa nyinaa,
\par na mma wonsisi wo kra.
\par Akyinnye hinhim gyidi,
\par enti so wo Nyame mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par So w'asub] apam nom,
\par na ma ennyina h] daa.
\par Fa wo haw ne wo dadwene
\par to no so, ono n' ob[y[.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. So wo d] no mu yiye daa,
\par na wode ad] Nyame.
\par D] wo y]nko a ]b[n wo 
\par s[nea wod] wo h].
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S[ way[ wo b]ne a
\par kae wo Yesu d] kronn no;
\par ]sre maa n'ahohiafo,
\par na Nyame defiri wo nso.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. So wo Kwankyer[fo m' pintinn,
\par na wo boa b[ba nt[m,
\par na nea w'ani da so no,
\par Nyame b[ma aba nt[m
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Gye di s[ Nyame w] h],
\par ne yam hyehye no ma wo,
\par enti ma w'ani nna no so,
\par na ]remma w'ani nwu da!\f1 
\par \pard\lang2057\f2 
\par }

