\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Momma y[n Agyenkwa so, 
\par na wayi y[n nnuab], 
\par watua y[n b]ne ka 
\par ama me ne wo dedaw.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. N'adwuma k[se asa, 
\par Agya Nyame p[ no sa; 
\par na onyan no fii ne dam, 
\par hy[[ ne Ba anuonyam.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. N'afei y[n Agyenkwa no
\par te Onyame nifa so,
\par na enti woyi n' ay[
\par ]soro ne wiase.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Mo a mod] no yiye,
\par momma mo ani nnye nn[! 
\par Daakye mob[k] ne nky[n 
\par akohu n'anuonyam.\f1 
