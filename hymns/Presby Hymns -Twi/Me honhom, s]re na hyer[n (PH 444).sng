\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me honhom, s]re na hyer[n,
\par na gu sum mu nnwuma nyinaa.
\par Yi wo ho adi s[ hann ti,
\par na fa anuonyam hyer[n.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hw[ w'Agyenkwa no refr[ wo 
\par s[ bra ne pon kronkron no ho.
\par Nea odi sor' hene no,
\par ab[so[ wo mu nn[ ampa. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Bra w'ay[foro Kunu nky[n, 
\par bra te s[ ay[foro pa.
\par Hw[, ]reb] wo pon akyi, 
\par bue wo koma mu ma no.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fa gyidi ne ahotoso 
\par bue wo komam, na ka s[:
\par Mey[ wo atuu, me D]fo,
\par bra b[tena me nky[n daa.nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. O, adasa mma D]fo pa, 
\par wo nky[n tena ho k]m de me kra.
\par Mede nusu rehw[ kw]n s[ 
\par menya aduan d[d[ yi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me Wura ne me Hene pa,
\par wo nkwagye ho k]m de me kra 
\par enti mepere hwehw[ s[ 
\par me ne wo b[fa adamfo. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, me Nkwa Awia no, 
\par Yesu, me Wer[kyekyefo
\par Yesu, Mfiase, Awiei, 
\par Daa Nkwa Nsuti, koma mu Hann! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mab[kotow wo nan ase 
\par ma minni nea woma me, 
\par wo honam w] abodoo mu,
\par na ma [nhy[ me gyidi den. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Me Wura, wo d] k[se no
\par na [twee wo fii w'Agya nky[n. 
\par Wode anigye penee so 
\par ma wubewu maa wiase. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wuhwiee wo mogya no gui 
\par w] ]p[ ne anigye mu. 
\par S[ y[nom saa mogya yi a, 
\par ma y[nnyin w] wo ho d] mu. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Yesu, me Nkwa Aduan pa 
\par di ma me ne nnipa nyinaa 
\par s[nea yebenya nhyira
\par w] aduan a yedi yim. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Saa honhom mu aduan yi:
\par ma yehu wo d] k[se no. 
\par Daakye ma y[ne wo nni
\par wo nnepa no w] soro h]. \f1 
