\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Miyi wo din ay[, 
\par me Nkwa, me Hann, me Nyame 
\par me y[fo a ]de 
\par honam ne kra ama me;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par m'Agya a wahw[ me 
\par de afi me na yam 
\par na ]ye me yiye 
\par [nn[ ne daa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Miyi wo din ay[ 
\par m'Agyenkwa pa, me Nyame;
\par Agya no Bakoro 
\par wode wo ho ama me 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na wode wo mogya,
\par agye me me b]nem 
\par ama me gyidi a 
\par wonam so bu me bem.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Miyi wo din ay[, 
\par me kanea, me Nyame,
\par Agya no Honhom pa,
\par \}ba de wo ama me. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wokyekye me wer[,
\par woy[ fotufo pa.
\par Wohy[ me honhom den.
\par wugyina m'akyi daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Miyi wo din ay[, 
\par me Nyankop]n, m'Aw'rade;
\par woy[ Onyame k'ro,
\par Agya, \}ba ne Honhom,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w]n a w]te soro 
\par ne Kristo nyinaa,
\par woyi wo din ay[;
\par wo din y[ kronkron daa!\f1\fs22 
\par \pard\lang2057\f2\fs24 
