\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me Gyefo, me Kwankyer[fo,
\par w'aho]den no so.
\par Asase so, obi nni h],
\par gye wo, Yesu, nkutoo.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo nko na wokyer[ me kwan,
\par na woy[ me yiye.
\par Asor]kye ne ahum mu,
\par wunnyaw me nko w] mu. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Asase so sum kabii mu,
\par [no mu na menam.
\par Wunim m'asomdwoe ho as[m,
\par na wokae mo me hawm.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W'ankasa na wudi m'anim,
\par na wutwitwa gye me.
\par Wob] asomdwoe kwan ma me,
\par wokari m'amane.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Akomatu ne ]haw mu,
\par wow] me nky[n daa yi.
\par Woy[ me Botan a ahum
\par ne asor]kye rentwiw. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wuse: Ma wo bo nt] wo yam,
\par na ma wo ho nsan wo;
\par mey[ wo Hann wo ho sum mu,
\par na me ne wo Gyefo.\f1 
\par \pard\lang2057\f2 
\par }

