\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Owu sum mu na woanya
\par wiase nkwagye no,
\par na wonam wo trenee so
\par atua ka ama y[n.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Woafa ]tamfo d]m so,
\par Woahi[ soro pon.
\par Wo, Yesu, yeyi w'ay[,
\par na y[kamfo wo din.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Asase so ne soro
\par tumi w] wo nsam daa,
\par wo Agya de w'atamfo
\par begu wo nan ase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Aman a w]te nifa, 
\par benkum ne anafo
\par ne atifi nyinaa 'ra 
\par b[ba wo anigyem.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Woda so hyia w]n a
\par wonnya ntee w'as[m no
\par w'asomfo de wo dom fr[
\par twe w]n ba wo fifom; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par wommu br[ ne amane
\par W]b] mm]den k[se 
\par k]s] wo gya kronkron no 
\par amanaman no mu.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Abibirim aman no
\par bebue w]n ani
\par ama w'as[mpa hann no
\par na w]n komam atew;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w]n a w]soa w]n k].
\par s[ nnipa nkoa no
\par hu s[ w]n Gyefo aba 
\par abehu w]n mmaba.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. W]n a wodi w]n nya no
\par anya w]n ho afei;
\par na ]bonsam ahenni
\par res[e wa wiase.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea w]ka w'as[mpa,
\par nnipa reba wo mmam 
\par s[ w]de ahodwoe pa
\par b[hy[ wo anuonyam.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \}henk[se, b[boa
\par wo nk'r]fo no ano!
\par Gye w]n ewiase ha 
\par fa bra wo pon no ho! 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Behi[ w'apon tenten no,
\par Na w'asafo reba;
\par na nea ade nkyee h]
\par b[s] wo gya w] h]!\f1 
