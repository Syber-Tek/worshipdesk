\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Agya, nnaw]twe yi da kan,
\par na  maba w'anim ha yi.
\par Mesr[ s[, ma menk] anim,
\par na  y[ me Boafo pa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M'ani gyina wo daa nyinaa,
\par w] me nney[e nyinaa mu,
\par m'ahomegye bere mu,
\par me  Yesu, woka me ho.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Awurade, ma menkae s[
\par wo  ne wo mma w] h]  daa,
\par na wo honhom aniwa no,
\par nenam  w]n nyinaa 'ra so
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par wo nsusuwii ne adwenem.
\par Ose ne ]y] mu nso,
\par yegu  w'anim adagyaw;
\par ma  y[n ho ny[ wo f[ daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ nipadua akwaa bi
\par rebegyigye me ara
\par ama  mahwe ase birim,
\par ma  minyi no akwa bi,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na m'abrab] nyinaa ara
\par as]  w'ani, awura!
\par Na da biara nney[e
\par as] me Wura ani.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \{no de afei me ne wo
\par b[b] anamm]n are;
\par m'amanehunu ne m'anigye no,
\par me Yesu, [y[ wode.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par M'asefi ne m'awiei no,
\par hyira  me nsam nnwuma so.
\par Yesu, y[ m'ade nyinaa
\par Kosi daa nkwa awiei.\f1\fs22 
\par \pard\f2\fs24 
\par }

