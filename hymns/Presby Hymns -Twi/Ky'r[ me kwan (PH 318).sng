\par 1. Ky'r[ me kwan,
\par Kyer[ m' wo kwan trenee,
\par tew w'anim kyer[ me;
\par na wo Yesu, wo Yesu nko
\par na woma metena asomdwoe m'.\f1 
\par \pard\lang2057\f2 
\par }

