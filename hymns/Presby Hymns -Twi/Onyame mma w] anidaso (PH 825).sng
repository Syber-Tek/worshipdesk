\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyame mma w] anidaso
\par w] w]n wupa akyi;
\par w]n kra b[s]re,
\par [nna wobenya daa nkwa.
\par Halleluya! Halleluya!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]de w]n honam to ]da mu,
\par nanso [b[s]re; 
\par [te s[ aba a
\par w]de hy[ asase mu,
\par na afifi, na afifi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Awurade pa, s[ mek]da a,
\par ma mente wo kasa, 
\par na m'ani agye.
\par Nyan me honam fi da mu;
\par ma me daa nkwa, ma me daa nkwa.\f1 
\par \pard\f2 
\par }

