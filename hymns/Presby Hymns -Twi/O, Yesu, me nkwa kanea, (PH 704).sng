\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Yesu, me nkwa kanea,
\par anadwo  anya 'twam yi,
\par mehwehw[ wo, m'Agyenkwa pa.
\par Mesr[ wo s[ b[dom me!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Woama me nkwa foforo bi
\par s[  memfa memma wo bio,
\par s[ nn[ memfa wok wan no so,
\par na woahu s[ med] wo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Me Hw[fo pa, b[ka me ho,
\par na  daa begyina m'akyi;
\par mefom wok wan a, tu me fo,
\par na menhw[ me ho yiye.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ma menkae s[ wuhu me daa,
\par na  ma m'ani nka ase,
\par na meny[ wo nkutoo dea,
\par na as[m bi anto me.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na wo nkutoo ne m'Anika 
\par ne me Nkwa ne m'Ahot];
\par menhwehw[ ade biara,
\par wo nko na m[y[ wo de.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Fa wo nsa so me mu dennen,
\par na  mantwiw manhwe ase.
\par Fa wo d] hama no twe me
\par Kodu me kwan no ase!\f1 
\par \pard\f2 
