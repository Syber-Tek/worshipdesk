\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Dawid Ba, ]soro Hene 
\par kura wiase nyinaam. 
\par Mummesua nkyer[ no [, 
\par n'ahenni to rentwa da
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Atemmu, at[ntrenee na
\par Nyame de ahy[ ne nsa;
\par ]y[ mm]b'r]hunu Hene, 
\par gye n'ahiafo nkwa daa
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Soro ahodwoe no aba
\par ne nkoa ne ne man so;
\par na ne gye a ]de gye w]n
\par da adi w] mma nyinaa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}y[ Temmufo ne Gyefo
\par ma w]n a ehia w]n.
\par \}be]s]e at'rimm]denfo
\par na wagye me gyidifo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. N'ahenni fi pom k] po so.
\par tr[ ewiase nyinaa.
\par w]n a w]te kwaem no koto
\par Onuonyamfo no anim;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na n'atamfo nso hy[ n'ase,
\par na w]de w]n ho to fam;
\par w]n ahene de aky[de
\par som no hy[ no anu'nyam.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Kristo din b[tena h] daapem
\par s[ n'asafo awia;
\par dom ne anygye w] no mu,
\par na ]ma w]n daa nkwa daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W]de ne din no behyira
\par Ne manfo nna nyinaa 'ra.
\par Wura, fa w'anuonyam yi
\par hy[ aman nyinaa ma ma!\f1 
\par \pard\f2 
\par }

