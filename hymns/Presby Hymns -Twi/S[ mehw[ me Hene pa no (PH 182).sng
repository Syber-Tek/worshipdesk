\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. S[ mehw[ me Hene pa no 
\par w] as[ndua no ho a, 
\par mibu m'ahode ohunu, 
\par na metow m'ahantan kyene.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Awurade, d[n na minim po? 
\par Me Yesu wu no na minim; 
\par ahuhude gyigye me a, 
\par ne mogya n' [twe me fi ho.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Efi ne ti besi ne nan,
\par mihu awer[how ne d];
\par n'awer[how [ne ne d]
\par ne ne ns]eky[w no y[ nwonwa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wiase nyinaa w] me a,
\par esua ara ma n'af]re;
\par ]d] a [y[ nwonwa yi
\par Hwehw[ me kra, me nkwa, m'ade\f1 
\par \pard\f2 
