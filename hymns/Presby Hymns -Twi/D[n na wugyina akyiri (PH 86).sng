\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. D[n na wugyina akyiri, 
\par wo, Nyame Ba nu'nyamfo?
\par Hy[n me komam anigye so, 
\par na wone me nsoromma.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yesu, m'ani gye wo ho,
\par m'Agyenkwa koro ne wo.
\par Gyefo pa, beyi me koma 
\par fi ne haw ne mmusu mu. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Aw'r[kyekye ne anigye 
\par fi wo, Yesu nkutoo mu. 
\par Wode y[n k] didibea, 
\par na woma yemee w] h] 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me Hann kronkron, ma me hann, 
\par na menhaw me ho bio.
\par Awurade, dwudwo me koma, 
\par na menhw[ wo minni w'akyi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Yiw, me koma, ma w'ani nnye, 
\par Yesu ate wo fr[ no!
\par Prapra wo mu, na ]nhy[n mu, 
\par na ]ny[ wo de koraa!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par S]re beye no atuu, 
\par na b[y[ ne tenabea.
\par Bue wo kra mu kyer[ no, 
\par ma onhu nea [haw wo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Nea womp[ na [haw wo, 
\par b[y[ yie ama woo 
\par s[ Kristo ne wo w] h] yi, 
\par b'ribi rentumi wo da.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Di no nokware ara, 
\par na wubehu ampa s[ wo 
\par ne ne soro ab]fo 
\par b[bom ato n'ayeyi dwom.\f1\fs22 
\par \pard\lang2057\f2\fs24 
\par }

