\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Fi ase, fi ase
\par Hwehw[ Yesu nky[n nkwagye!
\par Woy[ mm]b], wudi hia,
\par enti br[ wo ho ase;
\par nu wo ho na hw[ w'Agyenkwa,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par so ne mu dennen na gye no di,
\par gye no di, gye no di,
\par gye w'Agyenkwa Yesu di.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Da n' ase, da n' ase, 
\par da w'Agyenkwa ase daa, 
\par s[ watua wo ka ama wo, 
\par agye wo w] wo b]nem 
\par de n'ahonyade aky[ wo. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Hw[ nea way[ wo yi yiye, 
\par yi n'ay[, yi n' ay[, 
\par yi w'Agyenkwa ay[ daa!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Tena nom' daa, tena nom' daa,
\par fa ne kwan no so ara;
\par ma ]ntew wo bra nyinaa mu;
\par kae no w] w'ade nyinaam,
\par na sr[ no n'aho]den no;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]de ne honhom di w'akyi a,
\par K] so daa,
\par fa ne kwan no so ara!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ko yiye, ko yiye,
\par pam bonsam ne wiase;
\par pa w]n, pa wo ho akyi bi,
\par pa honam ne n'ak]nn];
\par soro anigye sen fam de!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wubenya nkonim k[se adi,
\par di nkonim, di nkonim
\par na w]ahy[ wo anuonyam!\f1 
\par \pard\lang2057\f2 
\par }

