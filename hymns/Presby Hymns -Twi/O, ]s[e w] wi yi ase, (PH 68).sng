\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, ]s[e w] wi yi ase, 
\par nso nea Nyame b]] no yiye, 
\par apor]w na ahwe b]nem:
\par Onipa, w'ahantan nti.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}haw ne ahoguan d]]so, 
\par awi, nitan ne ]ko;
\par ]honam di honhom no so,
\par y[ay[ ]honam no mma.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Efi Adam so besi nn[
\par afobu da nnipa so;
\par b]ne so ade ne nnome.
\par Owu y[ akatua.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Hena na obegye nipa
\par de no asi kwan pa so? 
\par Hena na ogye akoa, 
\par na wayi ne ti mmusu?
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Onyame Ba, Wura Yesu, 
\par ]y[ Onyame koraa, 
\par nanso owuu b]n'y[fo wu 
\par de nyaa fafiri maa y[n.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Wura Yesu, hu y[n mm]b], 
\par wiase a as[e yim!
\par Begye y[n, y[ba wo nky[n bi, 
\par ma y[nhy[n wo nkwa no mu.\f1\fs22 
\par \pard\lang2057\f2\fs24 
