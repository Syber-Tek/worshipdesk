\par 1. As[m a [y[ nwonwa,
\par afotu ne nkuranhy[,
\par nidi, akomat]yam,
\par kyer[kyer[ ne odwo,
\par ahintas[m mmoroso;
\par eyinom ne Nyame d].
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nnipa a wonnim w]n ho,
\par w]n a wonhuu w]n ho da
\par na wonni nkitaho bi
\par w] adwene ne koma,
\par w]n na Nyame sakra w]n,
\par na ]ka w]n koma bom.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Treneefo n' ]ka w]n bom,
\par onim nea [te[
\par ne nea w]ma ho kwan,
\par n' obi ntumi nsiw ano.
\par Onyame p[ tim h] daa,
\par 'nipa kwan de, [yera.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Hw[ s[nea n'ad]fo
\par te aware kronkron mu;
\par ne nhyira nko na wonya,
\par na w]n abrab] k] so.
\par W]n dwumadi k] so daa,
\par na ewie w]n yiye.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. W]n d] dan y[ foforo
\par ma emu y[ den bio.
\par W]de d] tena pon ho,
\par na wodidi w] f[w so.
\par Saa ]d] yi ka w]n bom,
\par na w]n wer[ fi w]n haw.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Afei ahosan, nidi,
\par anigye, abot]yam,
\par yiyedi, nk]so, nhyira,
\par nam ]d] so ba w]n mu.
\par Ahintas[m mmoroso,
