\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Momfa anu'nyam mma Kristo
\par momfa koma ne adwene
\par mm[to dwom anigye pa mu,
\par na Kristo nyi n'ay[
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Asaman nni tumi bio,
\par owu ne bonsam ani awu.
\par Yeso Gyefo no mu den a,
\par ]pam aw'r[how nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Hw[ nea Nyame ama y[n
\par ne Ba mu, de rek] daa nkwam.
\par oyi y[n fi ha 'w'r[how mu
\par ma y[n soro anigye.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yakob ns'romma no apue
\par adum y[n p[ b]ne ano.
\par wap[t[ ]w] dada no,
\par was[e bonsam ahenni
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Na afiase nna a y[anhu, 
\par saa w'r[how yi nni kabea
\par nanso edi y[n koma so.
\par Obubum, y[de y[n ho.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. O, d]nhwerew yim aseda,
\par efi y[n koma nyinaa mu;
\par gyidi ne ano ka ho bi
\par da w'ase, y[n Yesu pa.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. Abofra f[f[ a woda
\par mmoa dakam, fa y[n nnamfo
\par ma amanan mmra wo nky[n bi
\par ne w'ab]fo nyi w'ay[.\f1\fs22 
