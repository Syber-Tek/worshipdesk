\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, Yesu Kristo, b[hw[ y[n,
\par na fa wo honhom pa ma y[n,
\par na ]mfa wo dom nni y[n kan
\par na ]nkyer[ y[n daa nkwa kwan.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Y[n t[kr[ma to dwom ma wo,
\par na y[n koma nso b] wo mpae;
\par hy[ gyidi den, tew y[n komam,
\par na y[ahu wo nyansa mu fann.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[ y[n saa daa fa kosi s[
\par y[ne Nyame asafo no
\par b[hw[ w'anim w] soro h],
\par ato wo dwom ama wo so.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Anuonyam nka Agya no,
\par \}ba ne Honhom Kronkron daa.
\par O, y[n Nyame, Nkwamafo pa,
\par gye ayeyi ne aseda!\f1 
\par \pard\lang2057\f2 
\par }

