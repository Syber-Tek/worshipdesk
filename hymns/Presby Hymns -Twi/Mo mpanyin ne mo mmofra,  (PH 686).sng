\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mo mpanyin ne mo mmofra, 
\par mommom na mommehyia, 
\par na monto Nyame dwom! 
\par Monkamfo Soro Hene 
\par s[ wab[ma y[n home, 
\par efis[ wama y[ayi d]m!
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Mommra mm[hw[ Onyame 
\par ne ne tumi nney[e 
\par s[ [da y[n anim! 
\par Way[ y[n s[ ne nk'r]fo, 
\par waboa y[n asafo, 
\par na wama y[adi nkonim bi.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyankop]n, Awurade,
\par Y[da wo w'ayamyede 
\par ne w'ad]e so ase. 
\par Woadi ama y[n manfo
\par ma w]apam w]n atamfo,'
\par wo na woay[ ade k[se!
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Afei, Agya, y[sr[ wo
\par s[, dom ma saa ahodwo
\par ne ]mannwoe yi ntim!
\par Na ma y[mfa wo kw]n so,
\par na y[mmra wo soro h]
\par mmetena wo nky[n w] asomdwoem!\f1 
