\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ma w'ab]fo no mm[w[n 
\par me ne me fifo daa,
\par na satan ne ne mpamfo
\par antumi ansse me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wiase nusu bon,
\par akwantum' amane nti,
\par hu y[n mm]b] daa nyinaa,
