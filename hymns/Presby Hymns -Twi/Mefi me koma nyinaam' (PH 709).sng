\par 1. Mefi me koma nyinaam'
\par mato  dwom mama wo.
\par Me Nyame, an]pa yi,
\par m[to wo din ho dwom
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w] w'ahengua anim.
\par Aseda, anuonyam,
\par nidi y[ wo de, wo Ba,
\par y[n Yesu Kristo, mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wufii w'ayamye no mu
\par hw[[ me ]dasu yim.
\par Amane bi anto me;
\par wuyii  me haw nyinaa
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mesr[ wo ara s[,
