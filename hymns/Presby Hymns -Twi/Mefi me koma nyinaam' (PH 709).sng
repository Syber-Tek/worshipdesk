\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me honhom, me kra, me nkwa,
\par me nipadua nyinaa,
\par me fifo, m'ade nyiaa,
\par wo nsam na mede hy[.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Nea mew] nyinaa,
\par w]n  a w]y[ m'ad]fo,
\par w]n a w]b[n me nyinaa,
