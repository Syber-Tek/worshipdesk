\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Dom hw[ me so nn[ da yi,
\par na mannya ]haw bi
\par w] ]bonsam nnadaas[m
\par ne n'afirisum mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Pam wiase b]ne,
