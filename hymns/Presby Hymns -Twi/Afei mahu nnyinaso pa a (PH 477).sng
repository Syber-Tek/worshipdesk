\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me nnyinaso no, [ne Yesu 
\par ne mm]b] a ohuu y[n no; 
\par ]n' na ]tr[w ne nsam ]d] mu, 
