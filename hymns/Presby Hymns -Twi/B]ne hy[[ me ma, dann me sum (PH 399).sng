\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. B]ne hy[[ me ma, dann me sum, 
\par na mep[e s[ menya hann. 
\par Yesu bra, b[hyer[n ma me, 
\par na ma minhu w'anuonyam. 
\par Mehwehw[ wo, ma minhu wo, 
\par yi wo ho adi ma me.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[, mahu s[ me nneb]ne 
\par ne me haw no farebae. 
\par Mepae mu ka, kot] sr[ wo: 
\par Hu me mm]b], Dawid Ba. 
\par Wona woy[ me Nkwamafo; 
\par woma me nkwa foforo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Mifi me koma mu haw mu
\par hwehw[ wo, me Gyefo pa. 
\par Me b]ne ma me koma tu, 
\par enti Yesu, bra me nky[n. 
\par Si fam bra, w'akyi na medi; 
\par wo na me koma hwehw[.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Hy[ me den, trenee ne nyansam,
\par na manantew wo hann mu. 
\par Fa wo honhom ne wo d] no 
\par b[hy[ me koma mu ma. 
\par \}dom b[n na wode dom me! 
\par Mew] wo, na wow] me.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Bue m'ani na ma minhu
\par nea wop[ s[ mey[.
\par Ma minnya nokware hann no
\par na me suban as[ wo.
\par Ma me nnwuma nni adanse
\par s[ wo hann aba me mu.
\par 
\par \cf1\ul\b\'b6  6Verse\cf0\ulnone\b0 
\par 6. Da bi me ne wo behyia 
\par na  woama me wo trenee.
\par Awer[how bi remma h],
\par na osu nso to betwa.
\par Wura Yesu,gye me taataa,
\par na fa me bra w'Agya fi.\f1 
