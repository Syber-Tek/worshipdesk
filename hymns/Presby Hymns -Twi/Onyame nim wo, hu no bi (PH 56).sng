\par 1. Onyame nim wo, hu no bi.
\par Onipa, hu wo Y[fo!
\par Amane pii w] wiase, 
\par hw[ Nyankop]n, wo Gyefo!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}w] wo na wow] no a,
\par nnipa b[tan wo ara de, 
\par nanso ]b[hw[ wo so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Onyame nim wo na onim
\par s[ wunni aho]den.
\par Hw[, wutumi nk] w'anim da,
\par k]d] no, na di n'akyi!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo Nyame pa renyi n'ani
\par w] wo a wosm no yiye
\par na wusu fr[ no daa nso.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyame nim wo papay[,
\par w'ayamye, w'ahumm]b]
\par won id], wo hiahw[,
\par ne nea obi mmu po;
\par \cf1\ul\b\'b6 
\par \cf0\ulnone\b0 na Yesu de, n's[m ne s[:
\par Wo nsonwini kuruwa
