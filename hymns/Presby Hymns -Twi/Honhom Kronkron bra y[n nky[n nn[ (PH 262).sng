\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Honhom Kronkron bra y[n nky[n nn[,
\par na ma y[ny[ wo tenabea;
\par komam wia, bepue!
\par \}soro Hann, b[hran y[n mu
\par na ma y[n komam nwie tew,
\par na ma y[n ho nt] y[n daa.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Daapem wia, wode soro
\par anigye no b[ma w]n a
\par w]b] wo mape nokware mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Woy[ nokware nyansa ti, 
\par na wode nyansa ma w]n a 
\par w]p[ w'as[m atie. 
\par Ma y[mfa gyidim' baakoy[ 
\par nso wo nokwas[m no mu p[ 
\par nni wo ho adanse pa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma y[n nyansa, na kyer[ y[n 
\par w'ayeyi ne w'anu'nyamhy[ 
\par y[n adwene ne nney[e mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ma w'as[mpa no nso ny[ nnam, 
\par na ma [nn[w te s[ ogya 
\par y[n kra ne y[n honhom mu. 
\par Ma y[nk] so wo nokwa d] 
\par ne w'as[mpa ho nimde[m, 
\par na y[anhwe b]nem bio. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Fa wo Nyame dom hy[ y[n ma, 
\par na y[atumi afr[ Kristo 
\par y[n Agyenkwa pa nokwarem.
\par \cf1\ul\b 
\par \'b6 Verse 4
\par \cf0\ulnone\b0 4. Fa w'afotu ne nyansapem 
\par Kyer[ y[n Nyame kwan so p[, 
\par na y[n de, yennim kwan no. 
\par Otumfo, hy[ y[n gyidi den,
\par na mma amane bi mmpam y[n, 
\par na y['nnyae wo akyidi.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma yenhyia y[n atamfo 
\par mfa w]n so daa mmarima so, 
\par na y[n wer' awie kyekye. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}soro bosu, y[sr[ wo, 
\par begu y[n kram, n'emu adwo. 
\par Fa wo d] hy[ y[n kra ma, 
\par na y[nn] w'asuafo a 
\par Onyame Ba gyee w]n nkwa no, 
\par n']de ne ho b[maa w]n. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mma akodi ne nitan bi 
\par nntena y[n mu da; ma ahodwo 
\par nkura y[n kra ne honam daa. 
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ma y[mfa wo ahotew so 
\par mm] y[n bra s[nea [s[, 
\par b[hy[ y[n den, di y[n so, 
\par na adefunu, ak]nn] 
\par ne nnwuma a [ns[ wo no, 
\par amma y[n bra mu bio. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yi y[n koma [ne y[n kra 
\par fi wiase ha k] soro, 
\par na y[n bo at] y[n yam daa.\f1 
