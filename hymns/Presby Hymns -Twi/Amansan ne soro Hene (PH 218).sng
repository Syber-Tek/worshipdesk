\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Amansan ne soro Hene, 
\par Yesu Kristo, Agyenkwa! 
\par Wufii wum no, wok]] soro, 
\par wok]tenaa w'Agya nifa. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mehw[ w'anu'nyam k[se yi, 
\par enti na me ho at] me. 
\par Sorofo koto w'anim, 
\par S[ na me nso mey[ nen. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wonam w'ahobr[ase so 
\par de awie y[n nkwagye;
\par enti na w]ama wo so pii, 
\par asoa wo ahenky[. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par W]de fam ne soro tumi 
\par ne aho]den ama wo, 
\par na wode hyira nipa 
\par gye wo gyidifo no nkwa. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ wonam amanehunum 
\par k] w'anuonyam nom a, 
\par na s[ me a midi w' akyi 
\par hu amane no bi a,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par [s[ me nso s[ mehw[ wo,
\par na mede me ho medan wo, 
\par na mefa wo kwan so daa, 
\par na midi w'akyi koraa. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Metumi mafa wo kwan so; 
\par wufi w'anuonyam mu 
\par soma wo Honhom Kronkron no 
\par ba w'asuafo komam. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wo Honhom no hy[ y[n den s[
\par y[ny[ nea [y[ wo f[; 
\par na s[ y[n wer[ how a, 
\par obetum' akyekye daa. 
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Yesu, hwie wo Honhom no, 
\par wo nkwa ne w'aho]den 
\par fa gu wo mmofra nyinaa mu. 
\par Y[sr[ s[ tena y[n nky[n daa, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ma w]n a w]aka kyiri 
\par mmra mm[ka w'asafo ho bi! 
\par Ko wo d]m, di wo nkonim, 
\par na w'ahenni ntr[w nt[mpa! \f1 
\par \pard\f2 
