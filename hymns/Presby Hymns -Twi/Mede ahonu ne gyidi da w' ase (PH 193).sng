\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Mede ahonu ne gyidi da w' ase; 
\par Woy[ Nyame Nwonwafo ne Nokwafo 
\par wo w'atirimp]w, wo nimde] k[se 
\par ne wo d] no mu.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[ m'adesoa, emu y[ duru pii, 
\par wode ayamhyehye yi fii m'atifi 
\par efis[ wofaa me s[ wo hiani; 
\par wuhuu me mm]b].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wo Ba ankasa n' ogyee m'adesoa; 
\par [mu y[ duru, nanso ]fa soae. 
\par \}soa koduu n'as[ndua no so; 
\par wafa me ka no.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Me Wura Yesu, m[kamfo wo d] no; 
\par [no na [ma wusui s[ minnya nkwa. 
\par Wo komam hyehyee wo maa ab]nefo; 
\par wuhuu w]n mmn]b].
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Wo ne me nni s[nea [fata me, 
\par efis[ wo ankasa afa me ka no. 
\par \{no nti fa me nneb]ne firi me 
\par w] w'anu'nyam mu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Sa me ho akuru na yi me ho fi,
\par wo mogya kronkron no na fa tew me ho. 
\par Ma wo daa nkwa nsu no mpue mfi me mu 
\par fa tew me komam.\f1 
\par \pard\f2 
\par }

