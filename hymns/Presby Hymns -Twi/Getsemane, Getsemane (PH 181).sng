\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Getsemane, Getsemane, 
\par y[n wer[ remfi h]. 
\par \{h] na y[n Agyenkwa pa 
\par konyaa awer[ho. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ne mpae dennen a ]k]boe, 
\par ne fifiri mu mogya, 
\par n'ahohia, n'aperedi, 
\par y[n wer[ remfi da. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Getsemane ne Golgota 
\par ne Yesu akoem; 
\par ne mogya kronkron hwie gui, 
\par y[n nnipa b]ne nti.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Agyenkwa, wo awer[ho
\par ne wo ahoyeraw
\par wo ko dennen a wok]koe,
\par y[n ani w] so daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. O, Yesu, y[n Awurade pa,
\par y[n Gyefo pa ne wo!
\par Ma amansan mm[da w'ase
\par w'amanehunu so!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n b]ne ho na wuhuu yaw,
\par wuwu ky[[ wo mmofra.
\par Y[n Wura ne Agyenkwa pa,
\par y[d] wo nko ara!\f1 
\par \pard\f2 
\par }

