\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Onyankop]n, nea y[w] no
\par ne nea y[de te ase,
\par efi wo d] ne w'ayamye mu;
\par enti y[da wo so ase.
\par Wo papa so y[da w'ase,
\par wo tumi nti, yeyi w'ay[.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Asase a wo nnipa te so,
\par [y[ y[n s[ ofi kok'roo;
\par wone Agya a wohw[ y[n so,
