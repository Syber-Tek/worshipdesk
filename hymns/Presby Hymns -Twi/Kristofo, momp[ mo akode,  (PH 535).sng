\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Kristofo, momp[ mo akode, 
\par atamfo hwehw[ mo as[e mo, 
\par na satan bo afu mo pii
\par Momfa Anyames[m nkrante, 
\par mo gyidi ky[m ne mpaeb] tuo, 
\par na momfa nk]ko mo d]m no
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mommma mo bo nntu da, 
\par na Yesu ka mo ho.
\par ]ne Tumfo
\par na obi nky[n n' aho]den, 
\par na y[ne no bedi nkonim.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Momfa Yesu aho]den so 
\par nyiyi mo honam ak]nn] no; 
\par mo ho na momma emfi yiye! 
\par Yesu din te mo komam a, 
\par mubenya mu aho]den daa 
\par na moanhinti anhwe ase.
\par \cf1\ul\b\'b6 
\par \cf0\ulnone\b0 Nea ]rebr[ no,
\par ]nhw[ ne kwan ase 
\par na ]nkae s[ 
\par ]soro h] na papa w], 
\par ahomeka ne ahot].
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Wonnya mfaa mo ntoo ]dam yi, 
\par monko no yiye mfe kakraa bi; 
\par y[n asetena renky[ koraa.
\par Da a w]b[fr[ awufo,\tab 
\par na nneb]ney[fo b[y'ra no,
\par mo de, mob[k] daa nkwa mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Wiasefo kyi mo,
\par b] mo at'rim]den,
\par kum mo po a, 
\par [ny[ b'ribi, Agyenkwa ni! 
\par Obeyi n'anu'nyam adi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Yesu, hy[ wo mma baninha, 
\par ma w]n a w]de  br[ ne mogya 
\par at] w]n no nni nkonim bi. 
\par S[ y[n tamfo tu y[n bo a, 
\par beyi wo ho s[ y[n Agyenkwa, 
\par na ma yenso wo mu dennen. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Behwie wo honhom 
\par ne d] gu y[n komam, 
\par na y[n ho nnwo, 
\par na y[ay[ nnam atu y[n kwan 
\par akodu soro anikam. \f1 
