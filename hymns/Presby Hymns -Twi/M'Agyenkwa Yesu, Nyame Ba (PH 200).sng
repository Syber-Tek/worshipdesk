\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. M'Agyenkwa Yesu, Nyame Ba,
\par anyan afi ne dam ampa,
\par wapam owu ne b]ne sum,
\par de y[n aba ne daa nkwa mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu antum' ankora no,
\par na b]ne bi anhy[ no so,
\par na wadi ne nkonim k[se
\par s[ nnipa mma mm[da n'ase.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. S[ Yesu Kristo te ase,
\par na ohw[ ne mmofra so a,
\par na enhia s[ yesuro
\par owu anaa asaman da.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu antum' ankora no,
\par na b]ne bi anhy[ no so,
\par na wadi ne nkonim k[se
\par s[ nnipa mma mm[da n' ase.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \}d] me, na ]p[ m'as[m, 
\par na ]kyekye me wer[ nt[m. 
\par Na s[ miwu a, ogye me 
\par k] soro k] n'ankasa fi. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu antum' ankora no, 
\par na b]ne bi anhy[ no so, 
\par na wadi ne nkonim k[se 
\par s[ nnipa mma mm[da n' ase.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Awer[kyekye yi nti na 
\par [s[ me s[ meda n' ase
\par me komam ne m'asetenam, 
\par na mafa wum, na mak] nkwam.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Owu antum' ankora no, 
\par na b]ne bi anhy[ no so,
\par na wadi ne nkonim k[se
\par s[ nnipa mma mmeda n' ase.\f1 
\par \pard\f2 
