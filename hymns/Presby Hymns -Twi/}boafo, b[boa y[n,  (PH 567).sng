\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. \}boafo, b[boa y[n, 
\par wutumi saa, Awurade. 
\par Wo nhumu ne w'aho]den 
\par y[ nea nnipa nte ase.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}boafo, b[boa y[n, 
\par wo nko ara, Awurade. 
\par Wo p[ ne s[ wubegye y[n, 
\par enti ma yenso wo mu daa.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 3. \}boafo, b[boa y[n, 
\par y[n nokware Awurade. 
\par W'agya ayamhyehye nti, 
\par wurennyaw y[n kwa ara da.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}boafo, b[boa y[n,
\par wo ne y[n Amen Tumfo no. 
\par S[ sum mu b]ne s]re a, 
\par adekyee mu, wuyi fi h]. 
\par (wo hann no mu, wuyi fi h])
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Enti di ma nnipa nyinaa 
\par te s[nea [s] w'ani. 
\par Me nso bra bedi ma me bi 
\par me wiase asetena mu.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Wo d], wo tumi da adi, 
\par na woma w'as[m ba mu p[, 
\par enti daa na m[da w'ase. 
\par Bra, Yesu, bra b[boa me.\f1 
\par \pard\lang2057\f2 
