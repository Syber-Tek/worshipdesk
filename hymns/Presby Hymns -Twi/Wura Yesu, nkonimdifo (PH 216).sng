\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Wura Yesu, nkonimdifo, 
\par woma w'ahotefo a w]ada 
\par s]res]re fi w]n wu mu. 
\par Wuwui na wos]ree bio, 
\par wokum wo, na wunyaa nkwa bio na
\par wob[y[[ nkwagye Hene. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0\i 
\par Y[n nyinaa b[som wo, 
\par y[b[kamfo wo daa, 
\par woy[ k[se.
\par \i0 Wos]re fii owu mu nti, 
\par yebeyi w' ay[ daa nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na Adam asefo nyinaa 
\par y[ satan nkoa w] b]ne mu, 
\par na [de w]n k]] owu mu. 
\par Efi tete na [bae saa; 
\par obi bi antumi annye w]n 
\par maa owu adi w]n nyinaa so. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0\i 
\par Na enti wo d] no 
\par ma wusian fii soro 
\par baa wiaae.
\par \i0 Wobae, wuhui, wubewiei, 
\par wuwui de wiee ne nyinaa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Enti wo soro Agya no 
\par nam Honhom Kronkron so anyan wo 
\par ama woafa wo nkwa bio.
\par Owu, satan ne wiase,
\par woadi w]n so na w]ansiw kwan,
\par na wontumi ny[ hwee bio. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0\i 
\par Wo ne Otumfo no, 
\par na wokyekye abran 
\par gye w]n nnomum. 
\par \i0 Nnomumfo no na wuhwim w]n; 
\par woma wonya ahofadi. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Eyi nti y[de ayeyi,
\par aseda ne anu'nyam k[se, 
\par anigye ne ahurusi, 
\par ahosan ne nhyira ma wo, 
\par ne Agya ne Honhom Kronkron no
\par s[ woayi y[n afi owum. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0\i 
\par Yegye wo nnwuma di. 
\par O, gye y[n s[ wo de, 
\par y[ y[n wo mma. 
\par \i0 Twe y[n nyinaa bra wo nky[n daa,
\par na ma yennya wo daa nkwa no. \f1 
\par \pard\f2 
