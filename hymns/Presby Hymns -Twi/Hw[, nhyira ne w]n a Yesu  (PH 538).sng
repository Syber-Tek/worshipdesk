\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Hw[, nhyira ne w]n a Yesu 
\par dan w]n y[ w]n n'ay[foro, 
\par na w]som no n'asafom. 
\par Aho]den ne tumi mu 
\par w]w] ne nky[n, na w]som no 
\par anadwo ne awia.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. W]n anu'nyam hena n' onim? 
\par Obi nnim nea wobenya; 
\par w]akata so asie. 
\par \}soro mu soro mpo nnim 
\par ]d] a w]n Hene pa no 
\par de d] w]n a w]d] no. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na s[ Serafim de suro
\par katakata wan anim a,
\par ay[foro rensuro.
\par Enti ]de ahotoso,
\par hw[ \}hene w] n'agua ao,
\par na [ma n'anim hyer[n 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ahopopo ne osuro
\par [n' na w]de som \}hene 
\par w] ne kronkronbea h].
\par Na ay[foro mma no de, 
\par s[ w]hw[ w]n hene no a,
\par w]n koma t] w]n yam pii.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Awurade, mesr[ wo s[
\par dom ma minnya wo nhumu no 
\par ne wo Nyame su no bi. 
\par Ma mintumi nhw[ me ho so,
\par na mempa fam adefunu
\par na may[ w'ay[foro.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[ manhu a, m'ani da so
\par kosi bere a w]ahy[ s[ 
\par ]ne me behyia no.
\par N'ay[forohyia no mu 
\par na menya nea migye dii,
\par na ne d] aboro so.\i\f1 
\par \pard\lang2057\i0\f2 
\par }

