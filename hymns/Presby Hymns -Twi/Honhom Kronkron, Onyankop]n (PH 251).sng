\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Honhom Kronkron, Onyankop]n
\par fa Yesu nnepa ne ne dom
\par hy[ gyidifo koma ma!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par B[s] wo d] gya w] w]n mu,
\par na fa w'as[mpaka no so
\par fr[ amansan se wommra.
\par \{no nti y[reto wo dwom
\par ayi w'ay[ w] w'asafom.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O, Hann Kronkron, y[n Nyame pa,
\par ma w'as[m no ntena y[n mu daa,
\par na y[ahu Nyame yiye!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Yi n'agyad] kyer[ nnipa,
\par na y[ab] no mpae daa s[ mma.
\par Pam nnaadaa ne akyinnye
\par Ma y[mfa d] ne gyidi nni
\par y[n Wura Yesu no akyi!
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. W'aw'r[kyekye n'[y[ y[n d[,
\par b[boa y[n na y[mfa f[w
\par nsom wo daa nokwarem,
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Na mma ]haw bi mmpam y[n da;
\par na s[ bonsam ba y[n so a,
\par ma y[nko mmarima so.
\par S[ yewu a, ma yemfi wum,
\par na y[nko wo daa nkwa no mu!\f1 
\par \pard\f2 
