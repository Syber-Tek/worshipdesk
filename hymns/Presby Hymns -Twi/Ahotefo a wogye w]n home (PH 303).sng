\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yegye di s[ ahotefo
\par fofa w]n ho ay]nko,
\par efis[ w]w] dom koro,
\par wura ne honhom baako;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par dodow a Kristo tew w]n ho,
\par n'ade y[ w]n nyinaa dea,
\par [ha ne soro h]nom.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Na s[nea w]n ha tena te,
\par w]n asetenam nam ahorow,
\par ma w]n mu bi y[ adefo
\par w] anu'nyam ne nidi;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par n'ebinom y[ ahiafo,
\par wiasefo mmu w]n bi;
\par na Onyame bu w]n p[. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na y[n Agyenkwa no anim 
\par na w]n nyinaa y[ baako; 
\par na y[w] Kristo baako p[; 
\par ]ne y[n Gyefo koro, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par y[n Nkwagye ne y[n soro Hann; 
\par na y[n nyinaa w] n'as[mpa, 
\par n'asub] ne n'adidi
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \}dehye, akoa nni h];
\par w]y[ Onyame mma p[;
\par na wonnyafi ahiafo,
\par na w]nkamfo adefo; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na adefo pii di hia,
\par ahiafo nya daa nnepa;
\par na Nyame sra koma mu.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}soro baako n' [w] h], 
\par ne kwankyer[fo baako; 
\par ]wer[kyekyefo koro 
\par ka y[n ho w] amanem. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par \}kwan koro a y[fa so 
\par k] soro ahot] no mu 
\par da h] ma gyidifo no.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Enti m[tena ahotefo 
\par ay]nkofa mu daapem; 
\par na ehia me nua a, 
\par [no de, merennyaw no; 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par mihu n'amane abia a, 
\par menya n'anuonyam no bi 
\par \pard w] ]soro noh] daa.\f1 
\par \lang2057\f2 
\par }

