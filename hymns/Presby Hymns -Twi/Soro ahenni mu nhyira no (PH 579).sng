\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Soro ahenni mu nhyira no
\par y[ honhom fam hiafo de.
\par Soro ahenni mu nhyira no
\par w] honhom fam wer[hofo.
\par Na nhyira ne w]n a wodwo no,
\par na wobenya aman adi so.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Nnipa a trenee ho k]m de w]n no,
\par b[mee w] Yesu Kristo mu.
\par W]n a w]y[ mm]b'r]hunufo
\par na wobenya ahumm]b].
\par Na w]n a w]n komam atew no
\par behu Onyankop]n w] soro
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Apatafo na w]b[fr[ w]n
\par Onyame mma ne n'adehye.
\par W]n a trenee nti, w]taa w]n no,
\par benya ]soro ahenni,
\par na w]ay[ ahemfo, as]fo
\par ne anu'nyamfo w] n'anim h].
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. S[ ]bonsam mma ka ns[mm]ne
\par gu y[n so w] ne din no nti,
\par na w]yeyaw y[n, taa y[n, kum y[n,
\par s[ y[y[ Yesu nnamfo a,
\par [s[ s[ y[n ani gye ho po,
\par y[n akatua so w] poro.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. O, Yesu, ma menhwehw[ wo a
\par woy[ me Hene, me Gyefo 
\par me Wer[kyekyefo, m'Ahode,
\par me daa Trenee ne me Domfo, 
\par me Nuonyamfo, m'Akatua; 
\par wow] me a, hwee renhia me.\f1 
\par \pard\lang2057\f2 
\par }

