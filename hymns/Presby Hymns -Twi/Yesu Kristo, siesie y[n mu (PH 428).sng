\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yesu Kristo, siesie y[n mu, 
\par na mma y[mmfa adwene hunu 
\par mma wo adidi ase ha
\par ma y[mm[n wo gyidi pa mu,
\par na ma y[mfa y[n koma mma wo,
\par na y[anya wo mu daa nkwa no!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[y[ wo de kora, 
\par na mma y[nnyaw wo da! 
\par Yeso wo mu! 
\par Yeyi w' ay[, na daakye bi 
\par y[b[tena soro pon ho bi.\f1 
\par \pard\lang2057\f2 
