\par (Asafo)
\par 1. \i0 Owu mu Nkonimdifo ni! 
\par Wode wo mogya at] wo mma; 
\par w]de aseda nnwom ma wo. 
\par W]de anigye hyia wo 
\par s[ w]n 'Nuonyamfo ne D]fo 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par w]n Kronkronni ne w]n Gyefo.
\par W'aniwa hu w]n fee, 
\par wobutuw w'anim daa; 
\par w]s]re wo. 
\par Awurade, w]y[ wo de. 
\par Y[de w]n nyinaa hy[ wo nsa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0\i 
\par (Mmofra)
\par \i0 2. Domfo Wura, may[ wo de; 
\par bere a w]b]] me asu no, 
\par madan wo ba a wod] no. 
\par Woaky[ me ]soro nnepa, 
\par na minni wo a, mey[ mm]b]; 
