\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. M[bata wo, Yesu ho daa, 
\par meso wo mu, na merennyaw wo,
\par na wo nso bedi m'akyi daa. 
\par Gye me w] wiase b]nem, 
\par fa me sie wo nokware mu, 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
