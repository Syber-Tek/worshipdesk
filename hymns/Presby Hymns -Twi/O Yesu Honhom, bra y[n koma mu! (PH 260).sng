\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O Yesu Honhom, bra y[n koma mu!
\par Wo d] kronkron no, atew y[n ho.
\par Y[n Kwankyer[fo, di y[n anim kan,
\par na ]soro h], y[anya nidi.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Owia fi a, Na nhwiren apae,
\par saa na wo d] no, y[ n'ade nen.
\par B[tena y[n nky[n daa, na b[tew y[n ho,
\par na y[ay[ kronkron, akosi daa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Owia redum, ama ne hyer[n.
\par \{de ahosan, ama nnipa.
\par Saa na Honhom no, de ne hyira ba.
\par \{te nnipa mu, kosi daapem.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Honhom Agya pa, kyekye y[n wer[;
\par fa wo honnhom no, ma y[n koraa.
\par wo kyer[ pa no, na [nkyer[ y[n
\par daa nkwa kurow no, w] soro h].\f1 
