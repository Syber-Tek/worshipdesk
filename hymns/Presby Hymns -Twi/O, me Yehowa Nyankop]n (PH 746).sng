\viewkind4\uc1\pard\sl276\slmult1\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. O, me Yehowa Nyankop]n
\par ma  minhu me nna kan
\par na memfa me koma mma wo,
\par na may[ nyansafo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Me Wura ne m'Agyenkwa pa
\par y[ me wo ba bio.
\par Nyansa ne nimde[ b[y[
\par m'asetena mfiase.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. O, fi w'ahumm]b] no mu
\par b[kyekye me wer[.
\par Ma memm[y[ wo de bio
\par w] w'animka akyi.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Sakra me, na ma me ho ntew,
\par na  fa daa nkwa ky[w no
\par hy[ me tin a y[ me kronkron,
\par w] w'ahenni mu h].
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. S[ me wiase nna to twa,
\par na  m'awiei du a,
\par ma  minhu wo s[ me Gyefo
\par akyiri  nna no mu.\f1\fs22 
\par \pard\f2\fs24 
