\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Awurade, y[ me s[ wop[, 
\par m[tena 'se oo, mewu oo, 
\par wo d] no nko na mehwehw[, 
\par na nnyaw me b]ne s[e mu. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Me yawm ma me boaset], 
\par ma wo dom pa no nhw[ me so; 
\par w'ap[de n' eye ma me. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ma w'as[mpa no ny[ me d[; 
\par ma minni w] nokware! 
\par Ma meny[ nea wop[ no, 
\par na ]bonsam annya me.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Ma minni w'ahy[de no so, 
\par na ma me nney[e mfata wo 
\par w] m'asetena nyinaa mu. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. S[ da bi wubehyia me 
\par fi fam ha ba w'anim a,
\par ma memfa f[w ne anigye 
\par mintie fr[ no memmra. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Mede me honam ne me kra 
\par Mehy[ w], m'Agyenkwa pa, nsa; 
\par fa me ye w] de dabaa.\f1 
\par \pard\lang2057\f2 
\par }

