\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. W]mfa nidi mma Nyame, 
\par ]n'na ]ne y[n w] h] daa. 
\par W'ahw[ y[n ]som yi so, 
\par na wama aba awiei. 
\par Enti yebeyi n' ay[ daa 
\par s[ ]de n'as[m ama y[n. 
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}som aba awiei,
\par na afei y[de ne nhyira 
\par reb[ka y[n afi mu, 
\par na ne Honhom Kronkron atena 
\par y[n nyinaa mu w] ne din mu, 
\par na daakye bi y[adu ne nky[n.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Onyankop]n nhyira mmra, 
\par y[n adifi ne mu ba so; 
\par ]nhw[ ne nnwuma, y[n su, 
\par adidi ne anigye so. 
\par \}mma yenwu w] asomdwoem, 
\par na y[anya soro ahenni. 
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ayeyi nka Agya no, 
\par \}ba ne Honhom Kronkron daa; 
\par w]y[ Onyame koro, 
\par Onyame Baasakoro no. 
\par N'as[mpa no ne y[n ntena daa 
