\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Me deb]ney[fo hiani,
\par migyina Nyame anim nn[.
\par O, me Nyankop]n, hu me mm]b],
\par na w]anni me b]ne akyi.
\par Hu me mm]b], hu me mm]b]
\par me Nyame mm]b'r]hunufo.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Hw[ s[nea me b]ne pii no
\par ama m'abrab] agyigya.
\par Ma minnya w'anim anuonyam,
\par mey[ w] ba a wayera.
\par Hu me mm]b], hu me mm]b]
\par me Nyame mm]b'r]hunufo.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Y[ aso tie me nkot]sr[
\par wo a w]y[ ]d] Nyame
\par Fa me b]ne nyinaa firi me,
\par na beyi me koma mu fi.
\par Hu me mm]b], hu me mm]b],
\par me Nyame mm]b'r]hunufo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na mma minni b'ribi ho nk]mm]
\par so w]nte me mm]b]r] nne?
\par So me nk]t]sr[ b[y[ hunu?
\par Woreny[ me aso anaa?
\par Hu me mm]b], hu me mm]b],
\par me Nyame mm]b'r]hunufo.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \{w]m s[ me b]ne d]]so pii,
\par na esiw m'ayaresa kw]n,
\par nanso mede mm]b'r]nne mefr[
\par de kosi s[ me ho befi.
\par Hu me mm]b], hu me mm]b],
\par me Nyame mm]b'r]hunufo.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Dom me fa me b]ne firi me,
\par na mannya so akatua;
\par O, Agya pa, b] me ho ban daa,
\par na fa me y[ wo ba bio.
\par Hu me mm]b], hu me mm]b],
\par me Nyame mm]b'r]hunufo.
\par 
\par \cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. O, kasa [, na ma minnya nkwa,
\par ma mente w'as[m as[:
\par Me ba, mepopa w] mm'rato no,
\par enti nk]y[ b]ne bi.
\par Hu me mm]b], hu me mm]b],
\par me Nyame mm]b'r]hunufo.
\par 
\par \pard\cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par 8. Merennye akyinne biara,
\par \pard\sl276\slmult1 minim s[ menya fafiri;
\par wo mu anigye w] me komam',
\par enti merenni nk]mm] bi.
\par Hu me mm]b], hu me mm]b],
\par dom hu me mm]b] nn[ ne daa.\f1 
\par \pard\lang2057\f2 
