\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Yehowa ne me Hwefo pa,
\par na hwee renhim me.
\par \}ma meda wura fr]mm so,
\par de me k] nsu pa ho.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \}ma ma kra ho s[p[ no,
\par ]ky[r[ me nan kwan,.
\par de me fa ]kwantrenee so
\par s[nea ne din te. 
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Menam owu bon mu po a,
\par minsuro b]ne bi
\par Me nantew mu, wode w'abaa
\par ma me wer[ kyekye,
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Wode adepa tow me pon
\par w] m'atamfo anim;
\par Wode ngo pa f]w me tirim;
\par me kuruwa bu so.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Yiye na ebedi m'akyi,
\par me nkwa nna nyinaa mu.
\par Yehowa fi na [b[y[
\par me daa tenabea pa.\f1 
\par \pard\lang2057\f2 
