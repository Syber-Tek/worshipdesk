\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Momm] mm]den na mony[ baako 
\par w] y[n Agyenkwa Yesu mu.
\par \}d] [ne asomdwoe nhama
\par na momfa nkyekyere mo ho!
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n nyinaa y[ ]honam baako
\par na y[n honhom y[ baako p[.
\par Na w]de anidaso baako
\par fr[ y[n s[ y[mmenya daa nkwa.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Wura a y[som no no y[ baako,
\par na gyidi baako w] y[n mu.
\par Asub] baako na w]fa so
\par de y[n fra Nyame mma no mu.
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n nyinaa Agya Onyame no
\par y[ baako a odi y[n so,
\par na okura y[n nyinaa mu nso,
\par na ]te y[n nyinaa'ra mu.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Na y[n nyinaa'ra mmaako mmaako
\par anya Onyame dom no bi
\par y[anya no s[nea y[n Wura 
\par ap[de ne nsusuwi te. 
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par Y[n Wura Yesu no k] soro, 
\par wafa atamfo no nnommum,
\par na ]de Nyankopan nnepa no 
\par ky[ nnipa a w]y[ gyidifo.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na s[nea ]k]faa soro,
\par s[ nso asase ne n'ase
\par y[ ne de nen; Agya Onyame
\par de ne nyinaa ahy[ ne nsa;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par ]de no asi sorosoro,
\par asase ne asaman so
\par s[ ]mfa ne nnepa nhy[ nnipa
\par ne ade nyinaa 'ra ma ma.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. \}no de binom ma n'asafo
\par s[ asomafo, n' ebinom
\par ka n'as[m no s[ adiyifo,
\par n' ebinom ka n'as[mpa no
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par kyer[ w]n a w]som abosom,
\par n'ebinom hw[ ne nguan no so,
\par n'ebinom y[ kyer[kyer[fo
\par ma n'ahenni mu ns[m da ha.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \}nam w]n som so siesie
\par n'asafo mma nyinaa p[p[;
\par ]de w]n adwuma bewie
\par n'ade a-ofii ase y[e;
\par \cf1\ul\b\'b6 \cf0\ulnone\b0 
\par na ]ma yenyin p[ nya nk]so
\par kosi s[ y[n nyinaa bedu
\par Onyame ne ne Ba no nhumu
\par ne ne mu baakoye no mu.\f1 
\par \pard\cf1\ul\b\fs16 
\par }

