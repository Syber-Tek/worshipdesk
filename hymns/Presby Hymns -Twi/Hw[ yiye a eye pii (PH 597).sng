\viewkind4\uc1\pard\sl276\slmult1\cf1\lang1033\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Hw[ yiye a eye pii
\par [ne f[ a [y[ nso
\par s[ gyidim anuanom
\par fa w]n ho ay]nko bom
\par tena faako, dwoodwoo ne komm
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \{te s[ ngo huamhuam
\par egugu Aaron mpampam
\par sian gugu ne b]gyes[m,
\par ma ebi gu n'atadem,
\par saa na nua do y[ huam
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \{te s[ obosu a
\par edwudwo asase pa
\par ma [so y[ fr]mm ara,
\par na nn]bae pii fi mu ba;
\par senea nua d] te nen.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Na nea saa d] no w],
\par [h] na Onyame b]
\par Ahy[ ]honam ne kra
\par daa nkwa [ne ne nhyira.
\par Yesu, ma yennya no sa!\f1 
\par \pard\lang2057\f2 
