\viewkind4\uc1\pard\cf1\lang1040\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. DZEB\}NY\{NYI k]besae a mahaw,
\par \}domankoma, mma nnto me seraha.
\par \}bra n'ehum rutu, kwanm' ay[ k]nn,
\par \}bra no kwangyafo], gya m' kodu s]nn
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Gya m' kodu fie, me kra no korabew,
\par Mbr[ ankonam b]b]fo] biara nnyew.
\par Ma bra n'ewiei to m' a, Onyankop]n,
\par Samanadze kanea, gya m' kodu s]nn.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. 'Wo a kitsa samanadze saafee
\par Akra a woenya wo no w]nnhwehw[ hwee;
\par 'Wo y[ Nokwar, \}kwan, N-kwa ma ab]n;
\par Annk]a w]nnk] Christ e, gya m' kodu s]nn.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Sum mu etumfo pii risi me mpa,
\par Woetwa ayer m'; minnya beebi memfa;
\par Naaso ber a medan Wo Nyame d] n',
\par M'ad]ntsenhen tumfo, gya m' kodu s]nn.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Medan Wo gya a, mabra; adze ehu m';
\par Motwer Wo a, mewie, owu nnkotum me;
\par M'adagyaw mu, boa me meny[ tartwe]n;
\par Ankor-n' apem-Nyame, gya m' kodu s]nn.
\par 
\par \cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. S[ 'Wo Christ gya m' a, mow] asomdwee;
\par Me hia mu W' asem y[ m' edzi-amee;
\par Migyaa moho ma Wo Sunsum Kr]nkr]n,
\par D[ ekyim o, nts[m o, gya m' kodu s]nn.  \f1 
\par \lang1033\f2 
