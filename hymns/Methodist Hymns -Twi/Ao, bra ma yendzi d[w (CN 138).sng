\viewkind4\uc1\pard\cf1\lang1040\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. Ao, bra ma yendzi d[w
\par S[ nkan n' meye hianyi a,
\par Afei menya Nyame ho d],
\par \}d] a ]kyen sika.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Ao bra ma yendzi d[w,
\par S[ nkan n' mot]] bahaw a
\par Afei menya Otumfo a
\par N'abaw we]n me dabaa.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Ao, bra ma yendzi d[w,
\par S[ nkan n' mob]] eko a,
\par Nyame dze No d] atwe me
\par D[ mensan m'Egya fie.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ao, bra ma yendzi d[w,
\par N ky[ me kra reyew;
\par M'Agyenkwa Jesus ab]twe m'
\par W] b]n na ab]nsam nsa.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ao, bra ma yendzi d[w,
\par Afei menya Nyanko a
\par No d] ky[n onua mpo no d],
\par \}d] a onnyi ewiei a.
\par \pard\fi720 
\par \pard\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Ao, bra ma yendzi d[w,
\par Ao, 'wo a eb] Jesus,
\par Nyame N'ab]dze nyinara,
\par Wonsuo m'yenyi N'ay[w.\f1 
