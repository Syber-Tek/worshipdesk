\viewkind4\uc1\pard\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par I know that my Redeemer lives -
\par What joy the blest assurance gives!
\par He lives, He lives, who once was dead;
\par He lives, my everlasting Head.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. He lives, to bless me with His love;
\par \pard\li180\sl190\slmult0 He llives, to plead for me above;
\par He lives, my hungry soul to feed;
\par He lives, to help in time of need.
\par 
\par \pard\fi-225\li405\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.   He lives, and grants me daily breath;
\par \pard\li405\sl190\slmult0 He lives, and I shall conquer death;
\par He lives, my mansion to prepare;
\par He lives, to lead me safely there.
\par 
\par \pard\fi-225\li405\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.   He lives, all glory to His name;
\par \pard\li405\sl190\slmult0 He lives, my Saviour, still the same;
\par What joy the blest assurance gives,
\par \pard       I know that my Redeemer lives!\f1 
\par \cf1\ul\b\f2\fs14 
\par }

