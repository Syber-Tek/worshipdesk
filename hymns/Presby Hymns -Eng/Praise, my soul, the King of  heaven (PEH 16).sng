\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0    Praise, my soul, the King of  heaven;
\par \pard\li270\sl190\slmult0 to his feet thy tribute bring;\tab 
\par ransomed, healed, restored, forgiven,
\par  who like me his praise should sing?\tab 
\par Praise him! Praise him!\tab 
\par Praise the everlasting King.\tab 
\par 
\par \pard\fi-270\li270\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Praise him for his grace and favour
\par \pard\li270\sl190\slmult0\qj To our fathers in distress;\tab 
\par \pard\li270\sl190\slmult0 praise him, still the same for ever,\tab 
\par slow to chide, and swift to bless:
\par Praise him! Praise him!\tab 
\par Glorious in his faithfulness.\tab 
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.   Father-like he tends and spares us;
\par \pard\li270\sl190\slmult0 well our feeble frame he knows;\tab 
\par \pard\li225\sl190\slmult0  in his hands he gently bears us,
\par \pard\li360\sl190\slmult0 rescues us from all our foes:
\par Praise him! Praise him!\tab 
\par widely as his mercy flows.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Frail as summer's flower we flourish;
\par \pard\li360\sl190\slmult0 blows the wind and it is gone;
\par but, while mortals rise and perish,
\par God endures unchanging on.
\par Praise him! Praise him!
\par Praise the high eternal One.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Angels, help us to adore him;
\par \pard\li360\sl190\slmult0 ye behold him face to face;
\par sun and moon, bow down before Him;
\par dwellers all in time and space.
\par Praise Him! Praise Him!
\par \pard         Praise with us the God of grace.\f1 
\par \cf1\ul\b\f2 
\par }

