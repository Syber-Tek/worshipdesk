\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus shall reign where'er the sun
\par \pard\li180\sl190\slmult0\qj  Does its successive journeys run;
\par  His Kingdom stretch from shore to shore,
\par  Till moons shall wax and wane no more.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  People and realms of every tongue
\par \pard\li180\sl190\slmult0  Declare his love in sweetest song;
\par  And infant voices shall proclaim
\par  Their early blessings on his name.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Blessings abound where Jesus reigns:
\par \pard\li315\sl190\slmult0\qj The prisoners leap to lose their chains,
\par The weary find eternal rest,
\par And all who suffer want are blessed.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Let every creature rise and bring
\par \pard\li315\sl190\slmult0 The highest honours to our King;
\par Angels descend with songs again,
\par \pard       And earth repeat the loud  Amen.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

