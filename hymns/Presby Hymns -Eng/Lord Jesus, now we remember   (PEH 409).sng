\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Lord Jesus, now we remember
\par \pard\li225\sl190\slmult0 The day you went to Canaan
\par You were invited to the town
\par On that happy wedding day
\par Jesus, hark, we beseech Thee
\par  Come and dwell within our midst
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2. Let your peaceful greetings dawn on
\par \pard\li225\sl190\slmult0 This day's great ceremony
\par We want to become one today
\par \pard\li315\sl190\slmult0 And forever remain same
\par Only death can separate
\par The bond of this sound marriage
\par 
\par \pard\fi-225\li315\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Lord, through grace, kindly strengthen us
\par \pard\li315\sl190\slmult0 For, we shall remain in truth
\par To vow and offer holy pledge
\par In order not to deviate,
\par Jesus, bless them completely
\par \pard      And dwell with them forever.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

