\viewkind4\uc1\pard\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  Hark! the herald angel sing,
\par \pard\li144\sl190\slmult0   'Glory to the new-born King,
\par   Peace on earth, and mercy mild,
\par   God and sinners reconciled!'
\par \cf1\ul\b\'b6   Verse\cf0\ulnone\b0 
\par   Joyful, all ye nations, rise,
\par   Join the triumph of the skies,
\par   With the angelic host proclaim,
\par   'Christ is born in Bethlehem'.
\par 
\par \cf1\ul\b\'b6  Chorus\cf0\ulnone\b0 
\par Hark! the herald angels sing,
\par 'Glory to the new-born King'.
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Christ, by highest heaven adored,
\par \pard\li144\sl190\slmult0   Christ, the everlasting Lord,
\par   Late in time behold Him come,
\par   Offspring of a virgin's womb.
\par \cf1\ul\b\'b6  Verse\cf0\ulnone\b0 
\par  Veiled in flesh the Godhead see
\par   Hail, the Incarnate Deity,
\par   Pleased as Man with man to dwell,
\par   Jesus, our Immanuel!
\par 
\par \cf1\ul\b\'b6  Chorus\cf0\ulnone\b0 
\par Hark! the herald angels sing,
\par 'Glory to the new-born King'.
\par 
\par \pard\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.   Hail, the heaven-born Prince of  Peace!
\par \pard\li144\sl190\slmult0   Hail, The Sun of Righteousness!
\par   Light and life to all he brings,
\par   Risen with healing in his wings.
\par \cf1\ul\b\'b6   Verse\cf0\ulnone\b0 
\par  Mild He lays His glory by,
\par   Born that man no more may die,
\par   Born to raise the son of earth,
\par \pard      Born to give them second birth: 
\par 
\par \pard\li144\sl190\slmult0\cf1\ul\b\'b6  Chorus\cf0\ulnone\b0 
\par Hark! the herald angels sing,
\par 'Glory to the new-born King'.
\par \pard\f1 
\par \cf1\ul\b\f2 
\par }

