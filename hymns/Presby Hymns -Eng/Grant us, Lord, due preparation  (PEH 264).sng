\viewkind4\uc1\pard\fi-225\li225\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1\cf0 .  Grant us, Lord, due preparation
\par \pard\li225\sl190\slmult0\qj For Thy blest supper's celebration!
\par Come, come, O God, within our midst.
\par In this life do us enable
\par In faith to now approach Thy table;
\par Pronounce us free from death and sin.
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj O Saviour, we are Thine!
\par Thine let us e'er remain!
\par Amen!  Amen!
\par Praise be to Thee! In heaven we,
\par Thy supper great shall celebrate.
\par \pard\sl190\slmult0 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.   May Thy glorious invitation
\par \pard\li360\sl190\slmult0 To this most blessed celebration
\par Extend to all who love Thy name.
\par Come then, ye who hear this calling,
\par His plea be not on deaf ears falling,
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par For strength and pow'r is ours to gain.
\par O Saviour, we are Thine!
\par Thine let us e'er remain!
\par Amen!  Amen!
\par  Praise be to Thee! In heaven we,
\par \pard       Thy supper great shall celebrate.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

