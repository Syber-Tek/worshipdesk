\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  God be with you till we meet again;
\par \pard\li180\sl190\slmult0 By His counsels guide, uphold you,
\par With His sheep securely fold you:
\par   God be with you till we met again.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  God be with you till we meet again;
\par \pard\li180\sl190\slmult0 'Neath His wings protecting hide you,
\par Daily manna still provide you:
\par God be with you till we meeet again.
\par \pard\fi-18\li18\sl190\slmult0 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.   God be with you till we meet again,
\par \pard\li315\sl190\slmult0  When life's perils thick confound you,
\par  Put His arms unfailing round you:
\par  God be with you till we meet again.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  God be with you till we meet again;
\par \pard\li315\sl190\slmult0  Keep love's banner floating o'er you
\par  Smite death's threatening wave before you
\par \pard      God be with you till we meet again.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

