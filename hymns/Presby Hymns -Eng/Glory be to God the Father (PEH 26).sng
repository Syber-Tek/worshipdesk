\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0   Glory be to God the Father,
\par \pard\li225\sl190\slmult0  Glory be to God the Son,
\par  Glory be to God the Spirit,
\par  Great Jehovah, Three in One!
\par  Glory, glory; Glory, glory
\par  While eternal ages run!
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Glory be to Him who loves us,
\par \pard\li270\sl190\slmult0\qj Washed us from each spot and stain!
\par Glory be to Him who bought us,
\par Made us Kings with Him to reign! Glory, glory
\par To the lamb that once was slain!
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Glory to the Kings of angels,
\par \pard\li225\sl190\slmult0  Glory to the Church's King
\par  Glory to the King of nations!
\par  Heaven and earth, your praises
\par  bring; Glory, glory
\par To the King of Glory bring!
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Glory, blessing, praise eternal!
\par \pard\li225\sl190\slmult0 Thus the choir of angels sings;
\par Honour, riches, power, dominion!
\par Thus its praise creation brings; Glory, glory
\par \pard  Glory to the King of kings.\f1 
\par \cf1\ul\b\f2 
\par }

