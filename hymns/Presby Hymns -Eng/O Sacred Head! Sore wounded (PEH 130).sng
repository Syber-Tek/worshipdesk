\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  O Sacred Head! Sore wounded,
\par \pard\li180\sl190\slmult0 With grief and shame bowed down!
\par O Kingly Head, surrounded
\par With thorns, thine only crown!
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par How pale art thou with anguish,
\par With sore abuse and scorn!
\par How does that face now languish,
\par Which once was bright as morn!
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O Lord of life and glory,
\par \pard\li180\sl190\slmult0 What bliss till now was thine!
\par I read the wondrous story;
\par I joy to call thee mine.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Thy grief and bitter Passion
\par Were all for sinners' gain;
\par Mine, mine was the transgression,
\par But thine the deadly pain.
\par 
\par \pard\fi-270\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 3\ulnone\b0 
\par  \cf0 3. What language shall I borrow
\par \pard\li360\sl190\slmult0 To praise thee, heavenly Friend,
\par For this, thy dying sorrow,
\par Thy pity without end?
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par O make me thine for ever,
\par And, should I fainting be,
\par Lord, let me never, never
\par Outlive my love to thee.
\par 
\par \pard\fi-270\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4. Be near me, Lord, when dying;
\par \pard\li315\sl190\slmult0 O show thyself to me;
\par  And, for my succour flying,
\par  Come, Lord, and set me free;
\par \cf1\ul\b\'b6  Verse\cf0\ulnone\b0 
\par These eyes, new faith receiving,
\par  From thee shall never move;
\par  For they who die believing
\par \pard         Die safely through thy love.\f1 
\par \cf1\ul\b\f2 
\par }

