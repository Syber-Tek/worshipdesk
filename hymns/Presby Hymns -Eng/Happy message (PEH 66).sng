\viewkind4\uc1\pard\fi-225\li225\sl180\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  1. \cf0  ://:Happy message ://:
\par \pard\li225\sl180\slmult0 We are told to-day
\par ://:This very day ://:
\par a saviour is born
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par He is Christ, He is the Lord
\par For us all in Bethlehem
\par ://:Be ye happy ://:
\par Oh! all you mankind.
\par 
\par \pard\fi-225\li225\sl180\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2. ://:Yes is Jesus ://:
\par \pard\li225\sl180\slmult0 That is born for us
\par ://:He is The king ://:
\par over all the earth
\par \pard\li180\sl180\slmult0\cf1\ul\b\'b6    Verse\cf0\ulnone\b0 
\par but his kingdom here on earth
\par   dwells in the hearts of mankind
\par   ://:seeking for us ://:
\par   and of all mankind.
\par 
\par \pard\fi-180\li180\sl180\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par   3.  ://:The Son of Man://:
\par \pard\li180\sl180\slmult0   has come in nature
\par   ://:He has saved us ://:
\par   From this sinful world.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par   Keep us within your children
\par   O, our King Emmanuel
\par   ://:Come and save us://:
\par   And of all mankind.
\par \pard\f1 
\par \cf1\ul\b\f2 
\par }

