\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0   Trust your life to Jesus Christ;
\par \pard\li225\sl190\slmult0  Bow to him in full submission:
\par Your own strength is not sufficient,
\par And you need his constant help.
\par Trust your life to Jesus Christ.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par   2.  Trust yourself to Jesus Christ;
\par \pard\li225\sl190\slmult0   He protects the meek and humble:
\par   He'll support you when you stumble,
\par \pard\li315\sl190\slmult0  Lead you to eternal life.
\par  Trust yourself to Jesus Christ.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Give your all to Jesus Christ;
\par \pard\li315\sl190\slmult0  When the devil tries to hurt you
\par  Your Lord Jesus won't desert you;
\par  He will help you to succeed.
\par \pard      Give your all to Jesus Christ.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

