\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0   From heav'n above to earth I come
\par \pard\li180\sl190\slmult0   To bring good news to everyone;
\par  Glad tidings of great joy I bring\tab 
\par  Where-off  I now will tell and sing.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  To you this night is born a Child,
\par \pard\li180\sl190\slmult0  Of Mary, chosen mother mild.
\par   This little Child of lowly birth
\par  Shall be the joy of all the earth!
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.   These are the tokens you shall mark,
\par \pard\li180\sl190\slmult0\qj   The swaddling clothes and manger dark;
\par    There shall you find the young child laid
\par \pard\li144\sl202\slmult0\qj    By whom the heav'ns and earth were made.
\par 
\par \pard\sl202\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.    Now let us all with gladsome cheer
\par \pard\li144\sl202\slmult0     The shepherds follow and draw near
\par \pard\li144\sl202\slmult0\qj     To see God's wondrous gift from heav'n;
\par \pard\li144\sl202\slmult0     He as His only Son hath giv'n.
\par 
\par \pard\sl202\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par  5.  All glory be to God in heav'n
\par \pard\li144\sl202\slmult0     Who unto man His Son hath giv'n;
\par     While angels sing with joyous mirth
\par \pard     A glad New Year to all on earth!\f1 
\par \cf1\ul\b\f2 
\par }

