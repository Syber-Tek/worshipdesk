\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Stand up! Stand up for Jesus
\par \pard\li225\sl190\slmult0 Ye soldiers of the Cross
\par Lift high His royal banner
\par It must not suffer loss
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par From victory unto victory
\par His army He shall lead
\par Till every foe is vanquished
\par And Christ is Lord indeed
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Stand up! Stand up for Jesus
\par \pard\li225\sl190\slmult0 The trumpet-call obey
\par Forth to the mighty conflict
\par In this His glorious day
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Ye that are men now serve Him
\par Against unnumbered foes
\par Your courage rise with danger
\par And strength to strength oppose.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.   Stand up! Stand up! For Jesus
\par \pard\li225\sl190\slmult0 Stand in His strength alone
\par  The arm of flesh will fail you
\par Ye dare not trust your own
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Put on the gospel amour
\par Each piece put on with prayer
\par Where duty calls or danger
\par Be never wanting there.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Stand up! stand up for Jesus!
\par \pard\li225\sl190\slmult0 The strife will not be long;
\par This day the noise of battle,
\par The next the victor's song.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par To him that overcometh
\par A crown of llife shall be;
\par He with the King of Glory
\par \pard      Shall reign eternally.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

