\viewkind4\uc1\pard\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.  \cf0   Zion's daughter, O be glad
\par \pard\li225\sl190\slmult0  and rejoice, Jerusalem!
\par  Lo! Thy King does come to thee;
\par  Lo! He comes, the Prince of Peace!
\par Zion's daughter, O be glad
\par And rejoice, Jerusalem!
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.   Glad Hosanna! David's Son
\par \pard\li180\sl190\slmult0   of Thy nation blest art Thou.
\par     Thy eternal Kingdom found;
\par      Glad hosanna!   Lord on high!
\par \pard\li315\sl190\slmult0  Glad hosanna! David's Son
\par  Of  Thy nation blest art Thou
\par 
\par \pard\fi-180\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Glad hosanna! Prince of Peace,
\par \pard\li315\sl190\slmult0  Greetings to Thee, Sov'reign mild.
\par  Ever stands Thy Throne of peace.
\par  Thou the heav'nly Father's Child
\par  Glad hosanna! Prince of Peace,
\par  Greetings to Thee, Sov'reign mild.
\par \pard\f1 
