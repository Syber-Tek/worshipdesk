\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  \cf0 1.     Heavens and earth, and sea and air,
\par \pard\li270\sl190\slmult0  All their Maker's praise declare;
\par  Wake my soul awake and sing:
\par   Now thy grateful praises bring.
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.    See the glorious orb of day
\par \pard\li270\sl190\slmult0  breaking through the clouds his way;
\par   Moon and stars with silvery light
\par  Praise Him through the silent night.
\par \pard\sl190\slmult0 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  See how He hath everywhere
\par \pard\li144\sl190\slmult0   made this earth so rich and fair;
\par   Hill and vale and fruitful land,
\par   All things living, show His hand.
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Lord, great wonders workest Thou!
\par \pard\li144\sl190\slmult0   to Thy sway all creatures bow;\tab 
\par   Write Thou deeply in my heart
\par \pard      what I am, and what Thou art.\f1 
\par \cf1\ul\b\f2 
\par }

