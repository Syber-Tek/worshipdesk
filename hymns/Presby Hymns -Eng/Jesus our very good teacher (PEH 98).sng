\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus our very good teacher
\par \pard\li225\sl190\slmult0 you showed us the way all to God
\par your words clear the paths to God
\par and we enter God's kingdom.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. He who listens to all your words
\par \pard\li225\sl190\slmult0 and be friends your disciples too
\par he it is who wins the prize
\par he it is who shall be saved.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Jesus your words that you taught me
\par \pard\li225\sl190\slmult0 let me think of them in my heart
\par  Grant me love and obedience
\par to obey your rules always.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Let me also love God always
\par       than anything ever on earth;
\par \pard\sl190\slmult0       let me love too my neighbour
\par      As I love also myself.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  Let me also learn your good life,
\par      Humble myself well for others,
\par       Let me be as cool as you,
\par \pard\li180\sl190\slmult0  Lend me all of your wisdom.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.  If I follow all your teaching:
\par \pard\li180\sl190\slmult0  I shall never depart from you;
\par  I shall have eternal rest,
\par \pard      here on earth and Heaven too.\f1 
\par \cf1\ul\b\f2 
\par }

