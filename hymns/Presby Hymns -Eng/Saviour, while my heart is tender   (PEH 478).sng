\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Saviour, while my heart is tender
\par \pard\li180\sl190\slmult0 I would yield that heart to Thee
\par All my powers to Thee surrender
\par Thine and only Thine to be
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Take me now, Lord Jesus take me
\par \pard\li180\sl190\slmult0 Let my youthful heart be Thine
\par Thy devoted servant make me
\par Fill my soul with love divine
\par \pard\li315\sl190\slmult0 
\par \pard\fi-225\li315\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Send me, Lord, where Thou wilt send me
\par \pard\li315\sl190\slmult0 Only do Thou guide my way
\par \pard\li315\sl180\slmult0 May Thy grace through life attend me
\par Gladly then shall I obey
\par 
\par \pard\fi-270\li360\sl180\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  Let me do Thy will or bear it
\par \pard\li360\sl180\slmult0 I would know no will but Thine
\par Shouldst Thou take my life or spare it
\par I that life to Thee resign.
\par 
\par \pard\fi-225\li360\sl180\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  Thine I am, o Lord for ever
\par \pard\li360\sl180\slmult0 To Thy service set apart
\par Suffer me to leave Thee never
\par Seal Thine image on my heart. Amen!
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

