\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Come, children, join to sing!
\par     Hallelujah, Amen!
\par \pard\li180\sl190\slmult0 Loud praise to Christ our King
\par Hallelujah! Amen!
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Let all with heart and voice
\par Before His throne rejoice
\par Praise is His gracious choice
\par Hallelujah! Amen!
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Come lift your hearts on high
\par \pard\li180\sl190\slmult0 Hallelujah! Amen!
\par Let praises fill the sky
\par Hallelujah! Amen!
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par He is our Guide and Friend
\par To us He'll condescend
\par His love shall never end
\par Hallelujah! Amen!
\par \pard\li225\sl190\slmult0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.  Praise yet the Lord again
\par \pard\li225\sl190\slmult0  Hallelujah! Amen!
\par  Life shall not end the strain
\par  Hallelujah! Amen!
\par \cf1\ul\b\'b6  Verse\cf0\ulnone\b0 
\par On heaven's blissful shore
\par  His goodness we'll adore
\par  Singing for evermore
\par \pard      Hallelujah! Amen!\f1 
\par \cf1\ul\b\f2\fs14 
\par }

