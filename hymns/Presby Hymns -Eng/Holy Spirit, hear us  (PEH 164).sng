\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  Holy Spirit, hear us;
\par \pard\li225\sl190\slmult0 Help us while we sing;
\par Breathe into the music
\par Of the praise we bring.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.   Holy Spirit, prompt us
\par \pard\li225\sl190\slmult0 When we kneel to pray;
\par Nearer come, and teach us
\par What we ought to say.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Holy Spirit, shine Thou
\par \pard\li225\sl190\slmult0 On the book we read;
\par Gild its holy pages
\par With the light we need.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.   Holy Spirit, give us
\par \pard\li315\sl190\slmult0  Each a lowly mind;
\par  Make us more like Jesus,
\par  Gentle, pure, and kind.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par  5.   Holy Spirit, brighten
\par \pard\li315\sl190\slmult0  Little deeds of toil;
\par  And our playful pastimes
\par  Let no folly spoil.
\par 
\par \pard\fi-180\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.   Holy Spirit, help us
\par \pard\li315\sl190\slmult0  Daily, by Thy might,
\par  What is wrong to conquer,
\par \pard      And to choose the right.\f1 
\par \cf1\ul\b\f2 
\par }

