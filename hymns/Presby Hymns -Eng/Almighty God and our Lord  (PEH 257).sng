\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.  \cf0   Almighty God and our Lord
\par \pard\li225\sl190\slmult0 here we stand before you, see us!
\par Come and then strengthen our faith,
\par or we may stand here for nothing.
\par Make us give our lives to you Lord;
\par and take us as your true children.
\par 
\par \pard\fi-225\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par     2. Be with us through all our lives
\par \pard\li270\sl190\slmult0 Bless us also do follow us
\par You know that we are so weak
\par and our souls are solely oppressed
\par Jesus, rescue us with your love
\par Lead us to your heav'ly Kingdom.
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

