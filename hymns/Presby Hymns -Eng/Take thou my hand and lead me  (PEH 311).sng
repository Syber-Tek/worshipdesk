\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0   Take thou my hand and lead me,
\par \pard\li225\sl190\slmult0 I Thee implore,
\par Until my life is ended
\par And ever more.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Alone I cannot journey,
\par Each step needs Thee.
\par Where Thou will go and journey,
\par There take Thou me.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Let Thy compassion shelter
\par \pard\li225\sl190\slmult0 My feeble heart.
\par Make Thou me ever patient
\par In joy or smart.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Thy humble child, O Saviour,
\par With Thee let rest.
\par Mine eyes see at their closing
\par Whate'er is best.
\par \pard\li360\sl190\slmult0 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Tho' I cannot perceive Thee
\par \pard\li360\sl190\slmult0 In all Thy might.
\par Thou to the goal will lead me,
\par Tho' dark the night.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Take Thou my hand and lead me,
\par I Thee implore,
\par Until my life is ended
\par \pard      And ever more.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

