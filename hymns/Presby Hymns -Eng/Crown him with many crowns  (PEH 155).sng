\viewkind4\uc1\pard\fi-225\li225\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  Crown him with many crowns,
\par \pard\li225\sl190\slmult0\qj  The Lamb upon his throne;
\par Hark! How the heavenly anthem drowns
\par All music but its own.
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj Awake, my soul, and sing
\par Of him who died for thee,
\par And hail him as thy matchless King
\par Through all eternity.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Crown him the Lord of life,
\par \pard\li225\sl190\slmult0  Who triumphed o'er the grave,
\par And rose victorious in the strife
\par For those he came to save.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par His glories now we sing
\par Who died and rose on high,
\par Who died eternal life to bring
\par And lives that death may die.
\par \pard\li360\sl190\slmult0 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Crown him the Lord of love;
\par \pard\li360\sl190\slmult0 Behold his hands and side,
\par Rich wounds yet visible above,
\par In beauty glorified.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par All hail, Redeemer, hail!
\par For thou hast died for me:
\par Thy praise shall never, never fail
\par \pard         Throughout eternity. \f1 
\par \cf1\ul\b\f2\fs14 
\par }

