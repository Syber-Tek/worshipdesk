\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  The radiant morn hath passed away
\par \pard\li180\sl190\slmult0 And spent too soon her golden store
\par The shadows of departing day
\par Creep on once more.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Our life is but an autumn day
\par \pard\li180\sl190\slmult0 Its glorious noon how quickly past
\par Lead us, O Christ, Thou living way;
\par Safe home at last.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. O by Thy soul-inspiring grace
\par \pard\li180\sl190\slmult0 Uplift our hearts to realms on high
\par Help us to look to that bright place
\par Beyond the sky
\par \pard\li315\sl190\slmult0 
\par \pard\fi-225\li315\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  Where light, and life, and joy and peace
\par \pard\li315\sl190\slmult0 In undivided empire reign
\par And thronging angels never cease
\par Their deathless strain
\par 
\par \pard\fi-180\li315\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par  5.  Where saints are clothed in spotless white
\par \pard\li315\sl190\slmult0 And evening shadows never fall
\par Where Thou, eternal Light of light;
\par \pard      Art Lord of all.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

