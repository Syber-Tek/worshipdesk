\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  \cf0 1.  Awake my soul!
\par \pard\li180\sl190\slmult0   See what your Saviour and Christ
\par   Has done for you.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Jesus, watch me
\par \pard\li180\sl190\slmult0   You have redeemed me,
\par    and I shall be your own.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par   3.   Oh! Yes, my Lord!
\par \pard\li315\sl190\slmult0  You Lord I know, and
\par there is no one like you.
\par 
\par \pard\fi-270\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par   4.  Jesus, take me
\par \pard\li315\sl190\slmult0 You have redeemed me,
\par \pard      and  I shall be your own.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

