\viewkind4\uc1\pard\sb100\sa100\cf1\ul\b\f0\fs24\'b6 Verse 1\cf0\ulnone\b0 
\par 1. We praise Thee, O God!
\par For the Son of Thy love,
\par For Jesus Who died,
\par And is now gone above.
\par \cf1\ul\b\'b6 Refrain\cf0\ulnone\b0 
\par Hallelujah! Thine the glory.
\par Hallelujah! Amen.
\par Hallelujah! Thine the glory.
\par Revive us again.
\par 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. We praise Thee, O God!
\par For Thy Spirit of light,
\par Who hath shown us our Savior,
\par And scattered our night.
\par \cf1\ul\b\'b6 Refrain\cf0\ulnone\b0 
\par Hallelujah! Thine the glory.
\par Hallelujah! Amen.
\par Hallelujah! Thine the glory.
\par Revive us again.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par All glory and praise
\par To the Lamb that was slain,
\par Who hath borne all our sins,
\par And hath cleansed every stain.
\par \cf1\ul\b\'b6 Refrain\cf0\ulnone\b0 
\par Hallelujah! Thine the glory.
\par Hallelujah! Amen.
\par Hallelujah! Thine the glory.
\par Revive us again.
\par 
\par \cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par All glory and praise
\par To the God of all grace,
\par Who hast brought us, and sought us,
\par And guided our ways.
\par \cf1\ul\b\'b6 Refrain\cf0\ulnone\b0 
\par Hallelujah! Thine the glory.
\par Hallelujah! Amen.
\par Hallelujah! Thine the glory.
\par Revive us again.
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Revive us again;
\par Fill each heart with Thy love;
\par May each soul be rekindled
\par With fire from above.
\par \cf1\ul\b\'b6 Refrain\cf0\ulnone\b0 
\par Hallelujah! Thine the glory.
\par Hallelujah! Amen.
\par Hallelujah! Thine the glory.
\par Revive us again.\f1 
\par \pard\cf1\ul\b\fs16 
\par }

