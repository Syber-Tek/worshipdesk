\viewkind4\uc1\pard\li288\sl202\slmult0\qj\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\tab God the Omnipotent! and King, who ordains\cf0 
\par \pard\li720\sl202\slmult0 Great winds Thy clarions, lightning Thy sword:
\par Show forth Thy pity on high where Thou reigneth;
\par Give to us peace in our time, O Lord.
\par 
\par \pard\li288\sl202\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par     2.  \tab God the  All-merciful!  Earth  hath forsaken
\par \pard\li720\sl202\slmult0\qj Meekness and mercy, and slighted Thy word;
\par Bid not Thy wrath in its terrors awaken;
\par Give to us peace in our time, O Lord.
\par 
\par \pard\li288\sl202\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par     3. \tab God the All-righteous One! Man hath defiled Thee;
\par \pard\li720\sl202\slmult0 Yet to eternity standeth Thy word;
\par  Falsehood and wrong shall not tarry beside Thee;
\par Give to us peace in our time, O Lord.
\par 
\par \pard\li288\sl202\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par     4. \tab God the All-wise! By the fire of Thy chastening,
\par \pard\li720\sl202\slmult0\qj Earth shall to freedom and truth be restored;
\par Through the thick darkness Thy Kingdom  is hastening;
\par Thou wilt give peace in Thy time, O Lord.
\par 
\par \pard\li288\sl202\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par     5. \tab So shall Thy children, with thankful devotion,
\par \pard\li720\sl202\slmult0 Praise Him who saved them from peril and sword,
\par \pard\li720\sl202\slmult0\qj Singing in chorus, from ocean to ocean,
\par \pard           Peace to the nations, and praise to the Lord.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

