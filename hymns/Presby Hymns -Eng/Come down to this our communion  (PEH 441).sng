\viewkind4\uc1\pard\li288\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \tab Come down to this our communion\cf0 
\par \pard\li144\sl190\slmult0\tab O Lord sanctify it for us
\par \tab Do help us so that in future
\par  \tab We sit at your table above.
\par 
\par \pard\li288\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par     2. \tab You give us care as Father, good;
\par \pard\li144\sl190\slmult0\tab We get satisfied in Your hands;
\par \tab As you have fed our bodies here,
\par \tab So may we have our spirits fed.
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

