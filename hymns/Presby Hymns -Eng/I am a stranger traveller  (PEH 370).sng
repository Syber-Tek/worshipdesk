\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0   I am a stranger traveller
\par \pard\li225\sl190\slmult0 In this worldly travail
\par I have no residence here,
\par My place is in heaven.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  I feel homesick on this earth,
\par \pard\li225\sl190\slmult0 Through all the days of life,
\par I miss my really good home,
\par Where my worries shall end.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\ulnone\b0 
\par 3. \cf0  Eternal rest, lasting peace
\par \pard\li225\sl190\slmult0 Exist for sons of God,
\par 'Tis this that's there in heaven.
\par We therefore long to go.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. O Jesus grant the passage
\par \pard\li180\sl190\slmult0 For me to come to Thee,
\par I shall sojourn no longer,
\par I'll live there forever.
\par \pard\li144\sl100\slmult0\i\f1\fs14 
\par \pard\cf1\ul\b\i0\f2 
\par }

