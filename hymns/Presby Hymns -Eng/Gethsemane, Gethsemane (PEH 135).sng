\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Gethsemane, Gethsemane,
\par \pard\li180\sl190\slmult0 We shall ne'er forget there:
\par Where the Dear Lord and Saviour Christ
\par went through much agony.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li180\sl190\slmult0\qj His strong prayer which He prayed there
\par \pard\li180\sl190\slmult0 His sweat was like blood clots
\par His strife struggle and agony
\par we shall never forget.\tab 
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Gethsemane and Golgotha
\par \pard\li180\sl190\slmult0\qj were Jesus' battle field
\par His holy blood was poured out
\par for the sins of all mankind
\par \pard\li180\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li180\sl190\slmult0\qj Our Saviour, dear, your grief, torture
\par and agony
\par your hard battle that you fought well
\par we shall remember always.
\par \pard\li270\sl190\slmult0\qj 
\par \pard\fi-180\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.  O Jesus Christ, our Saviour
\par \pard\li270\sl190\slmult0  You are our great Redeemer
\par  Let all nations acknowledge Thee
\par  Because of your great struggle
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par  You suffered because of our sins
\par  You died for your children
\par  Our Master, and our good Saviour
\par \pard       The only one we love.\f1 
\par \cf1\ul\b\f2 
\par }

