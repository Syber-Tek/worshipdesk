\viewkind4\uc1\pard\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  For unto us this day
\par \pard\li225\sl190\slmult0 A child is born to us
\par Saviour of men
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par From humble state He came
\par And in a manger laid
\par For us mankind
\par He was made such.
\par \pard\sl190\slmult0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. For if the Son of God
\par \pard\li225\sl190\slmult0 in humility shared?
\par What then to say?
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Our love to show to Him
\par And each to follow Him
\par In Him alone, we must rely.
\par \pard\f1 
