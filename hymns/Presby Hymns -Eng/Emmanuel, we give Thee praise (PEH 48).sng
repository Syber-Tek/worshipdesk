\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1  \cf0   Emmanuel, we give Thee praise
\par \pard\li180\sl190\slmult0\qj   With all our songs we give Thee thanks,
\par   men of old long expected you,
\par   You are now in our mist on earth.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  You who was born in Bethlehem
\par \pard\li180\sl190\slmult0  and you were laid in a manger
\par \pard\li135\sl190\slmult0   Your birth gives us exceeding joy
\par   You are our love and happiness
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  You, a good friend to human kind
\par \pard\li135\sl190\slmult0   yet all mankind  rejected you
\par    but all those who tasted your love
\par \pard\li225\sl190\slmult0 you cheered and took away their griefs.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par   4.I intend to love you always
\par       I have seen how great your love is
\par \pard\li315\sl190\slmult0  There is no other one like you
\par  Who give to us eternal rest.
\par 
\par \pard\fi-180\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.   I realize that my love is weak
\par \pard\li270\sl190\slmult0  I plead to you for a pardon
\par  Please do accept this my off'ring
\par \pard       help me and let it multiply. \f1 
\par \cf1\ul\b\f2 
\par }

