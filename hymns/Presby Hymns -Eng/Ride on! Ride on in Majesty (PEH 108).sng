\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Ride on! Ride on in Majesty!
\par \pard\li225\sl190\slmult0\qj Hark, all the tribes 'Hosanna!' cry;
\par O Saviour meek, pursue thy road
\par With palms and scattered
\par garments strowed.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2. Ride on! Ride on in majesty!
\par \pard\li225\sl190\slmult0 In lowly pomp ride on to die;
\par O Christ, thy triumphs now begin
\par O'er captive death and conquered sin.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3. Ride on! Ride on in majesty!
\par \pard\li180\sl190\slmult0\qj   The winged squadrons of the sky
\par \pard\li360\sl190\slmult0\qj  Look down with sad
\par and wondering eyes
\par To see the approaching sacrifice.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Ride on! Ride on in majesty!
\par \pard\li360\sl190\slmult0 Thy last and fiercest strife is nigh;
\par The Father on his sapphire throne
\par Awaits his own anointed Son.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Ride on! Ride on in majesty!
\par \pard\li360\sl190\slmult0\qj In  lowly pomp ride on to the die;
\par Bow thy meek head to mortal pain,
\par Then take, O God, thy power, and reign.
\par \pard\f1 
\par \cf1\ul\b\f2 
\par }

