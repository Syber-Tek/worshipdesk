\viewkind4\uc1\pard\li288\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  1. \cf0\tab  The table is ready, the dinner is set
\par \pard\li144\sl190\slmult0\qj\tab Come and partake of what the Lord has for us
\par \tab It is wholesome food that He has set for us
\par  \tab He wants both the young and old to fully fed.
\par 
\par \pard\li288\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par     2. \tab It is He who gives to the beasts and the birds
\par \pard\li144\sl190\slmult0\qj\tab Enough of their food requirements for the day.
\par \pard\li144\sl190\slmult0\tab He never does forget any creature.
\par \pard\tab Therefore we all with one accord thank the Lord.
\par \f1 
\par \cf1\ul\b\f2\fs14 
\par }

