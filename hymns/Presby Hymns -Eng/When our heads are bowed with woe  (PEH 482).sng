\viewkind4\uc1\pard\fi-270\li270\sl202\slmult0\qj\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1\cf0 .  When our heads are bowed with woe
\par \pard\li270\sl190\slmult0 When our bitter tears o'erflow
\par When we mourn  the  lost, the dear
\par Jesus, Son of Mary hear!
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Thou our throbbing flesh hast worn
\par \pard\li270\sl190\slmult0 Thou our mortal grief hast borne
\par Thou hast shed the human tear
\par Jesus, Son of May hear
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.  When the sullen death-bell tolls
\par \pard\li270\sl190\slmult0  For our own departing souls
\par \pard\li180\sl190\slmult0   When our final doom is near
\par   Jesus, Son of Mary, hear
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par   4.   When the heart is sad within
\par \pard\li270\sl190\slmult0 With the thought of all its sin
\par When the spirit shrinks with fear
\par Jesu, Son of Mary heer
\par 
\par \pard\fi-270\li270\sl202\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par   5.   Thou the shame the grief hast known
\par \pard\li270\sl202\slmult0 Though the sins were not Thine own
\par Thou hast deigned their load to bear
\par \pard     Jesus, Son of Mary hear.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

