\viewkind4\uc1\pard\fi-270\li270\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0   Just as I am, Thine own to be
\par \pard\li270\sl202\slmult0  Friend of the young who lovest me
\par  To consecrate myself to Thee
\par  O Jesus Christ, I come
\par 
\par \pard\fi-270\li270\sl202\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.    In the glad morning of the day
\par \pard\li270\sl202\slmult0  My life to give my vows to pay
\par  With no reserve and no delay
\par  With all my heart I come
\par 
\par \pard\fi-225\li315\sl202\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  I would live ever in the light
\par \pard\li315\sl202\slmult0\qj I would work ever for the right
\par I would server Thee with all my might
\par Therefore to Thee I come
\par 
\par \pard\fi-225\li315\sl202\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Just as I am, young, strong and free
\par \pard\li315\sl202\slmult0  To be the best that I can be
\par For truth and righteousness and Thee
\par \pard     Lord for my life I come.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

