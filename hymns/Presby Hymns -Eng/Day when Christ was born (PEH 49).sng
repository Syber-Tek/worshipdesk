\viewkind4\uc1\pard\fi-225\li225\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0   Day when Christ was born,
\par \pard\li225\sl190\slmult0  O most happy morn,
\par  Jesus came down to set us free!
\par  All the world was lost in sin,
\par  Jesus came to call us in:
\par  Jesus came to the world for me
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Day when Christ was born,
\par \pard\li225\sl190\slmult0  O most happy morn,
\par  Jesus came down to set us free!
\par Angels came to tell His birth,
\par Praise to God and peace on earth,
\par Jesus came to the world for me.
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.   Day when Christ was born,
\par \pard\li495\sl190\slmult0\tx675 O most happy morn,
\par Jesus came to set us free!
\par In His mercy he has come,
\par brings us to His father's home.
\par \pard        Jesus came to the world for me.\f1 
\par \cf1\ul\b\f2 
\par }

