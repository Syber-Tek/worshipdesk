\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.  I need Thee every hour,\cf0 
\par \pard\li225\sl190\slmult0 Most gracious Lord;
\par No tender voice but Thine
\par Can peace afford.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par I need Thee, O I need Thee;
\par Every hour I need Thee;
\par \pard\li180\sl190\slmult0  O bless me now, my Saviour;
\par  I come to Thee.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  I need Thee every hour;
\par \pard\li180\sl190\slmult0 Stay Thou near by;
\par Temptations lose their power
\par \pard     When thou art nigh.
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par I need Thee, O I need Thee;
\par Every hour I need Thee;
\par \pard\li180\sl190\slmult0  O bless me now, my Saviour;
\par  I come to Thee.
\par \pard 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\ulnone\b0 
\par 3.\cf0  I need Thee every hour,
\par \pard\li225\sl190\slmult0 In joy or pain;
\par Come quickly and abide,
\par Or life is vain.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par I need Thee, O I need Thee;
\par Every hour I need Thee;
\par \pard\li180\sl190\slmult0  O bless me now, my Saviour;
\par  I come to Thee.
\par \pard\li225\sl190\slmult0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. I need Thee every hour;
\par \pard\li225\sl190\slmult0 Teach me Thy will;
\par And Thy rich promises
\par \pard      In me fulfil.
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par I need Thee, O I need Thee;
\par Every hour I need Thee;
\par \pard\li180\sl190\slmult0  O bless me now, my Saviour;
\par  I come to Thee.
\par \pard\f1 
