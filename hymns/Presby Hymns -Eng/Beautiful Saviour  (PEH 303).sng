\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Beautiful Saviour,
\par \pard\li225\sl190\slmult0 King of creation,
\par Son of God and Son of man;
\par Truly I'd love Thee,
\par Truly I'd serve Thee;
\par Light of my soul, my joy, my crown!
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Fair is the sunshine,
\par      Fair is the moonlight;
\par \pard\li225\sl190\slmult0 Bright the stars shine in the sky.
\par \pard\li180\sl190\slmult0  Jesus shines brighter,
\par  Jesus shines purer,
\par  Than all the angels from on high.
\par \pard\li360\sl190\slmult0 
\par \pard\fi-270\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.  All of the beauty
\par \pard\li360\sl190\slmult0 Of earth and heaven;
\par Lord, is found in Thee alone.
\par Nothing on earth here,
\par Would I hold more dear,
\par \pard      Than Thee who for us did atone.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

