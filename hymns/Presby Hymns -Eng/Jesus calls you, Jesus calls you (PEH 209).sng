\viewkind4\uc1\pard\fi-180\li180\sl180\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.  Jesus calls you, Jesus calls you,\cf0 
\par \pard\li180\sl180\slmult0  Jesus calls you today.
\par  Jesus calls you, and speaks to you,
\par  Jesus calls you today.
\par 
\par \pard\fi-180\li180\sl180\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Jesus loves you, Jesus loves you,
\par \pard\li180\sl180\slmult0  Jesus loves you today.
\par  Jesus loves you and He seeks you,
\par  Jesus calls you today.
\par 
\par \pard\fi-270\li270\sl180\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par    3.  He died for you, He died for you
\par \pard\li270\sl180\slmult0  He died for you Jesus,
\par  He died for you and He saves you,
\par  Jesus calls you today.
\par 
\par \pard\fi-270\li270\sl180\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  Listen to Him, listen to Him,
\par \pard\li270\sl180\slmult0  Listen to Him today.
\par  Listen to Him and obey Him,
\par  Jesus calls you today.
\par 
\par \pard\fi-225\li270\sl180\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  Jesus calls you, Jesus calls you
\par \pard\li270\sl180\slmult0    Jesus calls you today.
\par  Jesus calls you, answer Him now,
\par  Jesus calls you today.
\par 
\par 
\par \pard\fi-225\li270\sl180\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.  Hallelujah, Hallelujah,
\par \pard\li270\sl180\slmult0  Hallelujah, Jesus,
\par  Hallelujah, Hallelujah
\par \pard       Jesus calls you today. \f1 
