\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1 \cf0  Good Christian, men rejoice
\par \pard\li225\sl190\slmult0  With heart and soul and voice;
\par  Now give heed to what we say,
\par News! News!
\par  Jesus Christ is born today:
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par  Ox and ass before him bow,
\par   And he is in the manger now.
\par   Christ is born today!
\par   Christ is born today!
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Good Christian, men rejoice
\par \pard\li225\sl190\slmult0   With heart and soul and voice;
\par  Now you hear of endless bliss,
\par Joy! Joy!
\par  Jesus Christ was born for this:
\par \cf1\ul\b\'b6  Verse\cf0\ulnone\b0 
\par He has ope'd the heaven's door,
\par   And all are blessed for evermore
\par   Christ was born for this!
\par   Christ was born for this!
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.    Good Christian, men rejoice
\par \pard\li225\sl190\slmult0  With heart and soul and voice;
\par  Now you need not fear the grave,
\par Peace! Peace!
\par  Jesus Christ was born to save,
\par \cf1\ul\b\'b6  Verse\cf0\ulnone\b0 
\par Call you one, and calls you all,
\par  To gain his everlasting hall.
\par  Christ was born to save!
\par \pard       Christ was born to save!\f1 
\par \cf1\ul\b\f2 
\par }

