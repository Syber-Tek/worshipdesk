\viewkind4\uc1\pard\li288\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par   1. \tab I am the Bread of Life broken for all,\cf0 
\par \pard\li720\sl202\slmult0\qj I give hope to all those who heed my call;
\par The hungry, the helpless, the sick and the weakest
\par \pard\li720\sl202\slmult0 Shall find happiness at my feast in fullness blest.
\par \pard\li720\sl202\slmult0\qj\i 
\par \pard\li720\sl202\slmult0\cf1\ul\b\i0\'b6 Chorus\cf0\ulnone\b0\i 
\par \pard\li720\sl202\slmult0\qj\i0 Celebrate, Celebrate, Celebrate, Celebrate!
\par \pard\li720\sl202\slmult0 Celebrate, celebrate, Celebrate, Celebrate!
\par I have come that all may have life
\par And have it in fullness.
\par 
\par \pard\li288\sl202\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par    2. \tab I am the Vine growing in the garden,
\par \pard\li720\sl202\slmult0\qj All the world's people are its branches green;
\par Together we share the wealth of God's creation
\par And promise to make it a place of life in full,
\par \i 
\par \pard\li720\sl202\slmult0\cf1\ul\b\i0\'b6 Chorus\cf0\ulnone\b0\i 
\par \pard\li720\sl202\slmult0\qj\i0 Celebrate, Celebrate, Celebrate, Celebrate!
\par \pard\li720\sl202\slmult0 Celebrate, celebrate, Celebrate, Celebrate!
\par I have come that all may have life
\par And have it in fullness.
\par \pard\li720\sl202\slmult0\qj\i 
\par \pard\li288\sl202\slmult0\cf1\ul\b\i0\'b6 Verse 3\cf0\ulnone\b0 
\par    3. \tab With God's great help, we do commit ourselves
\par \pard\li720\sl202\slmult0\qj To uphold justice in the whole wide world;
\par To break chains of injustice, shun all suppression,
\par In faith we are blessed to receive life in fullness.
\par \pard\li720\sl202\slmult0\i 
\par \cf1\ul\b\i0\'b6 Chorus\cf0\ulnone\b0\i 
\par \pard\li720\sl202\slmult0\qj\i0 Celebrate, Celebrate, Celebrate, Celebrate!
\par \pard\li720\sl202\slmult0 Celebrate, celebrate, Celebrate, Celebrate!
\par I have come that all may have life
\par And have it in fullness.\cf1\ul\b\f1\fs14 
\par }

