\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  O my Lord, my heart you know;
\par \pard\li225\sl190\slmult0 All my life lies before you
\par \i In your loving kindness hear my prayer.
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  You have been Saviour and guide
\par \pard\li225\sl190\slmult0 All my needs you have supplied.
\par \i In your loving kindness hear my prayer.
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Through the night, in the bright day
\par \pard\li225\sl190\slmult0 Your strong hand will guard my way
\par \i In your loving kindness hear my prayer.
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Jesus, your begotten Son
\par \pard\li225\sl190\slmult0 He's the one who brings me home
\par \i In your loving kindness hear my prayer.
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  Now myself to you I give
\par \pard\li225\sl190\slmult0 By your law ever to live
\par \i In your loving kindness hear my prayer.
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.  Holy God, help me to stay
\par \pard\li225\sl190\slmult0 Ever yours, now and alway
\par \pard\i     In your loving kindness hear my prayer.\i0  \f1 
\par \cf1\ul\b\f2\fs14 
\par }

