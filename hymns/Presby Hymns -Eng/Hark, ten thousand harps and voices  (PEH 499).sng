\viewkind4\uc1\pard\fi-270\li270\sl188\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.   \cf0 Hark, ten thousand harps and voices
\par \pard\li270\sl188\slmult0\qj Sound the note of praise above!\tab 
\par Jesus reigns, and heaven rejoices,
\par Jesus reigns, the God of love,
\par \pard\li270\sl188\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li270\sl188\slmult0\qj See, He sits on  yonder throne,
\par Jesus rules the world alone.
\par Hallelujah! Hallelujah! Hallelujah! \tab 
\par Amen.
\par 
\par \pard\fi-270\li270\sl188\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.   Jesus, hail whose glory brightens
\par \pard\li270\sl188\slmult0\qj all above, and gives it worth,
\par Lord of life, Thy smile enlightens,
\par cheers and charms Thy saints on earth;
\par \pard\li315\sl188\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li315\sl188\slmult0\qj When we think of love like Thine,
\par Lord, we own it love divine.
\par Hallelujah! Hallelujah! Hallelujah,
\par Amen!
\par 
\par \pard\fi-225\li315\sl188\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.   Saviour hasten Thine appearing;
\par \pard\li315\sl188\slmult0\qj Bring, O bring the glorious day,
\par When, the awful summons hearing,
\par Heaven and earth shall pass away;
\par \pard\li315\sl188\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li315\sl188\slmult0\qj Then with golden harps we'll sing,
\par 'Glory, glory to our King!
\par Hallelujah! Hallelujah! Hallelujah!
\par \pard        Amen.\f1 
\par \cf1\ul\b\f2 
\par }

