\viewkind4\uc1\pard\li288\sl200\slmult0\qj\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  \cf0 1. \tab Peace, perfect peace in this dark world of sin
\par \pard\li144\sl200\slmult0\qj\tab The blood of Jesus whispers peace within.
\par 
\par \pard\li288\sl200\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par     2. \tab Peace, perfect peace, by thronging duties pressed
\par \pard\li144\sl200\slmult0\tab To do the will of Jesus this is rest.
\par 
\par \pard\li288\sl200\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par     3. \tab Peace perfect peace with sorrows surging round
\par \pard\li144\sl200\slmult0\qj\tab On Jesus bosom nought but calm is found.
\par 
\par \pard\li288\sl200\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par     4. \tab Peace perfect peace with loved ones far away
\par \pard\li144\sl200\slmult0\tab  In Jesus keeping we are safe and they.
\par 
\par \pard\li288\sl200\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par     5. \tab  Peace  perfect peace, our future all unknown
\par \pard\sl200\slmult0\tab  Jesus we know and He is on the throne.
\par 
\par \pard\li288\sl200\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par     6. \tab Peace perfect Peace, death shadowing us and ours
\par \pard\li144\sl200\slmult0\qj\tab  Jesus has vanquished death and all its powers.
\par 
\par \pard\li288\sl200\slmult0\cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par     7. \tab   It is enough: earth's struggles soon shall cease
\par \pard\li144\sl200\slmult0\qj\tab And Jesus call us to heaven's perfect peace.
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

