\viewkind4\uc1\pard\li288\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  \cf0 1. \tab There is still rest by God provided;
\par \pard\li720\sl188\slmult0\qj rise, weary heart be filled with light!
\par You sorrow now and mourn in bondage
\par while lacking strength to sooth your plight.
\par \pard\li720\sl188\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li720\sl188\slmult0\qj Lay down your burden, ye oppressed;
\par come, enter now to peace and rest!
\par Come, enter now to peace and rest!
\par 
\par \pard\li288\sl188\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par     2. \tab Come unto  Me, ye souls that languish,
\par \pard\li720\sl188\slmult0\qj who are by burdens sore distressed!
\par Come, hasten from your den of sorrows,
\par do not bow down with sighs, depressed!
\par \pard\li720\sl188\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li720\sl188\slmult0\qj Lift up your eyes and enter in
\par where Christ the Lamb gives rest within,
\par where Christ the Lamb gives rest within,
\par 
\par \pard\li288\sl188\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par     3. \tab Refreshment find ye at the fountain,
\par \pard\li720\sl188\slmult0\qj there you will see the comforter.
\par He'll wipe all tears from weeping faces,
\par 'tis to this promise we refer.
\par \pard\li720\sl188\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li720\sl188\slmult0\qj where tears are sown, praise shall resound
\par and sheaves of joy will then be found,
\par \pard           and sheaves of joy will then be found.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

