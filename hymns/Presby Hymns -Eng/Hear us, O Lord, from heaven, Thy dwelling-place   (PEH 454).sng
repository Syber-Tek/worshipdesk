\viewkind4\uc1\pard\li288\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \tab Hear us, O Lord, from heaven, Thy dwelling-place\cf0 
\par \pard\li720\sl190\slmult0\qj Like them of old, in vain we toil all night
\par \pard\li720\sl190\slmult0 Unless with us Thou go, who art the Light
\par Come then, O lord, that we may see Thy face
\par 
\par \pard\li288\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par     2. \tab Thou, dost rule the raging of the sea
\par \pard\li720\sl190\slmult0\qj When loud the storm and furious is the gale
\par Strong is Thine arm; our little barques are frail
\par Sent  us Thy help; remember Galilee.
\par 
\par \pard\li288\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par     3. \tab Our wives and children we commend to Thee;
\par \pard\li720\sl190\slmult0 For them we plough the land and plough the deep
\par \pard\li720\sl190\slmult0\qj For them by day the golden corn we reap
\par \pard\li720\sl190\slmult0 By night the silver harvest of the sea
\par 
\par \pard\li288\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par     4. \tab We thank Thee, Lord for sunshine, dew and rain;
\par \pard\li720\sl190\slmult0\qj Broadcast from heaven by Thine almighty hand
\par  Source of all life, unnumbered as the sand
\par Bird, beast, and fish, herb, fruit and golden grain
\par 
\par \pard\li288\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par     5. \tab O Bread of Life, Thou in Thy word hast said
\par \pard\li720\sl190\slmult0\qj Who feeds in faith on Me shall never die
\par In mercy hear Thy hungry children's cry;
\par Father, give us this day our daily bread
\par 
\par \pard\li288\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par     6. \tab Sow in our hearts the seed of Thy dear love;
\par \pard\li720\sl190\slmult0  That we may reap contentment, joy and peace;
\par And when at last our earthly labours cease
\par \pard           Grant us to join Thy harvest home above.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

