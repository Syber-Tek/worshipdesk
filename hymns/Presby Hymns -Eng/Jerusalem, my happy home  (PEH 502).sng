\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jerusalem, my happy home,
\par \pard\li225\sl190\slmult0 When shall I come to thee?
\par When shall my sorrows have an end?
\par  Thy joys, when shall I see?
\par 
\par \pard\fi-225\li225\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Thy walls are made of precious stones,
\par \pard\li225\sl190\slmult0 Thy bulwarks diamonds square;
\par Thy gates are of right orient pearl,
\par Exceeding rich and rare.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3. O, happy harbour of the saints!
\par \pard\li270\sl190\slmult0  O sweet and pleasant soil!
\par In Thee, no sorrow can be found,
\par No grief, no care, no toil.
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  Thy gardens and their gallant walks
\par \pard\li270\sl190\slmult0\qj  Continually are green;
\par  There grow such sweet and pleasant flowers,
\par  As nowhere else are seen.
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par  5.  But there they live in such delight,
\par \pard\li270\sl190\slmult0  Such pleasure and such play,
\par \pard\li360\sl190\slmult0\cf1 As that to them a thousand years,\cf0 
\par Doth seem as yesterday.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.  Jerusalem my happy home,
\par \pard\li360\sl190\slmult0  Would God I were in Thee;
\par  Would God my woes were at an end,
\par  Thy joys that I might see!\f1 
\par \pard\cf1\ul\b\f2\fs14 
\par }

