\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus Christ is risen today,
\par \pard\li270\sl190\slmult0\i Alleluia!\i0 
\par \pard\li270\sl190\slmult0\qj  Our triumphant holy day,
\par \i Alleluia!\i0 
\par \pard\li270\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li270\sl190\slmult0\qj  Who did once, upon the cross,
\par \i Alleluia!\i0 
\par Suffer to redeem our loss.
\par \i Alleluia!
\par \i0 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Hymns of praise then let us sing
\par \pard\li270\sl190\slmult0\i Alleluia!\i0 
\par  Unto Christ, our heavenly King,
\par \i Alleluia!\i0 
\par \cf1\ul\b\'b6  Verse\cf0\ulnone\b0 
\par Who endured the cross and grave,
\par   \i Alleluia!\i0 
\par  Sinners to redeem and save.
\par \i Alleluia!
\par \i0 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.   But the anguish he endured
\par \pard\li270\sl190\slmult0  \i  Alleluia!\i0 
\par   Our salvation has procured;
\par  \i  Alleluia!\i0 
\par \pard\li315\sl190\slmult0\cf1\ul\b\'b6   Verse\cf0\ulnone\b0 
\par   Now in heaven Christ is King,
\par  \i Alleluia!\i0 
\par     Where the angels ever sing.
\par  \i Alleluia!
\par \i0 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Sing we to our God above
\par \pard\li315\sl190\slmult0  \i Alleluia!\i0 
\par Praise eternal as his love;
\par  \i Alleluia!\i0 
\par \cf1\ul\b\'b6    Verse\cf0\ulnone\b0 
\par Praise him, all you heavenly host.
\par  \i Alleluia!\i0 
\par   Father, Son, and Holy Ghost.
\par  \i Alleluia!\i0 
\par \pard\f1 
\par \cf1\ul\b\f2 
\par }

