\viewkind4\uc1\pard\fi-270\li720\sl186\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  To-day  the Saviour calls:
\par \pard\li720\sl186\slmult0 Ye wanderers, come;
\par O, ye benighted souls,
\par Why longer roam?
\par 
\par \pard\fi-270\li720\sl186\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  To-day the Saviour calls:
\par \pard\li720\sl186\slmult0 O hear Him now;
\par Within these sacred walls
\par To Jesus bow.
\par 
\par \pard\fi-270\li720\sl186\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.  The Spirit calls to-day:
\par \pard\li720\sl186\slmult0 Yield to His power;
\par O grieve Him not away;
\par \pard          'Tis mercy's hour.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

