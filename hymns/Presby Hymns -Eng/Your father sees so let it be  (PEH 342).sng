\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Your father sees so let it be;
\par \pard\li180\sl190\slmult0  Your father hears; be quiet
\par  Your father comes, bid Him welcome.
\par  Give heed when'er he calls.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. E'en though the Lord you cannot see;
\par \pard\li180\sl190\slmult0  He is always so close
\par  Therefore obey all His commands
\par  He's an eternal God
\par \pard\sl190\slmult0 
\par \pard\fi-225\li405\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Cleave to Him strongly, faithfully
\par \pard\li405\sl190\slmult0 As if you see Him clear;
\par And do believe He'll leave you not.
\par And truly trod His paths.
\par 
\par \pard\fi-225\li405\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  In difficulties, say to Him ;
\par \pard\li405\sl190\slmult0 Help us for we are Yours!
\par In Jesus name we plead with You,
\par \pard       Save our souls when we die!\f1 
\par \cf1\ul\b\f2\fs14 
\par }

