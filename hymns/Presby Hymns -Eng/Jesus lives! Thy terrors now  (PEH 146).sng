\viewkind4\uc1\pard\fi-225\li225\sl200\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  \cf0 1.    Jesus lives! Thy terrors now
\par \pard\li225\sl200\slmult0    Can, O Death, no more appal us;
\par   Jesus lives: by this we know,
\par   Thou  O grave, can not enthrall us.
\par \i    Hallelujah!
\par \i0 
\par \pard\fi-180\li225\sl200\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Jesus lives! Henceforth is death
\par \pard\li225\sl200\slmult0  But the gate of life immortal;
\par   This shall calm our trembling breath
\par   When we pass its gloomy portal,
\par \i    Hallelujah!\tab 
\par \i0 
\par \pard\fi-180\li225\sl200\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Jesus lives! For us He died;
\par \pard\li225\sl200\slmult0  Then, alone to Jesus living,
\par  Pure in heart may we abide
\par \pard\li270\sl200\slmult0    Glory to our Saviour giving.
\par \i  Hallelujah!
\par \i0 
\par \pard\fi-225\li270\sl200\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.   Jesus lives! our hearts know well
\par \pard\li270\sl200\slmult0  Nought from us His love shall sever;
\par Life, nor death, nor powers of hell
\par Part us from His keeping ever.
\par \i Hallelujah!
\par \i0 
\par \pard\fi-225\li270\sl200\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.   Jesus lives! to Him the throne
\par \pard\li270\sl200\slmult0 High o'er heaven and earth is given;
\par May we go where He is gone,
\par  Rest and reign with Him in heaven.
\par \pard\i        Hallelujah!\i0\f1 
\par \cf1\ul\b\f2 
\par }

