\viewkind4\uc1\pard\fi-225\li225\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  All hail the power of Jesus' Name!
\par \pard\li225\sl202\slmult0  Let angels prostrate fall;
\par  Bring forth the royal diadem,
\par  And crown him Lord of all.
\par \pard\li225\sl40\slmult0 
\par \pard\fi-225\li225\sl202\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Crown him, you martyrs of your God,
\par \pard\li225\sl202\slmult0\qj  Who from his altar call;
\par  Praise him whose path of pain you trod,
\par  And crown him Lord of all.
\par \pard\li225\sl40\slmult0 
\par \pard\fi-225\li315\sl202\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3. Let every tongue and every tribe,
\par \pard\li315\sl202\slmult0 Responsive to the call,
\par To him all majesty ascribe,
\par And crown him Lord of all.
\par 
\par \pard\fi-270\li315\sl202\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4. Oh, that with yonder sacred throng,
\par \pard\li315\sl202\slmult0 We at his feet may fall;
\par Join in the everlasting song,
\par \pard       And crown him Lord of all!\f1 
\par \cf1\ul\b\f2 
\par }

