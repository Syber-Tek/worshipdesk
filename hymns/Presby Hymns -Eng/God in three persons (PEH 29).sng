\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  God in three persons,
\par \pard\li225\sl190\slmult0\qj  We voice out to say,
\par  The redeemer of all people
\par  comes from the whole being of the Lord
\par  and His painful death
\par  suffered on the cross.
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par   2.  Tongues of the Angel,
\par \pard\li144\sl190\slmult0   songs of Seraphim
\par    that we need to use to praise Him
\par   God the most Holy Trinity
\par    to sing a sweet song
\par   for the one who died.\f1 
\par \pard\cf1\ul\b\f2 
\par }

