\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  1. \cf0  Now the labourer's task is o'er
\par \pard\li270\sl190\slmult0 Now the battle-day is past
\par Now upon the farther shore
\par Lands the voyager at last
\par \i Father, in Thy gracious keeping
\par Leave we now Thy servant sleeping\i0 
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par   2.  There the tears of earth are dried
\par \pard\li270\sl190\slmult0 There its hidden things are clear
\par There the work of life is tried
\par By a juster Judge than here
\par \i  Father, in Thy gracious keeping \'85.
\par \i0 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par   3.   There the penitents that turn
\par \pard\li270\sl190\slmult0 To the Cross their dying eyes
\par \pard\li225\sl190\slmult0 All the love of Jesus learn
\par At His feet in Paradise
\par \i Father, in Thy gracious keeping....\i0 
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  'Earth to earth and dust to dust
\par \pard\li225\sl190\slmult0 Calmly now the words we say
\par Leaving him to sleep in trust
\par Till the resurrection day
\par \i Father, in Thy gracious keeping....
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par  5.  'Till the sea gives up its dead
\par \pard\li225\sl190\slmult0 Calmly now the words we say
\par Laid in ocean's quiet bed
\par Till the resurrection day
\par \pard\i     Father in Thy gracious keeping.\i0\f1 
\par \cf1\ul\b\f2\fs14 
\par }

