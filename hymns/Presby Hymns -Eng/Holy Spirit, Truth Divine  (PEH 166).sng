\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Holy Spirit, Truth Divine,
\par \pard\li225\sl190\slmult0 Dawn upon this soul of mine;
\par Word of God, and inward Light,
\par Wake my spirit, clear my sight.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2. Holy Spirit, Love Divine,
\par \pard\li225\sl190\slmult0 Glow within this heart of mine;
\par Kindle every high desire;
\par Perish self in Thy pure fire.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3. Holy Spirit, Power Divine,
\par \pard\li225\sl190\slmult0 Fill and nerve this will of mine;
\par By Thee may I strongly live
\par Bravely bear, and nobly strive.
\par 
\par \pard\fi-270\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4. Holy Spirit, Right Divine,
\par \pard\li360\sl190\slmult0 King within my conscience reign;
\par Be my law, and I shall be
\par Firmly bound, for ever free.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Holy Spirit, Peace Divine,
\par \pard\li360\sl190\slmult0 Still this restless heart of mine;
\par Speak to calm this tossing sea,
\par Stayed in Thy tranquility.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. Holy Spirit, Joy Divine,
\par \pard\li360\sl190\slmult0 Gladden Thou this heart of mine;
\par In the desert ways I sing,
\par 'Spring, O, Well forever spring!'\f1 
\par \pard\cf1\ul\b\f2\fs14 
\par }

