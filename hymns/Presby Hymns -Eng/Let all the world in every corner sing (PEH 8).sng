\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  Let all the world in every corner sing,                               
\par \pard\li144\sl190\slmult0   'My God and King!'\tab       
\par   The heavens are not too high,\tab       
\par   His praise may thither fly;\tab       
\par \cf1\ul\b\'b6   Verse\cf0\ulnone\b0 
\par The earth is not too low,\tab       
\par   His praises there may grow.\tab       
\par   Let all the world in every corner sing,\tab       
\par   'My God and King!'
\par 
\par \pard\cf1\ul\b\'b6   Verse 2\cf0\ulnone\b0 
\par \pard\qj  2.   Let all the world in every corner sing,
\par \pard\li144\qj     'My God and King!'  
\par \pard\li144\sl190\slmult0     The church with psalms must shout
\par     no door can keep them out;
\par \cf1\ul\b\'b6     Verse\cf0\ulnone\b0 
\par but, above all, the heart
\par  must bear the longest part
\par  Let all the world in every corner sing
\par \pard     'My God and King!'
\par \cf1\ul\b\f1\fs16 
\par \fs24 
