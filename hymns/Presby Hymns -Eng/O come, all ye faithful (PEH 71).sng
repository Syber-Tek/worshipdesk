\par 1.\cf0  O come, all ye faithful,
\par \pard\li225\sl190\slmult0\qj  Joyful and triumphant,
\par O come ye, O come ye to Bethlehem;
\par  Come and behold him,
\par  Born the King of angels;
\par  
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj O come, let us adore him,
\par  O come, let us adore him,
\par  O come, let us adore him, Christ the Lord.
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par    2.  God of true God,
\par \pard\li270\sl190\slmult0 Light of light,
\par   Lo! He abhors not the Virgin's womb;
\par Son of the Father,
\par Begotten, not created;        \tab 
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj O come, let us adore him,
\par  O come, let us adore him,
\par  O come, let us adore him, Christ the Lord.
\par \pard\li270\sl190\slmult0 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.   Sing, choirs of angels,
\par \pard\li270\sl190\slmult0 Sing in exultation,
\par Sing, all ye citizens of  heaven above,
\par 'Glory to God
\par In the highest':
\par \pard\li405\sl190\slmult0 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj O come, let us adore him,
\par  O come, let us adore him,
\par  O come, let us adore him, Christ the Lord.
