\viewkind4\uc1\pard\fi-270\li270\sl202\slmult0\qj\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1   \cf0  Father of  heaven, whose love profound
\par \pard\li270\sl190\slmult0 A ransom for our souls hath found,
\par Before Thy throne we sinners bend;
\par  To us Thy pardoning love extend.
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2   Almighty Son, Incarnate Word,
\par \pard\li270\sl190\slmult0 Our Prophet, Priest, Redeemer, Lord,
\par Before Thy throne we sinners bend;
\par To us Thy saving grace extend.
\par \pard\li225\sl190\slmult0 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3  Eternal Spirit, by whose breath
\par \pard\li144\sl190\slmult0  The soul is raised from sin and death,
\par  Before Thy throne we sinners bend;
\par  To us Thy quickening power extend.
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4  Jehovah Father, Spirit, Son
\par \pard\li144\sl190\slmult0  Mysterious Godhead, Three in One,
\par  Before Thy throne we sinners bend;
\par \pard  Grace, pardon, life to us extend.\f1 
\par \cf1\ul\b\f2 
\par }

