\viewkind4\uc1\pard\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1\cf0 .  Awake, sons of the Kingdom,
\par \pard\li144\sl190\slmult0   The King is drawing nigh;
\par    Arise and hail with gladness
\par   The Ruler from on high.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par   God's children, come and see!
\par    The goal we are now nearing;
\par    Our banner proudly bearing:
\par    "We're waiting, Lord, for Thee"
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.   Look up, ye tearful mourners,
\par \pard\li144\sl190\slmult0    the King is very near,
\par \pard\li270\sl190\slmult0  away with grief and sorrow,
\par  for see our help is here.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Here in this holy place:
\par O blessed consolation!
\par We find here our salvation
\par Through His pure means of grace
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.  Arise, ye much afflicted,
\par \pard\li270\sl190\slmult0 Your King is not afar
\par Rejoice, ye long dejected,
\par Here comes the Morning Star!
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par The Lord is with us now;
\par \pard\li225\sl190\slmult0  Tho' troubles here distress you
\par  With comfort He will bless you,
\par e'en death to Him shall bow.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.    Up, up, ye faint and fearful,
\par \pard\li225\sl190\slmult0 the King now comes with might;
\par  His heart hath long since loved us
\par and makes our darkness light.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Now are our sorrows o'er;
\par no wrath shall e'er befall us
\par since God in grace doth call us,
\par \pard     His Children evermore.\f1 
\par \cf1\ul\b\f2 
\par }

