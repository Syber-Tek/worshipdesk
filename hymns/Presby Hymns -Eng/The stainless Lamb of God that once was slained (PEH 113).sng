\viewkind4\uc1\pard\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  The stainless Lamb of God that once was slained,
\par \pard\li144\sl190\slmult0   Had saved us with His blood for The Father,
\par \pard\li144\sl190\slmult0\qj   Deserves the honour and  wisdom, power, might.
\par   Prosperity and thanks and of His grace.
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  The stainless Lamb of God that once was slained,
\par \pard\li144\sl190\slmult0\qj   by His own holy blood had saved us all,
\par   Deserves the honour and wisdom power, might.
\par \pard       Prosperity and thanks and of His grace. \f1 
\par \cf1\ul\b\f2 
\par }

