\viewkind4\uc1\pard\fi-225\li360\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  O my Master, Jesus,
\par \pard\li360\sl190\slmult0 your table I come.
\par Thou preparest for me
\par by Thy great mercies
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par cleanse me then O, my master
\par my heart is unclean
\par Let me have all Thy grace
\par in this communion
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Thy troubles, Thy sorrows
\par \pard\li360\sl190\slmult0 Thy predicaments.
\par Thy sufferings and Thy death
\par befit my status
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par but you've paid with all your love
\par for my sinfulness
\par Thou had mercy on me
\par  came down to save me.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Then again my Saviour,
\par \pard\li225\sl190\slmult0 this great deliverance;
\par Let it benefit me,
\par and not be in vain
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par O, forgive me all my sins
\par and my hardened heart
\par forgive me and save me
\par Let me all thy peace.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Give me all thy blessing
\par \pard\li225\sl190\slmult0 in this communion
\par That what Thou gaveth me
\par death cannot destroy
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par I will triumph over all
\par trials and temptations
\par and give me the courage
\par \pard    on the path of heav'n.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

