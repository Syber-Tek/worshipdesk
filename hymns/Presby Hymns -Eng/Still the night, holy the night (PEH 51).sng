\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Still the night, holy the night!
\par \pard\li225\sl190\slmult0  Sleeps the world; hid from sight,
\par  Mary and Joseph in stable bare,
\par  Watch o'er the child beloved and fair,
\par \i ://:Sleeping in heavenly rest. ://:
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Still the night, holy the night!
\par \pard\li225\sl190\slmult0  Shepherds first saw the light,
\par  Heard resounding clear and long,
\par \pard\li144\sl190\slmult0  Far and near, the angel-song,
\par \i  ://: Christ, the Redeemer is here! ://:
\par \i0 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Still the night, holy the night!
\par \pard\li144\sl190\slmult0  Son of God, O how bright!
\par  Love is smiling from Thy face!
\par  Strike for us now, the hour of grace.
\par \pard  ://:Saviour, since Thou art born! ://:\f1 
\par \cf1\ul\b\f2 
\par }

