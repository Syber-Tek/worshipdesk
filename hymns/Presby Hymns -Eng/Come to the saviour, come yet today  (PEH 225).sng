\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Come to the saviour, come yet today;
\par \pard\li225\sl190\slmult0\qj O heed His word, and come while you may;
\par \pard\li225\sl190\slmult0 He is so near to bless you today,
\par calling so friendly  "Come!"
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Joyful, Joyful will the meeting be,
\par when from sin we are made pure and free;
\par And we shall enter Canaan with Thee
\par come now, ye chosen, come!
\par 
\par \pard\fi-270\li270\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.   Come, O my children and hear His voice,
\par \pard\li270\sl190\slmult0\qj  Give Him your heart and in Him rejoice.
\par  He is a safe and heavenly choice;
\par Therefore prepare and come!
\par \pard\li270\sl190\slmult0 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Joyful, Joyful will the meeting be,
\par when from sin we are made pure and free;
\par And we shall enter Canaan with Thee
\par come now, ye chosen, come!
\par \pard\li270\sl190\slmult0 
\par \pard\fi-180\li225\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Firmly believe, He hears when you pray.
\par \pard\li225\sl190\slmult0\qj  O can you feel His presence today?
\par  With love and grace He will you repay
\par  Come then, O sinner, come!
\par \pard\i  
\par \pard\li225\sl190\slmult0\cf1\ul\b\i0\'b6 Chorus\cf0\ulnone\b0 
\par Joyful, Joyful will the meeting be,
\par when from sin we are made pure and free;
\par And we shall enter Canaan with Thee
\par come now, ye chosen, come!
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

