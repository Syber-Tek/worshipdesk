\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  Sing joyful songs 
\par \pard\li225\sl190\slmult0  Yes, sing unto God 
\par  Jehovah the Lord,
\par  The Creator of man and our Saviour! 
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.    Angels from Heav'n 
\par \pard\li225\sl190\slmult0  Sing songs of the realms, 
\par  To God Almighty 
\par \pard\li270\sl200\slmult0 And The Lamb That was slain for all  mankind.
\par 
\par \pard\fi-270\li270\sl200\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.   God you are kind
\par \pard\li270\sl200\slmult0\qj  Yes, God you are kind;
\par  You merciful one, 
\par And you gave to us Your one only Son. 
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\ulnone\b0 
\par \pard\fi-225\li225\sl190\slmult0\qj 4. \cf0   Let's bless His name 
\par \pard\li225\sl190\slmult0\qj Yes, let's bless His name:
\par His name is Jesus,
\par The Saviour and Master of all mankind. 
\par \b 
\par \pard\sl190\slmult0\cf1\ul\'b6 Verse 5\cf0\ulnone 
\par \b0 5.  Praise ye the Lord,
\par \pard\li144\sl190\slmult0   Yes, praise ye the Lord,
\par   He came a  human
\par   And paid the price and saved us from our sins. 
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6.  Sing joyful songs 
\par \pard\li144\sl190\slmult0   Let  all voices sing 
\par   in praise of our God;
\par \pard\li144\sl190\slmult0\qj   Our Lord and our Saviour, Almighty.
\par \pard\f1 
\par \cf1\ul\b\f2 
\par }

