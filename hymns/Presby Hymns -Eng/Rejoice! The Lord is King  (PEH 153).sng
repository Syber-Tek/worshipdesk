\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.  \cf0  Rejoice! The Lord is King,
\par \pard\li270\sl190\slmult0 Your Lord and King adore.
\par Mortals, give thanks and sing,
\par And triumph evermore:
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 Lift up your heart, lift up your voice;
\par Rejoice; again I say: Rejoice!
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par    2.  Jesus the Saviour reigns,
\par \pard\li270\sl190\slmult0 The God of truth and love;
\par When he had purged our stains,
\par He took his seat above:
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 Lift up your heart, lift up your voice;
\par Rejoice; again I say: Rejoice!
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par   3.  His kingdom cannot fail;
\par \pard\li270\sl190\slmult0    He rules both earth and heaven;
\par \pard\li360\sl190\slmult0 The keys of death and hell
\par Are to our Jesus given:
\par 
\par \pard\li270\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 Lift up your heart, lift up your voice;
\par Rejoice; again I say: Rejoice!
\par \pard\li360\sl190\slmult0 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. He sits at God's right hand
\par \pard\li360\sl190\slmult0 Till all his foes submit,
\par And bow to his command,
\par And fall before his feet:
\par 
\par \pard\li270\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 Lift up your heart, lift up your voice;
\par Rejoice; again I say: Rejoice!
\par \pard\li360\sl190\slmult0 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Rejoice in glorious hope,
\par \pard\li360\sl190\slmult0 For Christ, the Judge, shall come,
\par And take his servants up
\par \pard        To their eternal home:
\par 
\par \pard\li270\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 Lift up your heart, lift up your voice;
\par Rejoice; again I say: Rejoice!\cf1\ul\b\f1\fs14 
\par }

