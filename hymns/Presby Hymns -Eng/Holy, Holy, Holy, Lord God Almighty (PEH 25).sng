\viewkind4\uc1\pard\li288\sl210\slmult0\qj\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \tab Holy, Holy, Holy, Lord God Almighty!\cf0 
\par Early in the morning our song shall rise to Thee;
\par Holy, Holy, Holy, merciful and mighty!
\par God in Three Persons, blessed Trinity!
\par \pard\li720\sl210\slmult0\qj 
\par \pard\li288\sl210\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2. \tab Holy, Holy, Holy, all the saints adore Thee,
\par Casting down their golden crowns around the glassy sea;
\par \pard     Cherubim and Seraphim falling down before Thee,
\par     \cf1 Who wert, and art, and evermore shall be.
\par \pard\li720\sl210\slmult0\qj\cf0 
\par \pard\li288\sl210\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \tab Holy, Holy, Holy, 
\par though the darkness hide Thee,
\par Though the sinful human eye Thy glory may not see,
\par Only Thou art Holy; there is none beside Thee,
\par Perfect in power, in love, and purity.
\par \pard\li720\sl210\slmult0\qj 
\par \pard\li288\sl210\slmult0\qj\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \tab Holy, Holy, Holy, Lord God Almighty!
\par All Thy works shall praise Thy name
\par in earth and  sky and sea;
\par Holy, Holy, Holy, merciful and mighty!
\par \pard     God in Three Persons, blessed Trinity.\f1 
\par \cf1\ul\b\f2 
\par }

