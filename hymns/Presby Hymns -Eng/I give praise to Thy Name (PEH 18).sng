\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0   I give praise to Thy Name,
\par \pard\li180\sl190\slmult0   my life my light and my God.
\par   My maker you gave me
\par   my flesh my soul and body;
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par   my Father who cares for
\par   me from my mother's womb,
\par   He grants me all my needs
\par   today and evermore.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par   2.  I give praise to your name,
\par \pard\li180\sl190\slmult0   My Lord and my Salvation
\par    The only son of God
\par    To me Thy life be given
\par \cf1\ul\b\'b6   Verse\cf0\ulnone\b0 
\par And to your precious blood
\par    Redeemed me from my sins
\par    Unshaken faith I find
\par     A pardoning grace receive.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  I give praise to Your name,
\par \pard\li225\sl190\slmult0  my light, my life, and my God
\par Father, Spirit divine
\par  The son to you has given
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Comforter of my Soul
\par A counsellor I find
\par Your Spirit strengthen me
\par My sure defence You are.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. I give praise to Your name
\par \pard\li225\sl190\slmult0 my Father, Lord and my God
\par You are the only God
\par Father, Son, Holy Spirit
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par all saints in Your Heavens
\par and all Christians on earth
\par shall give praise to Your name,
\par \pard    Your name is Holy Lord!\f1 
\par \cf1\ul\b\f2 
\par }

