\viewkind4\uc1\pard\fi-225\li225\sl180\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus the only good shepherd
\par \pard\li225\sl180\slmult0 who with love cares for his sheep
\par because of  their own safe keeping
\par He gave up his life for them
\par 
\par \pard\fi-225\li225\sl180\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. He takes good care of his sheep
\par \pard\li225\sl180\slmult0 and they also hear his voice
\par \pard\li225\sl180\slmult0\qj he knows them and they follow him
\par \pard\li225\sl180\slmult0  cares for them right to the least
\par 
\par \pard\fi-270\li270\sl180\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3. Are you also one amongst them
\par \pard\li270\sl180\slmult0 and have received him at all?
\par He has out-stretched his hands always
\par for us to fall on his breast\i 
\par \i0 
\par \pard\fi-225\li270\sl180\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Good Jesus let me worship you,
\par \pard\li270\sl180\slmult0 and be present at your feet!
\par be merciful, let me love you,
\par \pard      and give you praise for your love.\f1 
\par \cf1\ul\b\f2 
\par }

