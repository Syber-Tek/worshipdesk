\viewkind4\uc1\pard\fi-225\li225\sl180\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  I receive your grace now
\par \pard\li225\sl180\slmult0 Jesus, son of God
\par By this grace and Mercy
\par I give thanks to thee
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par O, take me and all my heart
\par and all of my mind
\par Let it all be my thanks
\par And to please you more.
\par 
\par \pard\fi-360\li360\sl180\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par    2  By thine own broken flesh
\par \pard\li360\sl180\slmult0 and thy precious blood;
\par gives me the great courage
\par and takes care of me:
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par That by what your meekness is
\par Let mine be the same
\par Take me to be your own
\par \pard      On this earth and heav'n.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

