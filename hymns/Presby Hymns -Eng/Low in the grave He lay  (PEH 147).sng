\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0   Low in the grave He lay,
\par \pard\li225\sl190\slmult0  Jesus my Saviour;
\par  Waiting the coming day,
\par  Jesus, my Lord.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \pard\li225\sl190\slmult0\qj Up from the grave He arose,
\par With a mighty triumph o'er His foes;
\par He arose a Victor from the dark domain,
\par And He lives forever with
\par His saints to reign:
\par He arose! Hallelujah! Christ arose!
\par \pard\li450\sl190\slmult0\i0 
\par \pard\fi-270\li450\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Vainly they watch His bed,
\par \pard\li450\sl190\slmult0 Jesus, my Saviour;
\par Vainly they seal the dead,
\par Jesus, my Lord.
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b Chorus\cf0\ulnone\b0\i 
\par \pard\li225\sl190\slmult0\qj Up from the grave He arose,
\par With a mighty triumph o'er His foes;
\par He arose a Victor from the dark domain,
\par And He lives forever with
\par His saints to reign:
\par He arose! Hallelujah! Christ arose!
\par \pard\li450\sl190\slmult0\i0 
\par \pard\fi-270\li450\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3. Death cannot keep his prey,
\par \pard\li450\sl190\slmult0 Jesus, my Saviour;
\par He tore the bars away,
\par \pard          Jesus, my Lord.
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b Chorus\cf0\ulnone\b0\i 
\par \pard\li225\sl190\slmult0\qj Up from the grave He arose,
\par With a mighty triumph o'er His foes;
\par He arose a Victor from the dark domain,
\par And He lives forever with
\par His saints to reign:
\par He arose! Hallelujah! Christ arose!
\par \pard\cf1\i0\f1 
