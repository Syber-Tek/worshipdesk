\viewkind4\uc1\pard\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  To-day is the birth day of Christ
\par \pard\li144\sl190\slmult0   An important day for children
\par   Because he loves us as children
\par   and has become as one of us.
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Oh! Jesus our saviour divine
\par \pard\li144\sl190\slmult0   That for our sake that you came down
\par  as to become God's own children
\par  and to receive eternal peace.
\par 
\par \pard\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.   We give you thanks, we plead with you
\par \pard\li144\sl190\slmult0    That we may have clean and pure hearts
\par \pard        that you may come within to dwell
\par       and we shall not be found wanting.    \f1 
\par \cf1\ul\b\f2 
\par }

