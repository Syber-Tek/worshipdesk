\viewkind4\uc1\pard\fi-180\li180\sl180\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  For my household and I shall serve Jehovah!
\par \pard\li180\sl180\slmult0  He is our Saviour and our Keeper
\par  He is our foundation which will never shake,
\par \pard\li180\sl180\slmult0\qj  For we shall firmly stand on Him with faith
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj Let people of this world search for Godliness;
\par In midst of filth and in wordly passion;
\par As for us, we have had life and perfect peace
\par Through our Saviour and in His holy blood.
\par 
\par \pard\fi-225\li225\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. He is our head, we are part of His body
\par \pard\li225\sl190\slmult0\qj He has purchased us with His holy blood;
\par His immense love, we shall never forget it;
\par His blessing is what we mostly yearn for
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj The house He deserts, Satan takes it over;
\par Abominations, always in the house;
\par His blessings bestowed unto that house
\par \pard\li225\sl190\slmult0 Upon themselves and all their descendants.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Let hopeless people kick against their life head,
\par \pard\li225\sl190\slmult0\qj And say that they dislike Jesus' Kingdom
\par But for my house, and me we shall follow Him;
\par In good faith and in perfect and pure love
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj In good living, we always rejoice in Him,
\par In times of trouble, He stands behind us
\par He is with us in death and He will take us
\par Also to the heaven's perfect living.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  For my household and me shall serve Jehovah;
\par \pard\li225\sl190\slmult0\qj For He is our life and our lasting wealth;
\par This word is the law which and I my household;
\par Shall depend on throughout our lives on earth;
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj I plead with my good Lord to let my children;
\par My grandchildren and all my descendants;
\par To search for their lives only through Jesus Christ;
\par So to rejoice now and forever!\tab\tab\i 
\par \pard\i0\f1 
\par \cf1\ul\b\f2\fs14 
\par }

