\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.  Thine forever! God of Love,\cf0 
\par \pard\li225\sl190\slmult0  Hear us from Thy throne above;
\par Thine for ever may we be,
\par  Here and in eternity.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  Thine forever! O how blest
\par \pard\li225\sl190\slmult0 They who find in Thee their rest!
\par Saviour, Guardian Heavenly Friend,
\par O defend us to the end.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.  Thine forever! Lord of Life,
\par \pard\li225\sl190\slmult0 Shield us through our earthly strife;
\par \pard\li315\sl190\slmult0 Thou the Life, the Truth, the Way
\par Guide us to the realms of day.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Thine forever! Shepherd, keep
\par \pard\li315\sl190\slmult0 These, Thy frail and trembling sheep;
\par Safe alone beneath Thy care,
\par Let us all Thy goodness share.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. Thine forever! Thou our Guide,
\par \pard\li315\sl190\slmult0 All our wants by Thee supplied,
\par All our sins by Thee forgiven,
\par \pard        Lead us, Lord, from earth to heaven.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

