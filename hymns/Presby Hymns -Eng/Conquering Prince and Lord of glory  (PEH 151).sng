\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  Conquering Prince and Lord of glory,
\par \pard\li270\sl190\slmult0\qj Majesty enthroned in light;
\par All the heavens are bowed before Thee,
\par \pard\li225\sl190\slmult0\qj  For beyond them spreads Thy might;
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj  Shall I then fall at Thy feet,
\par  And my heart with rapture beat,
\par \pard\li270\sl190\slmult0\qj Now Thy glory is displayed,
\par Thine ere yet the worlds were made?
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.   As I watch thee far ascending
\par \pard\li270\sl190\slmult0 To the right hand of the throne,
\par See the host before Thee bending,
\par Praising Thee in sweetest tone;
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Shall not I too at thy feet
\par Here the angels' strain repeat,
\par And rejoice that heaven doth ring
\par With the triumph of my King?
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3. Power and spirit are o'er flowing,
\par \pard\li225\sl190\slmult0 On me also they are poured;
\par Every hindrance overthrowing
\par Make Thy foes Thy footstool, Lord;
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Yea, let earth's remotest end
\par To Thy righteous scepter bend,
\par Make Thy way before Thee plain
\par O'er all hearts and spirits reign.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  Lo! Thy presence now is filling
\par \pard\li225\sl190\slmult0 All thy church in every place;
\par Fill my heart too; make me willing
\par In this season of Thy grace;
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Come, Thou king of glory, come,
\par Deign to make my heart Thy home,
\par There abide and rule alone,
\par \pard      As upon Thy heavenly throne! Amen.\f1 
\par \cf1\ul\b\f2 
\par }

