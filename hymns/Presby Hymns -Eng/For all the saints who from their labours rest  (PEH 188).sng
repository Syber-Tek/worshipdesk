\viewkind4\uc1\pard\li450\sl202\slmult0\qj\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0\tab For all the saints who from their labours rest,
\par \pard\li450\sl190\slmult0\tab Who Thee by faith before the world confessed,
\par \tab Thy name, O Jesu, be for ever blest.
\par \tab\i\tab Hallelujah!
\par \i0 
\par \cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. \tab Thou was their Rock, their Fortress, and their Might;
\par \tab Thou, Lord, their Captain in the well fought fight;
\par \tab Thou in the darkness drear their one true Light.
\par \tab\i\tab Hallelujah!
\par \i0 
\par \pard\li450\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. \tab O may Thy soldiers, faithful, true, and bold,
\par \pard\li450\sl190\slmult0\tab Fight as the saints who nobly fought of old,
\par \tab win, with them, the victor's crown of  gold
\par \tab\i\tab Hallelujah!
\par \i0 
\par \pard\li450\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. \tab O blest communion, fellowship divine!
\par \tab We feebly struggle; they in glory shine,
\par \tab Yet all are one in Thee, for all are Thine.
\par \tab\i\tab Hallelujah!
\par \i0 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.\tab And when the strife is fierce, the warfare long,
\par \tab Steals on the ear the distant triumph song,
\par \pard\li450\sl190\slmult0\tab And hearts are brave again, and arms are strong.
\par \tab\i\tab Hallelujah
\par \i0 
\par \pard\li450\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par 6. \tab The golden evening brightens in the west;
\par \pard\li450\sl190\slmult0\tab Soon, soon to faithful warriors cometh rest;
\par \pard\li450\sl190\slmult0\qj\tab Sweet is the calm of paradise the blest.
\par \pard\li450\sl190\slmult0\i\tab\tab Hallelujah!
\par \i0 
\par \pard\li450\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par 7. \tab But lo! There breaks a yet more glorious day:
\par \tab The saints triumphant rise in bright array;
\par \pard\li450\sl190\slmult0\tab The King of Glory passes on His way.
\par \tab\i\tab Hallelujah!
\par \i0 
\par \pard\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par           8.   From earth's wide bounds, from ocean's farthest coast,
\par \pard\sl190\slmult0\tab Through gates of pearl streams in the countless host,
\par \pard\sl190\slmult0\qj\tab Singing  to Father, Son, and Holy Ghost:
\par \pard\sl190\slmult0\tab\i                  Hallelujah!
\par \pard\i0\f1 
\par \cf1\ul\b\f2\fs14 
\par }

