\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1 \cf0  O come, O come, Emmanuel,
\par \pard\li225\sl190\slmult0 And ransom captive Israel,
\par That mourns in lonely exile here
\par Until  the  Son of God appear.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Rejoice!  Rejoice!  Emmanuel!
\par Shall come to thee, O Israel.\tab 
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. O come, O come, thou Lord of might,
\par \pard\li225\sl190\slmult0 Who to thy tribes, on Sinai's height,
\par In ancient times didst give the law
\par  In cloud and majesty and awe.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Rejoice!  Rejoice!  Emmanuel!
\par Shall come to thee, O Israel.\tab 
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  O come, thou Rod of Jesse, free
\par \pard\li225\sl190\slmult0   Thine own from satan's tyranny;
\par From depths of hell thy people save,
\par \pard\li270\sl190\slmult0  And give them victory o'er the grave:
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Rejoice!  Rejoice!  Emmanuel!
\par Shall come to thee, O Israel.\tab 
\par \pard\li270\sl190\slmult0 
\par \pard\fi-225\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  O come, thou key of David, come,
\par \pard\li270\sl190\slmult0  And open wide our heavenly home;
\par  Make safe the way that leads on high,
\par \pard\li144\sl190\slmult0     And close the path to misery:
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Rejoice!  Rejoice!  Emmanuel!
\par Shall come to thee, O Israel.\tab 
\par \pard\li144\sl190\slmult0 
\par \pard\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par   5.  O come, thou Dayspring, come and cheer
\par \pard\sl190\slmult0        Our spirits by thine advent here;
\par       Disperse the gloomy clouds of night,
\par        And death's dark shadows put to flight:
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Rejoice!  Rejoice!  Emmanuel!
\par Shall come to thee, O Israel.\tab 
\par \pard\sl190\slmult0\f1 
\par \pard\cf1\ul\b\f2 
\par }

