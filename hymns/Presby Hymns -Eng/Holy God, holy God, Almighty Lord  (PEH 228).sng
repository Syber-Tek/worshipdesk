\viewkind4\uc1\pard\li288\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \tab Holy God, holy God, Almighty Lord,\cf0 
\par \pard\sl190\slmult0\tab Through Jesus we pray to you today.
\par 
\par \pard\li288\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par     2. \tab Holy one, Holy one, the Lord of all,
\par \pard\li288\sl190\slmult0\qj\tab Here are we, here are we, your people,
\par 
\par \cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par     3. \tab Now we read, now we read your Holy Word,
\par \tab We have sinned, we have sinned before you,
\par 
\par \pard\li288\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par     4. \tab You called us, you called us, and  now we come,
\par \tab Joyfully, joyfully, sing to you,
\par 
\par \cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par     5.\tab It's Thy word, Thy Holy Word, that we read
\par \pard\tab Hear our prayers, hear our prayers and keep us.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

