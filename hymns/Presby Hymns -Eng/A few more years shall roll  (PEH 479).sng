\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1\cf0 .  A few more years shall roll,
\par \pard\li225\sl180\slmult0 A few more seasons come,
\par And we shall be with those that rest
\par Asleep within the tomb.
\par \b\i 
\par \cf1\ul\i0\'b6 Chorus\cf0\ulnone\b0 
\par Then, O my Lord, prepare
\par My soul for that great day;
\par Oh, wash me in Thy precious blood,
\par And take my sins away.
\par 
\par \pard\fi-225\li225\sl180\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  A few more suns shall set,
\par \pard\li225\sl180\slmult0 O'er these dark hills of time;
\par And we shall be where suns are not,
\par A far serener clime.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Then, O my Lord, prepare
\par My soul for that great day;
\par Oh, wash me in Thy precious blood,
\par And take my sins away.
\par 
\par \pard\fi-225\li225\sl180\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. A few more storms shall beat
\par \pard\li225\sl180\slmult0\qj On this wild rocky shore;
\par And me shall be where tempests cease,
\par And surge swell no more.
\par \pard\li360\sl180\slmult0\qj 
\par \pard\li225\sl180\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Then, O my Lord, prepare
\par My soul for that great day;
\par Oh, wash me in Thy precious blood,
\par And take my sins away.
\par \pard\li360\sl180\slmult0\qj 
\par \pard\fi-225\li360\sl180\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  A few more struggles here,
\par \pard\li360\sl180\slmult0 A few more partings o'er;
\par A few more toils, a few more tears,
\par And we shall weep no more.
\par 
\par \pard\li225\sl180\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Then, O my Lord, prepare
\par My soul for that great day;
\par Oh, wash me in Thy precious blood,
\par And take my sins away.
\par \pard\li360\sl180\slmult0 
\par \pard\fi-225\li360\sl180\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  'Tis but a little while
\par \pard\li360\sl180\slmult0 And he shall come again,
\par \pard\li360\sl180\slmult0\qj Who died that we might live; who lives
\par \pard\li360\sl180\slmult0 That we with Him may reign.
\par \pard 
\par \pard\li225\sl180\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Then, O my Lord, prepare
\par My soul for that great day;
\par Oh, wash me in Thy precious blood,
\par And take my sins away.\cf1\ul\b\f1\fs14 
\par }

