\viewkind4\uc1\pard\fi-225\li225\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  O, Master, Honourable
\par \pard\li225\sl190\slmult0 Jesus, son of God;
\par How can I give you thanks
\par You who have saved me
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par and by thy most holy blood
\par and of your whole being:
\par by which you strengthen me
\par in all my whole life.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Father take my spirit,
\par \pard\li360\sl190\slmult0 my soul and body
\par Take it as an off'ring,
\par take also my thanks
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par All the earths, worldly things I owe
\par take them as thine own,
\par that some day when I'm called
\par to Your house of Joy.\fs18 
\par \pard\f1\fs24 
\par \cf1\ul\b\f2\fs14 
\par }

