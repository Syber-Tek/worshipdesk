\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Let the whole world thank the Lord
\par \pard\li225\sl190\slmult0 for fulfillment of his word!
\par advocate for all sinners
\par God has sent him to us now.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. What generation of old
\par \pard\li225\sl190\slmult0 waited for and longed to see
\par \pard\li270\sl190\slmult0 what was prophesied to them
\par that we are now embracing
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.   Hail oh! hail my Saviour king
\par \pard\li270\sl190\slmult0 see how now I worship you
\par Prepare a place for yourself
\par in my heart and dwell within.
\par \pard\f1 
