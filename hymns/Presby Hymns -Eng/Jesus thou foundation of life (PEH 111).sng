\viewkind4\uc1\pard\fi-225\li225\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus thou foundation of life
\par \pard\li225\sl190\slmult0 Your death has now cancelled mine
\par You sacrificed yourself for me
\par You took up all my suffering
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par You did not see me die in sin
\par You saved me to eternal life.
\par Thank you Lord, O my Saviour,
\par I praise you my honoured King.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Jesus Christ most Holy, righteous
\par \pard\li225\sl190\slmult0 Son of God most Holy one,
\par You were tortured and molested
\par and was disgraced
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Just to rescue me a sinner
\par bringing me into your glory
\par Thank you Lord, O my Saviour
\par My honoured King I praise you.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3   Out of humility you paid
\par \pard\li225\sl190\slmult0 for my pride and laziness
\par boastfulness and inward looking
\par The cost of my arrogance
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par The crown of thorns that you wore
\par made me to wear a kingly crown
\par Thank you Lord, O my Saviour
\par I praise you my honoured King.
\par \pard\f1 
\par \cf1\ul\b\f2 
\par }

