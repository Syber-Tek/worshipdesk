\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.   \cf0  King of glory, King of peace,
\par \pard\li270\sl190\slmult0 I will love Thee;
\par And that love may never cease,
\par I will move Thee.
\par \cf1\ul\b\fs16\'b6 Verse\cf0\ulnone\b0\fs24 
\par Thou hast granted my request,
\par Thou hast heard me;
\par Thou didst note my working breast,
\par Thou hast spared me.
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2. Wherefore with my utmost art
\par \pard\li270\sl190\slmult0 I will sing Thee,
\par And the cream of all my heart
\par I  bring to You.
\par \cf1\ul\b\fs16\'b6 Verse\cf0\ulnone\b0\fs24 
\par Though my sins against me cried,
\par \pard\li315\sl190\slmult0 Thou did clear me;
\par And alone, when they replied,
\par Thou did hear me.
\par 
\par \pard\fi-270\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.  Seven whole days, not one in seven,
\par \pard\li315\sl190\slmult0 I will praise You;
\par In my heart, though not in heaven,
\par can I raise You.
\par \cf1\ul\b\fs16\'b6 Verse\cf0\ulnone\b0\fs24 
\par Small it is, in this poor sort
\par To enrol Thee;
\par E'en eternity's too short
\par \pard      To extol Thee.\f1 
\par \cf1\ul\b\f2 
\par }

