\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Have mercy on us, Jesus Christ
\par \pard\li225\sl190\slmult0 Thou, Holy Immanuel!
\par Thou has showered blessings on us
\par Take our hearts to be Thine own
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  You had to sleep in a manger
\par \pard\li225\sl190\slmult0 Just as soft baby looks like.
\par You did that for our children's sake
\par \pard\li315\sl190\slmult0 In your honour and deep love
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.    You descended as a baby
\par \pard\li315\sl190\slmult0 Let our children to be like you
\par  Teach us, so that we learn from you
\par  That our nature befits you
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.   Let us always walk before Thee
\par \pard\li315\sl190\slmult0 Silently listening to Thee
\par \pard\li360\sl190\slmult0\cf1 Take from our hearts all evil deeds\cf0 
\par And grant us good, perfect hearts
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  Let us eschew all evil deeds
\par \pard\li360\sl190\slmult0 To inherit eternal life
\par Cleanse our bodies from all evil
\par All say: Amen, let it be.\f1 
\par \pard\cf1\ul\b\f2 
\par }

