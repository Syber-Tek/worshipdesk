\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. Looking upward every day,\cf0 
\par \pard\li180\sl190\slmult0 Sunshine on our faces;
\par Pressing onward every day
\par Toward the heavenly places;
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Growing every day in awe,
\par \pard\li180\sl190\slmult0 For Thy name is holy;
\par Learning every day to love
\par With a love more lowly.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Walking every day more close
\par \pard\li180\sl190\slmult0 To our Elder Brother;
\par Growing every day more true
\par Unto one another;
\par \pard\li315\sl190\slmult0 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4.  Leaving everyday behind
\par \pard\li315\sl190\slmult0 Something which might hinder;
\par Running swifter everyday;
\par Growing purer, kinder;
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  Lord so pray we every day:
\par \pard\li315\sl190\slmult0 Hear us in Thy pity,
\par That we enter in at last
\par \pard      To the holy city.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

