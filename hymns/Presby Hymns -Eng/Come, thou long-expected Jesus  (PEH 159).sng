\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  Come, thou long-expected Jesus,
\par \pard\li180\sl190\slmult0  Born to set thy people free;
\par  From our fears and sins release us;
\par  Let us find our rest in thee.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Israel's strength and consolation,
\par \pard\li180\sl190\slmult0  Hope of all the earth thou art,
\par  Dear desire of every nation,
\par  Joy of every longing heart.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Born thy people to deliver,
\par \pard\li315\sl190\slmult0 Born a child, and yet a King,
\par Born to reign in us for ever,
\par Now thy gracious kingdom bring.
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. By thine own eternal Spirit
\par \pard\li315\sl190\slmult0 Rule in all our hearts alone;
\par By thine all-sufficient merit
\par Raise us to thy glorious throne.
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

