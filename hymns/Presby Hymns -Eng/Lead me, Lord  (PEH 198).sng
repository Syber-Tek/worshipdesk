\viewkind4\uc1\pard\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.  Lead me, Lord,
\par lead me in Thy righteousness,
\par make Thy way plain, before my face,
\par For it is Thou, Lord, Thou Lord only,
\par that makest me dwell in safety.\f1\fs18 
\par \ul\b\f2\fs16 
\par }

