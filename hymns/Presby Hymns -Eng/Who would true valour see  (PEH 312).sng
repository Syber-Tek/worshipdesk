\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Who would true valour see,
\par \pard\li225\sl190\slmult0 Let him come hither;
\par One here will constant be,
\par Come wind, come weather;
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par There's no discouragement
\par Shall make him once relent
\par His first avowed intent
\par To be a pilgrim.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Who so beset him round
\par \pard\li225\sl190\slmult0 With dismal stories,
\par Do but themselves confound;
\par His strength the more is.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par No lion can him fright,
\par He'll with a giant flight,
\par But he will have a right
\par To be a pilgrim.
\par \pard\li360\sl190\slmult0 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Hobgoblin or foul fiend
\par \pard\li360\sl190\slmult0 Can daunt his spirit;
\par He knows he at the end
\par Shall life inherit.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Then fancies fly away;
\par He'll fear not what men say;
\par He'll labour night and day
\par \pard      To be a pilgrim.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

