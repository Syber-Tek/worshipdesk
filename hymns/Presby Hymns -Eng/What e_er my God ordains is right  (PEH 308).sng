\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  What e'er my God ordains is right,
\par \pard\li225\sl190\slmult0 His holy will abideth;
\par I will be still, what e'er He doth
\par And follow where He guideth
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par He is my God, tho' dark my road,
\par From falling He doth hold me,
\par Therefore I trust Him only.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. What e'er my God ordains is right,
\par \pard\li225\sl190\slmult0 my life and will controlling
\par He lets no evil me betide;
\par His love I'll be extolling
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par In joy and grief, I hold belief
\par that soon 'twill be appearing
\par what here we have been hearing.
\par \pard\li315\sl190\slmult0 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. What e'er my God ordains is right,
\par \pard\li315\sl190\slmult0 here shall my stand be taken
\par tho' sorrow, need or death be mine,
\par yet I am not forsaken.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par My Father's care is round me here,
\par His godly love enfolds me,
\par \pard     therefore I trust Him only.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

