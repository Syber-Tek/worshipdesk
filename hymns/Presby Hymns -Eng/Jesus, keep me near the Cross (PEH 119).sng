\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus, keep me near the Cross;
\par \pard\li225\sl190\slmult0 There a precious fountain,
\par Free to all, a healing stream,
\par Flows from Calvary's mountain.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 In the Cross, in the Cross,
\par Be my glory ever;
\par Till my ruptured-soul shall find
\par Rest beyond the river.
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.   Near the Cross, a trembling soul,
\par \pard\li225\sl190\slmult0   Love and mercy found me;
\par \pard\li315\sl190\slmult0 There the bright and morning star
\par Shed its beams around me.
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 In the Cross, in the Cross,
\par Be my glory ever;
\par Till my ruptured-soul shall find
\par Rest beyond the river.
\par \pard\li315\sl190\slmult0 
\par \pard\fi-315\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.    Near the Cross: O Lamb of God,
\par \pard\li315\sl190\slmult0  Being its scenes before me;
\par  Help me walk from day to day,
\par   With its shadow o'er me.
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 In the Cross, in the Cross,
\par Be my glory ever;
\par Till my ruptured-soul shall find
\par Rest beyond the river.
\par \pard\li315\sl190\slmult0 
\par \pard\fi-315\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.     Near the Cross I'll watch and wait,
\par \pard\li315\sl190\slmult0  Hoping, trusting ever,
\par  Till I reach the golden strand,
\par \pard         Just be yond the river.
\par 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 In the Cross, in the Cross,
\par Be my glory ever;
\par Till my ruptured-soul shall find
\par Rest beyond the river.
\par \pard\f1 
\par \cf1\ul\b\f2 
\par }

