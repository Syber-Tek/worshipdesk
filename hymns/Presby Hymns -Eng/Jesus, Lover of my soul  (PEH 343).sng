\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus, Lover of my soul,
\par \pard\li180\sl190\slmult0 Let me to Thy bosom fly,
\par While the nearer waters roll,
\par While the tempest still is high;
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Hide me, O my Saviour, hide,
\par Till the storm of life is past;
\par Safe into the haven guide;
\par O receive my soul at last!
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Other refuge have I none;
\par \pard\li180\sl190\slmult0 Hangs my helpless soul on thee;
\par Leave, ah! Leave me not alone;
\par Still support and comfort me.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par All my trust on Thee is stayed;
\par All my help from Thee I bring;
\par Cover my defenceless head
\par With the shadow of Thy wing.
\par \pard\li405\sl190\slmult0 
\par \pard\fi-225\li405\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Thou, O Christ, art all I want;
\par \pard\li405\sl190\slmult0 More than all in Thee I find;
\par Raise the fallen, cheer the faint,
\par Heal the sick, and lead the blind.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Just and holy is Thy Name,
\par \pard\li360\sl190\slmult0 I am all unrighteousness;
\par False and full of sin I am,
\par Thou art full of truth and grace.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Plenteous grace with Thee is found,
\par \pard\li360\sl190\slmult0 Grace to cover all my sin;
\par Let the healing streams abound;
\par Make and keep me pure within.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Thou of life the fountain art,
\par Freely let me take of Thee;
\par Spring Thou up within my heart,
\par Rise to all eternity.
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

