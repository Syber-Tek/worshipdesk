\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\f0\fs24 1. \cf0   Guide me, O Thou great Jehovah,
\par \pard\li225\sl190\slmult0 Pilgrim through this barren land;
\par I am weak, but Thou art mighty;
\par Hold me with Thy powerful hand:
\par \i ://: Bread of heaven!
\par  Feed me now and evermore.://:
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0 2. Open Thou the crystal fountain,
\par \pard\li225\sl190\slmult0  Whence the healing stream shall flow;
\par     Let the fiery, cloudy pillar
\par \pard\li360\sl190\slmult0 Lead me all my journey through:
\par \i ://:Strong Deliverer!
\par Be Thou still my help and shield. ://:
\par \i0 
\par \pard\fi-225\li360\sl190\slmult0  3.  When I tread the verge of Jordan,
\par \pard\li360\sl190\slmult0\qj Bid my anxious fears subside;
\par Death of death, and hell's Destruction,
\par Land me safe on Canaan's side:
\par \i ://:Songs of praises
\par  I will ever give to Thee. ://:
\par \pard\li360\sl100\slmult0\qj 
\par \pard\i0\f1 
\par \cf1\f2\fs18 
\par }

