\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0  Children of Jerusalem
\par \pard\li225\sl190\slmult0 Sang the praise of Jesus name
\par Children, too, of modern days
\par Join to sing the Saviour's name
\par \i 
\par \cf1\ul\b\i0\'b6 Chorus\cf0\ulnone\b0\i 
\par \i0 Hark! Hark! Hark! While infant
\par voices sing
\par Hark! Hark! Hark! While infant voices sing
\par Loud hosannas,Loud hosannas,
\par Loud hosannas, to our King
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  We are taught to love the Lord
\par \pard\li225\sl190\slmult0 We are taught to read His word
\par \pard\li180\sl190\slmult0  We are taught the way to heaven
\par Praise for all to God be given
\par \pard\li315\sl190\slmult0 
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Hark! Hark! Hark! While infant
\par voices sing
\par Hark! Hark! Hark! While infant voices sing
\par Loud hosannas,Loud hosannas,
\par Loud hosannas, to our King
\par \pard\li315\sl190\slmult0 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Parents, teachers, old and young
\par \pard\li315\sl190\slmult0 All unite to swell the song
\par Higher and yet higher rise
\par Till hosannas reach the skies.
\par \pard 
