\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par  1.\cf0  Friend who comes from heaven
\par \pard\li270\sl190\slmult0 you who cheers me up
\par when I lost my way
\par you delivered me
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par All these worldly fortunes
\par which I chased for long
\par that couldn't give me peace
\par You've satisfied me.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Now my strength and my life
\par \pard\li225\sl190\slmult0   my behaviour too,
\par   Master, let it be yours
\par   and to you be mine
\par \cf1\ul\b\'b6   Verse\cf0\ulnone\b0 
\par in the toils of this earth
\par   there  is heav'nly light
\par   for me as perfect peace;
\par \pard       You've satisfied me.\f1 
\par \cf1\ul\b\f2 
\par }

