\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Gentle Jesus, meek and mild,
\par \pard\li225\sl190\slmult0 Look upon a little child,
\par Pity my simplicity
\par Suffer me to come to Thee.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Lamb of God, I look to Thee;
\par \pard\li225\sl190\slmult0 Thou shalt my example be;
\par Thou art gentle, meek, and mild;
\par Thou wast once a little child.
\par 
\par \pard\fi-225\li225\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Fain I would be as Thou art;
\par \pard\li225\sl190\slmult0 Give me Thy obedient heart;
\par Thou art pitiful and kind;
\par Let me have Thy loving mind.
\par \pard\li360\sl190\slmult0 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Loving Jesus, gentle Lamb,
\par \pard\li360\sl190\slmult0 In Thy gracious hands I am ;
\par Make me, Saviour, what Thou art;
\par Live Thyself within my heart.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5. I shall then show forth Thy praise,
\par \pard\li360\sl190\slmult0 Serve Thee all my happy days;
\par Then the world shall always see
\par \pard      Christ, the Holy Child, in me.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

