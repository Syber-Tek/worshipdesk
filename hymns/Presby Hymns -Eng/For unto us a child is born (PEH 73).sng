\viewkind4\uc1\pard\fi-225\li225\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0   For unto us a child is born
\par \pard\li225\sl202\slmult0  unto us a son is given
\par  His kingdom is on his shoulder
\par  and his name shall be called
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par  Wonderful, Counsellor, Mighty God
\par  Brave everlasting father
\par  he shall be called Prince of Peace
\par  this child has been born to-day.
\par \pard\sl40\slmult0 
\par \pard\fi-225\li405\sl202\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  His pow'r will continue to grow
\par \pard\li405\sl202\slmult0 His kingdom shall be at peace.
\par A successor of King David
\par rightful heirs unto the throne
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par he will enforce justice and right
\par from now till the end of time
\par so his kingship shall be established
\par \pard      forever and evermore.\f1 
\par \cf1\ul\b\f2 
\par }

