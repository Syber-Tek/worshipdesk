\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0     Master Jesus! Master Jesus!
\par \pard\li180\sl190\slmult0    Lord and our Saviour
\par    And our dear Lord, and our dear Lord,
\par   Source of  everything.
\par \cf1\ul\b\'b6   Verse\cf0\ulnone\b0 
\par It is by Your sacred death
\par   That we are free from our sins
\par   Praise and Honour be unto You,
\par    Lord forever more.
\par 
\par \pard\fi-225\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Come, revive us, come revive us
\par \pard\li270\sl190\slmult0 Our Almighty God,
\par From our slumber, from our slumber,
\par \pard       From this deep slumber!
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6  Verse\ulnone\b0 
\par \cf0 Father you are Holy one
\par  That, we come before Your throne
\par  To adore you, to adore you
\par \pard       And give you your praise.\f1 
\par \cf1\ul\b\f2 
\par }

