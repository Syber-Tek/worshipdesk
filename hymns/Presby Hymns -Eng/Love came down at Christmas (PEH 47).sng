\viewkind4\uc1\pard\fi-270\li270\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1  \cf0   Love came down at Christmas,
\par \pard\li270\sl190\slmult0 Love all lovely, Love Divine;
\par Love was born at Christmas,
\par star and angels gave the sign.
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.   Worship we the Godhead,
\par \pard\li270\sl190\slmult0 Love Incarnate, Love Divine;
\par \pard\li315\sl190\slmult0  worship we our Jesus:
\par  but wherewith for sacred sign?
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Love shall be our token,
\par \pard\li90\sl190\slmult0       love be yours and love be mine,
\par        love to God and all men,
\par \pard       love for plea and gift and sign.\f1 
\par \cf1\ul\b\f2 
\par }

