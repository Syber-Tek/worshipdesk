\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus Christ, the son of God,
\par \pard\li225\sl190\slmult0 I want to listen to your word.
\par All my sins are known to you,
\par if I bow before you my God.
\par You've forgiven me all my sins,
\par and have given me all my peace.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Jesus Christ, the son of God
\par \pard\li360\sl190\slmult0 I submit myself before you.
\par I have sinned against you Lord,
\par So I come before you my God.
\par Your forgiveness that I look for,
\par then I shall be so new again.
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

