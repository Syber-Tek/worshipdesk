\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Christian, work for Jesus,
\par \pard\li180\sl190\slmult0 Who on earth for thee
\par Laboured, wearied, suffered,
\par Died upon the tree.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Work, with lips so fervid
\par \pard\li180\sl190\slmult0 That thy words may prove
\par Thou hast brought a message
\par From the God of love.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. Work, with hearts that burneth
\par \pard\li180\sl190\slmult0 Humbly at His feet
\par \pard\li144\sl190\slmult0  Priceless gems to offer,
\par  For His crown made meet.
\par 
\par \pard\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Work, with prayer unceasing,
\par \pard\li144\sl190\slmult0  Borne on faith's strong wing
\par  Earnestly beseeching
\par  Trophies for the King
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par 5.  Work, while strength endureth,
\par \pard\li315\sl190\slmult0 Until death draw near;
\par Then thy Lord's sweet welcome
\par Thou in heaven shalt hear.
\par \pard\f1 
\par \cf1\ul\b\f2\fs14 
\par }

