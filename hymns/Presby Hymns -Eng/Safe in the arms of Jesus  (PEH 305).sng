\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Safe in the arms of Jesus,
\par \pard\li180\sl190\slmult0 Safe on His gentle breast,
\par There, by His love o'ershaded,
\par Sweetly my soul shall rest.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Hark! 'tis the voice of angels,
\par Borne in a song to me,
\par Over the fields of glory,
\par Over the crystal sea!
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Safe in the arms of Jesus,
\par Safe on His gentle breast,
\par There, by His love o'ershaded,\tab 
\par Sweetly my soul shall rest.
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  Safe in the arms of Jesus,
\par \pard\li180\sl190\slmult0 Safe from corroding care,
\par Safe from the world's temptations
\par Sin cannot harm me there, -
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Free from the blight of sorrow,
\par Free from my doubts and fears,
\par Only a few more trials,
\par Only a few more tears.
\par 
\par \cf1\ul\b\'b6 Chorus\cf0\ulnone\b0 
\par Safe in the arms of Jesus,
\par Safe on His gentle breast,
\par There, by His love o'ershaded,\tab 
\par Sweetly my soul shall rest.
\par 
\par \pard\fi-225\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Jesus, my heart's dear refuge,
\par \pard\li360\sl190\slmult0 Jesus has died for me;
\par Firm on the Rock of Ages
\par Ever my trust shall be.
\par \cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par Here let me wait with patience,
\par Wait till the night is o'er,
\par Wait till I see the morning
\par Break on the golden shore.
\par \pard\b\i     
\par \pard\li180\sl190\slmult0\cf1\ul\i0\'b6 Chorus\cf0\ulnone\b0 
\par Safe in the arms of Jesus,
\par Safe on His gentle breast,
\par There, by His love o'ershaded,\tab 
\par Sweetly my soul shall rest.
\par \pard\f1 
