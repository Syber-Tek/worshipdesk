\viewkind4\uc1\pard\fi-270\li270\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. \cf0   Look down to me Merciful one
\par \pard\li270\sl190\slmult0 I call you from this earth,
\par My sins are destroying my life
\par My master, I'm suffering.
\par 
\par \pard\fi-270\li270\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par  2.  O, I have a very bad Heart
\par \pard\li270\sl190\slmult0 It is so hard as stone.
\par My mentor change my heart today
\par and make it your abode.
\par \pard\sl190\slmult0 
\par \pard\fi-270\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.   O take out every sinful act
\par \pard\li360\sl190\slmult0 from this my troubled Heart
\par drive fear and arguments away
\par that I may believe you.
\par 
\par \pard\fi-270\li360\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  Come Holy Spirit come in time
\par \pard\li360\sl190\slmult0 And brighten all my heart
\par And take away my sinful deeds
\par \pard      And make me your own son.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

