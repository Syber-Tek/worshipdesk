{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\froman\fcharset0 WL-Sims English;}{\f1\fnil\fcharset0 Courier New;}{\f2\froman\fcharset0 Times New Roman;}}
