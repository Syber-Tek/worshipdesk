\viewkind4\uc1\pard\fi-225\li225\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  They that fear Jehovah, they receive blessing
\par \pard\li225\sl190\slmult0\qj They walk on the paths of righteousness
\par The fruits of their toil will never elude them
\par They will enjoy throughout their blessings
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj Their wives represent vine trees which have
\par Lined up and surrounded all their houses
\par \i ://: Make them yield more ://:
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2.  All your children also will be like vine trees
\par \pard\li225\sl190\slmult0\qj That will be found around all your doors
\par For such is how a person will be blessed
\par He who fears Jehovah will bless you
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj So it is Jehovah will bless you too
\par He, from the tip of Mount Zion descend
\par \i ://: He will bless you ://:
\par \i0 
\par \pard\fi-225\li225\sl190\slmult0\qj\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3.  Now,  only through goodness of Jerusalem
\par \pard\li225\sl190\slmult0\qj That will be used to give you reward
\par Through these, you will get abundance of blessing
\par That will pass on to your descendants
\par \pard\li225\sl190\slmult0\cf1\ul\b\'b6 Verse\cf0\ulnone\b0 
\par \pard\li225\sl190\slmult0\qj Your blessing through Zion to be received
\par And you will get everlasting blessing
\par \pard\i       ://:Hallelujah ://:\i0\tab\tab\f1 
\par \cf1\ul\b\f2\fs14 
\par }

