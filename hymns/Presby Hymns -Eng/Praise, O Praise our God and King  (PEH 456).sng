\viewkind4\uc1\pard\fi-180\li180\sl190\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1. Praise, O Praise our God and King;\cf0 
\par \pard\li180\sl190\slmult0 Hymns of adoration sing
\par For His mercies still endure;
\par Ever faithful, ever sure
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. Praise Him that He made the sun
\par \pard\li180\sl190\slmult0 Day by day his course to run
\par For His mercies still endure;
\par Ever faithful, ever sure
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par  3.   And the silver moon, by night
\par \pard\li180\sl190\slmult0   Shining with her gentle light
\par   For His mercies still endure
\par    Ever faithful, ever sure
\par 
\par \pard\fi-180\li180\sl190\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par  4.  Praise Him that He gave the rain
\par \pard\li180\sl190\slmult0   To mature the swelling grain
\par   For His mercies still endure
\par   Ever faithful, ever sure;
\par 
\par \pard\fi-315\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 5\cf0\ulnone\b0 
\par  5.  And hath bid the fruitful field
\par \pard\li315\sl190\slmult0 Crops of precious increase yield
\par For His mercies still endure
\par Ever faithful, ever sure
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 6\cf0\ulnone\b0 
\par  6. Praise Him for our harvest-store;
\par \pard\li315\sl190\slmult0 He hath filled the garner floor
\par For His mercies still endure
\par Ever faithful, ever sure
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 7\cf0\ulnone\b0 
\par  7. And for richer food than this;
\par \pard\li315\sl190\slmult0 Pledge of everlasting bliss;
\par For His mercies still endure;
\par Ever faithful, ever sure;
\par 
\par \pard\fi-225\li315\sl190\slmult0\cf1\ul\b\'b6 Verse 8\cf0\ulnone\b0 
\par  8. Glory to our bounteous King!
\par \pard\li315\sl190\slmult0 Glory let creation sing
\par Glory to the Father, Son;
\par \pard     And blest Spirit, Three in One!\f1 
\par \cf1\ul\b\f2\fs14 
\par }

