\viewkind4\uc1\pard\fi-225\li225\sl202\slmult0\cf1\ul\b\f0\fs24\'b6 Verse 1\ulnone\b0 
\par 1.\cf0  Jesus, come and live with me
\par \pard\li225\sl202\slmult0 Now and for eternity;
\par Come, O Lord, my trusted friend,
\par Make me yours till life shall end.
\par 
\par \pard\fi-225\li225\sl202\slmult0\cf1\ul\b\'b6 Verse 2\cf0\ulnone\b0 
\par 2. All the pleasures that I try
\par \pard\li225\sl202\slmult0 Fail at last to satisfy;
\par Only you can meet my needs,
\par Your sure help all else exceeds
\par 
\par \pard\fi-225\li315\sl202\slmult0\cf1\ul\b\'b6 Verse 3\cf0\ulnone\b0 
\par 3. If you search my life and see
\par \pard\li315\sl202\slmult0 Evil ways or thoughts in me,
\par Sweep them out and make me clean;
\par Save me, Lord, from every sin.
\par 
\par \pard\fi-225\li315\sl202\slmult0\cf1\ul\b\'b6 Verse 4\cf0\ulnone\b0 
\par 4. Lord, I put my trust in you;
\par \pard\li315\sl202\slmult0 Hear my prayer: my life renew!
\par You will change my heart of stone;
\par \pard        Henceforth I'll be yours alone.\f1 
\par \cf1\ul\b\f2\fs14 
\par }

